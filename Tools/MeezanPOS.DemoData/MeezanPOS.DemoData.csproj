<Project Sdk="Microsoft.NET.Sdk">

  <!-- أداة توليد بيانات تجريبية لمنظومة ميزان في قاعدة بيانات منفصلة (لا تمس البيانات الحقيقية) -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\MeezanPOS\MeezanPOS.csproj" />
  </ItemGroup>

</Project>
