<UserControl x:Class="MeezanPOS.Presentation.Views.WagesManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:MeezanPOS.Application.ViewModels"
             xmlns:enums="clr-namespace:MeezanPOS.Domain.Enums"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:views="clr-namespace:MeezanPOS.Presentation.Views"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200"
             FlowDirection="RightToLeft"
             Background="#F5F7FA"
             Padding="32,24"
             Loaded="UserControl_Loaded">
    
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <views:IncrementConverter x:Key="IncrementConverter" />
        
        <ObjectDataProvider x:Key="AttendanceStatusEnum" MethodName="GetValues" ObjectType="{x:Type sys:Type}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="enums:AttendanceStatus"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══════════ القسم العلوي: العنوان والمؤشر العام ═══════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <StackPanel Grid.Column="0">
                <TextBlock Text="إدارة أجور وعمال المطعم" FontSize="26" FontWeight="Bold" Foreground="#1E293B"/>
                <TextBlock Text="النظام المالي المتكامل لتسجيل حضور العمال، السلف، الأجور، وتدقيق كشوف الحسابات." FontSize="14" Foreground="#64748b" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- إجمالي المستحقات العامة -->
            <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="20,12" BorderBrush="#e2e8f0" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.04"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#fee2e2" CornerRadius="8" Padding="10" Margin="0,0,16,0">
                        <materialDesign:PackIcon Kind="AccountMultiple" Foreground="#DC2626" Width="26" Height="26"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="إجمالي مستحقات العمال المتأخرة (عليهم/لهم)" FontSize="12" Foreground="#64748b" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding TotalOutstandingBalance, StringFormat={}{0:N2} د.ل}" FontSize="20" FontWeight="Bold" Foreground="#DC2626" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══════════ محتوى التبويبات الرئيسي ═══════════ -->
        <TabControl Grid.Row="1" FontSize="14">
            
            <!-- ═══════════ التبويب الأول: كشف الحضور واليومية ═══════════ -->
            <TabItem Header="كشف الحضور واليومية">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- شريط إعدادات وتصفية الحضور -->
                    <Border Grid.Row="0" Background="White" CornerRadius="12" BorderBrush="#e2e8f0" BorderThickness="1" Padding="16" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="تاريخ الحضور والوردية:" FontSize="13" FontWeight="Bold" Foreground="#334155" VerticalAlignment="Center"/>

                            <!-- اختيار التاريخ -->
                            <DatePicker Grid.Column="2" SelectedDate="{Binding SelectedAttendanceDate}"
                                        Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                        Padding="10,8" FontSize="13"/>

                            <!-- اختيار الوردية -->
                            <ComboBox Grid.Column="4" ItemsSource="{Binding ShiftTypes}"
                                      SelectedItem="{Binding SelectedAttendanceShift}"
                                      DisplayMemberPath="DisplayName"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                      Padding="10,8" FontSize="13"/>

                            <!-- زر الحفظ والترحيل للأستاذ المساعد -->
                            <Button Grid.Column="6" Content="حفظ واعتماد الحضور اليومي ✓" 
                                    Command="{Binding SaveAttendanceBatchCommand}" 
                                    Style="{StaticResource MaterialDesignFlatButton}" 
                                    Background="#3F51B5" Foreground="White" Height="40" Padding="20,0"/>
                        </Grid>
                    </Border>

                    <!-- جدول إدخال الحضور -->
                    <Border Grid.Row="1" Background="White" CornerRadius="12" BorderBrush="#e2e8f0" BorderThickness="1" Padding="12">
                        <DataGrid ItemsSource="{Binding AttendanceList}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  BorderThickness="0"
                                  Background="Transparent"
                                  RowHeight="48"
                                  FontSize="13"
                                  AlternationCount="100000"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  materialDesign:DataGridAssist.ColumnHeaderPadding="12,10"
                                  materialDesign:DataGridAssist.CellPadding="12,6">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <!-- تسلسل -->
                                <DataGridTemplateColumn Header="م" Width="Auto" MinWidth="50">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=AlternationIndex, Converter={StaticResource IncrementConverter}}" 
                                                       VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="#64748b"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="اسم العامل" Binding="{Binding WorkerName}" Width="2*" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="Foreground" Value="#1e293b"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="TextAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- حالة الحضور (Present / Absent / HalfDay / Leave) -->
                                <DataGridTemplateColumn Header="حالة الحضور" Width="Auto" MinWidth="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding DataContext.AttendanceStatuses, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      SelectedItem="{Binding Status, UpdateSourceTrigger=PropertyChanged}"
                                                      Style="{StaticResource MaterialDesignComboBox}"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Center"
                                                      HorizontalContentAlignment="Center">
                                                 <ComboBox.ItemTemplate>
                                                     <DataTemplate>
                                                         <TextBlock FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center">
                                                             <TextBlock.Style>
                                                                 <Style TargetType="TextBlock">
                                                                     <Setter Property="Text" Value="{Binding}"/>
                                                                     <Style.Triggers>
                                                                         <DataTrigger Binding="{Binding}" Value="Present">
                                                                             <Setter Property="Text" Value="حاضر (يوم كامل)"/>
                                                                             <Setter Property="Foreground" Value="#15803D"/>
                                                                         </DataTrigger>
                                                                         <DataTrigger Binding="{Binding}" Value="Absent">
                                                                             <Setter Property="Text" Value="غائب"/>
                                                                             <Setter Property="Foreground" Value="#b91c1c"/>
                                                                         </DataTrigger>
                                                                         <DataTrigger Binding="{Binding}" Value="HalfDay">
                                                                             <Setter Property="Text" Value="نصف يوم عمل"/>
                                                                             <Setter Property="Foreground" Value="#b45309"/>
                                                                         </DataTrigger>
                                                                         <DataTrigger Binding="{Binding}" Value="Leave">
                                                                             <Setter Property="Text" Value="إجازة"/>
                                                                             <Setter Property="Foreground" Value="#3F51B5"/>
                                                                         </DataTrigger>
                                                                     </Style.Triggers>
                                                                 </Style>
                                                             </TextBlock.Style>
                                                         </TextBlock>
                                                     </DataTemplate>
                                                 </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- يومية اليوم (يمكن تعديلها كلقطة Snapshot لهذا اليوم) -->
                                <DataGridTextColumn Header="أجر اليومية (د.ل)" Binding="{Binding SnapshotDailyWage, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" Width="Auto" MinWidth="130">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextAlignment" Value="Center"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                    <DataGridTextColumn.EditingElementStyle>
                                        <Style TargetType="TextBox">
                                            <Setter Property="TextAlignment" Value="Center"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.EditingElementStyle>
                                </DataGridTextColumn>

                                <!-- خصومات اليوم -->
                                <DataGridTextColumn Header="خصومات اليوم (د.ل)" Binding="{Binding DeductionAmount, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" Width="Auto" MinWidth="130">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextAlignment" Value="Center"/>
                                            <Setter Property="Foreground" Value="#DC2626"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                    <DataGridTextColumn.EditingElementStyle>
                                        <Style TargetType="TextBox">
                                            <Setter Property="TextAlignment" Value="Center"/>
                                            <Setter Property="Foreground" Value="#DC2626"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.EditingElementStyle>
                                </DataGridTextColumn>

                                <!-- تسوية السلفة اليومية -->
                                <DataGridTextColumn Header="خصم سلفة (د.ل)" Binding="{Binding AdvanceDeducted, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" Width="Auto" MinWidth="130">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextAlignment" Value="Center"/>
                                            <Setter Property="Foreground" Value="#b45309"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                    <DataGridTextColumn.EditingElementStyle>
                                        <Style TargetType="TextBox">
                                            <Setter Property="TextAlignment" Value="Center"/>
                                            <Setter Property="Foreground" Value="#b45309"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.EditingElementStyle>
                                </DataGridTextColumn>

                                <!-- ملاحظات اليوم -->
                                <DataGridTextColumn Header="ملاحظات الحضور والغياب" Binding="{Binding Notes}" Width="3*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="TextAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ═══════════ التبويب الثاني: ملفات العمال ═══════════ -->
            <TabItem Header="ملفات العمال وسجلاتهم">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- 1. الإحصائيات -->
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/> <!-- 2. شريط البحث والتحكم -->
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>    <!-- 3. جدول البيانات ملء الشاشة -->
                    </Grid.RowDefinitions>

                    <!-- 1. الإحصائيات -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- كرت إجمالي العمال -->
                        <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="20,16" BorderBrush="#e2e8f0" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.03"/>
                            </Border.Effect>
                            <StackPanel Orientation="Horizontal">
                                <Border Background="#EEF2FF" CornerRadius="8" Padding="12" Margin="0,0,16,0">
                                    <materialDesign:PackIcon Kind="AccountMultiple" Foreground="#3F51B5" Width="24" Height="24"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="إجمالي عدد الموظفين" FontSize="12.5" Foreground="#64748b" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding TotalWorkersCount}" FontSize="18" FontWeight="Bold" Foreground="#3F51B5" Margin="0,4,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- كرت العمال النشطون -->
                        <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="20,16" BorderBrush="#e2e8f0" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.03"/>
                            </Border.Effect>
                            <StackPanel Orientation="Horizontal">
                                <Border Background="#DCFCE7" CornerRadius="8" Padding="12" Margin="0,0,16,0">
                                    <materialDesign:PackIcon Kind="AccountCheck" Foreground="#16A34A" Width="24" Height="24"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="الموظفون النشطون" FontSize="12.5" Foreground="#64748b" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding ActiveWorkersCount}" FontSize="18" FontWeight="Bold" Foreground="#16A34A" Margin="0,4,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- كرت إجمالي تكلفة الأجور -->
                        <Border Grid.Column="4" Background="White" CornerRadius="12" Padding="20,16" BorderBrush="#e2e8f0" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.03"/>
                            </Border.Effect>
                            <StackPanel Orientation="Horizontal">
                                <Border Background="#FEF3C7" CornerRadius="8" Padding="12" Margin="0,0,16,0">
                                    <materialDesign:PackIcon Kind="CashMultiple" Foreground="#d97706" Width="24" Height="24"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="إجمالي تكلفة اليومية الثابتة" FontSize="12.5" Foreground="#64748b" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding TotalDailyWagesCost, StringFormat={}{0:N2} د.ل}" FontSize="18" FontWeight="Bold" Foreground="#d97706" Margin="0,4,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 2. شريط البحث والتحكم -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="320"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- مربع البحث -->
                        <Grid Grid.Column="0">
                            <TextBox Text="{Binding WorkerSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="ابحث باسم الموظف..."
                                     materialDesign:TextFieldAssist.HasClearButton="True"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     Padding="10,8" FontSize="13"/>
                            <materialDesign:PackIcon Kind="Search" Width="18" Height="18" Foreground="#94a3b8" 
                                                     HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0"/>
                        </Grid>

                        <!-- زر إضافة عامل جديد -->
                        <Button Grid.Column="2" 
                                Command="{Binding OpenAddWorkerDialogCommand}"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Background="#3F51B5" Foreground="White" Height="36" Padding="16,0"
                                materialDesign:ButtonAssist.CornerRadius="8">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Plus" Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="إضافة عامل جديد" VerticalAlignment="Center" FontWeight="Bold" FontSize="13"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- 3. جدول البيانات ملء الشاشة -->
                    <Border Grid.Row="4" Background="White" CornerRadius="12" BorderBrush="#e2e8f0" BorderThickness="1" Padding="12">
                        <DataGrid ItemsSource="{Binding WorkersList}"
                                  SelectedItem="{Binding SelectedWorkerProfile}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  BorderThickness="0"
                                  Background="Transparent"
                                  RowHeight="46"
                                  FontSize="13"
                                  AlternationCount="100000"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  materialDesign:DataGridAssist.ColumnHeaderPadding="12,10"
                                  materialDesign:DataGridAssist.CellPadding="12,6">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <!-- تسلسل -->
                                <DataGridTemplateColumn Header="م" Width="Auto" MinWidth="50">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=AlternationIndex, Converter={StaticResource IncrementConverter}}" 
                                                       VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="#64748b"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- الاسم الكامل -->
                                <DataGridTextColumn Header="الاسم الكامل" Binding="{Binding WorkerName}" Width="1.5*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="TextAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- اليومية الثابتة -->
                                <DataGridTextColumn Header="اليومية الثابتة" Binding="{Binding DailyWage, StringFormat=N2}" Width="Auto" MinWidth="120">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextAlignment" Value="Center"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- حالة العامل النشاط -->
                                <DataGridTemplateColumn Header="الحالة" Width="Auto" MinWidth="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                <Setter Property="Background" Value="#DCFCE7"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                <Setter Property="Background" Value="#FEE2E2"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock FontSize="11" FontWeight="Bold" HorizontalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                    <Setter Property="Text" Value="نشط"/>
                                                                    <Setter Property="Foreground" Value="#15803D"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                    <Setter Property="Text" Value="موقوف مؤقتاً"/>
                                                                    <Setter Property="Foreground" Value="#b91c1c"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- ملاحظات عامة -->
                                <DataGridTextColumn Header="ملاحظات عامة" Binding="{Binding Notes}" Width="2*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="TextAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- إجراءات مباشرة -->
                                <DataGridTemplateColumn Header="إجراءات" Width="Auto" MinWidth="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <!-- زر تعديل البيانات -->
                                                <Button Command="{Binding DataContext.OpenEditWorkerDialogCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource MaterialDesignToolButton}"
                                                        Width="26" Height="26" Padding="0" Margin="0,0,4,0" ToolTip="تعديل">
                                                    <materialDesign:PackIcon Kind="EditOutline" Width="16" Height="16" Foreground="#3F51B5"/>
                                                </Button>

                                                <!-- زر إيقاف / تشغيل -->
                                                <Button Command="{Binding DataContext.ToggleWorkerActiveCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource MaterialDesignToolButton}"
                                                        Width="26" Height="26" Padding="0" Margin="0,0,4,0" ToolTip="تغيير حالة النشاط">
                                                    <materialDesign:PackIcon Kind="AccountSwitchOutline" Width="16" Height="16" Foreground="#D97706"/>
                                                </Button>

                                                <!-- زر حذف نهائي -->
                                                <Button Command="{Binding DataContext.DeleteWorkerCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource MaterialDesignToolButton}"
                                                        Width="26" Height="26" Padding="0" ToolTip="حذف نهائي">
                                                    <materialDesign:PackIcon Kind="DeleteOutline" Width="16" Height="16" Foreground="#DC2626"/>
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ═══════════ التبويب الثالث: الأستاذ المساعد وكشف الحساب ═══════════ -->
            <TabItem Header="كشف الحساب والمدفوعات">
                <Grid Margin="0,16,0,0">
                    <!-- قائمة اختيار العمال الرئيسية -->
                    <Border Background="White" CornerRadius="12" BorderBrush="#e2e8f0" BorderThickness="1" Padding="20" MaxWidth="800" HorizontalAlignment="Center">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- شريط البحث الجانبي -->
                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="ابحث عن عامل..."
                                         materialDesign:TextFieldAssist.HasClearButton="True"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         Padding="10,8" FontSize="13"
                                         Background="#f8fafc">
                                </TextBox>
                                <materialDesign:PackIcon Kind="Search" Width="18" Height="18" Foreground="#94a3b8" 
                                                         HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0"/>
                            </Grid>

                            <!-- جدول أرصدة العمال -->
                            <DataGrid Grid.Row="1" 
                                      ItemsSource="{Binding WorkerSummaries}" 
                                      SelectedItem="{Binding SelectedWorkerSummary}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      BorderThickness="0"
                                      Background="Transparent"
                                      RowHeight="48"
                                      FontSize="13"
                                      AlternationCount="100000"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      materialDesign:DataGridAssist.ColumnHeaderPadding="12,10"
                                      materialDesign:DataGridAssist.CellPadding="12,6">
                                <DataGrid.Resources>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    </Style>
                                </DataGrid.Resources>
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow" BasedOn="{StaticResource MaterialDesignDataGridRow}">
                                        <EventSetter Event="MouseDoubleClick" Handler="WorkerRow_MouseDoubleClick"/>
                                        <Setter Property="Tag" Value="{Binding}"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <!-- تسلسل -->
                                    <DataGridTemplateColumn Header="م" Width="Auto" MinWidth="50">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=AlternationIndex, Converter={StaticResource IncrementConverter}}" 
                                                           VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="#64748b"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- اسم العامل -->
                                    <DataGridTextColumn Header="اسم العامل" Binding="{Binding WorkerName}" Width="2*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="TextAlignment" Value="Center"/>
                                                <Setter Property="Foreground" Value="#3F51B5"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- آخر حركة -->
                                    <DataGridTextColumn Header="آخر حركة" Binding="{Binding LastActivity, StringFormat={}{0:yyyy/MM/dd}}" Width="1.5*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="TextAlignment" Value="Center"/>
                                                <Setter Property="Foreground" Value="#94a3b8"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding LastActivity}" Value="{x:Null}">
                                                        <Setter Property="Text" Value="-"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- الرصيد الحالي -->
                                    <DataGridTextColumn Header="الرصيد الحالي" Binding="{Binding Balance, StringFormat={}{0:N2} د.ل}" Width="1.5*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="TextAlignment" Value="Center"/>
                                                <Setter Property="Foreground" Value="#DC2626"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Balance}" Value="0">
                                                        <Setter Property="Foreground" Value="#16A34A"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
