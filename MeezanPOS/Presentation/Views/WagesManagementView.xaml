<UserControl x:Class="MeezanPOS.Presentation.Views.WagesManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:MeezanPOS.Application.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200"
             FlowDirection="RightToLeft"
             Background="#f8f9ff"
             Padding="32,24">
    
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══════════ القسم العلوي: العنوان والمؤشرات الرئيسية ═══════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <StackPanel Grid.Column="0">
                <TextBlock Text="إدارة أجور ومستحقات العمال" FontSize="28" FontWeight="Bold" Foreground="#0b1c30"/>
                <TextBlock Text="متابعة حضور العمال، أرصدتهم المستحقة، وتسوية كشوفاتهم المالية مرناً." FontSize="15" Foreground="#64748b" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- كرت إجمالي الديون المستحقة للعمال -->
            <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="20,12" BorderBrush="#e2e8f0" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.04"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#fef3c7" CornerRadius="8" Padding="10" Margin="0,0,16,0">
                        <materialDesign:PackIcon Kind="AccountMultiple" Foreground="#d97706" Width="26" Height="26"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="إجمالي مستحقات العمال غير المدفوعة" FontSize="12" Foreground="#64748b" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding TotalOutstandingBalance, StringFormat={}{0:N2} د.ل}" FontSize="20" FontWeight="Bold" Foreground="#d97706" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══════════ محتوى الصفحة الرئيسي ═══════════ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/> <!-- العمود الأيمن: قائمة العمال والبحث -->
                <ColumnDefinition Width="24"/>  <!-- مسافة فاصلة -->
                <ColumnDefinition Width="*"/>   <!-- العمود الأيسر: النموذج وتفاصيل كشف الحساب -->
            </Grid.ColumnDefinitions>

            <!-- ═══════════ 1. قائمة العمال ═══════════ -->
            <Border Grid.Column="0" Background="White" CornerRadius="16" BorderBrush="#e2e8f0" BorderThickness="1" Padding="20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.03"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- شريط البحث -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="البحث عن عامل..."
                                 materialDesign:TextFieldAssist.HasClearButton="True"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Padding="12,10" FontSize="14"
                                 Background="#f8fafc">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding LoadDataCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        <materialDesign:PackIcon Kind="Search" Width="20" Height="20" Foreground="#94a3b8" 
                                                 HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0"/>
                    </Grid>

                    <!-- ترويسة القائمة -->
                    <Grid Grid.Row="1" Margin="4,0,4,8">
                        <TextBlock Text="اسم العامل" FontSize="13" FontWeight="SemiBold" Foreground="#64748b" HorizontalAlignment="Right"/>
                        <TextBlock Text="الرصيد المستحق" FontSize="13" FontWeight="SemiBold" Foreground="#64748b" HorizontalAlignment="Left"/>
                    </Grid>

                    <!-- قائمة العمال كروت -->
                    <ListBox Grid.Row="2" 
                             ItemsSource="{Binding WorkerSummaries}" 
                             SelectedItem="{Binding SelectedWorkerSummary}"
                             HorizontalContentAlignment="Stretch"
                             BorderThickness="0" Background="Transparent"
                             Padding="0" Margin="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,8"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="ItemBorder" Background="#f8fafc" CornerRadius="12" Padding="14,12" BorderBrush="#f1f5f9" BorderThickness="1" Cursor="Hand">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- الأيقونة التعبيرية للمستخدم -->
                                        <Border Grid.Column="0" Background="#e2e8f0" CornerRadius="8" Width="38" Height="38" Margin="0,0,12,0">
                                            <materialDesign:PackIcon Kind="Account" Foreground="#475569" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- تفاصيل الاسم والنشاط -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding WorkerName}" FontSize="14" FontWeight="Bold" Foreground="#0f172a"/>
                                            <TextBlock Text="{Binding LastActivity, StringFormat='آخر حركة: yyyy/MM/dd'}" FontSize="11" Foreground="#94a3b8" Margin="0,2,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding LastActivity}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="لا توجد حركات حضور" FontSize="11" Foreground="#94a3b8" Margin="0,2,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding LastActivity}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>

                                        <!-- الرصيد (مستحق أو مغلق) -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Balance, StringFormat={}{0:N2} د.ل}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Left">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#d97706"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Balance}" Value="0">
                                                                <Setter Property="Foreground" Value="#10b981"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            
                                            <Border CornerRadius="4" Padding="4,2" Margin="0,4,0,0" HorizontalAlignment="Left">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#fffbeb"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Balance}" Value="0">
                                                                <Setter Property="Background" Value="#ecfdf5"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock FontSize="10" FontWeight="Bold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="مستحقات معلقة"/>
                                                            <Setter Property="Foreground" Value="#b45309"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Balance}" Value="0">
                                                                    <Setter Property="Text" Value="مخلص ✓"/>
                                                                    <Setter Property="Foreground" Value="#047857"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                        <Setter TargetName="ItemBorder" Property="Background" Value="#eff6ff"/>
                                        <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#3b82f6"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- ═══════════ 2. التفاصيل وكشف الحساب والنموذج ═══════════ -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- نموذج إثبات الحضور واليوميات -->
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="*"/>    <!-- كشف حساب العامل التفصيلي -->
                </Grid.RowDefinitions>

                <!-- نموذج إثبات الحضور واليومية -->
                <Border Grid.Row="0" Background="White" CornerRadius="16" BorderBrush="#e2e8f0" BorderThickness="1" Padding="20">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.03"/>
                    </Border.Effect>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Border Background="#eff6ff" CornerRadius="6" Padding="6" Margin="0,0,10,0">
                                <materialDesign:PackIcon Kind="CalendarClock" Foreground="#2563eb" Width="20" Height="20"/>
                            </Border>
                            <TextBlock Text="تسجيل حضور ومستحقات يومية جديدة" FontSize="16" FontWeight="Bold" Foreground="#0f172a" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- اسم العامل (تنبئي) -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="اسم العامل:" FontSize="12" Foreground="#64748b" Margin="0,0,0,6" FontWeight="SemiBold"/>
                                <ComboBox ItemsSource="{Binding AvailableWorkerNames}"
                                          Text="{Binding InputWorkerName, UpdateSourceTrigger=PropertyChanged}"
                                          IsEditable="True"
                                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                          materialDesign:HintAssist.Hint="اكتب اسم العامل هنا"
                                          Padding="10,8" FontSize="13"/>
                            </StackPanel>

                            <!-- التاريخ -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="التاريخ:" FontSize="12" Foreground="#64748b" Margin="0,0,0,6" FontWeight="SemiBold"/>
                                <DatePicker SelectedDate="{Binding InputWorkDate}"
                                            Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                            Padding="10,8" FontSize="13"/>
                            </StackPanel>

                            <!-- نوع الوردية -->
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="الوردية:" FontSize="12" Foreground="#64748b" Margin="0,0,0,6" FontWeight="SemiBold"/>
                                <ComboBox ItemsSource="{Binding ShiftTypes}"
                                          SelectedItem="{Binding SelectedShiftType}"
                                          DisplayMemberPath="DisplayName"
                                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                          Padding="10,8" FontSize="13"/>
                            </StackPanel>

                            <!-- الأجر المستحق اليومي -->
                            <StackPanel Grid.Column="6">
                                <TextBlock Text="الأجر المستحق (د.ل):" FontSize="12" Foreground="#64748b" Margin="0,0,0,6" FontWeight="SemiBold"/>
                                <TextBox Text="{Binding InputAccruedWage, UpdateSourceTrigger=LostFocus, TargetNullValue=''}"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         materialDesign:HintAssist.Hint="0.00"
                                         Padding="10,8" FontSize="13" FontWeight="Bold"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- الملاحظات -->
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBox Text="{Binding InputNotes, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="ملاحظات الحضور أو العمل اليومي (مثال: أجر إضافي، عمل ساعات إضافية)"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         Padding="10,8" FontSize="13"/>
                            </StackPanel>

                            <!-- أزرار الإجراءات -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                                <Button Content="تفريغ" Command="{Binding ClearFormCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="#64748b" BorderBrush="#cbd5e1" Height="38" Padding="12,0" Margin="0,0,8,0"/>
                                <Button Content="تسجيل حضور ✓" Command="{Binding AddAttendanceCommand}" Style="{StaticResource MaterialDesignFlatButton}" Background="#2563eb" Foreground="White" Height="38" Padding="16,0"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- كشف الحساب التفصيلي -->
                <Border Grid.Row="2" Background="White" CornerRadius="16" BorderBrush="#e2e8f0" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.03"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- ترويسة كشف الحساب -->
                        <Border Grid.Row="0" BorderBrush="#e2e8f0" BorderThickness="0,0,0,1" Padding="20,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <Border Background="#f1f5f9" CornerRadius="6" Padding="6" Margin="0,0,10,0">
                                        <materialDesign:PackIcon Kind="ReceiptText" Foreground="#475569" Width="20" Height="20"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="كشف الحساب التفصيلي والمطابقات" FontSize="16" FontWeight="Bold" Foreground="#0f172a"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0" Visibility="{Binding SelectedWorkerSummary, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="الدفتر المالي للعامل: " FontSize="12" Foreground="#64748b"/>
                                            <TextBlock Text="{Binding SelectedWorkerSummary.WorkerName}" FontSize="12" FontWeight="Bold" Foreground="#2563eb"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>

                                <!-- الرصيد الحالي -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding SelectedWorkerSummary, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="الرصيد المتبقي له:" FontSize="13" Foreground="#64748b" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding SelectedWorkerSummary.Balance, StringFormat={}{0:N2} د.ل}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#d97706"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedWorkerSummary.Balance}" Value="0">
                                                        <Setter Property="Foreground" Value="#10b981"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- محتوى كشف الحساب -->
                        <Grid Grid.Row="1">
                            <!-- حالة عدم اختيار عامل -->
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding SelectedWorkerSummary, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=invert}">
                                <materialDesign:PackIcon Kind="AccountQuestion" Width="64" Height="64" Foreground="#cbd5e1" HorizontalAlignment="Center"/>
                                <TextBlock Text="يرجى اختيار عامل من القائمة الجانبية لعرض كشف حسابه التفصيلي" FontSize="14" Foreground="#94a3b8" Margin="0,16,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <!-- الجدول الرئيسي لكشف الحساب -->
                            <DataGrid ItemsSource="{Binding WorkerLedger}" 
                                      AutoGenerateColumns="False" 
                                      CanUserAddRows="False" 
                                      IsReadOnly="True" 
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal" 
                                      BorderThickness="0" 
                                      Background="Transparent"
                                      RowHeight="46" 
                                      FontSize="13"
                                      materialDesign:DataGridAssist.ColumnHeaderPadding="12,10"
                                      materialDesign:DataGridAssist.CellPadding="12,6"
                                      Visibility="{Binding SelectedWorkerSummary, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <DataGrid.Columns>
                                    <!-- عمود الحذف (متاح لحضور العمال فقط) -->
                                    <DataGridTemplateColumn Width="Auto">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <!-- يظهر فقط إذا كان المصدر هو حضور -->
                                                    <Button Command="{Binding DataContext.DeleteLedgerItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}"
                                                            Foreground="#ef4444" 
                                                            Width="26" Height="26" Padding="0">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignToolButton}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Source}" Value="حضور">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                        <materialDesign:PackIcon Kind="DeleteOutline" Width="16" Height="16"/>
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="التاريخ" Binding="{Binding Date, StringFormat=yyyy/MM/dd}" Width="100"/>
                                    
                                    <!-- المصدر بتصميم لوني مميز -->
                                    <DataGridTemplateColumn Header="النوع / المصدر" Width="110">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Right">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Source}" Value="حضور">
                                                                    <Setter Property="Background" Value="#eff6ff"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Source}" Value="مصروف عام">
                                                                    <Setter Property="Background" Value="#fef2f2"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Source}" Value="وردية">
                                                                    <Setter Property="Background" Value="#fefaf0"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Source}" FontSize="11" FontWeight="Bold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Source}" Value="حضور">
                                                                        <Setter Property="Foreground" Value="#1d4ed8"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Source}" Value="مصروف عام">
                                                                        <Setter Property="Foreground" Value="#b91c1c"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Source}" Value="وردية">
                                                                        <Setter Property="Foreground" Value="#b45309"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="البيان والتفاصيل" Binding="{Binding Description}" Width="2*"/>
                                    
                                    <DataGridTextColumn Header="مستحق له (+)" Binding="{Binding AccruedAmount, StringFormat=N2}" Width="100">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#2563eb"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="TextAlignment" Value="Right"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn Header="مدفوع عليه (-)" Binding="{Binding PaidAmount, StringFormat=N2}" Width="100">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#10b981"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="TextAlignment" Value="Right"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn Header="الرصيد التراكمي" Binding="{Binding BalanceAfter, StringFormat=N2}" Width="110">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#d97706"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="TextAlignment" Value="Right"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn Header="ملاحظات" Binding="{Binding Notes}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
