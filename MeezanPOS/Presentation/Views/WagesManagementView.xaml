<UserControl x:Class="MeezanPOS.Presentation.Views.WagesManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:MeezanPOS.Application.ViewModels"
             xmlns:enums="clr-namespace:MeezanPOS.Domain.Enums"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200"
             FlowDirection="RightToLeft"
             Background="#f8f9ff"
             Padding="32,24">
    
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        
        <ObjectDataProvider x:Key="AttendanceStatusEnum" MethodName="GetValues" ObjectType="{x:Type sys:Type}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="enums:AttendanceStatus"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══════════ القسم العلوي: العنوان والمؤشر العام ═══════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <StackPanel Grid.Column="0">
                <TextBlock Text="إدارة أجور وعمال المطعم" FontSize="26" FontWeight="Bold" Foreground="#0b1c30"/>
                <TextBlock Text="النظام المالي المتكامل لتسجيل حضور العمال، السلف، الأجور، وتدقيق كشوف الحسابات." FontSize="14" Foreground="#64748b" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- إجمالي المستحقات العامة -->
            <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="20,12" BorderBrush="#e2e8f0" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.04"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#fee2e2" CornerRadius="8" Padding="10" Margin="0,0,16,0">
                        <materialDesign:PackIcon Kind="AccountMultiple" Foreground="#ef4444" Width="26" Height="26"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="إجمالي مستحقات العمال المتأخرة (عليهم/لهم)" FontSize="12" Foreground="#64748b" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding TotalOutstandingBalance, StringFormat={}{0:N2} د.ل}" FontSize="20" FontWeight="Bold" Foreground="#ef4444" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══════════ محتوى التبويبات الرئيسي ═══════════ -->
        <TabControl Grid.Row="1" FontSize="14">
            
            <!-- ═══════════ التبويب الأول: كشف الحضور واليومية ═══════════ -->
            <TabItem Header="كشف الحضور واليومية">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- شريط إعدادات وتصفية الحضور -->
                    <Border Grid.Row="0" Background="White" CornerRadius="12" BorderBrush="#e2e8f0" BorderThickness="1" Padding="16" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="تاريخ الحضور والوردية:" FontSize="13" FontWeight="Bold" Foreground="#334155" VerticalAlignment="Center"/>

                            <!-- اختيار التاريخ -->
                            <DatePicker Grid.Column="2" SelectedDate="{Binding SelectedAttendanceDate}"
                                        Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                        Padding="10,8" FontSize="13"/>

                            <!-- اختيار الوردية -->
                            <ComboBox Grid.Column="4" ItemsSource="{Binding ShiftTypes}"
                                      SelectedItem="{Binding SelectedAttendanceShift}"
                                      DisplayMemberPath="DisplayName"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                      Padding="10,8" FontSize="13"/>

                            <!-- زر الحفظ والترحيل للأستاذ المساعد -->
                            <Button Grid.Column="6" Content="حفظ واعتماد الحضور اليومي ✓" 
                                    Command="{Binding SaveAttendanceBatchCommand}" 
                                    Style="{StaticResource MaterialDesignFlatButton}" 
                                    Background="#2563eb" Foreground="White" Height="40" Padding="20,0"/>
                        </Grid>
                    </Border>

                    <!-- جدول إدخال الحضور -->
                    <Border Grid.Row="1" Background="White" CornerRadius="12" BorderBrush="#e2e8f0" BorderThickness="1" Padding="12">
                        <DataGrid ItemsSource="{Binding AttendanceList}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  BorderThickness="0"
                                  Background="Transparent"
                                  RowHeight="48"
                                  FontSize="13"
                                  materialDesign:DataGridAssist.ColumnHeaderPadding="12,10"
                                  materialDesign:DataGridAssist.CellPadding="12,6">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="اسم العامل" Binding="{Binding WorkerName}" Width="2*" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="Foreground" Value="#1e293b"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- حالة الحضور (Present / Absent / HalfDay / Leave) -->
                                <DataGridTemplateColumn Header="حالة الحضور" Width="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding DataContext.AttendanceStatuses, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      SelectedItem="{Binding Status, UpdateSourceTrigger=PropertyChanged}"
                                                      Style="{StaticResource MaterialDesignComboBox}"
                                                      VerticalAlignment="Center">
                                                 <ComboBox.ItemTemplate>
                                                     <DataTemplate>
                                                         <TextBlock FontSize="12" FontWeight="SemiBold">
                                                             <TextBlock.Style>
                                                                 <Style TargetType="TextBlock">
                                                                     <Setter Property="Text" Value="{Binding}"/>
                                                                     <Style.Triggers>
                                                                         <DataTrigger Binding="{Binding}" Value="Present">
                                                                             <Setter Property="Text" Value="حاضر (يوم كامل)"/>
                                                                             <Setter Property="Foreground" Value="#047857"/>
                                                                         </DataTrigger>
                                                                         <DataTrigger Binding="{Binding}" Value="Absent">
                                                                             <Setter Property="Text" Value="غائب"/>
                                                                             <Setter Property="Foreground" Value="#b91c1c"/>
                                                                         </DataTrigger>
                                                                         <DataTrigger Binding="{Binding}" Value="HalfDay">
                                                                             <Setter Property="Text" Value="نصف يوم عمل"/>
                                                                             <Setter Property="Foreground" Value="#b45309"/>
                                                                         </DataTrigger>
                                                                         <DataTrigger Binding="{Binding}" Value="Leave">
                                                                             <Setter Property="Text" Value="إجازة"/>
                                                                             <Setter Property="Foreground" Value="#2563eb"/>
                                                                         </DataTrigger>
                                                                     </Style.Triggers>
                                                                 </Style>
                                                             </TextBlock.Style>
                                                         </TextBlock>
                                                     </DataTemplate>
                                                 </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- يومية اليوم (يمكن تعديلها كلقطة Snapshot لهذا اليوم) -->
                                <DataGridTextColumn Header="أجر اليومية (د.ل)" Binding="{Binding SnapshotDailyWage, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" Width="130">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextAlignment" Value="Right"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                    <DataGridTextColumn.EditingElementStyle>
                                        <Style TargetType="TextBox">
                                            <Setter Property="TextAlignment" Value="Right"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.EditingElementStyle>
                                </DataGridTextColumn>

                                <!-- خصومات اليوم -->
                                <DataGridTextColumn Header="خصومات اليوم (د.ل)" Binding="{Binding DeductionAmount, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" Width="130">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextAlignment" Value="Right"/>
                                            <Setter Property="Foreground" Value="#ef4444"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                    <DataGridTextColumn.EditingElementStyle>
                                        <Style TargetType="TextBox">
                                            <Setter Property="TextAlignment" Value="Right"/>
                                            <Setter Property="Foreground" Value="#ef4444"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.EditingElementStyle>
                                </DataGridTextColumn>

                                <!-- تسوية السلفة اليومية -->
                                <DataGridTextColumn Header="خصم سلفة (د.ل)" Binding="{Binding AdvanceDeducted, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" Width="130">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextAlignment" Value="Right"/>
                                            <Setter Property="Foreground" Value="#b45309"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                    <DataGridTextColumn.EditingElementStyle>
                                        <Style TargetType="TextBox">
                                            <Setter Property="TextAlignment" Value="Right"/>
                                            <Setter Property="Foreground" Value="#b45309"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.EditingElementStyle>
                                </DataGridTextColumn>

                                <!-- ملاحظات اليوم -->
                                <DataGridTextColumn Header="ملاحظات الحضور والغياب" Binding="{Binding Notes}" Width="3*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ═══════════ التبويب الثاني: ملفات العمال ═══════════ -->
            <TabItem Header="ملفات العمال وسجلاتهم">
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- بطاقة الإضافة والتعديل للملف -->
                    <Border Grid.Column="0" Background="White" CornerRadius="12" BorderBrush="#e2e8f0" BorderThickness="1" Padding="20" VerticalAlignment="Stretch">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <Border Background="#eff6ff" CornerRadius="6" Padding="6" Margin="0,0,10,0">
                                        <materialDesign:PackIcon Kind="AccountEdit" Foreground="#2563eb" Width="20" Height="20"/>
                                    </Border>
                                    <TextBlock Text="بطاقة بيانات الموظف" FontSize="15" FontWeight="Bold" Foreground="#0f172a" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- اسم العامل -->
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="اسم العامل بالكامل:" FontSize="12" Foreground="#64748b" Margin="0,0,0,6" FontWeight="SemiBold"/>
                                    <TextBox Text="{Binding NewWorkerName, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             materialDesign:HintAssist.Hint="مثال: أحمد علي"
                                             Padding="12,10" FontSize="13"/>
                                </StackPanel>

                                <!-- اليومية الثابتة -->
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="الأجر اليومي الثابت (د.ل):" FontSize="12" Foreground="#64748b" Margin="0,0,0,6" FontWeight="SemiBold"/>
                                    <TextBox Text="{Binding NewWorkerDailyWage, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             materialDesign:HintAssist.Hint="0.00"
                                             Padding="12,10" FontSize="13" FontWeight="Bold"/>
                                </StackPanel>

                                <!-- حالة النشاط -->
                                <StackPanel Margin="0,4,0,16" Orientation="Horizontal">
                                    <CheckBox IsChecked="{Binding IsWorkerActive}" Style="{StaticResource MaterialDesignActionCheckBox}" Margin="0,0,8,0"/>
                                    <TextBlock Text="الموظف نشط (يظهر في كشف الحضور)" FontSize="13" Foreground="#334155" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                </StackPanel>

                                <!-- ملاحظات -->
                                <StackPanel Margin="0,0,0,20">
                                    <TextBlock Text="ملاحظات عامة:" FontSize="12" Foreground="#64748b" Margin="0,0,0,6" FontWeight="SemiBold"/>
                                    <TextBox Text="{Binding NewWorkerNotes, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             materialDesign:HintAssist.Hint="ملاحظات أو المهام الموكلة للموظف..."
                                             AcceptsReturn="True" Height="70"
                                             Padding="12,10" FontSize="13"/>
                                </StackPanel>

                                <!-- أزرار الإجراءات -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0" Content="حفظ الملف المعروض" 
                                            Command="{Binding SaveWorkerProfileCommand}" 
                                            Style="{StaticResource MaterialDesignFlatButton}" 
                                            Background="#2563eb" Foreground="White" Height="38"/>
                                    
                                    <Button Grid.Column="2" Content="إلغاء التحديد" 
                                            Command="{Binding ClearWorkerFormCommand}" 
                                            Style="{StaticResource MaterialDesignOutlinedButton}" 
                                            Foreground="#64748b" BorderBrush="#cbd5e1" Height="38" Padding="12,0"/>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- جدول دليل العمال -->
                    <Border Grid.Column="2" Background="White" CornerRadius="12" BorderBrush="#e2e8f0" BorderThickness="1" Padding="12">
                        <DataGrid ItemsSource="{Binding WorkersList}"
                                  SelectedItem="{Binding SelectedWorkerProfile}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  BorderThickness="0"
                                  Background="Transparent"
                                  RowHeight="46"
                                  FontSize="13"
                                  materialDesign:DataGridAssist.ColumnHeaderPadding="12,10"
                                  materialDesign:DataGridAssist.CellPadding="12,6">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="الاسم الكامل" Binding="{Binding WorkerName}" Width="1.5*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="اليومية الثابتة" Binding="{Binding DailyWage, StringFormat=N2}" Width="120">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextAlignment" Value="Right"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- حالة العامل النشاط -->
                                <DataGridTemplateColumn Header="الحالة" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                <Setter Property="Background" Value="#ecfdf5"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                <Setter Property="Background" Value="#fef2f2"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock FontSize="11" FontWeight="Bold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                    <Setter Property="Text" Value="نشط"/>
                                                                    <Setter Property="Foreground" Value="#047857"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                    <Setter Property="Text" Value="موقوف مؤقتاً"/>
                                                                    <Setter Property="Foreground" Value="#b91c1c"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="ملاحظات عامة" Binding="{Binding Notes}" Width="2*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- إجراءات مباشرة -->
                                <DataGridTemplateColumn Header="إجراءات" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <!-- زر تعديل البيانات -->
                                                <Button Command="{Binding DataContext.SelectWorkerForEditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource MaterialDesignToolButton}"
                                                        Width="26" Height="26" Padding="0" Margin="0,0,4,0" ToolTip="تعديل">
                                                    <materialDesign:PackIcon Kind="EditOutline" Width="16" Height="16" Foreground="#3b82f6"/>
                                                </Button>

                                                <!-- زر إيقاف / تشغيل -->
                                                <Button Command="{Binding DataContext.ToggleWorkerActiveCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource MaterialDesignToolButton}"
                                                        Width="26" Height="26" Padding="0" Margin="0,0,4,0" ToolTip="تغيير حالة النشاط">
                                                    <materialDesign:PackIcon Kind="AccountSwitchOutline" Width="16" Height="16" Foreground="#f59e0b"/>
                                                </Button>

                                                <!-- زر حذف نهائي -->
                                                <Button Command="{Binding DataContext.DeleteWorkerCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource MaterialDesignToolButton}"
                                                        Width="26" Height="26" Padding="0" ToolTip="حذف نهائي">
                                                    <materialDesign:PackIcon Kind="DeleteOutline" Width="16" Height="16" Foreground="#ef4444"/>
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ═══════════ التبويب الثالث: الأستاذ المساعد وكشف الحساب ═══════════ -->
            <TabItem Header="كشف الحساب والمدفوعات">
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- قائمة اختيار العمال الجانبية -->
                    <Border Grid.Column="0" Background="White" CornerRadius="12" BorderBrush="#e2e8f0" BorderThickness="1" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- شريط البحث الجانبي -->
                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="ابحث عن عامل..."
                                         materialDesign:TextFieldAssist.HasClearButton="True"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         Padding="10,8" FontSize="13"
                                         Background="#f8fafc">
                                </TextBox>
                                <materialDesign:PackIcon Kind="Search" Width="18" Height="18" Foreground="#94a3b8" 
                                                         HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0"/>
                            </Grid>

                            <!-- قائمة أرصدة العمال الجانبية -->
                            <ListBox Grid.Row="1" 
                                     ItemsSource="{Binding WorkerSummaries}" 
                                     SelectedItem="{Binding SelectedWorkerSummary}"
                                     HorizontalContentAlignment="Stretch"
                                     BorderThickness="0" Background="Transparent"
                                     Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0,0,0,6"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <ContentPresenter/>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="ItemBorder" Background="#f8fafc" CornerRadius="10" Padding="12,10" BorderBrush="#e2e8f0" BorderThickness="1" Cursor="Hand">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Background="#e2e8f0" CornerRadius="6" Width="32" Height="32" Margin="0,0,10,0">
                                                    <materialDesign:PackIcon Kind="Account" Foreground="#475569" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding WorkerName}" FontSize="13" FontWeight="Bold" Foreground="#1e293b"/>
                                                    <TextBlock Text="{Binding LastActivity, StringFormat='آخر حركة: yyyy/MM/dd'}" FontSize="10" Foreground="#94a3b8" Margin="0,2,0,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding LastActivity}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>

                                                <!-- رصيد العامل -->
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding Balance, StringFormat={}{0:N2} د.ل}" FontSize="13" FontWeight="Bold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#ef4444"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Balance}" Value="0">
                                                                        <Setter Property="Foreground" Value="#10b981"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#eff6ff"/>
                                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#2563eb"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <!-- تفاصيل كشف الحساب والعمليات المالية -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- كروت الأرصدة -->
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="*"/>    <!-- جدول كشف الحساب -->
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/> <!-- لوحة العمليات المالية -->
                        </Grid.RowDefinitions>

                        <!-- كروت أرصدة تفصيلية للموظف المختار -->
                        <Grid Grid.Row="0" Visibility="{Binding SelectedWorkerSummary, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- كرت إجمالي المستحقات (له) -->
                            <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="14,10" BorderBrush="#e2e8f0" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="#eff6ff" CornerRadius="6" Padding="8" Margin="0,0,12,0">
                                        <materialDesign:PackIcon Kind="CashPlus" Foreground="#2563eb" Width="20" Height="20"/>
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="إجمالي أجور العمل (له)" FontSize="11" Foreground="#64748b" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding SelectedWorkerTotalAccrued, StringFormat={}{0:N2} د.ل}" FontSize="15" FontWeight="Bold" Foreground="#2563eb" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- كرت إجمالي السلف والمدفوعات (عليه) -->
                            <Border Grid.Column="2" Background="White" CornerRadius="10" Padding="14,10" BorderBrush="#e2e8f0" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="#ecfdf5" CornerRadius="6" Padding="8" Margin="0,0,12,0">
                                        <materialDesign:PackIcon Kind="CashMinus" Foreground="#10b981" Width="20" Height="20"/>
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="سحوبات ومدفوعات وسلف (عليه)" FontSize="11" Foreground="#64748b" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding SelectedWorkerTotalPaid, StringFormat={}{0:N2} د.ل}" FontSize="15" FontWeight="Bold" Foreground="#10b981" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- كرت الصافي المتبقي -->
                            <Border Grid.Column="4" Background="White" CornerRadius="10" Padding="14,10" BorderBrush="#e2e8f0" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="#fffbeb" CornerRadius="6" Padding="8" Margin="0,0,12,0">
                                        <materialDesign:PackIcon Kind="CashMultiple" Foreground="#d97706" Width="20" Height="20"/>
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="صافي المستحقات المتأخرة" FontSize="11" Foreground="#64748b" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding SelectedWorkerBalance, StringFormat={}{0:N2} د.ل}" FontSize="15" FontWeight="Bold" Foreground="#d97706" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- جدول الحساب التفصيلي المالي -->
                        <Border Grid.Row="2" Background="White" CornerRadius="12" BorderBrush="#e2e8f0" BorderThickness="1" Padding="8">
                            <Grid>
                                <!-- حالة عدم تحديد موظف -->
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding SelectedWorkerSummary, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=invert}">
                                    <materialDesign:PackIcon Kind="AccountQuestion" Width="48" Height="48" Foreground="#cbd5e1" HorizontalAlignment="Center"/>
                                    <TextBlock Text="يرجى اختيار موظف لعرض كشف حسابه وحركاته المالية هنا" FontSize="13" Foreground="#94a3b8" Margin="0,8,0,0"/>
                                </StackPanel>

                                <!-- جدول حركات الأستاذ المساعد المالي للعمال -->
                                <DataGrid ItemsSource="{Binding WorkerLedger}" 
                                          AutoGenerateColumns="False" 
                                          CanUserAddRows="False" 
                                          IsReadOnly="True" 
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal" 
                                          BorderThickness="0" 
                                          Background="Transparent"
                                          RowHeight="42" 
                                          FontSize="12.5"
                                          materialDesign:DataGridAssist.ColumnHeaderPadding="10,8"
                                          materialDesign:DataGridAssist.CellPadding="10,5"
                                          Visibility="{Binding SelectedWorkerSummary, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <DataGrid.Columns>
                                        <!-- خيار الحذف للحركات غير المرحّلة يدوياً -->
                                        <DataGridTemplateColumn Width="Auto">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding DataContext.DeleteLedgerItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}"
                                                            Foreground="#ef4444" 
                                                            Width="24" Height="24" Padding="0"
                                                            Style="{StaticResource MaterialDesignToolButton}">
                                                        <materialDesign:PackIcon Kind="DeleteOutline" Width="14" Height="14"/>
                                                    </Button>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTextColumn Header="التاريخ" Binding="{Binding Date, StringFormat=yyyy/MM/dd}" Width="95"/>
                                        
                                        <DataGridTemplateColumn Header="الحركة" Width="110">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border CornerRadius="4" Padding="6,1.5" HorizontalAlignment="Right">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Source}" Value="استحقاق حضور">
                                                                        <Setter Property="Background" Value="#eff6ff"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Source}" Value="سداد نقدي">
                                                                        <Setter Property="Background" Value="#ecfdf5"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Source}" Value="سلفة عمال">
                                                                        <Setter Property="Background" Value="#fffbeb"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Source}" Value="خصم وغرامة">
                                                                        <Setter Property="Background" Value="#fef2f2"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Source}" Value="تسوية يدوية">
                                                                        <Setter Property="Background" Value="#f1f5f9"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding Source}" FontSize="10.5" FontWeight="Bold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Source}" Value="استحقاق حضور">
                                                                            <Setter Property="Foreground" Value="#1d4ed8"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Source}" Value="سداد نقدي">
                                                                            <Setter Property="Foreground" Value="#047857"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Source}" Value="سلفة عمال">
                                                                            <Setter Property="Foreground" Value="#b45309"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Source}" Value="خصم وغرامة">
                                                                            <Setter Property="Foreground" Value="#b91c1c"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Source}" Value="تسوية يدوية">
                                                                            <Setter Property="Foreground" Value="#475569"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTextColumn Header="البيان" Binding="{Binding Description}" Width="2*"/>
                                        
                                        <DataGridTextColumn Header="مستحق (له +)" Binding="{Binding AccruedAmount, StringFormat=N2}" Width="95">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#2563eb"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                    <Setter Property="TextAlignment" Value="Right"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <DataGridTextColumn Header="مدفوع (عليه -)" Binding="{Binding PaidAmount, StringFormat=N2}" Width="95">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#10b981"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                    <Setter Property="TextAlignment" Value="Right"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <DataGridTextColumn Header="الرصيد" Binding="{Binding BalanceAfter, StringFormat=N2}" Width="105">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#d97706"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                    <Setter Property="TextAlignment" Value="Right"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <DataGridTextColumn Header="ملاحظات" Binding="{Binding Notes}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <!-- لوحة العمليات المالية والصرف المباشر للعمال -->
                        <Border Grid.Row="4" Background="White" CornerRadius="12" BorderBrush="#e2e8f0" BorderThickness="1" Padding="16" Visibility="{Binding SelectedWorkerSummary, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="إجراء عملية مالية مباشرة للحساب" FontSize="14" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,12"/>
                                
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/> <!-- قيمة المبلغ -->
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="150"/> <!-- التاريخ المالي -->
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="200"/> <!-- صندوق الصرف -->
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>   <!-- ملاحظات -->
                                    </Grid.ColumnDefinitions>

                                    <!-- قيمة المعاملة -->
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="القيمة (د.ل):" FontSize="11" Foreground="#64748b" Margin="0,0,0,4" FontWeight="SemiBold"/>
                                        <TextBox Text="{Binding InputPaymentAmount, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                 materialDesign:HintAssist.Hint="0.00"
                                                 Padding="10,8" FontSize="12.5" FontWeight="Bold"/>
                                    </StackPanel>

                                    <!-- التاريخ المالي -->
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="التاريخ المالي:" FontSize="11" Foreground="#64748b" Margin="0,0,0,4" FontWeight="SemiBold"/>
                                        <DatePicker SelectedDate="{Binding InputPaymentDate}"
                                                    Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                                    Padding="10,8" FontSize="12.5"/>
                                    </StackPanel>

                                    <!-- صندوق الدفع (سداد مستحقات فقط) -->
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="مصدر الصرف (للصندوق):" FontSize="11" Foreground="#64748b" Margin="0,0,0,4" FontWeight="SemiBold"/>
                                        <ComboBox SelectedValue="{Binding SelectedPaymentSource, UpdateSourceTrigger=PropertyChanged}"
                                                  SelectedValuePath="Tag"
                                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                                  Padding="10,8" FontSize="12.5">
                                            <ComboBoxItem Content="كاشير (الوردية الجارية)" Tag="Cashier"/>
                                            <ComboBoxItem Content="نقدية المطعم العامة" Tag="GeneralCash"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <!-- البيان والملاحظات للعملية -->
                                    <StackPanel Grid.Column="6">
                                        <TextBlock Text="ملاحظات المعاملة:" FontSize="11" Foreground="#64748b" Margin="0,0,0,4" FontWeight="SemiBold"/>
                                        <TextBox Text="{Binding InputPaymentNotes, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                 materialDesign:HintAssist.Hint="مثال: سداد ذمة يوميات سابقة"
                                                 Padding="10,8" FontSize="12.5"/>
                                    </StackPanel>
                                </Grid>

                                <!-- أزرار الصرف المالي -->
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0" HorizontalAlignment="Left">
                                    <!-- زر دفع المستحقات وصرف الكاش -->
                                    <Button Content="صرف سداد مستحقات (Cash Out) 💸" 
                                            Command="{Binding ProcessWorkerPaymentCommand}" 
                                            Style="{StaticResource MaterialDesignFlatButton}" 
                                            Background="#10b981" Foreground="White" Height="36" Padding="14,0" Margin="0,0,8,0"/>

                                    <!-- زر تسجيل سلفة ذمة -->
                                    <Button Content="تسجيل سلفة ذمة ✍" 
                                            Command="{Binding ProcessWorkerAdvanceCommand}" 
                                            Style="{StaticResource MaterialDesignFlatButton}" 
                                            Background="#f59e0b" Foreground="White" Height="36" Padding="14,0" Margin="0,0,8,0"/>

                                    <!-- زر تسوية يدوية للرصيد -->
                                    <Button Content="تسوية رصيد يدوية ⚙" 
                                            Command="{Binding ProcessWorkerAdjustmentCommand}" 
                                            Style="{StaticResource MaterialDesignFlatButton}" 
                                            Background="#6b7280" Foreground="White" Height="36" Padding="14,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
