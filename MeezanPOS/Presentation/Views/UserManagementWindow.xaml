<Window x:Class="MeezanPOS.Presentation.Views.UserManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="إدارة المستخدمين"
        FontFamily="{StaticResource Font.Body}"
        Width="900" Height="620" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Canvas}"
        FlowDirection="RightToLeft">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- العنوان -->
        <Border Style="{StaticResource PageHeader}" Margin="0,0,0,16">
            <DockPanel>
                <Border Width="44" Height="44" CornerRadius="12" Background="{StaticResource Brush.PrimarySoft}" Margin="0,0,14,0">
                    <materialDesign:PackIcon Kind="AccountGroup" Width="24" Height="24" Foreground="{StaticResource Brush.Primary}"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="إدارة المستخدمين والصلاحيات" Style="{StaticResource Text.PageTitle}"/>
                    <TextBlock Text="كل موظف بحسابه الخاص حتى تُنسب كل عملية لصاحبها في سجل التدقيق" Style="{StaticResource Text.Caption}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- قائمة المستخدمين -->
            <Border Style="{StaticResource Card}" Padding="0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="12">
                        <Button x:Name="BtnToggleActive" Content="إيقاف / تفعيل الحساب" Style="{StaticResource Button.Secondary}" Click="ToggleActive_Click" Margin="0,0,8,0"/>
                        <Button x:Name="BtnResetPassword" Content="إعادة تعيين كلمة المرور" Style="{StaticResource Button.Secondary}" Click="ResetPassword_Click" Margin="0,0,8,0"/>
                        <ComboBox x:Name="CbChangeRole" Width="120" Margin="0,0,8,0" Style="{StaticResource MaterialDesignOutlinedComboBox}" Padding="10,4"/>
                        <Button Content="تغيير الدور" Style="{StaticResource Button.Secondary}" Click="ChangeRole_Click"/>
                    </StackPanel>
                    <DataGrid x:Name="UsersGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" Margin="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="اسم الدخول" Binding="{Binding Username}" Width="Auto" MinWidth="110"/>
                            <DataGridTextColumn Header="الاسم الكامل" Binding="{Binding FullName}" Width="*" MinWidth="140"/>
                            <DataGridTextColumn Header="الدور" Binding="{Binding RoleName}" Width="Auto" MinWidth="90"/>
                            <DataGridTextColumn Header="الحالة" Binding="{Binding StatusText}" Width="Auto" MinWidth="80"/>
                            <DataGridTextColumn Header="آخر دخول" Binding="{Binding LastLoginText}" Width="Auto" MinWidth="130"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- إضافة مستخدم / كلمة مؤقتة -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="إضافة مستخدم جديد" Style="{StaticResource Text.SectionTitle}" Margin="0,0,0,12"/>

                    <TextBlock Text="اسم الدخول" Style="{StaticResource Text.Label}" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtUsername" Style="{StaticResource MaterialDesignOutlinedTextBox}" Padding="10,6" FlowDirection="LeftToRight" Margin="0,0,0,10"/>

                    <TextBlock Text="الاسم الكامل" Style="{StaticResource Text.Label}" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtFullName" Style="{StaticResource MaterialDesignOutlinedTextBox}" Padding="10,6" Margin="0,0,0,10"/>

                    <TextBlock Text="الدور" Style="{StaticResource Text.Label}" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CbRole" Style="{StaticResource MaterialDesignOutlinedComboBox}" Padding="10,6" Margin="0,0,0,10"/>

                    <TextBlock Text="كلمة مرور مؤقتة" Style="{StaticResource Text.Label}" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtTempPassword" Style="{StaticResource MaterialDesignOutlinedTextBox}" Padding="10,6" FlowDirection="LeftToRight" Margin="0,0,0,4"/>
                    <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,0,0,14"
                               Text="تُستخدم للحساب الجديد ولإعادة تعيين كلمة مرور المستخدم المحدد. سيُطلب من المستخدم تغييرها عند أول دخول."/>

                    <Button Content="إضافة المستخدم" Style="{StaticResource Button.Primary}" Click="AddUser_Click" HorizontalAlignment="Stretch"/>

                    <Border x:Name="MessageBorder" Visibility="Collapsed" CornerRadius="8" Padding="10,8" Margin="0,14,0,0">
                        <TextBlock x:Name="TxtMessage" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
