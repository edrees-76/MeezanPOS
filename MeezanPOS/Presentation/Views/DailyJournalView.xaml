<UserControl x:Class="MeezanPOS.Presentation.Views.DailyJournalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:MeezanPOS.Application.ViewModels"
             FlowDirection="RightToLeft">
    
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        
        <Style x:Key="HideInViewMode" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsViewingMode}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HideButtonInViewMode" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsViewingMode}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ShowInViewMode" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsViewingMode}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ═══════════ القسم 1: معلومات الوردية ═══════════ -->
            <Border Grid.Row="0" Background="White" CornerRadius="16" Padding="28,24" Margin="0,0,0,16"
                    BorderBrush="#e5eeff" BorderThickness="1" IsEnabled="{Binding IsNotViewingMode}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.06"/>
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <materialDesign:PackIcon Kind="CalendarClock" Width="28" Height="28" Foreground="#0b1c30" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <TextBlock Text="معلومات الوردية" FontSize="20" FontWeight="Bold" Foreground="#0b1c30" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- التاريخ -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="التاريخ" FontWeight="SemiBold" FontSize="13" Foreground="#0b1c30" Margin="0,0,0,8"/>
                            <DatePicker SelectedDate="{Binding JournalDate}"
                                        Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                        FontSize="15" Padding="8"/>
                        </StackPanel>

                        <!-- نوع الوردية -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="نوع الوردية" FontWeight="SemiBold" FontSize="13" Foreground="#0b1c30" Margin="0,0,0,8"/>
                            <ComboBox ItemsSource="{Binding ShiftTypes}" 
                                      SelectedIndex="{Binding SelectedShiftIndex}"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                      FontSize="15" Padding="8"/>
                        </StackPanel>

                        <!-- اسم الموظف -->
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="اسم الموظف" FontWeight="SemiBold" FontSize="13" Foreground="#0b1c30" Margin="0,0,0,8"/>
                            <TextBox Text="{Binding EmployeeName, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="اسم الكاشير / الموظف"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     FontSize="15" Padding="8"/>
                        </StackPanel>

                        <!-- مبلغ الصرف -->
                        <StackPanel Grid.Column="6">
                            <TextBlock Text="مبلغ الصرف (الفكة)" FontWeight="SemiBold" FontSize="13" Foreground="#0b1c30" Margin="0,0,0,8"/>
                            <TextBox Text="{Binding CashFloat, UpdateSourceTrigger=LostFocus, TargetNullValue=''}"
                                     materialDesign:HintAssist.Hint="0.00"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     FontSize="15" Padding="8"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ═══════════ القسم 2: المبيعات ═══════════ -->
            <Border Grid.Row="1" Background="White" CornerRadius="16" Padding="28,24" Margin="0,0,0,16"
                    BorderBrush="#e5eeff" BorderThickness="1" IsEnabled="{Binding IsNotViewingMode}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.06"/>
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <materialDesign:PackIcon Kind="CashRegister" Width="28" Height="28" Foreground="#10b981" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <TextBlock Text="المبيعات" FontSize="20" FontWeight="Bold" Foreground="#0b1c30" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- مبيعات نقدية -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="مبيعات نقدية (كاش)" FontWeight="SemiBold" FontSize="14" Foreground="#0b1c30" Margin="0,0,0,8"/>
                            <TextBox Text="{Binding CashSalesInput, UpdateSourceTrigger=LostFocus, TargetNullValue=''}"
                                     materialDesign:HintAssist.Hint="0.00"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     FontSize="20" FontWeight="Bold" Padding="12"/>
                        </StackPanel>

                        <!-- خدمات مصرفية -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="خدمات مصرفية (شبكة / بطاقات)" FontWeight="SemiBold" FontSize="14" Foreground="#0b1c30" Margin="0,0,0,8"/>
                            <TextBox Text="{Binding BankingSalesInput, UpdateSourceTrigger=LostFocus, TargetNullValue=''}"
                                     materialDesign:HintAssist.Hint="0.00"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     FontSize="20" FontWeight="Bold" Padding="12"/>
                        </StackPanel>
                    </Grid>

                    <!-- إجمالي المبيعات (محسوب تلقائياً) -->
                    <Border Background="#f0fdf4" CornerRadius="8" Padding="16,12" Margin="0,16,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="إجمالي المبيعات:" FontWeight="Bold" FontSize="16" Foreground="#10b981" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding TotalSales, StringFormat=N2}" FontWeight="Bold" FontSize="20" Foreground="#10b981" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ═══════════ القسم 3: الخدمات المصرفية (مطابقة الدفتر) ═══════════ -->
            <Border Grid.Row="2" Background="White" CornerRadius="16" Padding="28,24" Margin="0,0,0,16"
                    BorderBrush="#e5eeff" BorderThickness="1" IsEnabled="{Binding IsNotViewingMode}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.06"/>
                </Border.Effect>
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CreditCard" Width="28" Height="28" Foreground="#6366f1" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding BankingSectionTitle}" FontSize="20" FontWeight="Bold" Foreground="#0b1c30" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="+ إضافة عملية" Command="{Binding AddBankingItemCommand}"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Visibility="{Binding IsNotViewingMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Foreground="#6366f1" FontSize="13"/>
                    </Grid>

                    <!-- جدول العمليات المصرفية -->
                    <ItemsControl ItemsSource="{Binding BankingItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- حذف -->
                                    <Button Grid.Column="0" Command="{Binding DataContext.RemoveBankingItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" Style="{StaticResource MaterialDesignToolButton}" Foreground="#ef4444" Width="32" Height="32"
                                            Visibility="{Binding DataContext.IsNotViewingMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <materialDesign:PackIcon Kind="DeleteOutline"/>
                                    </Button>
                                    <!-- تسلسل -->
                                    <Border Grid.Column="2" Background="#eef2ff" CornerRadius="6" Padding="4" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding SequenceNumber}" FontWeight="Bold" FontSize="14" Foreground="#6366f1"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="20" TextAlignment="Center"/>
                                    </Border>
                                    <!-- المبلغ -->
                                    <TextBox Grid.Column="4" Text="{Binding Amount, UpdateSourceTrigger=LostFocus, TargetNullValue=''}"
                                             materialDesign:HintAssist.Hint="المبلغ"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}" Padding="8" FontSize="14"/>
                                    <!-- رقم الفاتورة -->
                                    <TextBox Grid.Column="6" Text="{Binding InvoiceNumber, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="رقم الفاتورة"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}" Padding="8" FontSize="14"/>
                                    <!-- المصرف (قائمة منسدلة) -->
                                    <ComboBox Grid.Column="8" 
                                              ItemsSource="{Binding DataContext.BankNames, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                              SelectedItem="{Binding BankName, UpdateSourceTrigger=PropertyChanged}"
                                              materialDesign:HintAssist.Hint="المصرف"
                                              IsEditable="True"
                                              Style="{StaticResource MaterialDesignOutlinedComboBox}" Padding="8" FontSize="14"/>
                                    <!-- آخر 4 أرقام -->
                                    <TextBox Grid.Column="10" Text="{Binding Last4Digits, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="آخر 4 أرقام"
                                             MaxLength="4"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}" Padding="8" FontSize="14"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- وضع المطابقة: يظهر فقط عند إدخال قيمة مصرفية من الكاشير -->
                    <Border CornerRadius="8" Padding="16,12" Margin="0,8,0,0" Background="#f0f0ff"
                            Visibility="{Binding HasBankingSalesInput, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="المصرفية من الكاشير:" FontSize="14" Foreground="#606060" Margin="0,2"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding BankingSalesInput, StringFormat=N2}" FontSize="14" FontWeight="SemiBold" Foreground="#0b1c30" Margin="0,2"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="المصرفية من الدفتر:" FontSize="14" Foreground="#606060" Margin="0,2"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding BankingItemsTotal, StringFormat=N2}" FontSize="14" FontWeight="SemiBold" Foreground="#0b1c30" Margin="0,2"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="نتيجة المطابقة:" FontSize="14" FontWeight="Bold" Foreground="#6366f1" Margin="0,6,0,0"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding BankingDifferenceStatus}" FontSize="14" FontWeight="Bold" Foreground="#6366f1" Margin="0,6,0,0"/>
                        </Grid>
                    </Border>

                    <!-- وضع الإدخال العادي: يظهر فقط عندما لا يوجد قيمة مصرفية من الكاشير -->
                    <Border CornerRadius="8" Padding="16,10" Margin="0,8,0,0" Background="#f0f0ff"
                            Visibility="{Binding HasBankingSalesInput, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="إجمالي المصرفية:" FontWeight="SemiBold" FontSize="15" Foreground="#6366f1" Margin="0,0,12,0"/>
                            <TextBlock Text="{Binding BankingItemsTotal, StringFormat=N2}" FontWeight="Bold" FontSize="15" Foreground="#6366f1"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ═══════ قسم المرتجعات والطلبات المجانية ═══════ -->
            <Border Grid.Row="3" Background="White" CornerRadius="16" Padding="28,24" Margin="0,0,0,16"
                    BorderBrush="#e5eeff" BorderThickness="1" IsEnabled="{Binding IsNotViewingMode}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.06"/>
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <materialDesign:PackIcon Kind="SwapHorizontal" Width="28" Height="28" Foreground="#ef4444" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <TextBlock Text="المرتجعات والطلبات المجانية" FontSize="20" FontWeight="Bold" Foreground="#0b1c30" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- المرتجعات -->
                        <Border Grid.Column="0" Background="#fff5f5" CornerRadius="10" Padding="16,12" BorderBrush="#fecaca" BorderThickness="1">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <TextBlock Text="🔄 المرتجعات" FontWeight="Bold" FontSize="14" Foreground="#dc2626" VerticalAlignment="Center"/>
                                    <Button Content="+ إضافة مرتجع" Command="{Binding AddReturnItemCommand}" Style="{StaticResource MaterialDesignFlatButton}" 
                                            Visibility="{Binding IsNotViewingMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            Foreground="#dc2626" FontSize="12" HorizontalAlignment="Right" Padding="4,0" Height="24"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Returns}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="4"/>
                                                    <ColumnDefinition Width="24"/>
                                                    <ColumnDefinition Width="4"/>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="4"/>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="4"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" Command="{Binding DataContext.RemoveReturnItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Style="{StaticResource MaterialDesignToolButton}" Foreground="#ef4444" Width="24" Height="24" Padding="0"
                                                        Visibility="{Binding DataContext.IsNotViewingMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <materialDesign:PackIcon Kind="Close" Width="16" Height="16"/>
                                                </Button>
                                                <Border Grid.Column="2" Background="#fecaca" CornerRadius="4" Padding="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <TextBlock Text="{Binding SequenceNumber}" FontWeight="Bold" FontSize="11" Foreground="#991b1b" HorizontalAlignment="Center" MinWidth="14" TextAlignment="Center"/>
                                                </Border>
                                                <TextBox Grid.Column="4" Text="{Binding Amount, UpdateSourceTrigger=LostFocus, TargetNullValue=''}" materialDesign:HintAssist.Hint="المبلغ" Style="{StaticResource MaterialDesignOutlinedTextBox}" Padding="4" FontSize="12"/>
                                                <TextBox Grid.Column="6" Text="{Binding InvoiceNumber, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="ر.فاتورة" Style="{StaticResource MaterialDesignOutlinedTextBox}" Padding="4" FontSize="12"/>
                                                <TextBox Grid.Column="8" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="ملاحظات" Style="{StaticResource MaterialDesignOutlinedTextBox}" Padding="4" FontSize="12"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- الطلبات المجانية -->
                        <Border Grid.Column="2" Background="#fefff5" CornerRadius="10" Padding="16,12" BorderBrush="#fef9c3" BorderThickness="1">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <TextBlock Text="🎁 الطلبات المجانية" FontWeight="Bold" FontSize="14" Foreground="#ca8a04" VerticalAlignment="Center"/>
                                    <Button Content="+ إضافة طلب مجاني" Command="{Binding AddFreeOrderItemCommand}" Style="{StaticResource MaterialDesignFlatButton}" 
                                            Visibility="{Binding IsNotViewingMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            Foreground="#ca8a04" FontSize="12" HorizontalAlignment="Right" Padding="4,0" Height="24"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding FreeOrders}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="4"/>
                                                    <ColumnDefinition Width="24"/>
                                                    <ColumnDefinition Width="4"/>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="4"/>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="4"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" Command="{Binding DataContext.RemoveFreeOrderItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Style="{StaticResource MaterialDesignToolButton}" Foreground="#ef4444" Width="24" Height="24" Padding="0"
                                                        Visibility="{Binding DataContext.IsNotViewingMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <materialDesign:PackIcon Kind="Close" Width="16" Height="16"/>
                                                </Button>
                                                <Border Grid.Column="2" Background="#fef08a" CornerRadius="4" Padding="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <TextBlock Text="{Binding SequenceNumber}" FontWeight="Bold" FontSize="11" Foreground="#a16207" HorizontalAlignment="Center" MinWidth="14" TextAlignment="Center"/>
                                                </Border>
                                                <TextBox Grid.Column="4" Text="{Binding Amount, UpdateSourceTrigger=LostFocus, TargetNullValue=''}" materialDesign:HintAssist.Hint="المبلغ" Style="{StaticResource MaterialDesignOutlinedTextBox}" Padding="4" FontSize="12"/>
                                                <TextBox Grid.Column="6" Text="{Binding InvoiceNumber, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="ر.فاتورة" Style="{StaticResource MaterialDesignOutlinedTextBox}" Padding="4" FontSize="12"/>
                                                <TextBox Grid.Column="8" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="ملاحظات" Style="{StaticResource MaterialDesignOutlinedTextBox}" Padding="4" FontSize="12"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ═══════ قسم المصروفات النثرية ═══════ -->
            <Border Grid.Row="4" Background="White" CornerRadius="16" Padding="28,24" Margin="0,0,0,16"
                    BorderBrush="#e5eeff" BorderThickness="1" IsEnabled="{Binding IsNotViewingMode}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.06"/>
                </Border.Effect>
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CartArrowDown" Width="28" Height="28" Foreground="#f59e0b" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="المصروفات النثرية" FontSize="20" FontWeight="Bold" Foreground="#0b1c30" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="+ إضافة مصروف" Command="{Binding AddExpenseItemCommand}"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Visibility="{Binding IsNotViewingMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Foreground="#f59e0b" FontSize="13"/>
                    </Grid>

                    <!-- جدول المصروفات -->
                    <ItemsControl ItemsSource="{Binding ExpenseItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- حذف -->
                                    <Button Grid.Column="0" Command="{Binding DataContext.RemoveExpenseItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" Style="{StaticResource MaterialDesignToolButton}" Foreground="#ef4444" Width="30" Height="30"
                                            Visibility="{Binding DataContext.IsNotViewingMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <materialDesign:PackIcon Kind="DeleteOutline"/>
                                    </Button>
                                    <!-- تسلسل -->
                                    <Border Grid.Column="2" Background="#fff8f0" CornerRadius="6" Padding="4" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding SequenceNumber}" FontWeight="Bold" FontSize="13" Foreground="#f59e0b"
                                                   HorizontalAlignment="Center" MinWidth="18" TextAlignment="Center"/>
                                    </Border>
                                    <!-- نوع المصروف (قابل للكتابة - يمكن اختيار أو كتابة بيان جديد) -->
                                    <ComboBox Grid.Column="4"
                                              ItemsSource="{Binding DataContext.ExpenseTypes, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                              Text="{Binding ExpenseType, UpdateSourceTrigger=PropertyChanged}"
                                              IsEditable="True"
                                              materialDesign:HintAssist.Hint="النوع"
                                              Style="{StaticResource MaterialDesignOutlinedComboBox}" Padding="6" FontSize="13"/>
                                    <!-- المبلغ -->
                                    <TextBox Grid.Column="6" Text="{Binding Amount, UpdateSourceTrigger=LostFocus, TargetNullValue=''}"
                                             materialDesign:HintAssist.Hint="المبلغ"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}" Padding="6" FontSize="13"/>

                                    <!-- ===== مصروف عادي / إيجار / سحب مالك: الوصف فقط ===== -->
                                    <TextBox Grid.Column="8" Grid.ColumnSpan="5"
                                             Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="الوصف"
                                             Visibility="{Binding IsSimpleExpense, Converter={StaticResource BooleanToVisibilityConverter}}"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}" Padding="6" FontSize="13"/>

                                    <!-- ===== مشتريات: مورد + وصف + ملاحظات ===== -->
                                    <TextBox Grid.Column="8"
                                             Text="{Binding SupplierName, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="اسم المورد"
                                             Visibility="{Binding IsPurchase, Converter={StaticResource BooleanToVisibilityConverter}}"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}" Padding="6" FontSize="13"/>
                                    <TextBox Grid.Column="10"
                                             Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="الوصف"
                                             Visibility="{Binding IsPurchase, Converter={StaticResource BooleanToVisibilityConverter}}"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}" Padding="6" FontSize="13"/>
                                    <TextBox Grid.Column="12"
                                             Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="ملاحظات"
                                             Visibility="{Binding IsPurchase, Converter={StaticResource BooleanToVisibilityConverter}}"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}" Padding="6" FontSize="13"/>

                                    <!-- ===== دفعة فاتورة: مورد + رقم فاتورة + ملاحظات ===== -->
                                    <TextBox Grid.Column="8"
                                             Text="{Binding SupplierName, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="اسم المورد"
                                             Visibility="{Binding IsInvoicePayment, Converter={StaticResource BooleanToVisibilityConverter}}"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}" Padding="6" FontSize="13"/>
                                    <TextBox Grid.Column="10"
                                             Text="{Binding InvoiceNumber, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="رقم الفاتورة"
                                             Visibility="{Binding IsInvoicePayment, Converter={StaticResource BooleanToVisibilityConverter}}"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}" Padding="6" FontSize="13"/>
                                    <TextBox Grid.Column="12"
                                             Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="ملاحظات"
                                             Visibility="{Binding IsInvoicePayment, Converter={StaticResource BooleanToVisibilityConverter}}"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}" Padding="6" FontSize="13"/>

                                    <!-- ===== أجرة عامل: وضع بسيط (إجمالي فقط) ===== -->
                                    <StackPanel Grid.Column="8" Grid.ColumnSpan="5" Orientation="Horizontal"
                                                Visibility="{Binding IsWorkerWage, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <CheckBox Content="تفصيل العمال" IsChecked="{Binding IsDetailedWage}"
                                                  VerticalAlignment="Center" Margin="0,0,12,0" FontSize="13"/>
                                        <!-- المبلغ اليدوي عندما لا يكون تفصيل -->
                                        <TextBlock Text="(الإجمالي يُحسب تلقائياً)" VerticalAlignment="Center" FontSize="12" Foreground="#999"
                                                   Visibility="{Binding IsDetailedWage, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- جدول تفصيل العمال (يظهر فقط عند تفعيل التفصيل في بند أجرة عامل) -->
                                <StackPanel Margin="88,4,0,0"
                                            Visibility="{Binding IsDetailedWage, Converter={StaticResource BooleanToVisibilityConverter}}">

                                    <ItemsControl ItemsSource="{Binding Workers}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="6"/>
                                                        <ColumnDefinition Width="36"/>
                                                        <ColumnDefinition Width="6"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="6"/>
                                                        <ColumnDefinition Width="130"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Button Grid.Column="0" Command="{Binding DataContext.RemoveWorkerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}" Style="{StaticResource MaterialDesignToolButton}"
                                                            Foreground="#ef4444" Width="28" Height="28">
                                                        <materialDesign:PackIcon Kind="Close" Width="16" Height="16"/>
                                                    </Button>
                                                    <!-- تسلسل -->
                                                    <Border Grid.Column="2" Background="#fef3c7" CornerRadius="6" Padding="4" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                        <TextBlock Text="{Binding SequenceNumber}" FontWeight="Bold" FontSize="13" Foreground="#d97706"
                                                                   HorizontalAlignment="Center" MinWidth="18" TextAlignment="Center"/>
                                                    </Border>
                                                    <TextBox Grid.Column="4" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                             materialDesign:HintAssist.Hint="اسم العامل"
                                                             Style="{StaticResource MaterialDesignOutlinedTextBox}" Padding="8" FontSize="14"/>
                                                    <TextBox Grid.Column="6" Text="{Binding Wage, UpdateSourceTrigger=LostFocus, TargetNullValue=''}"
                                                             materialDesign:HintAssist.Hint="الأجر"
                                                             Style="{StaticResource MaterialDesignOutlinedTextBox}" Padding="8" FontSize="14"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Content="+ إضافة عامل" Command="{Binding AddWorkerCommand}"
                                            Style="{StaticResource MaterialDesignFlatButton}"
                                            Foreground="#f59e0b" FontSize="12" HorizontalAlignment="Right" Padding="8,2"/>
                                </StackPanel>
                            </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- ملخص المصروفات حسب النوع -->
                    <Border Background="#fff8f0" CornerRadius="8" Padding="16,12" Margin="0,8,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="مصاريف عادية:" FontSize="13" Foreground="#606060" Margin="0,2" Visibility="{Binding HasRegularExpenses, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding RegularExpensesTotal, StringFormat=N2}" FontSize="13" Foreground="#606060" Margin="0,2" Visibility="{Binding HasRegularExpenses, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="مشتريات:" FontSize="13" Foreground="#606060" Margin="0,2" Visibility="{Binding HasPurchases, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PurchasesTotal, StringFormat=N2}" FontSize="13" Foreground="#606060" Margin="0,2" Visibility="{Binding HasPurchases, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="دفعات فواتير:" FontSize="13" Foreground="#606060" Margin="0,2" Visibility="{Binding HasInvoicePayments, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding InvoicePaymentsTotal, StringFormat=N2}" FontSize="13" Foreground="#606060" Margin="0,2" Visibility="{Binding HasInvoicePayments, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="أجور عمال:" FontSize="13" Foreground="#606060" Margin="0,2" Visibility="{Binding HasWorkerWages, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding WorkerWagesTotal, StringFormat=N2}" FontSize="13" Foreground="#606060" Margin="0,2" Visibility="{Binding HasWorkerWages, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="أخرى:" FontSize="13" Foreground="#606060" Margin="0,2" Visibility="{Binding HasOtherExpenses, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding OtherExpensesTotal, StringFormat=N2}" FontSize="13" Foreground="#606060" Margin="0,2" Visibility="{Binding HasOtherExpenses, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                            <Separator Grid.Row="5" Grid.ColumnSpan="2" Margin="0,4" Background="#f59e0b" Opacity="0.3"/>

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="إجمالي المصروفات:" FontWeight="Bold" FontSize="15" Foreground="#f59e0b" Margin="0,2"/>
                            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding TotalExpenses, StringFormat=N2}" FontWeight="Bold" FontSize="15" Foreground="#f59e0b" Margin="0,2"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ═══════════ القسم 5: المطابقة والتسليم ═══════════ -->
            <Border Grid.Row="5" CornerRadius="16" Padding="28,24" Margin="0,0,0,16"
                    BorderBrush="#10b981" BorderThickness="2" IsEnabled="{Binding IsNotViewingMode}">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#f0fdf4" Offset="0"/>
                        <GradientStop Color="#ffffff" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.08"/>
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <materialDesign:PackIcon Kind="Calculator" Width="28" Height="28" Foreground="#10b981" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <TextBlock Text="المطابقة والتسليم" FontSize="20" FontWeight="Bold" Foreground="#0b1c30" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- الجانب الأيسر: الملخص الحسابي -->
                        <StackPanel Grid.Column="0">
                            <Border Background="#f8f9ff" CornerRadius="12" Padding="20,16" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- إجمالي دخل المطعم -->
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="إجمالي المبيعات (دخل الوردية)" FontSize="15" FontWeight="Bold" Foreground="#0b1c30" Margin="0,4"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding TotalSales, StringFormat=N2}" FontSize="15" FontWeight="Bold" Foreground="#0b1c30" Margin="0,4"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="(-) المرتجعات" FontSize="14" Foreground="#dc2626" Margin="0,4"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ReturnsAmount, StringFormat=N2}" FontSize="14" FontWeight="SemiBold" Foreground="#dc2626" Margin="0,4"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="(-) الطلبات المجانية" FontSize="14" Foreground="#ca8a04" Margin="0,4"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding FreeOrdersAmount, StringFormat=N2}" FontSize="14" FontWeight="SemiBold" Foreground="#ca8a04" Margin="0,4"/>

                                    <Separator Grid.Row="3" Grid.ColumnSpan="2" Margin="0,6" Background="#e0e0e0"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="صافي المبيعات" FontSize="14" FontWeight="Bold" Foreground="#10b981" Margin="0,4"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding NetSales, StringFormat=N2}" FontSize="14" FontWeight="Bold" Foreground="#10b981" Margin="0,4"/>

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="منها مبيعات نقدية" FontSize="14" Foreground="#10b981" Margin="0,4"/>
                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding CashSalesInput, StringFormat=N2}" FontSize="14" FontWeight="SemiBold" Foreground="#10b981" Margin="0,4"/>

                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="منها خدمات مصرفية" FontSize="14" Foreground="#6366f1" Margin="0,4"/>
                                    <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding EffectiveBankingTotal, StringFormat=N2}" FontSize="14" FontWeight="SemiBold" Foreground="#6366f1" Margin="0,4"/>

                                    <TextBlock Grid.Row="7" Grid.Column="0" Text="(-) المصروفات النثرية" FontSize="14" Foreground="#f59e0b" Margin="0,4"/>
                                    <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding TotalExpenses, StringFormat=N2}" FontSize="14" FontWeight="SemiBold" Foreground="#f59e0b" Margin="0,4"/>

                                    <TextBlock Grid.Row="8" Grid.Column="0" Text="(+) مبلغ الصرف" FontSize="14" Foreground="#606060" Margin="0,4"/>
                                    <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding CashFloat, StringFormat=N2}" FontSize="14" FontWeight="SemiBold" Foreground="#0b1c30" Margin="0,4"/>
                                </Grid>
                            </Border>
                            
                            <!-- النقد المتوقع -->
                            <Border Background="#0b1c30" CornerRadius="10" Padding="20,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="النقد المتوقع في الدرج" FontSize="15" Foreground="#bec6e0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ExpectedCash, StringFormat=N2}" FontSize="22" FontWeight="Bold" Foreground="#ffe081" VerticalAlignment="Center" Margin="16,0,0,0"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- الجانب الأيمن: الإدخال الفعلي -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="النقد الفعلي المستلم" FontWeight="SemiBold" FontSize="15" Foreground="#0b1c30" Margin="0,0,0,10"/>
                            <TextBox Text="{Binding ActualCash, UpdateSourceTrigger=LostFocus, TargetNullValue=''}"
                                     materialDesign:HintAssist.Hint="أدخل المبلغ الذي استلمته فعلياً"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     FontSize="22" FontWeight="Bold" Padding="12" Margin="0,0,0,16"/>

                            <!-- نتيجة المطابقة -->
                            <Border CornerRadius="12" Padding="20,16">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#f0fdf4"/>
                                    </Style>
                                </Border.Style>
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="نتيجة المطابقة" FontSize="14" Foreground="#606060" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                    <TextBlock Text="{Binding DifferenceStatus}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#10b981"/>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- ملاحظات -->
                            <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="ملاحظات إضافية (اختياري)"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     FontSize="14" Padding="8" Margin="0,16,0,0"
                                     TextWrapping="Wrap" AcceptsReturn="True" MinHeight="60"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ═══════════ القسم 6: أزرار الإجراء ═══════════ -->
            <Grid Grid.Row="6" Margin="0,0,0,32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsNotViewingMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Button Command="{Binding SaveJournalCommand}" 
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                materialDesign:ButtonAssist.CornerRadius="10"
                                Background="#10b981" BorderBrush="#10b981"
                                Height="50" Padding="24,0" FontSize="16" FontWeight="Bold">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentSave" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="حفظ وترحيل" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding ClearFormCommand}" Margin="16,0,0,0"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                materialDesign:ButtonAssist.CornerRadius="10"
                                BorderBrush="#606060" Foreground="#606060"
                                Height="50" Padding="24,0" FontSize="16">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Eraser" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="مسح النموذج" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- زر الإغلاق (يظهر فقط في وضع العرض) -->
                    <Button Command="{Binding CloseFormCommand}"
                            Visibility="{Binding IsViewingMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            materialDesign:ButtonAssist.CornerRadius="10"
                            Background="#ef4444" BorderBrush="#ef4444"
                            Height="50" Padding="24,0" FontSize="16" FontWeight="Bold">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Close" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="إغلاق والتخطي" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    
                    <!-- زر الطباعة (متاح دائماً) -->
                    <Button Command="{Binding PrintPdfCommand}" Margin="16,0,0,0"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            materialDesign:ButtonAssist.CornerRadius="10"
                            Background="#3b82f6" BorderBrush="#3b82f6"
                            Height="50" Padding="24,0" FontSize="16" FontWeight="Bold">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Printer" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="طباعة تقرير PDF" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- رسالة الحالة -->
                <TextBlock Grid.Column="2" Text="{Binding StatusMessage}" 
                           FontSize="15" FontWeight="SemiBold" Foreground="#10b981"
                           VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="300"/>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
