<UserControl x:Class="MeezanPOS.Presentation.Views.DailyJournalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:MeezanPOS.Application.ViewModels"
             FlowDirection="RightToLeft">
    
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        
        <Style x:Key="ReadOnlySectionStyle" TargetType="materialDesign:Card">
            <Setter Property="KeyboardNavigation.TabNavigation" Value="Local"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsNotViewingMode}" Value="False">
                    <Setter Property="KeyboardNavigation.TabNavigation" Value="None"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        
        <Style x:Key="HideInViewMode" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsViewingMode}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HideButtonInViewMode" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsViewingMode}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ShowInViewMode" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsViewingMode}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ═══════════ القسم 1: معلومات الوردية ═══════════ -->
            <materialDesign:Card Grid.Row="0" UniformCornerRadius="16" Padding="28,24" Margin="0,0,0,24"
                                 Background="White" materialDesign:ElevationAssist.Elevation="Dp2"
                                 IsHitTestVisible="{Binding IsNotViewingMode}" Style="{StaticResource ReadOnlySectionStyle}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <materialDesign:PackIcon Kind="CalendarClock" Width="28" Height="28" Foreground="#0b1c30" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <TextBlock Text="معلومات الوردية" FontSize="20" FontWeight="Bold" Foreground="#0b1c30" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- التاريخ -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="التاريخ" FontWeight="SemiBold" FontSize="13" Foreground="#0b1c30" Margin="0,0,0,8"/>
                            <DatePicker SelectedDate="{Binding JournalDate}"
                                        Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                        FontSize="15" Padding="8"/>
                        </StackPanel>

                        <!-- نوع الوردية -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="نوع الوردية" FontWeight="SemiBold" FontSize="13" Foreground="#0b1c30" Margin="0,0,0,8"/>
                            <ComboBox ItemsSource="{Binding ShiftTypes}" 
                                      SelectedValue="{Binding SelectedShiftType}"
                                      SelectedValuePath="Type"
                                      DisplayMemberPath="DisplayName"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                      FontSize="15" Padding="8"/>
                        </StackPanel>

                        <!-- اسم الموظف -->
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="اسم الموظف" FontWeight="SemiBold" FontSize="13" Foreground="#0b1c30" Margin="0,0,0,8"/>
                            <TextBox Text="{Binding EmployeeName, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="اسم الكاشير / الموظف"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     FontSize="15" Padding="8"/>
                        </StackPanel>

                        <!-- مبلغ الصرف -->
                        <StackPanel Grid.Column="6">
                            <TextBlock Text="مبلغ الصرف (الفكة)" FontWeight="SemiBold" FontSize="13" Foreground="#0b1c30" Margin="0,0,0,8"/>
                            <TextBox Text="{Binding CashFloat, UpdateSourceTrigger=LostFocus, TargetNullValue=''}"
                                     materialDesign:HintAssist.Hint="0.00"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     FontSize="15" Padding="8"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </materialDesign:Card>

            <!-- ═══════════ القسم 2: المبيعات ═══════════ -->
            <materialDesign:Card Grid.Row="1" UniformCornerRadius="16" Padding="28,24" Margin="0,0,0,24"
                                 Background="White" materialDesign:ElevationAssist.Elevation="Dp2"
                                 IsHitTestVisible="{Binding IsNotViewingMode}" Style="{StaticResource ReadOnlySectionStyle}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <materialDesign:PackIcon Kind="CashRegister" Width="28" Height="28" Foreground="#10b981" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <TextBlock Text="المبيعات" FontSize="20" FontWeight="Bold" Foreground="#0b1c30" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- مبيعات نقدية -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="مبيعات نقدية (كاش)" FontWeight="SemiBold" FontSize="14" Foreground="#0b1c30" Margin="0,0,0,8"/>
                            <TextBox Text="{Binding CashSalesInput, UpdateSourceTrigger=LostFocus, TargetNullValue=''}"
                                     materialDesign:HintAssist.Hint="0.00"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     FontSize="20" FontWeight="Bold" Padding="12"/>
                        </StackPanel>

                        <!-- خدمات مصرفية -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="خدمات مصرفية (شبكة / بطاقات)" FontWeight="SemiBold" FontSize="14" Foreground="#0b1c30" Margin="0,0,0,8"/>
                            <TextBox Text="{Binding BankingSalesInput, UpdateSourceTrigger=LostFocus, TargetNullValue=''}"
                                     materialDesign:HintAssist.Hint="0.00"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     FontSize="20" FontWeight="Bold" Padding="12"/>
                        </StackPanel>
                    </Grid>

                    <!-- إجمالي المبيعات (محسوب تلقائياً) -->
                    <Border Background="#f0fdf4" CornerRadius="8" Padding="16,12" Margin="0,16,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="إجمالي المبيعات:" FontWeight="Bold" FontSize="16" Foreground="#10b981" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding TotalSales, StringFormat=N2}" FontWeight="Bold" FontSize="20" Foreground="#10b981" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </materialDesign:Card>

            <!-- ═══════════ القسم 3: الخدمات المصرفية (مطابقة الدفتر) ═══════════ -->
            <materialDesign:Card Grid.Row="2" Background="White" UniformCornerRadius="16" Padding="28,24" Margin="0,0,0,16"
                                 materialDesign:ElevationAssist.Elevation="Dp2" IsHitTestVisible="{Binding IsNotViewingMode}" Style="{StaticResource ReadOnlySectionStyle}">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CreditCard" Width="28" Height="28" Foreground="#6366f1" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding BankingSectionTitle}" FontSize="20" FontWeight="Bold" Foreground="#0b1c30" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="+ إضافة عملية" Command="{Binding AddBankingItemCommand}"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Visibility="{Binding IsNotViewingMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Foreground="#6366f1" FontSize="13"/>
                    </Grid>

                    <!-- جدول العمليات المصرفية -->
                    <DataGrid ItemsSource="{Binding BankingItems}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="All" BorderThickness="1" BorderBrush="Black"
                              HorizontalGridLinesBrush="Black" VerticalGridLinesBrush="Black" Background="White" RowBackground="White" AlternatingRowBackground="#f5f7ff" Margin="0,0,0,16"
                              materialDesign:DataGridAssist.CellPadding="8" materialDesign:DataGridAssist.ColumnHeaderPadding="8">
                        <DataGrid.Columns>
                            <!-- حذف -->
                            <DataGridTemplateColumn Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.RemoveBankingItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" Style="{StaticResource MaterialDesignToolButton}" Foreground="#ef4444" Width="32" Height="32"
                                                Visibility="{Binding DataContext.IsNotViewingMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <materialDesign:PackIcon Kind="DeleteOutline"/>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            
                            <!-- تسلسل -->
                            <DataGridTextColumn Header="#" Binding="{Binding SequenceNumber}" IsReadOnly="True" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnStyle}"/>
                            
                            <!-- المبلغ -->
                            <DataGridTemplateColumn Header="المبلغ" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Amount, UpdateSourceTrigger=LostFocus, TargetNullValue=''}" BorderThickness="0" Background="Transparent" Foreground="Black" Padding="8" FontSize="14"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- رقم الفاتورة -->
                            <DataGridTemplateColumn Header="رقم الفاتورة" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding InvoiceNumber, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" Foreground="Black" Padding="8" FontSize="14"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- المصرف (قائمة منسدلة) -->
                            <DataGridTemplateColumn Header="المصرف" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.BankNames, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  SelectedItem="{Binding BankName, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" 
                                                  BorderThickness="0" Background="Transparent" Foreground="Black" Padding="8" FontSize="14"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- رقم التحويل اخر 4 ارقام -->
                            <DataGridTemplateColumn Header="رقم التحويل اخر 4 ارقام" Width="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Last4Digits, UpdateSourceTrigger=PropertyChanged}" MaxLength="4" BorderThickness="0" Background="Transparent" Foreground="Black" Padding="8" FontSize="14"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- وضع المطابقة: يظهر فقط عند إدخال قيمة مصرفية من الكاشير -->
                    <Border CornerRadius="8" Padding="16,12" Margin="0,8,0,0" Background="#f0f0ff"
                            Visibility="{Binding HasBankingSalesInput, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="المصرفية من الكاشير:" FontSize="14" Foreground="#606060" Margin="0,2"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding BankingSalesInput, StringFormat=N2}" FontSize="14" FontWeight="SemiBold" Foreground="#0b1c30" Margin="0,2"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="المصرفية من الدفتر:" FontSize="14" Foreground="#606060" Margin="0,2"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding BankingItemsTotal, StringFormat=N2}" FontSize="14" FontWeight="SemiBold" Foreground="#0b1c30" Margin="0,2"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="نتيجة المطابقة:" FontSize="14" FontWeight="Bold" Foreground="#6366f1" Margin="0,6,0,0"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding BankingDifferenceStatus}" FontSize="14" FontWeight="Bold" Foreground="{Binding BankingDifferenceColor}" Margin="0,6,0,0"/>
                        </Grid>
                    </Border>

                    <!-- وضع الإدخال العادي: يظهر فقط عندما لا يوجد قيمة مصرفية من الكاشير -->
                    <Border CornerRadius="8" Padding="16,10" Margin="0,8,0,0" Background="#f0f0ff"
                            Visibility="{Binding HasBankingSalesInput, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="إجمالي المصرفية:" FontWeight="SemiBold" FontSize="15" Foreground="#6366f1" Margin="0,0,12,0"/>
                            <TextBlock Text="{Binding BankingItemsTotal, StringFormat=N2}" FontWeight="Bold" FontSize="15" Foreground="#6366f1"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </materialDesign:Card>

            <!-- ═══════ قسم المرتجعات والطلبات المجانية ═══════ -->
            <materialDesign:Card Grid.Row="3" UniformCornerRadius="16" Padding="28,24" Margin="0,0,0,24"
                                 Background="White" materialDesign:ElevationAssist.Elevation="Dp2"
                                 IsHitTestVisible="{Binding IsNotViewingMode}" Style="{StaticResource ReadOnlySectionStyle}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <materialDesign:PackIcon Kind="SwapHorizontal" Width="28" Height="28" Foreground="#ef4444" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <TextBlock Text="المرتجعات والطلبات المجانية" FontSize="20" FontWeight="Bold" Foreground="#0b1c30" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- المرتجعات -->
                        <Border Grid.Column="0" Background="#fff5f5" CornerRadius="10" Padding="16,12" BorderBrush="#fecaca" BorderThickness="1">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <TextBlock Text="🔄 المرتجعات" FontWeight="Bold" FontSize="14" Foreground="#dc2626" VerticalAlignment="Center"/>
                                    <Button Content="+ إضافة مرتجع" Command="{Binding AddReturnItemCommand}" Style="{StaticResource MaterialDesignFlatButton}" 
                                            Visibility="{Binding IsNotViewingMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            Foreground="#dc2626" FontSize="12" HorizontalAlignment="Right" Padding="4,0" Height="24"/>
                                </Grid>
                                <DataGrid ItemsSource="{Binding Returns}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                          HeadersVisibility="Column" GridLinesVisibility="All" BorderThickness="1" BorderBrush="Black"
                                          HorizontalGridLinesBrush="Black" VerticalGridLinesBrush="Black" Background="White" RowBackground="White" AlternatingRowBackground="#fff5f5" Margin="0,0,0,6"
                                          materialDesign:DataGridAssist.CellPadding="4" materialDesign:DataGridAssist.ColumnHeaderPadding="4">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Width="Auto">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding DataContext.RemoveReturnItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Style="{StaticResource MaterialDesignToolButton}" Foreground="#ef4444" Width="24" Height="24" Padding="0"
                                                            Visibility="{Binding DataContext.IsNotViewingMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <materialDesign:PackIcon Kind="Close" Width="16" Height="16"/>
                                                    </Button>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="#" Binding="{Binding SequenceNumber}" IsReadOnly="True" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnStyle}"/>
                                        <DataGridTemplateColumn Header="المبلغ" Width="80">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding Amount, UpdateSourceTrigger=LostFocus, TargetNullValue=''}" BorderThickness="0" Background="Transparent" Foreground="Black" Padding="4" FontSize="13"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="ر.فاتورة" Width="80">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding InvoiceNumber, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" Foreground="Black" Padding="4" FontSize="13"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="ملاحظات" Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" Foreground="Black" Padding="4" FontSize="13"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <!-- الطلبات المجانية -->
                        <Border Grid.Column="2" Background="#fefff5" CornerRadius="10" Padding="16,12" BorderBrush="#fef9c3" BorderThickness="1">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <TextBlock Text="🎁 الطلبات المجانية" FontWeight="Bold" FontSize="14" Foreground="#ca8a04" VerticalAlignment="Center"/>
                                    <Button Content="+ إضافة طلب مجاني" Command="{Binding AddFreeOrderItemCommand}" Style="{StaticResource MaterialDesignFlatButton}" 
                                            Visibility="{Binding IsNotViewingMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            Foreground="#ca8a04" FontSize="12" HorizontalAlignment="Right" Padding="4,0" Height="24"/>
                                </Grid>
                                <DataGrid ItemsSource="{Binding FreeOrders}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                          HeadersVisibility="Column" GridLinesVisibility="All" BorderThickness="1" BorderBrush="Black"
                                          HorizontalGridLinesBrush="Black" VerticalGridLinesBrush="Black" Background="White" RowBackground="White" AlternatingRowBackground="#fefff5" Margin="0,0,0,6"
                                          materialDesign:DataGridAssist.CellPadding="4" materialDesign:DataGridAssist.ColumnHeaderPadding="4">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Width="Auto">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding DataContext.RemoveFreeOrderItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Style="{StaticResource MaterialDesignToolButton}" Foreground="#ef4444" Width="24" Height="24" Padding="0"
                                                            Visibility="{Binding DataContext.IsNotViewingMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <materialDesign:PackIcon Kind="Close" Width="16" Height="16"/>
                                                    </Button>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="#" Binding="{Binding SequenceNumber}" IsReadOnly="True" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnStyle}"/>
                                        <DataGridTemplateColumn Header="المبلغ" Width="80">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding Amount, UpdateSourceTrigger=LostFocus, TargetNullValue=''}" BorderThickness="0" Background="Transparent" Foreground="Black" Padding="4" FontSize="13"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="ر.فاتورة" Width="80">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding InvoiceNumber, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" Foreground="Black" Padding="4" FontSize="13"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="ملاحظات" Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" Foreground="Black" Padding="4" FontSize="13"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </materialDesign:Card>

            <!-- ═══════ قسم المصروفات النثرية ═══════ -->
            <materialDesign:Card Grid.Row="4" UniformCornerRadius="16" Padding="28,24" Margin="0,0,0,24"
                                 Background="White" materialDesign:ElevationAssist.Elevation="Dp2"
                                 IsHitTestVisible="{Binding IsNotViewingMode}" Style="{StaticResource ReadOnlySectionStyle}">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CartArrowDown" Width="28" Height="28" Foreground="#f59e0b" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="المصروفات النثرية" FontSize="20" FontWeight="Bold" Foreground="#0b1c30" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="+ إضافة مصروف" Command="{Binding AddExpenseItemCommand}"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Visibility="{Binding IsNotViewingMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Foreground="#f59e0b" FontSize="13"/>
                    </Grid>

                    <!-- جدول المصروفات -->
                    <DataGrid ItemsSource="{Binding ExpenseItems}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="All" BorderThickness="1" BorderBrush="Black"
                              HorizontalGridLinesBrush="Black" VerticalGridLinesBrush="Black" Background="White" RowBackground="White" AlternatingRowBackground="#fffbeb" Margin="0,0,0,8"
                              materialDesign:DataGridAssist.CellPadding="6" materialDesign:DataGridAssist.ColumnHeaderPadding="6">
                        <DataGrid.Columns>
                            <!-- حذف -->
                            <DataGridTemplateColumn Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.RemoveExpenseItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" Style="{StaticResource MaterialDesignToolButton}" Foreground="#ef4444" Width="30" Height="30"
                                                Visibility="{Binding DataContext.IsNotViewingMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <materialDesign:PackIcon Kind="DeleteOutline"/>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- تسلسل -->
                            <DataGridTextColumn Header="#" Binding="{Binding SequenceNumber}" IsReadOnly="True" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnStyle}"/>

                            <!-- النوع -->
                            <DataGridTemplateColumn Header="النوع" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.ExpenseTypes, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  SelectedItem="{Binding ExpenseType, UpdateSourceTrigger=PropertyChanged}"
                                                  Text="{Binding ExpenseType, UpdateSourceTrigger=PropertyChanged}" IsEditable="True"
                                                  BorderThickness="0" Background="Transparent" Foreground="Black" Padding="6" FontSize="13"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- المبلغ -->
                            <DataGridTemplateColumn Header="المبلغ" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Amount, UpdateSourceTrigger=LostFocus, TargetNullValue=''}" BorderThickness="0" Background="Transparent" Foreground="Black" Padding="6" FontSize="13"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- البيان / المستفيد -->
                            <DataGridTemplateColumn Header="البيان / المستفيد" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <!-- الأنواع البسيطة ويومية العامل: وصف نصي -->
                                            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="البيان أو اسم العامل" Visibility="{Binding IsSimpleExpense, Converter={StaticResource BooleanToVisibilityConverter}}" BorderThickness="0" Background="Transparent" Foreground="Black" Padding="6" FontSize="13"/>
                                            
                                            <!-- أنواع المورد (مشتريات/دفعات): قائمة الموردين -->
                                            <ComboBox ItemsSource="{Binding DataContext.Suppliers, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding SelectedSupplierId, UpdateSourceTrigger=PropertyChanged}"
                                                      materialDesign:HintAssist.Hint="اختر المورد"
                                                      Visibility="{Binding HasSupplier, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                      BorderThickness="0" Background="Transparent" Foreground="Black" Padding="6" FontSize="13"/>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- رقم الفاتورة -->
                            <DataGridTemplateColumn Header="رقم الفاتورة" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding InvoiceNumber, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="رقم الفاتورة" Visibility="{Binding HasInvoiceNumber, Converter={StaticResource BooleanToVisibilityConverter}}" BorderThickness="0" Background="Transparent" Foreground="Black" Padding="6" FontSize="13"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- ملاحظات -->
                            <DataGridTemplateColumn Header="ملاحظات" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="ملاحظات" Visibility="{Binding HasNotes, Converter={StaticResource BooleanToVisibilityConverter}}" BorderThickness="0" Background="Transparent" Foreground="Black" Padding="6" FontSize="13"/>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- ملخص المصروفات حسب النوع -->
                    <Border Background="#fff8f0" CornerRadius="8" Padding="16,12" Margin="0,8,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="مشتريات:" FontSize="13" Foreground="#606060" Margin="0,2" Visibility="{Binding HasPurchases, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding PurchasesTotal, StringFormat=N2}" FontSize="13" Foreground="#606060" Margin="0,2" Visibility="{Binding HasPurchases, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="يومية عمال:" FontSize="13" Foreground="#606060" Margin="0,2" Visibility="{Binding HasWorkerWages, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding WorkerWagesTotal, StringFormat=N2}" FontSize="13" Foreground="#606060" Margin="0,2" Visibility="{Binding HasWorkerWages, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="دفعات موردين:" FontSize="13" Foreground="#606060" Margin="0,2" Visibility="{Binding HasSupplierPayments, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SupplierPaymentsTotal, StringFormat=N2}" FontSize="13" Foreground="#606060" Margin="0,2" Visibility="{Binding HasSupplierPayments, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="دفعات فواتير:" FontSize="13" Foreground="#606060" Margin="0,2" Visibility="{Binding HasInvoicePayments, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding InvoicePaymentsTotal, StringFormat=N2}" FontSize="13" Foreground="#606060" Margin="0,2" Visibility="{Binding HasInvoicePayments, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="غاز:" FontSize="13" Foreground="#606060" Margin="0,2" Visibility="{Binding HasGas, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding GasTotal, StringFormat=N2}" FontSize="13" Foreground="#606060" Margin="0,2" Visibility="{Binding HasGas, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="نظافة:" FontSize="13" Foreground="#606060" Margin="0,2" Visibility="{Binding HasCleaning, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding CleaningTotal, StringFormat=N2}" FontSize="13" Foreground="#606060" Margin="0,2" Visibility="{Binding HasCleaning, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="صيانة:" FontSize="13" Foreground="#606060" Margin="0,2" Visibility="{Binding HasMaintenance, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding MaintenanceTotal, StringFormat=N2}" FontSize="13" Foreground="#606060" Margin="0,2" Visibility="{Binding HasMaintenance, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                            <TextBlock Grid.Row="7" Grid.Column="0" Text="مواصلات:" FontSize="13" Foreground="#606060" Margin="0,2" Visibility="{Binding HasTransport, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding TransportTotal, StringFormat=N2}" FontSize="13" Foreground="#606060" Margin="0,2" Visibility="{Binding HasTransport, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                            <TextBlock Grid.Row="8" Grid.Column="0" Text="مصروف نثري:" FontSize="13" Foreground="#606060" Margin="0,2" Visibility="{Binding HasPettyCash, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding PettyCashTotal, StringFormat=N2}" FontSize="13" Foreground="#606060" Margin="0,2" Visibility="{Binding HasPettyCash, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                            <Separator Grid.Row="9" Grid.ColumnSpan="2" Margin="0,4" Background="#f59e0b" Opacity="0.3"/>

                            <TextBlock Grid.Row="10" Grid.Column="0" Text="إجمالي المصروفات:" FontWeight="Bold" FontSize="15" Foreground="#f59e0b" Margin="0,2"/>
                            <TextBlock Grid.Row="10" Grid.Column="1" Text="{Binding TotalExpenses, StringFormat=N2}" FontWeight="Bold" FontSize="15" Foreground="#f59e0b" Margin="0,2"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </materialDesign:Card>

            <!-- ═══════════ القسم 5: المطابقة والتسليم ═══════════ -->
            <materialDesign:Card Grid.Row="5" UniformCornerRadius="16" Padding="28,24" Margin="0,0,0,16"
                                 materialDesign:ElevationAssist.Elevation="Dp4" IsEnabled="{Binding IsNotViewingMode}">
                <materialDesign:Card.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#F8FAFC" Offset="0"/> <!-- Light Slate -->
                        <GradientStop Color="#FFFFFF" Offset="1"/> <!-- White -->
                    </LinearGradientBrush>
                </materialDesign:Card.Background>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <materialDesign:PackIcon Kind="Calculator" Width="28" Height="28" Foreground="#10B981" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <TextBlock Text="المطابقة والتسليم" FontSize="20" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- الجانب الأيسر: الملخص الحسابي -->
                        <StackPanel Grid.Column="0">
                            <Border Background="#f8f9ff" CornerRadius="12" Padding="20,16" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- إجمالي دخل المطعم -->
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="إجمالي المبيعات (دخل الوردية)" FontSize="15" FontWeight="Bold" Foreground="#0b1c30" Margin="0,4"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding TotalSales, StringFormat=N2}" FontSize="15" FontWeight="Bold" Foreground="#0b1c30" Margin="0,4"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="(-) المرتجعات" FontSize="14" Foreground="#dc2626" Margin="0,4"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ReturnsAmount, StringFormat=N2}" FontSize="14" FontWeight="SemiBold" Foreground="#dc2626" Margin="0,4"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="(-) الطلبات المجانية" FontSize="14" Foreground="#ca8a04" Margin="0,4"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding FreeOrdersAmount, StringFormat=N2}" FontSize="14" FontWeight="SemiBold" Foreground="#ca8a04" Margin="0,4"/>

                                    <Separator Grid.Row="3" Grid.ColumnSpan="2" Margin="0,6" Background="#e0e0e0"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="صافي المبيعات" FontSize="14" FontWeight="Bold" Foreground="#10b981" Margin="0,4"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding NetSales, StringFormat=N2}" FontSize="14" FontWeight="Bold" Foreground="#10b981" Margin="0,4"/>

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="منها مبيعات نقدية" FontSize="14" Foreground="#10b981" Margin="0,4"/>
                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding CashSalesInput, StringFormat=N2}" FontSize="14" FontWeight="SemiBold" Foreground="#10b981" Margin="0,4"/>

                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="منها خدمات مصرفية" FontSize="14" Foreground="#6366f1" Margin="0,4"/>
                                    <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding EffectiveBankingTotal, StringFormat=N2}" FontSize="14" FontWeight="SemiBold" Foreground="#6366f1" Margin="0,4"/>

                                    <TextBlock Grid.Row="7" Grid.Column="0" Text="(-) المصروفات النثرية" FontSize="14" Foreground="#f59e0b" Margin="0,4"/>
                                    <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding TotalExpenses, StringFormat=N2}" FontSize="14" FontWeight="SemiBold" Foreground="#f59e0b" Margin="0,4"/>

                                    <TextBlock Grid.Row="8" Grid.Column="0" Text="(+) مبلغ الصرف" FontSize="14" Foreground="#606060" Margin="0,4"/>
                                    <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding CashFloat, StringFormat=N2}" FontSize="14" FontWeight="SemiBold" Foreground="#0b1c30" Margin="0,4"/>
                                </Grid>
                            </Border>
                            
                            <!-- النقد المتوقع -->
                            <Border Background="#0b1c30" CornerRadius="10" Padding="20,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="النقد المتوقع في الدرج" FontSize="15" Foreground="#bec6e0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ExpectedCash, StringFormat=N2}" FontSize="22" FontWeight="Bold" Foreground="#ffe081" VerticalAlignment="Center" Margin="16,0,0,0"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- الجانب الأيمن: الإدخال الفعلي -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="النقد الفعلي المستلم" FontWeight="SemiBold" FontSize="15" Foreground="#0b1c30" Margin="0,0,0,10"/>
                            <TextBox Text="{Binding ActualCash, UpdateSourceTrigger=LostFocus, TargetNullValue=''}"
                                     materialDesign:HintAssist.Hint="أدخل المبلغ الذي استلمته فعلياً"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     FontSize="22" FontWeight="Bold" Padding="12" Margin="0,0,0,16"/>

                            <!-- نتيجة المطابقة -->
                            <Border CornerRadius="12" Padding="20,16">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#f0fdf4"/>
                                    </Style>
                                </Border.Style>
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="نتيجة المطابقة" FontSize="14" Foreground="#606060" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                    <TextBlock Text="{Binding DifferenceStatus}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{Binding DifferenceColor}"/>
                                </StackPanel>
                            </Border>

                            <!-- ملاحظات -->
                            <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="ملاحظات إضافية (اختياري)"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     FontSize="14" Padding="8" Margin="0,16,0,0"
                                     TextWrapping="Wrap" AcceptsReturn="True" MinHeight="60"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </materialDesign:Card>

            <!-- ═══════════ القسم 6: أزرار الإجراء ═══════════ -->
            <Grid Grid.Row="6" Margin="0,0,0,32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsNotViewingMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Button Command="{Binding SaveJournalCommand}" 
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                materialDesign:ButtonAssist.CornerRadius="10"
                                Background="#10b981" BorderBrush="#10b981"
                                Height="50" Padding="24,0" FontSize="16" FontWeight="Bold">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentSave" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding SaveButtonText}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding CloseFormCommand}" Margin="16,0,0,0"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                materialDesign:ButtonAssist.CornerRadius="10"
                                BorderBrush="#606060" Foreground="#606060"
                                Height="50" Padding="24,0" FontSize="16">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Eraser" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="إلغاء" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- زر الإغلاق (يظهر فقط في وضع العرض) -->
                    <Button Command="{Binding CloseFormCommand}"
                            Visibility="{Binding IsViewingMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            materialDesign:ButtonAssist.CornerRadius="10"
                            Background="#ef4444" BorderBrush="#ef4444"
                            Height="50" Padding="24,0" FontSize="16" FontWeight="Bold">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Close" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="إغلاق" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    
                    <!-- زر الطباعة (متاح دائماً) -->
                    <Button Command="{Binding PrintPdfCommand}" Margin="16,0,0,0"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            materialDesign:ButtonAssist.CornerRadius="10"
                            Background="#3b82f6" BorderBrush="#3b82f6"
                            Height="50" Padding="24,0" FontSize="16" FontWeight="Bold">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Printer" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="PDF" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- رسالة الحالة -->
                <TextBlock Grid.Column="2" Text="{Binding StatusMessage}" 
                           FontSize="15" FontWeight="SemiBold" Foreground="#10b981"
                           VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="300"/>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
