<UserControl x:Class="MeezanPOS.Presentation.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:MeezanPOS.Application.ViewModels"
             xmlns:enums="clr-namespace:MeezanPOS.Domain.Enums"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900"
             FlowDirection="RightToLeft"
             Background="#F5F7FA">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        
        <ObjectDataProvider x:Key="FrequencyEnumValues" MethodName="GetValues" ObjectType="{x:Type System:Enum}" xmlns:System="clr-namespace:System;assembly=mscorlib">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="enums:BackupFrequency" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <Style x:Key="SidebarTabItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Foreground" Value="#64748b"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="8" Margin="8,2">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#080b1c30" />
                                <Setter Property="Foreground" Value="#1E293B"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EEF2FF" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#3F51B5"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="4,0,0,0"/>
                                <Setter Property="Foreground" Value="#3F51B5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/> <!-- Inner Sidebar -->
            <ColumnDefinition Width="*"/> <!-- Tab Content -->
        </Grid.ColumnDefinitions>

        <!-- Inner Sidebar for Settings Tabs -->
        <Border Grid.Column="0" Background="White" BorderBrush="#EEF2FF" BorderThickness="0,0,1,0" Padding="8,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="أقسام الإعدادات" FontSize="15" FontWeight="Bold" Foreground="#1E293B" Margin="16,0,16,16"/>

                <ListBox Grid.Row="1" x:Name="SettingsTabsList" AutomationProperties.AutomationId="SettingsTabsList" Background="Transparent" BorderThickness="0" SelectedIndex="{Binding SelectedTab, Mode=TwoWay}">
                    <!-- Tab 1: Backup & Restore -->
                    <ListBoxItem Style="{StaticResource SidebarTabItem}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="DatabaseSync" Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="النسخ الاحتياطي والاسترجاع" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>

                    <!-- Tab 2: عن المنظومة -->
                    <ListBoxItem Style="{StaticResource SidebarTabItem}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="InformationOutline" Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="عن المنظومة" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>

                    <!-- Tab 3: عن المصمم -->
                    <ListBoxItem Style="{StaticResource SidebarTabItem}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AccountOutline" Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="عن المصمم" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </Grid>
        </Border>

        <!-- Settings Content Area -->
        <Grid Grid.Column="1" Margin="24">
            
            <!-- Tab 0: Backup & Restore -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedIndex, ElementName=SettingsTabsList}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header Grid with Close Button -->
                <Grid Grid.Row="0" Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Title & Subtitle -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="إعدادات النسخ الاحتياطي والاسترجاع" FontSize="20" FontWeight="Bold" Foreground="#1E293B"/>
                        <TextBlock Text="قم بتكوين خيارات النسخ الاحتياطي التلقائي أو إجراء عمليات نسخ واسترجاع يدوية لقاعدة البيانات." FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Close Button -->
                    <Button Grid.Column="1" x:Name="btnCloseSettings" AutomationProperties.AutomationId="btnCloseSettings"
                            Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="Dashboard"
                            Style="{StaticResource MaterialDesignIconButton}" 
                            Foreground="#DC2626" 
                            VerticalAlignment="Top" 
                            HorizontalAlignment="Left"
                            Margin="16,0,0,0"
                            Width="36" 
                            Height="36">
                        <materialDesign:PackIcon Kind="Close" Width="24" Height="24"/>
                    </Button>
                </Grid>

                <!-- Sections Card -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        
                        <!-- Section A: Automatic Backup -->
                        <Border Background="White" CornerRadius="8" BorderBrush="#EEF2FF" BorderThickness="1" Padding="20" Margin="0,0,0,20">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <materialDesign:PackIcon Kind="ClockStart" Foreground="#3F51B5" Width="22" Height="22" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="الجدولة والنسخ التلقائي" FontSize="16" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Folder Selection -->
                                <TextBlock Text="مسار النسخ الاحتياطي المفضل" FontSize="13" FontWeight="SemiBold" Foreground="#64748b" Margin="0,0,0,6"/>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding PreferredBackupPath, Mode=TwoWay}" IsReadOnly="True" 
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             Padding="12,10" Height="40" Background="#F5F7FA"/>
                                    <Button Grid.Column="1" Command="{Binding BackupNowCommand}" Content="استعراض مجلد..." 
                                             Style="{StaticResource MaterialDesignFlatButton}" Foreground="#3F51B5"
                                             Margin="8,0,0,0" Height="40" Padding="12,0"/>
                                </Grid>

                                <!-- Backup Frequency -->
                                <TextBlock Text="تكرار النسخ الاحتياطي التلقائي (عند إغلاق المنظومة)" FontSize="13" FontWeight="SemiBold" Foreground="#64748b" Margin="0,0,0,6"/>
                                <ComboBox x:Name="comboFrequency" AutomationProperties.AutomationId="comboFrequency" SelectedItem="{Binding SelectedFrequency}" ItemsSource="{Binding Source={StaticResource FrequencyEnumValues}}"
                                          Width="250" HorizontalAlignment="Right" Height="40" Padding="8,6" VerticalContentAlignment="Center">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock FontSize="13" HorizontalAlignment="Right" TextAlignment="Right">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding}" Value="{x:Static enums:BackupFrequency.Disabled}">
                                                                <Setter Property="Text" Value="معطّل (إيقاف النسخ التلقائي)" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding}" Value="{x:Static enums:BackupFrequency.Daily}">
                                                                <Setter Property="Text" Value="يومي" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding}" Value="{x:Static enums:BackupFrequency.Weekly}">
                                                                <Setter Property="Text" Value="أسبوعي" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding}" Value="{x:Static enums:BackupFrequency.Monthly}">
                                                                <Setter Property="Text" Value="شهري" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <!-- Info -->
                                <Border Background="#f0f7ff" CornerRadius="6" Padding="12" Margin="0,16,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Information" Foreground="#3F51B5" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="تاريخ آخر نسخ تلقائي:" FontSize="12" Foreground="#283593" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding LastAutoBackupDateText}" FontSize="12" Foreground="#283593" Margin="6,0,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Section B: Manual Actions -->
                        <Border Background="White" CornerRadius="8" BorderBrush="#EEF2FF" BorderThickness="1" Padding="20" Margin="0,0,0,20">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <materialDesign:PackIcon Kind="DatabaseSettings" Foreground="#D97706" Width="22" Height="22" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="العمليات اليدوية الفورية" FontSize="16" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center"/>
                                </StackPanel>

                                <TextBlock Text="يمكنك حفظ نسخة احتياطية بشكل يدوي في أي وقت أو استعادة البيانات من ملف قديم." FontSize="13" Foreground="#64748B" Margin="0,0,0,16"/>

                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="btnBackupNow" AutomationProperties.AutomationId="btnBackupNow" Command="{Binding BackupNowCommand}" Background="#3F51B5" BorderThickness="0" Padding="16,8" Height="40" Margin="0,0,12,0" materialDesign:ButtonAssist.CornerRadius="6">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Backup" Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="نسخ احتياطي فوري الآن" Foreground="White" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <Button x:Name="btnRestoreNow" AutomationProperties.AutomationId="btnRestoreNow" Command="{Binding RestoreNowCommand}" Background="#DC2626" BorderThickness="0" Padding="16,8" Height="40" materialDesign:ButtonAssist.CornerRadius="6">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Restore" Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="استرجاع نسخة سابقة..." Foreground="White" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Section C: Reset and Initialization -->
                        <Border Background="White" CornerRadius="8" BorderBrush="#fecaca" BorderThickness="1" Padding="20" Margin="0,0,0,20">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <materialDesign:PackIcon Kind="DatabaseAlert" Foreground="#dc2626" Width="22" Height="22" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="إعادة الضبط والتهيئة" FontSize="16" FontWeight="Bold" Foreground="#991b1b" VerticalAlignment="Center"/>
                                </StackPanel>

                                <TextBlock Text="إعادة تعيين المنظومة بالكامل وحذف كافة البيانات التشغيلية والمصرفية والحركات والتقارير والنسخ الاحتياطي نهائياً، مع الإبقاء فقط على حسابات المستخدمين وكلمات مرورهم." 
                                           FontSize="13" Foreground="#7f1d1d" TextWrapping="Wrap" Margin="0,0,0,16"/>

                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="btnResetSystem" AutomationProperties.AutomationId="btnResetSystem" Command="{Binding ResetSystemCommand}" Background="#dc2626" BorderThickness="0" Padding="16,8" Height="40" materialDesign:ButtonAssist.CornerRadius="6">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="DatabaseRemove" Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="إعادة ضبط المنظومة وحذف البيانات" Foreground="White" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Tab 1: عن المنظومة -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedIndex, ElementName=SettingsTabsList}" Value="1">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header Grid with Close Button -->
                <Grid Grid.Row="0" Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Title & Subtitle -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="عن المنظومة" FontSize="20" FontWeight="Bold" Foreground="#1E293B"/>
                        <TextBlock Text="معلومات حول منظومة ميزان ومميزاتها وإمكانياتها." FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Close Button -->
                    <Button Grid.Column="1" 
                            Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="Dashboard"
                            Style="{StaticResource MaterialDesignIconButton}" 
                            Foreground="#DC2626" 
                            VerticalAlignment="Top" 
                            HorizontalAlignment="Left"
                            Margin="16,0,0,0"
                            Width="36" 
                            Height="36">
                        <materialDesign:PackIcon Kind="Close" Width="24" Height="24"/>
                    </Button>
                </Grid>

                <!-- About System Content Card -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <Border Background="#1A2744" CornerRadius="12" Padding="24" Margin="0,0,0,20">
                        <StackPanel FlowDirection="RightToLeft">
                            <!-- System Logo at top -->
                            <Image Source="pack://application:,,,/MeezanPOS;component/Resources/meezan_logo.png" 
                                   Width="80" Height="80"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,12"/>

                            <!-- System Name -->
                            <TextBlock Text="منظومة ميزان للمطاعم"
                                       FontSize="22" FontWeight="Bold"
                                       Foreground="#FFD700"
                                       HorizontalAlignment="Center"/>

                            <!-- Version -->
                            <TextBlock Text="الإصدار 1.0 — 2026"
                                       FontSize="13" Foreground="#C5CAE9"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,16"/>

                            <!-- Divider -->
                            <Separator Background="#2A3A5C" Margin="40,0"/>

                            <!-- Description -->
                            <TextBlock TextWrapping="Wrap"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       Margin="20,16,20,0"
                                       Foreground="#CFD8DC"
                                       FontSize="13"
                                       Text="منظومة متكاملة لإدارة المطاعم تشمل المبيعات والمصاريف والأجور والموردين والحسابات البنكية وإصدار التقارير المالية الشاملة"/>

                            <!-- Features Title -->
                            <TextBlock Text="✦ المميزات والإمكانيات"
                                       FontSize="15" FontWeight="Bold"
                                       Foreground="#7986CB"
                                       Margin="20,20,20,10"/>

                            <!-- Features List -->
                            <StackPanel Margin="20,0">
                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                    <TextBlock Text="✓" Foreground="#16A34A" FontWeight="Bold" Margin="0,0,8,0" FontSize="13"/>
                                    <TextBlock Text="إدارة الورديات والمبيعات اليومية" Foreground="#E2E8F0" FontSize="13"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                    <TextBlock Text="✓" Foreground="#16A34A" FontWeight="Bold" Margin="0,0,8,0" FontSize="13"/>
                                    <TextBlock Text="متابعة المصاريف العامة واليومية" Foreground="#E2E8F0" FontSize="13"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                    <TextBlock Text="✓" Foreground="#16A34A" FontWeight="Bold" Margin="0,0,8,0" FontSize="13"/>
                                    <TextBlock Text="إدارة أجور العمال وسلفهم" Foreground="#E2E8F0" FontSize="13"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                    <TextBlock Text="✓" Foreground="#16A34A" FontWeight="Bold" Margin="0,0,8,0" FontSize="13"/>
                                    <TextBlock Text="إدارة حسابات الموردين والفواتير" Foreground="#E2E8F0" FontSize="13"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                    <TextBlock Text="✓" Foreground="#16A34A" FontWeight="Bold" Margin="0,0,8,0" FontSize="13"/>
                                    <TextBlock Text="الخدمات المصرفية وتتبع الأرصدة" Foreground="#E2E8F0" FontSize="13"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                    <TextBlock Text="✓" Foreground="#16A34A" FontWeight="Bold" Margin="0,0,8,0" FontSize="13"/>
                                    <TextBlock Text="الحساب الختامي والتقارير المالية" Foreground="#E2E8F0" FontSize="13"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                    <TextBlock Text="✓" Foreground="#16A34A" FontWeight="Bold" Margin="0,0,8,0" FontSize="13"/>
                                    <TextBlock Text="لوحة قيادة تفاعلية مع رسوم بيانية" Foreground="#E2E8F0" FontSize="13"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                    <TextBlock Text="✓" Foreground="#16A34A" FontWeight="Bold" Margin="0,0,8,0" FontSize="13"/>
                                    <TextBlock Text="تصدير التقارير بصيغة PDF احترافية" Foreground="#E2E8F0" FontSize="13"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                    <TextBlock Text="✓" Foreground="#16A34A" FontWeight="Bold" Margin="0,0,8,0" FontSize="13"/>
                                    <TextBlock Text="نسخ احتياطي تلقائي مجدول" Foreground="#E2E8F0" FontSize="13"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                    <TextBlock Text="✓" Foreground="#16A34A" FontWeight="Bold" Margin="0,0,8,0" FontSize="13"/>
                                    <TextBlock Text="نظام صلاحيات وحماية بكلمة مرور" Foreground="#E2E8F0" FontSize="13"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                    <TextBlock Text="✓" Foreground="#16A34A" FontWeight="Bold" Margin="0,0,8,0" FontSize="13"/>
                                    <TextBlock Text="واجهة عربية RTL بالكامل" Foreground="#E2E8F0" FontSize="13"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                    <TextBlock Text="✓" Foreground="#16A34A" FontWeight="Bold" Margin="0,0,8,0" FontSize="13"/>
                                    <TextBlock Text="يعمل بدون إنترنت (Offline)" Foreground="#E2E8F0" FontSize="13"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </Grid>

            <!-- Tab 2: عن المصمم -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedIndex, ElementName=SettingsTabsList}" Value="2">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header Grid with Close Button -->
                <Grid Grid.Row="0" Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Title & Subtitle -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="عن المصمم" FontSize="20" FontWeight="Bold" Foreground="#1E293B"/>
                        <TextBlock Text="معلومات الاتصال وتفاصيل حول مطور ومصمم النظام." FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Close Button -->
                    <Button Grid.Column="1" 
                            Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="Dashboard"
                            Style="{StaticResource MaterialDesignIconButton}" 
                            Foreground="#DC2626" 
                            VerticalAlignment="Top" 
                            HorizontalAlignment="Left"
                            Margin="16,0,0,0"
                            Width="36" 
                            Height="36">
                        <materialDesign:PackIcon Kind="Close" Width="24" Height="24"/>
                    </Button>
                </Grid>

                <!-- Designer Profile Card -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <Border Background="#1A2744" CornerRadius="12" Padding="24" Margin="0,0,0,20">
                        <StackPanel FlowDirection="RightToLeft">
                            <!-- Designer Logo — centered, large -->
                            <Border Background="White"
                                    CornerRadius="16"
                                    Padding="16"
                                    HorizontalAlignment="Center"
                                    Margin="0,10,0,20">
                                <Image Source="pack://application:,,,/MeezanPOS;component/Resources/designer_logo.png"
                                       Width="180" Height="180"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       HorizontalAlignment="Center"/>
                            </Border>

                            <!-- Designer Name -->
                            <TextBlock Text="م. إدريس فتح الله الهرى"
                                       FontSize="20" FontWeight="Bold"
                                       Foreground="#FFD700"
                                       HorizontalAlignment="Center"/>

                            <!-- Title -->
                            <TextBlock Text="EDREES .F. ELHERY"
                                       FontSize="13"
                                       Foreground="#C5CAE9"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,2"/>

                            <TextBlock Text="AI-Powered Software Developer"
                                       FontSize="12"
                                       Foreground="#78909C"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,16"/>

                            <!-- Divider -->
                            <Separator Background="#2A3A5C" Margin="40,0,40,16"/>

                            <!-- About Text -->
                            <TextBlock TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Margin="20,0,20,16"
                                       Foreground="#CFD8DC"
                                       FontSize="13"
                                       Text="مطور برامج متخصص في بناء منظومات إدارية متكاملة باستخدام تقنيات الذكاء الاصطناعي. يجمع بين الخبرة التقنية العميقة والفهم الدقيق لاحتياجات بيئة العمل العربية."/>

                            <!-- Contact Title -->
                            <TextBlock Text="✦ معلومات التواصل"
                                       FontSize="15" FontWeight="Bold"
                                       Foreground="#7986CB"
                                       Margin="20,0,20,12"
                                       HorizontalAlignment="Center"/>

                            <!-- Contact Items -->

                            <!-- Phone 1 -->
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Margin="0,6,0,0">
                                <TextBlock Text="📱" FontSize="14" Margin="0,0,8,0"/>
                                <TextBlock Text="0925126355"
                                           FontSize="14" Foreground="#E2E8F0"
                                           FontFamily="{StaticResource Font.Money}"/>
                            </StackPanel>

                            <!-- Phone 2 -->
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Margin="0,6,0,0">
                                <TextBlock Text="📱" FontSize="14" Margin="0,0,8,0"/>
                                <TextBlock Text="0917730110"
                                           FontSize="14" Foreground="#E2E8F0"
                                           FontFamily="{StaticResource Font.Money}"/>
                            </StackPanel>

                            <!-- Location -->
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Margin="0,6,0,0">
                                <TextBlock Text="📍" FontSize="14" Margin="0,0,8,0"/>
                                <TextBlock Text="بنغازي — ليبيا"
                                           FontSize="14" Foreground="#E2E8F0"/>
                            </StackPanel>

                            <!-- Email -->
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Margin="0,6,0,16">
                                <TextBlock Text="✉️" FontSize="14" Margin="0,0,8,0"/>
                                <TextBlock Text="EdreesElhery@gmail.com"
                                           FontSize="13" Foreground="#C5CAE9"
                                           FontFamily="{StaticResource Font.Money}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </Grid>
            
        </Grid>

        <!-- Reset System Password Verification Overlay Dialog -->
        <Grid Grid.ColumnSpan="2" Background="#66000000" Visibility="{Binding IsResetPasswordDialogOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="White" CornerRadius="16" Width="450" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="28" BorderBrush="#fecaca" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="تأكيد الهوية لإعادة ضبط المنظومة" FontSize="18" FontWeight="Bold" Foreground="#991b1b" HorizontalAlignment="Center"/>
                    <TextBlock Text="الرجاء إدخال كلمة مرور الحساب الحالي لتأكيد العملية وحذف البيانات نهائياً." FontSize="13" Foreground="#475569" Margin="0,8,0,16" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>

                    <!-- Password Box -->
                    <TextBlock Text="كلمة مرور الحساب الحالي:" FontSize="13" FontWeight="Bold" Foreground="#dc2626" Margin="0,0,0,6"/>
                    <PasswordBox x:Name="ResetPasswordBox" AutomationProperties.AutomationId="txtResetPassword" Style="{StaticResource MaterialDesignOutlinedPasswordBox}" Margin="0,0,0,20" Padding="12,10"/>

                    <!-- Actions -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="إلغاء" Command="{Binding CloseResetDialogCommand}" 
                                Style="{StaticResource MaterialDesignFlatButton}" Background="#F1F5F9" Foreground="#475569" Height="42" Margin="0,0,8,0" materialDesign:ButtonAssist.CornerRadius="8"/>
                        <Button Grid.Column="1" AutomationProperties.AutomationId="btnConfirmReset" Content="تأكيد الحذف النهائي" Command="{Binding ConfirmResetCommand}" CommandParameter="{Binding ElementName=ResetPasswordBox}"
                                Background="#dc2626" BorderThickness="0" Foreground="White" Height="42" Margin="8,0,0,0" materialDesign:ButtonAssist.CornerRadius="8"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
