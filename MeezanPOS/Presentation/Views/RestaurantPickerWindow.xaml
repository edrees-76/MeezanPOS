<Window x:Class="MeezanPOS.Presentation.Views.RestaurantPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="ميزان للمطاعم — اختيار المطعم"
        Icon="pack://application:,,,/MeezanPOS;component/Assets/Images/mizan_3d_icon_final_transparent.png"
        FontFamily="{StaticResource Font.Body}"
        Width="820" Height="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize"
        FlowDirection="RightToLeft"
        MouseLeftButtonDown="DragWindow">

    <Border Background="{StaticResource Brush.Canvas}" CornerRadius="16" BorderBrush="{StaticResource Brush.BorderStrong}" BorderThickness="1"
            Effect="{StaticResource Shadow.Dialog}" Margin="12" ClipToBounds="True">
        <Grid>
            <DockPanel>
                <!-- الترويسة -->
                <Border DockPanel.Dock="Top" Background="{StaticResource Brush.Sidebar}" CornerRadius="16,16,0,0" Padding="24,18">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource MaterialDesignToolButton}" Width="32" Height="32" Padding="0"
                                Command="{Binding ExitCommand}" ToolTip="خروج">
                            <materialDesign:PackIcon Kind="Close" Width="20" Height="20" Foreground="White"/>
                        </Button>
                        <Border Width="46" Height="46" CornerRadius="10" Background="White" Padding="3">
                            <Image Source="pack://application:,,,/MeezanPOS;component/Assets/Images/mizan_3d_icon_final_transparent.png" Stretch="Uniform"/>
                        </Border>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="اختر المطعم" FontFamily="{StaticResource Font.Heading}" FontWeight="Bold" FontSize="20" Foreground="White"/>
                            <TextBlock Text="لكل مطعم حساباته ومستخدموه ونسخه الاحتياطية المستقلة" FontSize="12.5" Foreground="{StaticResource Brush.SidebarText}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- الأزرار السفلية -->
                <Border DockPanel.Dock="Bottom" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0"
                        CornerRadius="0,0,16,16" Padding="24,14">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" FlowDirection="LeftToRight">
                            <Button Content="خروج" Style="{StaticResource Button.Secondary}" Command="{Binding ExitCommand}" MinWidth="100" Margin="0,0,10,0"/>
                            <Button Style="{StaticResource Button.Primary}" Command="{Binding OpenCommand}" MinWidth="170" IsDefault="True">
                                <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                                    <materialDesign:PackIcon Kind="LoginVariant" Width="18" Height="18" VerticalAlignment="Center"/>
                                    <TextBlock Text="فتح المطعم المختار" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Button.Secondary}" Command="{Binding StartAddCommand}" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="StorefrontPlusOutline" Width="18" Height="18" VerticalAlignment="Center"/>
                                    <TextBlock Text="إضافة مطعم" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource MaterialDesignFlatButton}" Command="{Binding StartOwnerPasswordCommand}"
                                    ToolTip="كلمة مرور المالك تلزم لإضافة المطاعم وتغيير أسمائها">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ShieldKeyOutline" Width="18" Height="18" VerticalAlignment="Center"/>
                                    <TextBlock Text="كلمة مرور المالك" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- قائمة المطاعم -->
                <ListBox ItemsSource="{Binding Restaurants}" SelectedItem="{Binding SelectedRestaurant}" Margin="20,18,20,10"
                         Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         MouseDoubleClick="Restaurants_DoubleClick">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2" VerticalAlignment="Top"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="6"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Card" Background="{StaticResource Brush.Surface}" CornerRadius="12" BorderThickness="2"
                                                BorderBrush="{StaticResource Brush.Border}" Padding="16,14">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Brush.BorderStrong}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Brush.Primary}"/>
                                                <Setter TargetName="Card" Property="Background" Value="{StaticResource Brush.PrimarySoft}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Width="48" Height="48" CornerRadius="24" Background="{StaticResource Brush.Primary}">
                                    <TextBlock Text="{Binding Initial}" FontSize="20" FontWeight="Bold" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Button DockPanel.Dock="Left" Style="{StaticResource MaterialDesignToolButton}" Width="34" Height="34" Padding="0"
                                        VerticalAlignment="Top" ToolTip="إعادة تسمية (تتطلب كلمة مرور المالك)"
                                        Command="{Binding DataContext.StartRenameCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}">
                                    <materialDesign:PackIcon Kind="PencilOutline" Width="18" Height="18" Foreground="{StaticResource Brush.TextMuted}"/>
                                </Button>
                                <StackPanel Margin="12,0,6,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource Brush.TextStrong}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <Border Background="{StaticResource Brush.SurfaceAlt}" CornerRadius="6" Padding="6,1">
                                            <TextBlock Text="{Binding Code}" FontSize="11" Foreground="{StaticResource Brush.TextSecondary}"/>
                                        </Border>
                                        <Border Background="{StaticResource Brush.IncomeSoft}" CornerRadius="6" Padding="6,1" Margin="6,0,0,0"
                                                Visibility="{Binding IsLastUsed, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="آخر مطعم مفتوح" FontSize="11" Foreground="{StaticResource Brush.IncomeText}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding LastOpenedText}" Style="{StaticResource Text.Caption}" FontSize="11.5" Margin="0,5,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- نافذة الإضافة / التسمية / كلمة مرور المالك -->
            <Grid Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border Background="#99101828" CornerRadius="16"/>
                <Border Background="{StaticResource Brush.Surface}" CornerRadius="14" Width="440" VerticalAlignment="Center" Padding="24"
                        Effect="{StaticResource Shadow.Dialog}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource Brush.PrimarySoft}" Margin="0,0,12,0">
                                <materialDesign:PackIcon Width="22" Height="22" Foreground="{StaticResource Brush.Primary}"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <materialDesign:PackIcon.Style>
                                        <Style TargetType="materialDesign:PackIcon">
                                            <Setter Property="Kind" Value="ShieldKeyOutline"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAddMode}" Value="True">
                                                    <Setter Property="Kind" Value="StorefrontPlusOutline"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsRenameMode}" Value="True">
                                                    <Setter Property="Kind" Value="PencilOutline"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </materialDesign:PackIcon.Style>
                                </materialDesign:PackIcon>
                            </Border>
                            <TextBlock Text="{Binding EditTitle}" Style="{StaticResource Text.SectionTitle}" VerticalAlignment="Center"/>
                        </DockPanel>

                        <TextBlock Text="{Binding EditHint}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,0,0,16"/>

                        <StackPanel Visibility="{Binding ShowNameField, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="اسم المطعم" Style="{StaticResource Text.Label}" Margin="0,0,0,6"/>
                            <TextBox x:Name="TxtName" Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" Height="44" Padding="12,0"
                                     VerticalContentAlignment="Center" Style="{StaticResource MaterialDesignOutlinedTextBox}" MaxLength="60" Margin="0,0,0,14"/>
                        </StackPanel>

                        <StackPanel Visibility="{Binding ShowOwnerPasswordField, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Margin="0,0,0,6">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Label}">
                                        <Setter Property="Text" Value="كلمة مرور المالك"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPasswordMode}" Value="True">
                                                <Setter Property="Text" Value="كلمة مرور المالك الحالية"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <PasswordBox x:Name="TxtOwner" PasswordChanged="Owner_PasswordChanged" Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                                         Height="44" Padding="12,0" VerticalContentAlignment="Center" FlowDirection="LeftToRight" Margin="0,0,0,14"/>
                        </StackPanel>

                        <StackPanel Visibility="{Binding ShowNewPasswordFields, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="كلمة المرور الجديدة" Style="{StaticResource Text.Label}" Margin="0,0,0,6"/>
                            <PasswordBox x:Name="TxtNew" PasswordChanged="New_PasswordChanged" Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                                         Height="44" Padding="12,0" VerticalContentAlignment="Center" FlowDirection="LeftToRight" Margin="0,0,0,14"/>
                            <TextBlock Text="تأكيد كلمة المرور الجديدة" Style="{StaticResource Text.Label}" Margin="0,0,0,6"/>
                            <PasswordBox x:Name="TxtConfirm" PasswordChanged="Confirm_PasswordChanged" Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                                         Height="44" Padding="12,0" VerticalContentAlignment="Center" FlowDirection="LeftToRight" Margin="0,0,0,14"/>
                        </StackPanel>

                        <Border Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Background="{StaticResource Brush.ExpenseSoft}" CornerRadius="8" Padding="12,8" Margin="0,0,0,14">
                            <TextBlock Text="{Binding Error}" Foreground="{StaticResource Brush.ExpenseText}" TextWrapping="Wrap"/>
                        </Border>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" FlowDirection="LeftToRight">
                            <Button Content="إلغاء" Style="{StaticResource Button.Secondary}" Command="{Binding CancelEditCommand}" MinWidth="100" Margin="0,0,10,0"/>
                            <Button Content="{Binding ConfirmText}" Style="{StaticResource Button.Primary}" Command="{Binding ConfirmCommand}" MinWidth="150"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
