<!-- ========================================================= -->
<!-- File: LoginView.xaml                                      -->
<!-- Project: Mizan Restaurants System                         -->
<!-- Technology: WPF + .NET 8 + XAML                          -->
<!-- ========================================================= -->

<Window x:Class="MeezanPOS.Presentation.Views.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:MeezanPOS.Application.ViewModels"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="ميزان المطاعم"
        Icon="pack://application:,,,/MeezanPOS;component/Assets/Images/mizan_3d_icon_final_transparent.png"
        Height="640"
        Width="1000"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FlowDirection="RightToLeft"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.DataContext>
        <vm:LoginViewModel />
    </Window.DataContext>

    <!-- ========================================================= -->
    <!-- Resources -->
    <!-- ========================================================= -->

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="LocalBooleanToVisibilityConverter"/>

        <!-- حقول الإدخال بهوية ميزان -->
        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
            <Setter Property="Background" Value="{StaticResource Brush.SurfaceAlt}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontFamily" Value="{StaticResource Font.Body}"/>
            <Setter Property="Padding" Value="44,0,44,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="{StaticResource Brush.Primary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.PrimaryInteractive}"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="Bd" Property="Background" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernPasswordStyle" TargetType="PasswordBox">
            <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
            <Setter Property="Background" Value="{StaticResource Brush.SurfaceAlt}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="44,0,44,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="{StaticResource Brush.Primary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.PrimaryInteractive}"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="Bd" Property="Background" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldWatermark" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="44,0,44,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>

        <Style x:Key="FieldIcon" TargetType="materialDesign:PackIcon">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="14,0,0,0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>

        <!-- أزرار التحكم بالنافذة (فوق اللوحة النيلية) -->
        <Style x:Key="WindowControlButton" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.SidebarText}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#26FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FeatureTile" TargetType="Border">
            <Setter Property="Background" Value="#1FFFFFFF"/>
            <Setter Property="BorderBrush" Value="#33FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- خلفية ملء الشاشة عند التكبير -->
        <Grid x:Name="FullScreenBackground" Visibility="Collapsed">
            <Image Source="pack://application:,,,/MeezanPOS;component/Assets/Images/perfect_login_bg.png" Stretch="UniformToFill">
                <Image.Effect>
                    <BlurEffect Radius="15"/>
                </Image.Effect>
            </Image>
            <Border Background="#D51A237E"/>
        </Grid>

        <!-- البطاقة الرئيسية: نموذج الدخول + اللوحة التعريفية -->
        <Border Width="960" Height="600" Background="White" CornerRadius="16"
                HorizontalAlignment="Center" VerticalAlignment="Center" Effect="{StaticResource Shadow.Dialog}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="440"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ===== نموذج الدخول ===== -->
                <Grid Grid.Column="0" Margin="48,40,48,28">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <Image Source="pack://application:,,,/MeezanPOS;component/Assets/Images/mizan_3d_icon_final_transparent.png" Width="40" Height="40"/>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="ميزان للمطاعم" FontFamily="{StaticResource Font.Heading}" FontWeight="Bold" FontSize="16" Foreground="{StaticResource Brush.Primary}"/>
                            <TextBlock Text="نظام إدارة المحاسبة والخزينة" Style="{StaticResource Text.Caption}"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                        <TextBlock Text="تسجيل الدخول للنظام" Style="{StaticResource Text.PageTitle}" FontSize="26"/>
                        <TextBlock Text="أهلاً بك مجدداً، أدخل بيانات حسابك لبدء العمل" Style="{StaticResource Text.Body}" Margin="0,6,0,28"/>

                        <!-- اسم المستخدم -->
                        <TextBlock Text="اسم المستخدم" Style="{StaticResource Text.Label}" Foreground="{StaticResource Brush.TextPrimary}" FontWeight="Bold" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,18">
                            <TextBox x:Name="txtUsername"
                                     Style="{StaticResource ModernTextBoxStyle}"
                                     Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                     TextChanged="TxtUsername_TextChanged"/>
                            <TextBlock x:Name="txtUsernameWatermark" Text="أدخل اسم المستخدم" Style="{StaticResource FieldWatermark}"/>
                            <materialDesign:PackIcon Kind="AccountOutline" Style="{StaticResource FieldIcon}"/>
                        </Grid>

                        <!-- كلمة المرور -->
                        <TextBlock Text="كلمة المرور" Style="{StaticResource Text.Label}" Foreground="{StaticResource Brush.TextPrimary}" FontWeight="Bold" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,16">
                            <PasswordBox x:Name="txtPassword"
                                         Style="{StaticResource ModernPasswordStyle}"
                                         PasswordChanged="PasswordBox_PasswordChanged"/>
                            <TextBox x:Name="txtVisiblePassword"
                                     Style="{StaticResource ModernTextBoxStyle}"
                                     Padding="44,0,44,0"
                                     Visibility="Collapsed"
                                     TextChanged="TxtVisiblePassword_TextChanged"/>
                            <TextBlock x:Name="txtPasswordWatermark" Text="أدخل كلمة المرور" Style="{StaticResource FieldWatermark}"/>
                            <materialDesign:PackIcon Kind="LockOutline" Style="{StaticResource FieldIcon}"/>

                            <!-- إظهار / إخفاء كلمة المرور -->
                            <Button x:Name="btnTogglePassword"
                                    Width="36" Height="36"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Margin="0,0,6,0"
                                    Cursor="Hand"
                                    ToolTip="إظهار / إخفاء كلمة المرور"
                                    Click="BtnTogglePassword_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="Transparent">
                                            <materialDesign:PackIcon x:Name="iconTogglePassword"
                                                                     Kind="EyeOutline"
                                                                     Foreground="{StaticResource Brush.TextMuted}"
                                                                     Width="20" Height="20"
                                                                     HorizontalAlignment="Center"
                                                                     VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                            <CheckBox x:Name="chkRememberMe" IsChecked="{Binding RememberMe}" VerticalAlignment="Center"
                                      Style="{StaticResource MaterialDesignCheckBox}"/>
                            <TextBlock Text="تذكرني على هذا الجهاز" Style="{StaticResource Text.Body}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>

                        <Button x:Name="btnLogin" Click="btnLogin_Click" IsDefault="True"
                                Style="{StaticResource Button.Primary}" Height="48" FontSize="16" HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="تسجيل الدخول" VerticalAlignment="Center"/>
                                <materialDesign:PackIcon Kind="Login" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <DockPanel Grid.Row="2">
                        <TextBlock DockPanel.Dock="Right" Text="جميع الحقوق محفوظة © 2026" Style="{StaticResource Text.Caption}" FontSize="11"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="تصميم وتنفيذ:" Style="{StaticResource Text.Caption}" FontSize="11"/>
                            <TextBlock Text="م. إدريس فتح الله الهرى" Style="{StaticResource Text.Caption}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Brush.Primary}" Margin="4,0,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Grid>

                <!-- ===== اللوحة التعريفية النيلية ===== -->
                <Border Grid.Column="1" CornerRadius="0,16,16,0" ClipToBounds="True">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="{StaticResource Color.Primary}" Offset="0"/>
                            <GradientStop Color="{StaticResource Color.PrimaryDark}" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <!-- أزرار النافذة -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,12,0" FlowDirection="LeftToRight">
                            <Button Style="{StaticResource WindowControlButton}" Click="MinimizeButton_Click" ToolTip="تصغير">
                                <materialDesign:PackIcon Kind="WindowMinimize" Width="16" Height="16"/>
                            </Button>
                            <Button Style="{StaticResource WindowControlButton}" Click="MaximizeButton_Click" ToolTip="تكبير">
                                <materialDesign:PackIcon Kind="WindowMaximize" Width="15" Height="15"/>
                            </Button>
                            <Button Style="{StaticResource WindowControlButton}" Click="CloseButton_Click" ToolTip="إغلاق">
                                <materialDesign:PackIcon Kind="Close" Width="18" Height="18"/>
                            </Button>
                        </StackPanel>

                        <!-- المطعم الذي يُسجَّل الدخول إليه، مع زر تغييره (أعلى الجهة الأخرى من أزرار النافذة) -->
                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20,16,0,0" Background="#26FFFFFF"
                                BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="12" Padding="12,5"
                                Visibility="{Binding HasRestaurantName, Converter={StaticResource LocalBooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Storefront" Width="18" Height="18" Foreground="White" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding RestaurantName}" FontWeight="Bold" FontSize="14" Foreground="White"
                                           Margin="7,0,0,0" VerticalAlignment="Center" MaxWidth="220" TextTrimming="CharacterEllipsis"/>
                                <Border Width="1" Background="#40FFFFFF" Margin="10,2"
                                        Visibility="{Binding CanSwitchRestaurant, Converter={StaticResource LocalBooleanToVisibilityConverter}}"/>
                                <Button Click="SwitchRestaurant_Click" Style="{StaticResource MaterialDesignFlatButton}" Height="26" Padding="6,0"
                                        Foreground="White" FontSize="12.5" ToolTip="إعادة فتح المنظومة على شاشة اختيار المطعم"
                                        Visibility="{Binding CanSwitchRestaurant, Converter={StaticResource LocalBooleanToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="SwapHorizontal" Width="16" Height="16" VerticalAlignment="Center"/>
                                        <TextBlock Text="تغيير المطعم" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <StackPanel VerticalAlignment="Center" Margin="44,0">
                            <Border Width="92" Height="92" CornerRadius="20" Background="White" HorizontalAlignment="Left" Padding="8" Margin="0,0,0,22">
                                <Image Source="pack://application:,,,/MeezanPOS;component/Assets/Images/mizan_3d_icon_final_transparent.png" Stretch="Uniform"/>
                            </Border>
                            <TextBlock Text="ميزان — محاسبة مطعمك بدقة" FontFamily="{StaticResource Font.Heading}" FontWeight="Bold" FontSize="28" Foreground="White" TextWrapping="Wrap"/>
                            <TextBlock Text="نظام متكامل يربط الكاشير بالخزينة والموردين وأجور العمال، مع إقفال ورديات يومي وتقارير ختامية بضغطة زر."
                                       FontSize="14" Foreground="{StaticResource Brush.SidebarText}" TextWrapping="Wrap" LineHeight="22" Margin="0,10,0,28"/>

                            <UniformGrid Columns="3">
                                <Border Style="{StaticResource FeatureTile}">
                                    <StackPanel>
                                        <materialDesign:PackIcon Kind="CashMultiple" Width="22" Height="22" Foreground="{StaticResource Brush.Accent}" Margin="0,0,0,8"/>
                                        <TextBlock Text="الخزينة النقدية" FontWeight="Bold" FontSize="13" Foreground="White"/>
                                        <TextBlock Text="مطابقة الدرج والورديات" FontSize="11.5" Foreground="{StaticResource Brush.SidebarText}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource FeatureTile}">
                                    <StackPanel>
                                        <materialDesign:PackIcon Kind="TruckOutline" Width="22" Height="22" Foreground="{StaticResource Brush.Accent}" Margin="0,0,0,8"/>
                                        <TextBlock Text="الموردون" FontWeight="Bold" FontSize="13" Foreground="White"/>
                                        <TextBlock Text="فواتير ودفعات وكشوف" FontSize="11.5" Foreground="{StaticResource Brush.SidebarText}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource FeatureTile}" Margin="0">
                                    <StackPanel>
                                        <materialDesign:PackIcon Kind="AccountGroupOutline" Width="22" Height="22" Foreground="{StaticResource Brush.Accent}" Margin="0,0,0,8"/>
                                        <TextBlock Text="أجور العمال" FontWeight="Bold" FontSize="13" Foreground="White"/>
                                        <TextBlock Text="حضور وسلف ومستحقات" FontSize="11.5" Foreground="{StaticResource Brush.SidebarText}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>

</Window>
