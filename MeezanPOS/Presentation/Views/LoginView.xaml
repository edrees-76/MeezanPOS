<Window x:Class="MeezanPOS.Presentation.Views.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:MeezanPOS.Application.ViewModels"
        mc:Ignorable="d"
        Title="تسجيل الدخول - ميزان" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        Background="#0b1c30"
        FontFamily="Segoe UI">
    
    <Window.DataContext>
        <vm:LoginViewModel />
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="1" RadiusY="1">
                <GradientStop Color="#131b2e" Offset="0" />
                <GradientStop Color="#0b1c30" Offset="1" />
            </RadialGradientBrush>
        </Grid.Background>

        <!-- Decorative Blurs -->
        <Ellipse Fill="#10ffe081" Width="600" Height="600" Margin="-200,-200,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" >
            <Ellipse.Effect>
                <BlurEffect Radius="150"/>
            </Ellipse.Effect>
        </Ellipse>
        <Ellipse Fill="#0Ddce9ff" Width="700" Height="700" Margin="0,0,-200,-200" HorizontalAlignment="Right" VerticalAlignment="Bottom" >
            <Ellipse.Effect>
                <BlurEffect Radius="150"/>
            </Ellipse.Effect>
        </Ellipse>

        <!-- Card Container -->
        <Border Width="450" VerticalAlignment="Center" HorizontalAlignment="Center" 
                CornerRadius="20" Background="#F8ffffff" Padding="40"
                BorderBrush="#20ffffff" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.4" Color="Black"/>
            </Border.Effect>
            
            <StackPanel>
                <!-- Logo Place -->
                <Image Source="/Assets/Images/mizan_chef_scale-removebg-preview.png" 
                       Width="180" Height="180" 
                       Stretch="Uniform" 
                       HorizontalAlignment="Center" Margin="0,-20,0,16">
                    <Image.Effect>
                        <DropShadowEffect BlurRadius="15" ShadowDepth="4" Opacity="0.15" Color="Black"/>
                    </Image.Effect>
                </Image>

                <TextBlock Text="مرحباً بك في ميزان" FontSize="28" FontWeight="Bold" Foreground="#0b1c30" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock Text="أدخل بياناتك للمتابعة" FontSize="15" Foreground="#606060" HorizontalAlignment="Center" Margin="0,0,0,30"/>

                <!-- Form -->
                <TextBlock Text="اسم المستخدم" FontWeight="SemiBold" FontSize="13" Foreground="#0b1c30" Margin="0,0,0,8"/>
                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" 
                         materialDesign:HintAssist.Hint="admin"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Margin="0,0,0,20" Padding="12" FontSize="15"/>

                <Grid Margin="0,0,0,8">
                    <TextBlock Text="كلمة المرور" FontWeight="SemiBold" FontSize="13" Foreground="#0b1c30" HorizontalAlignment="Left"/>
                    <TextBlock Text="نسيت كلمة المرور؟" FontSize="13" Foreground="#606060" HorizontalAlignment="Right" Cursor="Hand" TextDecorations="Underline"/>
                </Grid>
                <Grid Margin="0,0,0,20">
                    <PasswordBox materialDesign:HintAssist.Hint="••••••••"
                                 Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                                 Padding="12,12,40,12" FontSize="15" x:Name="txtPassword"
                                 PasswordChanged="PasswordBox_PasswordChanged" />
                    <TextBox materialDesign:HintAssist.Hint="••••••••"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Padding="12,12,40,12" FontSize="15" x:Name="txtVisiblePassword"
                             Visibility="Collapsed" 
                             TextChanged="TxtVisiblePassword_TextChanged"/>
                    <Button x:Name="btnTogglePassword" 
                            Style="{StaticResource MaterialDesignToolButton}"
                            HorizontalAlignment="Right" Margin="0,0,8,0"
                            Width="30" Height="30"
                            Click="BtnTogglePassword_Click">
                        <materialDesign:PackIcon x:Name="iconTogglePassword" Kind="EyeOutline" />
                    </Button>
                </Grid>

                <!-- Validation Error -->
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#ba1a1a" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,10" 
                           Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}" HorizontalAlignment="Center"/>

                <CheckBox Content="تذكرني على هذا الجهاز" IsChecked="{Binding RememberMe}" Foreground="#606060" Margin="0,0,0,30" FontSize="14"/>

                <!-- Login Button -->
                <Button Content="تسجيل الدخول" Command="{Binding LoginCommand}" 
                        Style="{StaticResource MaterialDesignRaisedButton}" 
                        materialDesign:ButtonAssist.CornerRadius="10"
                        Background="#0b1c30" BorderBrush="#0b1c30"
                        Height="55" FontSize="18" FontWeight="Bold"/>

                <!-- Footer -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,25,0,0">
                    <TextBlock Text="بيئة الإنتاج الآمنة" Foreground="#0b1c30" FontSize="13" Opacity="0.6" Margin="5,0,0,0" VerticalAlignment="Center"/>
                    <materialDesign:PackIcon Kind="ShieldCheck" Foreground="#10b981" Width="18" Height="18" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
