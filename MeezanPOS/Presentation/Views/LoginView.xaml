<!-- ========================================================= -->
<!-- File: LoginView.xaml                                      -->
<!-- Project: Mizan Restaurants System                         -->
<!-- Technology: WPF + .NET 8 + XAML                          -->
<!-- ========================================================= -->

<Window x:Class="MeezanPOS.Presentation.Views.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:MeezanPOS.Application.ViewModels"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="ميزان المطاعم"
        Icon="/Assets/Images/mizan_3d_icon_final_transparent.png"
        Height="720"
        Width="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FlowDirection="RightToLeft"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.DataContext>
        <vm:LoginViewModel />
    </Window.DataContext>

    <!-- ========================================================= -->
    <!-- Resources -->
    <!-- ========================================================= -->

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="LocalBooleanToVisibilityConverter"/>

        <!-- Colors -->
        <Color x:Key="PrimaryBlue">#071D49</Color>
        <Color x:Key="SecondaryBlue">#102B61</Color>
        <Color x:Key="GoldColor">#C9A65B</Color>
        <Color x:Key="WhiteText">#F3F3F3</Color>

        <!-- Brushes -->
        <SolidColorBrush x:Key="BlueBrush" Color="{StaticResource PrimaryBlue}"/>
        <SolidColorBrush x:Key="SecondaryBlueBrush" Color="{StaticResource SecondaryBlue}"/>
        <SolidColorBrush x:Key="GoldBrush" Color="{StaticResource GoldColor}"/>
        <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource WhiteText}"/>

        <!-- ========================================================= -->
        <!-- TextBox Style -->
        <!-- ========================================================= -->

        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">

            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource SecondaryBlueBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource GoldBrush}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="15,0,15,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="White"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="TextBox">

                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">

                            <ScrollViewer x:Name="PART_ContentHost"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>

        <!-- ========================================================= -->
        <!-- PasswordBox Style -->
        <!-- ========================================================= -->

        <Style x:Key="ModernPasswordStyle" TargetType="PasswordBox">

            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource SecondaryBlueBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource GoldBrush}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="15,0,15,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="PasswordBox">

                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">

                            <ScrollViewer x:Name="PART_ContentHost"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>

        <!-- ========================================================= -->
        <!-- Login Button Style -->
        <!-- ========================================================= -->

        <Style x:Key="LoginButtonStyle" TargetType="Button">

            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#0B2455"/>
            <Setter Property="BorderBrush" Value="{StaticResource GoldBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="50"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="25">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#153B80"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#04142F"/>
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>

    </Window.Resources>

    <!-- ========================================================= -->
    <!-- Main Grid -->
    <!-- ========================================================= -->

    <Grid>

        <!-- Full-screen Background when Maximized -->
        <Grid x:Name="FullScreenBackground" Visibility="Collapsed">
            <Image Source="/Assets/Images/perfect_login_bg.png" Stretch="UniformToFill">
                <Image.Effect>
                    <BlurEffect Radius="15"/>
                </Image.Effect>
            </Image>
            <!-- Dark Blue brand overlay for high contrast and readability -->
            <Border Background="#D5071D49"/>
        </Grid>

        <!-- Main Card -->

        <Border Width="430"
                Height="640"
                Background="White"
                CornerRadius="20"
                BorderBrush="#C7AA6C"
                BorderThickness="1.5"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="250"/>
                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>

                <!-- ========================================================= -->
                <!-- Top White Section -->
                <!-- ========================================================= -->

                <Grid Grid.Row="0">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,10,0,0">
                        <!-- Logo (Mizan Chef Scale Logo) -->
                        <Image Source="/Assets/Images/mizan_3d_icon_final_transparent.png" 
                               Width="165" Height="165" 
                               Stretch="Uniform" 
                               HorizontalAlignment="Center">
                            <Image.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.12" Color="Black"/>
                            </Image.Effect>
                        </Image>

                        <!-- Premium Typography Title -->
                        <TextBlock Text="منظومة ميزان للمطاعم"
                                   Foreground="#071D49"
                                   FontSize="20"
                                   FontWeight="ExtraBold"
                                   FontFamily="Segoe UI"
                                   HorizontalAlignment="Center"
                                   Margin="0,8,0,0"
                                   TextAlignment="Center">
                            <TextBlock.Effect>
                                <DropShadowEffect BlurRadius="2" ShadowDepth="1" Opacity="0.05" Color="Black"/>
                            </TextBlock.Effect>
                        </TextBlock>
                    </StackPanel>
                </Grid>

                <!-- ========================================================= -->
                <!-- Bottom Blue Section -->
                <!-- ========================================================= -->

                <Border Grid.Row="1"
                        Background="{StaticResource BlueBrush}"
                        CornerRadius="0,0,20,20">

                    <Grid Margin="30">

                        <Grid.RowDefinitions>

                            <RowDefinition Height="75"/>
                            <RowDefinition Height="75"/>
                            <RowDefinition Height="75"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>

                        </Grid.RowDefinitions>

                        <!-- ========================================================= -->
                        <!-- Username -->
                        <!-- ========================================================= -->

                        <StackPanel Grid.Row="0" VerticalAlignment="Center">

                            <!-- Label -->
                            <TextBlock Text="اسم المستخدم"
                                       Foreground="#C9A65B"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Margin="4,0,4,6"/>

                            <!-- Field -->
                            <Grid>
                                <TextBox x:Name="txtUsername"
                                         Style="{StaticResource ModernTextBoxStyle}"
                                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                         TextChanged="TxtUsername_TextChanged"/>

                                <TextBlock x:Name="txtUsernameWatermark"
                                           Text="أدخل اسم المستخدم هنا"
                                           Foreground="#6A7FA8"
                                           FontSize="15"
                                           Margin="0"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           IsHitTestVisible="False"/>
                            </Grid>

                        </StackPanel>

                        <!-- ========================================================= -->
                        <!-- Password -->
                        <!-- ========================================================= -->

                        <StackPanel Grid.Row="1" VerticalAlignment="Center">

                            <!-- Label -->
                            <TextBlock Text="كلمة المرور"
                                       Foreground="#C9A65B"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Margin="4,0,4,6"/>

                            <!-- Field -->
                            <Grid>
                                <PasswordBox x:Name="txtPassword"
                                             Style="{StaticResource ModernPasswordStyle}"
                                             Padding="45,0,45,0"
                                             PasswordChanged="PasswordBox_PasswordChanged"/>

                                <TextBox x:Name="txtVisiblePassword"
                                         Style="{StaticResource ModernTextBoxStyle}"
                                         Padding="45,0,45,0"
                                         Visibility="Collapsed"
                                         TextChanged="TxtVisiblePassword_TextChanged"/>

                                <TextBlock x:Name="txtPasswordWatermark"
                                           Text="أدخل كلمة المرور هنا"
                                           Foreground="#6A7FA8"
                                           FontSize="15"
                                           Margin="0"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           IsHitTestVisible="False"/>

                                <!-- Toggle Password Button (Right aligned in RTL) -->
                                <Button x:Name="btnTogglePassword"
                                        Width="36" Height="36"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Margin="0,0,10,0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Click="BtnTogglePassword_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="Transparent">
                                                <materialDesign:PackIcon x:Name="iconTogglePassword" 
                                                                         Kind="EyeOutline" 
                                                                         Foreground="#C9A65B" 
                                                                         Width="22" Height="22" 
                                                                         HorizontalAlignment="Center" 
                                                                         VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>

                        </StackPanel>

                        <!-- ========================================================= -->
                        <!-- Login Button -->
                        <!-- ========================================================= -->

                        <Button x:Name="btnLogin"
                                Grid.Row="2"
                                Margin="0,15,0,0"
                                Content="دخول"
                                Style="{StaticResource LoginButtonStyle}"
                                Click="btnLogin_Click"/>

                        <!-- ========================================================= -->
                        <!-- Footer Row: Remember Me & Designer (centered) -->
                        <!-- ========================================================= -->

                        <StackPanel Grid.Row="3"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="0,10,0,0">

                            <!-- Remember Me Checkbox -->
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center">
                                <CheckBox x:Name="chkRememberMe"
                                          IsChecked="{Binding RememberMe}"
                                          Margin="0,0,6,0"
                                          VerticalAlignment="Center"/>
                                <TextBlock Text="تذكرني"
                                           Foreground="#D8C08A"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                        </StackPanel>

                        <!-- ========================================================= -->
                        <!-- Copyright & Branding -->
                        <!-- ========================================================= -->

                        <StackPanel Grid.Row="4"
                                    Orientation="Vertical"
                                    HorizontalAlignment="Center"
                                    Margin="0,8,0,10">

                            <!-- Row: logo + credit text side by side -->
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">

                                <!-- Logo: small, clean, no background -->
                                <Image Source="/Resources/designer_logo.png"
                                       Width="52" Height="52"
                                       Margin="0,0,10,0"
                                       VerticalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       Opacity="0.92"/>

                                <!-- Text: designed and developed by -->
                                <StackPanel Orientation="Vertical"
                                            VerticalAlignment="Center">

                                    <TextBlock Text="تصميم وتنفيذ"
                                               FontSize="10"
                                               Foreground="#90A4AE"
                                               HorizontalAlignment="Right"
                                               FlowDirection="RightToLeft"/>

                                    <TextBlock Text="م. إدريس فتح الله الهرى"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#FFD700"
                                               HorizontalAlignment="Right"
                                               FlowDirection="RightToLeft"/>

                                    <TextBlock Text="EDREES .F. ELHERY"
                                               FontSize="10"
                                               Foreground="#64B5F6"
                                               HorizontalAlignment="Right"/>

                                </StackPanel>
                            </StackPanel>

                            <!-- Copyright below -->
                            <TextBlock Text="جميع الحقوق محفوظة © 2026"
                                       FontSize="10"
                                       Foreground="#607D8B"
                                       HorizontalAlignment="Center"
                                       Margin="0,6,0,0"
                                       FlowDirection="RightToLeft"/>

                        </StackPanel>

                    </Grid>

                </Border>

            </Grid>

        </Border>

        <!-- ========================================================= -->
        <!-- Window Control Buttons (macOS style premium window actions) -->
        <!-- ========================================================= -->
        <StackPanel Orientation="Horizontal" 
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Top" 
                    Margin="20,20,0,0">

            <!-- Close Button (Red) -->
            <Button Width="18"
                    Height="18"
                    Background="#FF5F56"
                    BorderBrush="#E0443E"
                    BorderThickness="1"
                    Cursor="Hand"
                    Margin="0,0,10,0"
                    Click="CloseButton_Click"
                    ToolTip="إغلاق">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="9">
                            <TextBlock Text="✕" FontSize="8" FontWeight="Bold" Foreground="#4C0002"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource LocalBooleanToVisibilityConverter}}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF3B30"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Minimize Button (Yellow) -->
            <Button Width="18"
                    Height="18"
                    Background="#FFBD2E"
                    BorderBrush="#DEA123"
                    BorderThickness="1"
                    Cursor="Hand"
                    Margin="0,0,10,0"
                    Click="MinimizeButton_Click"
                    ToolTip="تصغير">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="9">
                            <TextBlock Text="—" FontSize="8" FontWeight="Bold" Foreground="#5C3E00"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource LocalBooleanToVisibilityConverter}}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF9500"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Maximize Button (Green) -->
            <Button Width="18"
                    Height="18"
                    Background="#27C93F"
                    BorderBrush="#1AAB29"
                    BorderThickness="1"
                    Cursor="Hand"
                    Click="MaximizeButton_Click"
                    ToolTip="تكبير">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="9">
                            <TextBlock Text="⬜" FontSize="6" FontWeight="Bold" Foreground="#024D00"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource LocalBooleanToVisibilityConverter}}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#34C759"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

        </StackPanel>

    </Grid>

</Window>
