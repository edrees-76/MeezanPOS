<UserControl x:Class="MeezanPOS.Presentation.Views.SupplierDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:MeezanPOS.Presentation.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1000"
             FlowDirection="RightToLeft"
             Background="White">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:BalanceToColorConverter x:Key="BalanceToColorConverter"/>
        <converters:InvoiceNotPaidConverter x:Key="InvoiceNotPaidConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- الترويسة -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Command="{Binding GoBackCommand}" Style="{StaticResource MaterialDesignIconButton}" ToolTip="رجوع للموردين">
                    <materialDesign:PackIcon Kind="ArrowRight" Width="24" Height="24"/>
                </Button>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0">
                    <materialDesign:PackIcon Kind="ClipboardTextClock" Width="32" Height="32" Foreground="{DynamicResource PrimaryHueMidBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding SupplierName, StringFormat='كشف حساب: {0}'}" FontSize="24" FontWeight="Bold" Margin="16,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalTransactionsCount, StringFormat='(إجمالي {0} حركة)'}" FontSize="16" Foreground="#64748b" Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                </StackPanel>

                <materialDesign:Card Grid.Column="2" Padding="16,8" UniformCornerRadius="8" Background="#f5f5f5">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="الرصيد الحالي (الدين): " FontSize="16" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CurrentBalance, StringFormat=N2}" 
                                   FontSize="20" FontWeight="Bold" 
                                   Foreground="{Binding CurrentBalance, Converter={StaticResource BalanceToColorConverter}}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </materialDesign:Card>
            </Grid>

            <!-- شريط الأزرار والفلترة (تم فصله ليبقى ثابتاً في الأعلى) -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="2" Margin="16,8,16,16">
                
                <!-- فلاتر التاريخ -->
                <DatePicker SelectedDate="{Binding FilterStartDate}" materialDesign:HintAssist.Hint="من تاريخ" Style="{StaticResource MaterialDesignFloatingHintDatePicker}" Margin="0,0,16,0" Width="120" VerticalAlignment="Bottom"/>
                <DatePicker SelectedDate="{Binding FilterEndDate}" materialDesign:HintAssist.Hint="إلى تاريخ" Style="{StaticResource MaterialDesignFloatingHintDatePicker}" Margin="0,0,16,0" Width="120" VerticalAlignment="Bottom"/>
                
                <Button Command="{Binding FilterStatementCommand}" Content="تصفية" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,0" VerticalAlignment="Bottom"/>
                <Button Command="{Binding ClearFilterCommand}" ToolTip="إلغاء التصفية" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,32,0" Foreground="#ef4444" BorderBrush="#ef4444" VerticalAlignment="Bottom">
                    <materialDesign:PackIcon Kind="FilterRemove" />
                </Button>

                <!-- أزرار الإجراءات -->
                <Button Command="{Binding PrintStatementCommand}" Content="طباعة كشف الحساب" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,16,0" VerticalAlignment="Bottom">
                    <Button.ContentTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Printer" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </Button.ContentTemplate>
                </Button>

                <Button Command="{Binding OpenPaymentFormCommand}" Content="تسديد قيمة" Style="{StaticResource MaterialDesignFlatMidBgButton}" Margin="0,0,16,0" VerticalAlignment="Bottom">
                    <Button.ContentTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CashMultiple" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </Button.ContentTemplate>
                </Button>

                <Button Command="{Binding OpenAddInvoiceFormCommand}" Content="إضافة فاتورة مشتريات" Style="{StaticResource MaterialDesignFlatMidBgButton}" VerticalAlignment="Bottom">
                    <Button.ContentTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ReceiptTextPlus" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </Button.ContentTemplate>
                </Button>
            </StackPanel>

            <!-- جدول كشف الحساب الموحد -->
            <DataGrid Grid.Row="3" Margin="0"
                      ItemsSource="{Binding UnifiedLedger}" 
                      AutoGenerateColumns="False" 
                      CanUserAddRows="False" 
                      IsReadOnly="True"
                      CanUserResizeColumns="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="All" BorderThickness="1" BorderBrush="#e5e7eb"
                      HorizontalGridLinesBrush="#e5e7eb" VerticalGridLinesBrush="#e5e7eb"
                      materialDesign:DataGridAssist.CellPadding="8"
                      materialDesign:DataGridAssist.ColumnHeaderPadding="8">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="التسلسل" Binding="{Binding Sequence}" Width="60"/>
                    <DataGridTextColumn Header="رصيد أول" Binding="{Binding OpeningBalance, StringFormat=N2}" Width="75"/>
                    
                    <DataGridTextColumn Header="قيمة الفاتورة" Binding="{Binding InvoiceAmount, StringFormat=N2}" Width="85"/>
                    <DataGridTextColumn Header="تاريخ الفاتورة" Binding="{Binding InvoiceDate, StringFormat=yyyy-MM-dd}" Width="90"/>
                    <DataGridTextColumn Header="رقم الفاتورة" Binding="{Binding InvoiceNumber}" Width="80"/>
                    
                    <DataGridTextColumn Header="المبلغ المستلم" Binding="{Binding PaymentAmount, StringFormat=N2}" Width="95"/>
                    <DataGridTextColumn Header="تاريخ الدفع" Binding="{Binding PaymentDate, StringFormat=yyyy-MM-dd}" Width="90"/>
                    <DataGridTemplateColumn Header="طريقة الدفع" Width="105">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid HorizontalAlignment="Center">
                                    <!-- إذا كانت الدفعة من الوردية (اليومية) -->
                                    <Button Command="{Binding DataContext.ShowShiftDetailsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource MaterialDesignFlatButton}"
                                            Foreground="#3b82f6"
                                            Padding="4,2" Height="Auto" Margin="0"
                                            ToolTip="عرض تفاصيل الوردية والكاشير"
                                            Visibility="{Binding IsDailyJournalPayment, Converter={StaticResource BoolToVis}}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="ClockOutline" Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding PaymentMethod}" VerticalAlignment="Center" TextDecorations="Underline"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- إذا كانت الدفعة تحويل مصرفي -->
                                    <Button Command="{Binding DataContext.ShowTransferDetailsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource MaterialDesignFlatButton}"
                                            Foreground="#8b5cf6"
                                            Padding="4,2" Height="Auto" Margin="0"
                                            ToolTip="عرض تفاصيل التحويل المصرفي"
                                            Visibility="{Binding IsTransferPayment, Converter={StaticResource BoolToVis}}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="BankTransfer" Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding PaymentMethod}" VerticalAlignment="Center" TextDecorations="Underline"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- إذا كانت الدفعة نقدية عادية -->
                                    <TextBlock Text="{Binding PaymentMethod}" 
                                               VerticalAlignment="Center" 
                                               HorizontalAlignment="Center"
                                               Visibility="{Binding IsPlainPayment, Converter={StaticResource BoolToVis}}"/>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="رقم الايصال" Binding="{Binding ReceiptNumber}" Width="80"/>
                    
                    <DataGridTemplateColumn Header="المتبقي" Width="85">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding RemainingBalance, StringFormat=N2}" 
                                           FontWeight="Bold"
                                           Foreground="{Binding RemainingBalance, Converter={StaticResource BalanceToColorConverter}}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    
                    <DataGridTextColumn Header="ملاحظات" Binding="{Binding Notes}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextWrapping" Value="Wrap" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="Margin" Value="4" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- ملخص كشف الحساب -->
            <Grid Grid.Row="4" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <materialDesign:Card Grid.Column="0" Margin="4" Padding="12" Background="#f8fafc">
                    <StackPanel>
                        <TextBlock Text="رصيد أول" FontSize="12" Foreground="#64748b" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding TotalOpeningBalance, StringFormat=N2}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </materialDesign:Card>
                
                <materialDesign:Card Grid.Column="1" Margin="4" Padding="12" Background="#f8fafc">
                    <StackPanel>
                        <TextBlock Text="قيمة الفواتير" FontSize="12" Foreground="#64748b" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding TotalInvoicesSum, StringFormat=N2}" FontSize="18" FontWeight="Bold" Foreground="#eab308" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </materialDesign:Card>
                
                <materialDesign:Card Grid.Column="2" Margin="4" Padding="12" Background="#f8fafc">
                    <StackPanel>
                        <TextBlock Text="المبالغ المستلمة" FontSize="12" Foreground="#64748b" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding TotalPaymentsSum, StringFormat=N2}" FontSize="18" FontWeight="Bold" Foreground="#22c55e" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </materialDesign:Card>
                
                <materialDesign:Card Grid.Column="3" Margin="4" Padding="12" Background="#f8fafc">
                    <StackPanel>
                        <TextBlock Text="المتبقي" FontSize="12" Foreground="#64748b" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding CurrentBalance, StringFormat=N2}" FontSize="18" FontWeight="Bold" Foreground="{Binding CurrentBalance, Converter={StaticResource BalanceToColorConverter}}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </materialDesign:Card>
            </Grid>
        </Grid>

        <!-- نافذة إضافة فاتورة (Overlay) -->
        <Grid Background="#80000000" Visibility="{Binding IsInvoiceFormOpen, Converter={StaticResource BoolToVis}}" Panel.ZIndex="100">
            <materialDesign:Card Width="400" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24" UniformCornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="تسجيل فاتورة مشتريات" FontSize="20" FontWeight="Bold"/>

                    <StackPanel Grid.Row="2">
                        <DatePicker materialDesign:HintAssist.Hint="تاريخ الفاتورة" SelectedDate="{Binding NewInvoice.InvoiceDate}" Style="{StaticResource MaterialDesignOutlinedDatePicker}" Margin="0,0,0,16"/>
                        <TextBox materialDesign:HintAssist.Hint="رقم الفاتورة (الورقية)" Text="{Binding NewInvoice.InvoiceNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,16"/>
                        <TextBox materialDesign:HintAssist.Hint="إجمالي الفاتورة *" Text="{Binding NewInvoice.TotalAmount, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,16"/>
                        <TextBox materialDesign:HintAssist.Hint="ملاحظات" Text="{Binding NewInvoice.Notes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}" TextWrapping="Wrap" AcceptsReturn="True" Height="60"/>
                    </StackPanel>

                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Command="{Binding CloseInvoiceFormCommand}" Content="إلغاء" Style="{StaticResource MaterialDesignFlatButton}" Margin="0,0,16,0"/>
                        <Button Command="{Binding SaveInvoiceCommand}" Content="حفظ الفاتورة" Style="{StaticResource MaterialDesignFlatMidBgButton}"/>
                    </StackPanel>
                </Grid>
            </materialDesign:Card>
        </Grid>

        <!-- نافذة الدفع (Overlay) -->
        <Grid Background="#80000000" Visibility="{Binding IsPaymentFormOpen, Converter={StaticResource BoolToVis}}" Panel.ZIndex="101">
            <materialDesign:Card Width="400" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24" UniformCornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="تسديد قيمة" FontSize="20" FontWeight="Bold"/>

                    <StackPanel Grid.Row="2">
                        <DatePicker materialDesign:HintAssist.Hint="تاريخ الدفع *" SelectedDate="{Binding PaymentDate}" Style="{StaticResource MaterialDesignOutlinedDatePicker}" Margin="0,0,0,16"/>
                        
                        <TextBox materialDesign:HintAssist.Hint="قيمة الدفعة *" Text="{Binding PaymentAmount, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,16"/>
                        
                        <TextBox materialDesign:HintAssist.Hint="رقم الإيصال" Text="{Binding ReceiptNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,16"/>
                        
                        <ComboBox materialDesign:HintAssist.Hint="طريقة الدفع *" SelectedValue="{Binding SelectedPaymentMethod}" SelectedValuePath="Content" Style="{StaticResource MaterialDesignOutlinedComboBox}" Margin="0,0,0,16">
                            <ComboBoxItem Content="نقدي"/>
                            <ComboBoxItem Content="تحويل"/>
                        </ComboBox>

                        <!-- تفاصيل التحويل (تظهر فقط عند اختيار تحويل) -->
                        <StackPanel Margin="0,0,0,16">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedPaymentMethod}" Value="تحويل">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <ComboBox materialDesign:HintAssist.Hint="اسم المصرف *" 
                                     ItemsSource="{Binding BankNames}" 
                                     SelectedItem="{Binding BankName, UpdateSourceTrigger=PropertyChanged}" 
                                     IsEditable="True"
                                     Style="{StaticResource MaterialDesignOutlinedComboBox}" 
                                     Margin="0,0,0,16"/>
                            <TextBox materialDesign:HintAssist.Hint="رقم التحويل اخر 4 ارقام *" Text="{Binding TransferLast4, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                        </StackPanel>

                        <TextBox materialDesign:HintAssist.Hint="بيان / وصف الدفعة" Text="{Binding PaymentDescription, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Command="{Binding ClosePaymentFormCommand}" Content="إلغاء" Style="{StaticResource MaterialDesignFlatButton}" Margin="0,0,16,0"/>
                        <Button Command="{Binding SavePaymentCommand}" Content="اعتماد الدفعة" Style="{StaticResource MaterialDesignFlatMidBgButton}"/>
                    </StackPanel>
                </Grid>
            </materialDesign:Card>
        </Grid>
        
        <!-- Loading Indicator -->
        <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}" 
                     IsIndeterminate="True" 
                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" 
                     Value="0" 
                     Width="48" Height="48" 
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     Panel.ZIndex="200"/>
    </Grid>
</UserControl>
