<UserControl x:Class="MeezanPOS.Presentation.Views.SupplierDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:MeezanPOS.Presentation.Converters"
             xmlns:behaviors="clr-namespace:MeezanPOS.Presentation.Behaviors"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1000"
             FlowDirection="RightToLeft"
             Background="White">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:BalanceToColorConverter x:Key="BalanceToColorConverter"/>
        <converters:InvoiceNotPaidConverter x:Key="InvoiceNotPaidConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- الترويسة -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Command="{Binding GoBackCommand}" Style="{StaticResource MaterialDesignIconButton}" ToolTip="رجوع للموردين">
                    <materialDesign:PackIcon Kind="ArrowRight" Width="24" Height="24"/>
                </Button>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0">
                    <materialDesign:PackIcon Kind="ClipboardTextClock" Width="32" Height="32" Foreground="{DynamicResource PrimaryHueMidBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding SupplierName, StringFormat='كشف حساب: {0}'}" FontSize="24" FontWeight="Bold" Margin="16,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalTransactionsCount, StringFormat='(إجمالي {0} حركة)'}" FontSize="16" Foreground="#64748b" Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                </StackPanel>

                <materialDesign:Card Grid.Column="2" Padding="16,8" UniformCornerRadius="8" Background="#f5f5f5">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="الرصيد الحالي (الدين): " FontSize="16" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CurrentBalance, StringFormat=N2}" 
                                   FontSize="20" FontWeight="Bold" 
                                   Foreground="{Binding CurrentBalance, Converter={StaticResource BalanceToColorConverter}}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </materialDesign:Card>
            </Grid>

            <!-- شريط الأزرار والفلترة (تم فصله ليبقى ثابتاً في الأعلى) -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="2" Margin="16,8,16,16">
                
                <!-- فلاتر التاريخ -->
                <DatePicker SelectedDate="{Binding FilterStartDate}" materialDesign:HintAssist.Hint="من تاريخ" Style="{StaticResource MaterialDesignFloatingHintDatePicker}" Margin="0,0,16,0" Width="120" VerticalAlignment="Bottom"/>
                <DatePicker SelectedDate="{Binding FilterEndDate}" materialDesign:HintAssist.Hint="إلى تاريخ" Style="{StaticResource MaterialDesignFloatingHintDatePicker}" Margin="0,0,16,0" Width="120" VerticalAlignment="Bottom"/>
                
                <Button Command="{Binding FilterStatementCommand}" Content="تصفية" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,0" VerticalAlignment="Bottom"/>
                <Button Command="{Binding ClearFilterCommand}" ToolTip="إلغاء التصفية" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,32,0" Foreground="#ef4444" BorderBrush="#ef4444" VerticalAlignment="Bottom">
                    <materialDesign:PackIcon Kind="FilterRemove" />
                </Button>

                <!-- أزرار الإجراءات -->
                <Button Command="{Binding PrintStatementCommand}" Content="طباعة كشف الحساب" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,16,0" VerticalAlignment="Bottom">
                    <Button.ContentTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Printer" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </Button.ContentTemplate>
                </Button>

                <Button Command="{Binding OpenPaymentFormCommand}" Content="تسديد قيمة" Style="{StaticResource MaterialDesignFlatMidBgButton}" Margin="0,0,16,0" VerticalAlignment="Bottom">
                    <Button.ContentTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CashMultiple" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </Button.ContentTemplate>
                </Button>

                <Button Command="{Binding OpenAddInvoiceFormCommand}" Content="إضافة فاتورة مشتريات" Style="{StaticResource MaterialDesignFlatMidBgButton}" VerticalAlignment="Bottom">
                    <Button.ContentTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ReceiptTextPlus" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </Button.ContentTemplate>
                </Button>
            </StackPanel>

            <!-- جدول كشف الحساب الموحد -->
            <DataGrid Grid.Row="3" Margin="0"
                      ItemsSource="{Binding UnifiedLedger}" 
                      AutoGenerateColumns="False" 
                      CanUserAddRows="False" 
                      IsReadOnly="True"
                      CanUserResizeColumns="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="All" BorderThickness="1" BorderBrush="#e5e7eb"
                      HorizontalGridLinesBrush="#e5e7eb" VerticalGridLinesBrush="#e5e7eb"
                      materialDesign:DataGridAssist.CellPadding="8"
                      materialDesign:DataGridAssist.ColumnHeaderPadding="8">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="التسلسل" Binding="{Binding Sequence}" Width="60"/>
                    <DataGridTextColumn Header="رصيد أول" Binding="{Binding OpeningBalance, StringFormat=N2}" Width="75"/>
                    
                    <DataGridTemplateColumn Header="قيمة الفاتورة" Width="85">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.EditInvoiceCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Foreground="#eab308"
                                        Padding="4,2" Height="Auto" Margin="0"
                                        ToolTip="تعديل الفاتورة"
                                        Visibility="{Binding HasInvoice, Converter={StaticResource BoolToVis}}"
                                        HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding InvoiceAmount, StringFormat=N2}" VerticalAlignment="Center" TextDecorations="Underline" FontWeight="Bold"/>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="تاريخ الفاتورة" Binding="{Binding InvoiceDate, StringFormat=yyyy-MM-dd}" Width="90"/>
                    <DataGridTextColumn Header="رقم الفاتورة" Binding="{Binding InvoiceNumber}" Width="80"/>
                    
                    <DataGridTemplateColumn Header="المبلغ المستلم" Width="95">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.EditPaymentCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Foreground="#22c55e"
                                        Padding="4,2" Height="Auto" Margin="0"
                                        ToolTip="تعديل الدفعة"
                                        Visibility="{Binding HasPayment, Converter={StaticResource BoolToVis}}"
                                        HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding PaymentAmount, StringFormat=N2}" VerticalAlignment="Center" FontWeight="Bold"/>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="تاريخ الدفع" Binding="{Binding PaymentDate, StringFormat=yyyy-MM-dd}" Width="90"/>
                    <DataGridTemplateColumn Header="طريقة الدفع" Width="105">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid HorizontalAlignment="Center">
                                    <!-- إذا كانت الدفعة من الوردية (اليومية) -->
                                    <Button Command="{Binding DataContext.ShowShiftDetailsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource MaterialDesignFlatButton}"
                                            Foreground="#1d4ed8"
                                            Padding="4,2" Height="Auto" Margin="0"
                                            ToolTip="عرض تفاصيل الوردية والكاشير"
                                            Visibility="{Binding IsDailyJournalPayment, Converter={StaticResource BoolToVis}}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="ClockOutline" Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding PaymentMethod}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- إذا كانت الدفعة تحويل مصرفي -->
                                    <Button Command="{Binding DataContext.ShowTransferDetailsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource MaterialDesignFlatButton}"
                                            Foreground="#6d28d9"
                                            Padding="4,2" Height="Auto" Margin="0"
                                            ToolTip="عرض تفاصيل التحويل المصرفي"
                                            Visibility="{Binding IsTransferPayment, Converter={StaticResource BoolToVis}}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="BankTransfer" Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding PaymentMethod}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- إذا كانت الدفعة نقدية عادية -->
                                    <TextBlock Text="{Binding PaymentMethod}" 
                                               VerticalAlignment="Center" 
                                               HorizontalAlignment="Center"
                                               FontWeight="SemiBold"
                                               Visibility="{Binding IsPlainPayment, Converter={StaticResource BoolToVis}}"/>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="رقم الايصال" Binding="{Binding ReceiptNumber}" Width="80"/>
                    
                    <DataGridTemplateColumn Header="المتبقي" Width="85">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding RemainingBalance, StringFormat=N2}" 
                                           FontWeight="Bold"
                                           Foreground="{Binding RemainingBalance, Converter={StaticResource BalanceToColorConverter}}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    
                    <DataGridTextColumn Header="ملاحظات" Binding="{Binding Notes}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextWrapping" Value="Wrap" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="Margin" Value="4" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- ملخص كشف الحساب -->
            <Grid Grid.Row="4" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <materialDesign:Card Grid.Column="0" Margin="4" Padding="12" Background="#f8fafc">
                    <StackPanel>
                        <TextBlock Text="رصيد أول" FontSize="12" Foreground="#64748b" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding TotalOpeningBalance, StringFormat=N2}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </materialDesign:Card>
                
                <materialDesign:Card Grid.Column="1" Margin="4" Padding="12" Background="#f8fafc">
                    <StackPanel>
                        <TextBlock Text="قيمة الفواتير" FontSize="12" Foreground="#64748b" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding TotalInvoicesSum, StringFormat=N2}" FontSize="18" FontWeight="Bold" Foreground="#eab308" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </materialDesign:Card>
                
                <materialDesign:Card Grid.Column="2" Margin="4" Padding="12" Background="#f8fafc">
                    <StackPanel>
                        <TextBlock Text="المبالغ المستلمة" FontSize="12" Foreground="#64748b" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding TotalPaymentsSum, StringFormat=N2}" FontSize="18" FontWeight="Bold" Foreground="#22c55e" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </materialDesign:Card>
                
                <materialDesign:Card Grid.Column="3" Margin="4" Padding="12" Background="#f8fafc">
                    <StackPanel>
                        <TextBlock Text="المتبقي" FontSize="12" Foreground="#64748b" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding CurrentBalance, StringFormat=N2}" FontSize="18" FontWeight="Bold" Foreground="{Binding CurrentBalance, Converter={StaticResource BalanceToColorConverter}}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </materialDesign:Card>
            </Grid>
        </Grid>

        <!-- نافذة إضافة فاتورة (Overlay) -->
        <Grid Background="#80000000" Visibility="{Binding IsInvoiceFormOpen, Converter={StaticResource BoolToVis}}" Panel.ZIndex="100">
            <materialDesign:Card Width="450" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24" UniformCornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="تسجيل فاتورة مشتريات" FontSize="20" FontWeight="Bold"/>

                    <StackPanel Grid.Row="2">
                        <DatePicker materialDesign:HintAssist.Hint="تاريخ الفاتورة" SelectedDate="{Binding NewInvoice.InvoiceDate}" Style="{StaticResource MaterialDesignOutlinedDatePicker}" Margin="0,0,0,16"/>
                        <TextBox materialDesign:HintAssist.Hint="رقم الفاتورة (الورقية)" Text="{Binding NewInvoice.InvoiceNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}" behaviors:EnterKeyBehavior.MoveFocusOnEnter="True" Margin="0,0,0,16"/>
                        
                        <!-- إجمالي الفاتورة + زر التفاصيل -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" materialDesign:HintAssist.Hint="إجمالي الفاتورة *" Text="{Binding NewInvoice.TotalAmount, UpdateSourceTrigger=LostFocus, TargetNullValue=''}" Style="{StaticResource MaterialDesignOutlinedTextBox}" behaviors:EnterKeyBehavior.EnterCommand="{Binding SaveInvoiceCommand}" Margin="0,0,8,0"/>
                            <Button Grid.Column="1" Command="{Binding OpenInvoiceDetailsCommand}" 
                                    Style="{StaticResource MaterialDesignOutlinedButton}" 
                                    Foreground="#3b82f6" BorderBrush="#3b82f6"
                                    Padding="12,8" VerticalAlignment="Stretch"
                                    ToolTip="إضافة تفاصيل الأصناف للتحقق من إجمالي الفاتورة">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FormatListBulleted" Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="التفاصيل" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- حالة المطابقة -->
                        <TextBlock Text="{Binding MatchingStatusText}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,0,0,8"
                                   Visibility="{Binding IsInvoiceDetailsOpen, Converter={StaticResource BoolToVis}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#eab308"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTotalMatching}" Value="True">
                                            <Setter Property="Foreground" Value="#22c55e"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBox materialDesign:HintAssist.Hint="ملاحظات" Text="{Binding NewInvoice.Notes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}" TextWrapping="Wrap" AcceptsReturn="True" Height="60"/>
                    </StackPanel>

                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Command="{Binding CloseInvoiceFormCommand}" Content="إلغاء" Style="{StaticResource MaterialDesignFlatButton}" Margin="0,0,16,0"/>
                        <Button Command="{Binding SaveInvoiceCommand}" Content="حفظ الفاتورة" Style="{StaticResource MaterialDesignFlatMidBgButton}"/>
                    </StackPanel>
                </Grid>
            </materialDesign:Card>
        </Grid>

        <!-- نافذة تفاصيل الأصناف (Overlay) -->
        <Grid Background="#80000000" Visibility="{Binding IsInvoiceDetailsOpen, Converter={StaticResource BoolToVis}}" Panel.ZIndex="150">
            <materialDesign:Card Width="700" MaxHeight="550" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24" UniformCornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- العنوان -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="تفاصيل أصناف الفاتورة" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Command="{Binding AddInvoiceItemCommand}" 
                                Style="{StaticResource MaterialDesignFlatMidBgButton}" 
                                Padding="8,4" Height="32">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Plus" Width="18" Height="18" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="إضافة صنف" VerticalAlignment="Center" FontSize="13"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- جدول الأصناف -->
                    <DataGrid Grid.Row="2" 
                              ItemsSource="{Binding InvoiceItems}" 
                              AutoGenerateColumns="False" 
                              CanUserAddRows="False" 
                              CanUserDeleteRows="False"
                              CanUserResizeColumns="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="All" 
                              BorderThickness="1" BorderBrush="#e5e7eb"
                              HorizontalGridLinesBrush="#e5e7eb" VerticalGridLinesBrush="#e5e7eb"
                              materialDesign:DataGridAssist.CellPadding="6"
                              materialDesign:DataGridAssist.ColumnHeaderPadding="6"
                              VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="تسلسل" Binding="{Binding Sequence}" Width="55" IsReadOnly="True"/>
                            <DataGridTextColumn Header="البيان" Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                            <DataGridTextColumn Header="الكمية" Binding="{Binding Quantity, UpdateSourceTrigger=LostFocus}" Width="75"/>
                            <DataGridTextColumn Header="سعر الوحدة" Binding="{Binding UnitPrice, UpdateSourceTrigger=LostFocus}" Width="90"/>
                            <DataGridTextColumn Header="القيمة" Binding="{Binding TotalValue, StringFormat=N2}" Width="90" IsReadOnly="True"/>
                            <DataGridTemplateColumn Header="" Width="45">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.RemoveInvoiceItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource MaterialDesignIconButton}"
                                                Foreground="#ef4444" Width="28" Height="28" Padding="0"
                                                ToolTip="حذف الصنف">
                                            <materialDesign:PackIcon Kind="Delete" Width="16" Height="16"/>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- ملخص الإجمالي والمطابقة -->
                    <Border Grid.Row="3" Background="#f8fafc" CornerRadius="6" Padding="16,12" Margin="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="إجمالي الأصناف: " FontSize="16" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding InvoiceItemsTotal, StringFormat=N2}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Foreground="#1e293b"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding MatchingStatusText}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#eab308"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTotalMatching}" Value="True">
                                                <Setter Property="Foreground" Value="#22c55e"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <!-- أزرار -->
                    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Command="{Binding CloseInvoiceDetailsCommand}" Content="تم" Style="{StaticResource MaterialDesignFlatMidBgButton}" Padding="24,6"/>
                    </StackPanel>
                </Grid>
            </materialDesign:Card>
        </Grid>

        <!-- نافذة الدفع (Overlay) -->
        <Grid Background="#80000000" Visibility="{Binding IsPaymentFormOpen, Converter={StaticResource BoolToVis}}" Panel.ZIndex="101">
            <materialDesign:Card Width="400" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24" UniformCornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="تسديد قيمة" FontSize="20" FontWeight="Bold"/>

                    <StackPanel Grid.Row="2">
                        <DatePicker materialDesign:HintAssist.Hint="تاريخ الدفع *" SelectedDate="{Binding PaymentDate}" Style="{StaticResource MaterialDesignOutlinedDatePicker}" Margin="0,0,0,16"/>
                        
                        <TextBox materialDesign:HintAssist.Hint="قيمة الدفعة *" Text="{Binding PaymentAmount, UpdateSourceTrigger=LostFocus, TargetNullValue=''}" Style="{StaticResource MaterialDesignOutlinedTextBox}" behaviors:EnterKeyBehavior.MoveFocusOnEnter="True" Margin="0,0,0,16"/>
                        
                        <TextBox materialDesign:HintAssist.Hint="رقم الإيصال" Text="{Binding ReceiptNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}" behaviors:EnterKeyBehavior.MoveFocusOnEnter="True" Margin="0,0,0,16"/>
                        
                        <ComboBox materialDesign:HintAssist.Hint="طريقة الدفع *" SelectedValue="{Binding SelectedPaymentMethod}" SelectedValuePath="Content" Style="{StaticResource MaterialDesignOutlinedComboBox}" Margin="0,0,0,16">
                            <ComboBoxItem Content="نقدي"/>
                            <ComboBoxItem Content="تحويل"/>
                            <ComboBoxItem Content="شخصي (شريك)"/>
                        </ComboBox>

                        <!-- تفاصيل التحويل (تظهر فقط عند اختيار تحويل بنكي) -->
                        <StackPanel Margin="0,0,0,16">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedPaymentMethod}" Value="تحويل">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <ComboBox materialDesign:HintAssist.Hint="اسم المصرف *" 
                                     ItemsSource="{Binding BankAccounts}" 
                                     SelectedItem="{Binding SelectedBankAccountForPayment}" 
                                     Style="{StaticResource MaterialDesignOutlinedComboBox}" 
                                     Margin="0,0,0,16">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <Run Text="{Binding FriendlyName, Mode=OneWay}" FontWeight="SemiBold"/>
                                            <Run Text=" - "/>
                                            <Run Text="{Binding BankName, Mode=OneWay}" FontSize="12" Foreground="#64748b"/>
                                            <Run Text=" (رصيد: "/>
                                            <Run Text="{Binding CurrentBalance, StringFormat=N2, Mode=OneWay}"/>
                                            <Run Text=")"/>
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBox materialDesign:HintAssist.Hint="رقم التحويل اخر 4 ارقام *" Text="{Binding TransferLast4, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}" behaviors:EnterKeyBehavior.MoveFocusOnEnter="True"/>
                        </StackPanel>

                        <!-- تفاصيل السداد الشخصي (تظهر فقط عند اختيار شخصي (شريك)) -->
                        <StackPanel Margin="0,0,0,16">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedPaymentMethod}" Value="شخصي (شريك)">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <ComboBox materialDesign:HintAssist.Hint="اسم الشريك الممول *" 
                                     ItemsSource="{Binding PartnerNames}" 
                                     Text="{Binding PartnerNameForPayment, UpdateSourceTrigger=PropertyChanged}" 
                                     IsEditable="True"
                                     Style="{StaticResource MaterialDesignOutlinedComboBox}"/>
                        </StackPanel>

                        <TextBox materialDesign:HintAssist.Hint="بيان / وصف الدفعة" Text="{Binding PaymentDescription, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}" behaviors:EnterKeyBehavior.EnterCommand="{Binding SavePaymentCommand}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Command="{Binding ClosePaymentFormCommand}" Content="إلغاء" Style="{StaticResource MaterialDesignFlatButton}" Margin="0,0,16,0"/>
                        <Button Command="{Binding SavePaymentCommand}" Content="اعتماد الدفعة" Style="{StaticResource MaterialDesignFlatMidBgButton}"/>
                    </StackPanel>
                </Grid>
            </materialDesign:Card>
        </Grid>

        <!-- نافذة خيارات طباعة كشف الحساب (Overlay) -->
        <Grid Background="#80000000" Visibility="{Binding IsPrintSelectionOpen, Converter={StaticResource BoolToVis}}" Panel.ZIndex="102">
            <materialDesign:Card Width="520" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28" UniformCornerRadius="16" Background="White">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- عنوان النافذة -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">
                        <materialDesign:PackIcon Kind="PrinterEye" Width="28" Height="28" Foreground="{DynamicResource PrimaryHueMidBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="خيارات طباعة كشف الحساب" FontSize="20" FontWeight="Bold" Foreground="#1e293b" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- رسالة توضيحية -->
                    <TextBlock Grid.Row="2" Text="يرجى اختيار نوع كشف الحساب الذي ترغب في طباعته وتصديره كملف PDF:" FontSize="13" Foreground="#64748b" HorizontalAlignment="Center" TextAlignment="Center"/>

                    <!-- خيارات البطاقات -->
                    <Grid Grid.Row="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- بطاقة كشف حساب عادي -->
                        <materialDesign:Card Grid.Row="0" Grid.Column="0" UniformCornerRadius="12" Padding="0" Background="#f8fafc" BorderThickness="1" BorderBrush="#e2e8f0">
                            <Button Command="{Binding PrintStandardStatementCommand}" Style="{StaticResource MaterialDesignFlatButton}" Height="150" Padding="0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                                <StackPanel Margin="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="FileDocumentOutline" Width="48" Height="48" Foreground="#0284c7" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                    <TextBlock Text="كشف حساب عادي" FontSize="16" FontWeight="Bold" Foreground="#0f172a" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                    <TextBlock Text="الحركات المالية العامة فقط" FontSize="11" Foreground="#64748b" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Button>
                        </materialDesign:Card>

                        <!-- بطاقة كشف حساب مفصل -->
                        <materialDesign:Card Grid.Row="0" Grid.Column="2" UniformCornerRadius="12" Padding="0" Background="#f8fafc" BorderThickness="1" BorderBrush="#e2e8f0">
                            <Button Command="{Binding PrintDetailedStatementCommand}" Style="{StaticResource MaterialDesignFlatButton}" Height="150" Padding="0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                                <StackPanel Margin="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="FileDocumentEditOutline" Width="48" Height="48" Foreground="#7c3aed" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                    <TextBlock Text="كشف حساب مفصل" FontSize="16" FontWeight="Bold" Foreground="#0f172a" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                    <TextBlock Text="كشف الحساب + تفاصيل جميع الفواتير" FontSize="11" Foreground="#64748b" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Button>
                        </materialDesign:Card>

                        <!-- زر الإلغاء -->
                        <Button Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" 
                                Command="{Binding ClosePrintSelectionCommand}" 
                                Content="إلغاء" 
                                Style="{StaticResource MaterialDesignOutlinedButton}" 
                                Foreground="#ef4444" BorderBrush="#ef4444" 
                                HorizontalAlignment="Stretch" Padding="0,8" Height="40"/>
                    </Grid>
                </Grid>
            </materialDesign:Card>
        </Grid>
        
        <!-- Loading Indicator -->
        <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}" 
                     IsIndeterminate="True" 
                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" 
                     Value="0" 
                     Width="48" Height="48" 
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     Panel.ZIndex="200"/>
    </Grid>
</UserControl>
