<UserControl x:Class="MeezanPOS.Presentation.Views.SupplierListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:MeezanPOS.Presentation.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1000"
             FlowDirection="RightToLeft"
             Background="White">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis"/>
        <converters:BalanceToColorConverter x:Key="BalanceToColorConverter"/>
    </UserControl.Resources>

    <Grid>
        <!-- المحتوى الرئيسي (القائمة) -->
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- الترويسة والبحث -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Grid.Column="0">
                    <materialDesign:PackIcon Kind="AccountTie" Width="32" Height="32" Foreground="{DynamicResource PrimaryHueMidBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="إدارة الموردين" FontSize="24" FontWeight="Bold" Margin="16,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Grid.Column="1">
                    <TextBox Width="300" 
                             materialDesign:HintAssist.Hint="بحث عن مورد..." 
                             materialDesign:TextFieldAssist.HasClearButton="True"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding LoadSuppliersCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                    
                    <Button Command="{Binding LoadSuppliersCommand}" Margin="8,0,0,0" Style="{StaticResource MaterialDesignIconButton}" ToolTip="بحث">
                        <materialDesign:PackIcon Kind="Magnify"/>
                    </Button>

                    <Button Command="{Binding OpenAddFormCommand}" Margin="16,0,0,0" Content="إضافة مورد" Style="{StaticResource MaterialDesignFlatMidBgButton}">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Plus" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- القائمة -->
            <Border Grid.Row="2" CornerRadius="16" Background="White" Padding="0" Margin="0,0,0,0"
                    BorderBrush="#E2E8F0" BorderThickness="1" ClipToBounds="True">
                <DataGrid ItemsSource="{Binding Suppliers}" 
                          SelectedItem="{Binding SelectedSupplier}"
                          AutoGenerateColumns="False" 
                          CanUserAddRows="False" 
                          IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#F1F5F9"
                          Background="White" RowBackground="White" AlternatingRowBackground="#F8FAFC"
                          FontSize="15" BorderThickness="0"
                          materialDesign:DataGridAssist.CellPadding="16,16"
                          materialDesign:DataGridAssist.ColumnHeaderPadding="16,14">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Foreground" Value="#475569"/>
                            <Setter Property="FontSize" Value="15"/>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="التسلسل" Binding="{Binding Sequence}" Width="100"/>
                        <DataGridTextColumn Header="اسم المورد" Binding="{Binding Name}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="#1E1B4B"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="رقم الهاتف" Binding="{Binding Phone}" Width="150"/>
                        
                        <!-- الرصيد الحالي -->
                        <DataGridTemplateColumn Header="الرصيد الحالي (الدين)" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding CurrentBalance, StringFormat=N2}" 
                                               FontWeight="ExtraBold"
                                               Foreground="{Binding CurrentBalance, Converter={StaticResource BalanceToColorConverter}}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        
                        <DataGridTextColumn Header="الرصيد الافتتاحي" Binding="{Binding OpeningBalance, StringFormat=N2}" Width="150"/>
                        
                        <!-- نشط -->
                        <DataGridTemplateColumn Header="نشط" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="12" Padding="8,4" HorizontalAlignment="Left">
                                        <CheckBox IsChecked="{Binding IsActive}" IsEnabled="False" Style="{StaticResource MaterialDesignCheckBox}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        
                        <DataGridTemplateColumn Header="إجراءات" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Command="{Binding DataContext.ViewSupplierDetailsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource MaterialDesignOutlinedButton}" 
                                                Foreground="#4F46E5" BorderBrush="#4F46E5"
                                                materialDesign:ButtonAssist.CornerRadius="8" Padding="12,4" Height="32" Margin="0,0,8,0"
                                                ToolTip="كشف الحساب والفواتير">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="ClipboardTextClock" Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="كشف" VerticalAlignment="Center" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding DataContext.OpenEditFormCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource MaterialDesignIconButton}" 
                                                Foreground="#F59E0B"
                                                ToolTip="تعديل">
                                            <materialDesign:PackIcon Kind="Pencil" Width="20" Height="20" />
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Loading Indicator -->
            <ProgressBar Grid.Row="2" Style="{StaticResource MaterialDesignCircularProgressBar}" 
                         IsIndeterminate="True" 
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" 
                         Value="0" 
                         Width="48" Height="48" 
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>

        <!-- نافذة إضافة/تعديل (Overlay) -->
        <Grid Background="#80000000" Visibility="{Binding IsFormOpen, Converter={StaticResource BoolToVis}}" Panel.ZIndex="100">
            <materialDesign:Card Width="500" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24" UniformCornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{Binding FormTitle}" FontSize="20" FontWeight="Bold"/>

                    <StackPanel Grid.Row="2">
                        <TextBox materialDesign:HintAssist.Hint="اسم المورد *" Text="{Binding FormSupplier.Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,16"/>
                        <TextBox materialDesign:HintAssist.Hint="رقم الهاتف" Text="{Binding FormSupplier.Phone, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,16"/>
                        
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBox Grid.Column="0" materialDesign:HintAssist.Hint="الرصيد الافتتاحي" Text="{Binding FormSupplier.OpeningBalance, UpdateSourceTrigger=LostFocus, TargetNullValue=''}">
                                <TextBox.Style>
                                    <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding FormSupplier.Id}" Value="0">
                                                <Setter Property="IsEnabled" Value="True"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                            
                            <TextBox Grid.Column="2" materialDesign:HintAssist.Hint="الحد الائتماني (اختياري)" Text="{Binding FormSupplier.CreditLimit, UpdateSourceTrigger=LostFocus, TargetNullValue=''}" Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                        </Grid>

                        <CheckBox Content="المورد نشط" IsChecked="{Binding FormSupplier.IsActive}" Margin="0,8,0,0"/>
                    </StackPanel>

                    <!-- أزرار الإجراءات -->
                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Command="{Binding CloseFormCommand}" Content="إلغاء" Style="{StaticResource MaterialDesignFlatButton}" Margin="0,0,16,0"/>
                        <Button Command="{Binding SaveSupplierCommand}" Content="حفظ البيانات" Style="{StaticResource MaterialDesignFlatMidBgButton}"/>
                    </StackPanel>
                </Grid>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
