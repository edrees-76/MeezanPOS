<Window x:Class="MeezanPOS.Presentation.Views.WorkerStatementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:MeezanPOS.Application.ViewModels"
        xmlns:enums="clr-namespace:MeezanPOS.Domain.Enums"
        xmlns:views="clr-namespace:MeezanPOS.Presentation.Views"
        Title="كشف حساب العامل"
        WindowState="Maximized"
        WindowStyle="None"
        Background="#f8f9ff"
        FlowDirection="RightToLeft">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <views:IncrementConverter x:Key="IncrementConverter"/>
    </Window.Resources>

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- 1. الهيدر -->
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>  <!-- 2. كروت الأرصدة -->
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>     <!-- 3. جدول كشف الحساب -->
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>  <!-- 4. لوحة العمليات المالية -->
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>  <!-- 5. الأزرار السفلية -->
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- 1. الهيدر -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#eff6ff" CornerRadius="8" Padding="10" Margin="0,0,16,0">
                    <materialDesign:PackIcon Kind="FileDocumentEditOutline" Foreground="#2563eb" Width="26" Height="26"/>
                </Border>
                <StackPanel>
                    <TextBlock FontSize="22" FontWeight="Bold" Foreground="#0b1c30">
                        <Run Text="كشف الحساب والمدفوعات للعمل: "/>
                        <Run Text="{Binding SelectedWorkerSummary.WorkerName}" Foreground="#2563eb"/>
                    </TextBlock>
                    <TextBlock Text="كشف حساب تفصيلي مالي يوضح جميع حركات الأستاذ المساعد، اليوميات، المدفوعات، والسلف المسجلة." FontSize="13" Foreground="#64748b" Margin="0,4,0,0"/>
                </StackPanel>
            </StackPanel>

            <Button Grid.Column="1" Style="{StaticResource MaterialDesignToolButton}" Width="36" Height="36" Padding="0" Click="Close_Click" Cursor="Hand" ToolTip="إغلاق">
                <materialDesign:PackIcon Kind="Close" Width="24" Height="24" Foreground="#64748b"/>
            </Button>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- 2. كروت الأرصدة -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- كرت إجمالي المستحقات (له) -->
            <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="20,16" BorderBrush="#e2e8f0" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.03"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <Border Background="#eff6ff" CornerRadius="8" Padding="12" Margin="0,0,16,0">
                        <materialDesign:PackIcon Kind="CashPlus" Foreground="#2563eb" Width="24" Height="24"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="إجمالي أجور العمل (له)" FontSize="12.5" Foreground="#64748b" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding SelectedWorkerTotalAccrued, StringFormat={}{0:N2} د.ل}" FontSize="18" FontWeight="Bold" Foreground="#2563eb" Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- كرت إجمالي السلف والمدفوعات (عليه) -->
            <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="20,16" BorderBrush="#e2e8f0" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.03"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <Border Background="#ecfdf5" CornerRadius="8" Padding="12" Margin="0,0,16,0">
                        <materialDesign:PackIcon Kind="CashMinus" Foreground="#10b981" Width="24" Height="24"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="سحوبات ومدفوعات وسلف (عليه)" FontSize="12.5" Foreground="#64748b" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding SelectedWorkerTotalPaid, StringFormat={}{0:N2} د.ل}" FontSize="18" FontWeight="Bold" Foreground="#10b981" Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- كرت الصافي المتبقي -->
            <Border Grid.Column="4" Background="White" CornerRadius="12" Padding="20,16" BorderBrush="#e2e8f0" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.03"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <Border Background="#fffbeb" CornerRadius="8" Padding="12" Margin="0,0,16,0">
                        <materialDesign:PackIcon Kind="CashMultiple" Foreground="#d97706" Width="24" Height="24"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="صافي المستحقات المتأخرة" FontSize="12.5" Foreground="#64748b" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding SelectedWorkerBalance, StringFormat={}{0:N2} د.ل}" FontSize="18" FontWeight="Bold" Foreground="#d97706" Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- 3. جدول كشف الحساب -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <Border Grid.Row="4" Background="White" CornerRadius="14" BorderBrush="#e2e8f0" BorderThickness="1" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- شريط البحث والتبويبات -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- مربع البحث -->
                    <Grid Grid.Column="0">
                        <TextBox Text="{Binding TimelineSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="ابحث في البيان أو الوصف..."
                                 materialDesign:TextFieldAssist.HasClearButton="True"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Padding="10,8" FontSize="13"/>
                        <materialDesign:PackIcon Kind="Search" Width="18" Height="18" Foreground="#94a3b8" 
                                                 HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0"/>
                    </Grid>

                    <!-- أزرار التصفية النوعية -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton Content="الكل" 
                                     Command="{Binding ChangeTimelineFilterCommand}" 
                                     CommandParameter="{x:Static enums:WorkerLedgerFilter.All}"
                                     IsChecked="True"
                                     Style="{StaticResource MaterialDesignTabRadioButton}" 
                                     Margin="0,0,10,0" FontSize="13"/>
                        <RadioButton Content="حضور عمال" 
                                     Command="{Binding ChangeTimelineFilterCommand}" 
                                     CommandParameter="{x:Static enums:WorkerLedgerFilter.WageAccrual}"
                                     Style="{StaticResource MaterialDesignTabRadioButton}" 
                                     Margin="0,0,10,0" FontSize="13"/>
                        <RadioButton Content="سداد نقدي" 
                                     Command="{Binding ChangeTimelineFilterCommand}" 
                                     CommandParameter="{x:Static enums:WorkerLedgerFilter.Payment}"
                                     Style="{StaticResource MaterialDesignTabRadioButton}" 
                                     Margin="0,0,10,0" FontSize="13"/>
                        <RadioButton Content="سلفة عمال" 
                                     Command="{Binding ChangeTimelineFilterCommand}" 
                                     CommandParameter="{x:Static enums:WorkerLedgerFilter.Advance}"
                                     Style="{StaticResource MaterialDesignTabRadioButton}" 
                                     Margin="0,0,10,0" FontSize="13"/>
                        <RadioButton Content="خصومات وغرامات" 
                                     Command="{Binding ChangeTimelineFilterCommand}" 
                                     CommandParameter="{x:Static enums:WorkerLedgerFilter.Deduction}"
                                     Style="{StaticResource MaterialDesignTabRadioButton}" 
                                     Margin="0,0,10,0" FontSize="13"/>
                        <RadioButton Content="تسويات يدوية" 
                                     Command="{Binding ChangeTimelineFilterCommand}" 
                                     CommandParameter="{x:Static enums:WorkerLedgerFilter.Adjustment}"
                                     Style="{StaticResource MaterialDesignTabRadioButton}" 
                                     FontSize="13"/>
                    </StackPanel>
                </Grid>

                <DataGrid Grid.Row="2"
                          ItemsSource="{Binding WorkerLedger}" 
                          AutoGenerateColumns="False" 
                          CanUserAddRows="False" 
                          IsReadOnly="True" 
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" 
                          BorderThickness="0" 
                          Background="Transparent"
                          RowHeight="54" 
                          FontSize="13"
                          AlternationCount="100000"
                          materialDesign:DataGridAssist.ColumnHeaderPadding="12,10"
                          materialDesign:DataGridAssist.CellPadding="12,6">
                    <DataGrid.Columns>
                        <!-- تسلسل -->
                        <DataGridTemplateColumn Header="م" Width="50">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=AlternationIndex, Converter={StaticResource IncrementConverter}}" 
                                               VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="#64748b"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- التاريخ -->
                        <DataGridTextColumn Header="التاريخ" Binding="{Binding Date, StringFormat={}{0:dd/MM/yyyy}}" Width="110">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- نوع الحركة كـ Badge ملون -->
                        <DataGridTemplateColumn Header="نوع الحركة" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="4" Padding="8,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Source}" Value="استحقاق حضور">
                                                        <Setter Property="Background" Value="#eff6ff"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Source}" Value="سداد نقدي">
                                                        <Setter Property="Background" Value="#ecfdf5"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Source}" Value="سلفة عمال">
                                                        <Setter Property="Background" Value="#fffbeb"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Source}" Value="خصم وغرامة">
                                                        <Setter Property="Background" Value="#fef2f2"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Source}" Value="تسوية يدوية">
                                                        <Setter Property="Background" Value="#f1f5f9"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Source}" FontSize="11" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Source}" Value="استحقاق حضور">
                                                            <Setter Property="Foreground" Value="#1d4ed8"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Source}" Value="سداد نقدي">
                                                            <Setter Property="Foreground" Value="#047857"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Source}" Value="سلفة عمال">
                                                            <Setter Property="Foreground" Value="#b45309"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Source}" Value="خصم وغرامة">
                                                            <Setter Property="Foreground" Value="#b91c1c"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Source}" Value="تسوية يدوية">
                                                            <Setter Property="Foreground" Value="#475569"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- البيان والوصف -->
                        <DataGridTemplateColumn Header="البيان والتفاصيل" Width="2.5*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Description}" FontSize="13" Foreground="#1e293b" FontWeight="Medium"/>
                                        <TextBlock Text="{Binding Notes}" FontSize="11" Foreground="#64748b" Margin="0,3,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="Text" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </Trigger>
                                                        <Trigger Property="Text" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- مستحق (له) (+) -->
                        <DataGridTemplateColumn Header="مستحق (له) (+)" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock FontWeight="SemiBold" Foreground="#2563eb" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding AccruedAmount, StringFormat={}{0:N2}}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding AccruedAmount}" Value="0">
                                                        <Setter Property="Text" Value=""/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- مدفوع (عليه) (-) -->
                        <DataGridTemplateColumn Header="مدفوع (عليه) (-)" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock FontWeight="SemiBold" Foreground="#10b981" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding PaidAmount, StringFormat={}{0:N2}}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PaidAmount}" Value="0">
                                                        <Setter Property="Text" Value=""/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- الرصيد التراكمي -->
                        <DataGridTemplateColumn Header="الرصيد التراكمي" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock FontWeight="Bold" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding BalanceAfter, StringFormat={}{0:N2}}"/>
                                                <Setter Property="Foreground" Value="#d97706"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding BalanceAfter}" Value="0">
                                                        <Setter Property="Foreground" Value="#10b981"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- إجراءات -->
                        <DataGridTemplateColumn Header="إجراءات" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.DeleteLedgerItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding CanDelete, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            Foreground="#ef4444" 
                                            Width="28" Height="28" Padding="0"
                                            Style="{StaticResource MaterialDesignToolButton}"
                                            ToolTip="حذف الحركة">
                                        <materialDesign:PackIcon Kind="DeleteOutline" Width="16" Height="16"/>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- 4. لوحة العمليات المالية والصرف المباشر للعمال -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <Border Grid.Row="6" Background="White" CornerRadius="12" BorderBrush="#e2e8f0" BorderThickness="1" Padding="16">
            <StackPanel>
                <TextBlock Text="إجراء عملية مالية مباشرة للحساب" FontSize="14" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,12"/>
                
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/> <!-- قيمة المبلغ -->
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="150"/> <!-- التاريخ المالي -->
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="200"/> <!-- صندوق الصرف -->
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>   <!-- ملاحظات -->
                    </Grid.ColumnDefinitions>

                    <!-- قيمة المعاملة -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="القيمة (د.ل):" FontSize="11" Foreground="#64748b" Margin="0,0,0,4" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding InputPaymentAmount, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 materialDesign:HintAssist.Hint="0.00"
                                 Padding="10,8" FontSize="12.5" FontWeight="Bold"/>
                    </StackPanel>

                    <!-- التاريخ المالي -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="التاريخ المالي:" FontSize="11" Foreground="#64748b" Margin="0,0,0,4" FontWeight="SemiBold"/>
                        <DatePicker SelectedDate="{Binding InputPaymentDate}"
                                    Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                    Padding="10,8" FontSize="12.5"/>
                    </StackPanel>

                    <!-- صندوق الدفع (سداد مستحقات فقط) -->
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="مصدر الصرف (للصندوق):" FontSize="11" Foreground="#64748b" Margin="0,0,0,4" FontWeight="SemiBold"/>
                        <ComboBox SelectedValue="{Binding SelectedPaymentSource, UpdateSourceTrigger=PropertyChanged}"
                                  SelectedValuePath="Tag"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                  Padding="10,8" FontSize="12.5">
                            <ComboBoxItem Content="كاشير (الوردية الجارية)" Tag="Cashier"/>
                            <ComboBoxItem Content="نقدية المطعم العامة" Tag="GeneralCash"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- البيان والملاحظات للعملية -->
                    <StackPanel Grid.Column="6">
                        <TextBlock Text="ملاحظات المعاملة:" FontSize="11" Foreground="#64748b" Margin="0,0,0,4" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding InputPaymentNotes, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 materialDesign:HintAssist.Hint="مثال: سداد ذمة يوميات سابقة"
                                 Padding="10,8" FontSize="12.5"/>
                    </StackPanel>
                </Grid>

                <!-- أزرار الصرف المالي -->
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0" HorizontalAlignment="Left">
                    <!-- زر دفع المستحقات وصرف الكاش -->
                    <Button Content="صرف سداد مستحقات (Cash Out) 💸" 
                            Command="{Binding ProcessWorkerPaymentCommand}" 
                            Style="{StaticResource MaterialDesignFlatButton}" 
                            Background="#10b981" Foreground="White" Height="36" Padding="14,0" Margin="0,0,8,0"/>

                    <!-- زر تسجيل سلفة ذمة -->
                    <Button Content="تسجيل سلفة ذمة ✍" 
                            Command="{Binding ProcessWorkerAdvanceCommand}" 
                            Style="{StaticResource MaterialDesignFlatButton}" 
                            Background="#f59e0b" Foreground="White" Height="36" Padding="14,0" Margin="0,0,8,0"/>

                    <!-- زر تسوية يدوية للرصيد -->
                    <Button Content="تسوية رصيد يدوية ⚙" 
                            Command="{Binding ProcessWorkerAdjustmentCommand}" 
                            Style="{StaticResource MaterialDesignFlatButton}" 
                            Background="#6b7280" Foreground="White" Height="36" Padding="14,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- 5. الأزرار السفلية -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Left">
            <!-- زر PDF -->
            <Button Command="{Binding ExportWorkerLedgerPdfCommand}" 
                    Style="{StaticResource MaterialDesignFlatMidBgButton}"
                    Background="#eff6ff" Foreground="#2563eb" Height="40" Padding="24,0"
                    materialDesign:ButtonAssist.CornerRadius="8" Margin="0,0,12,0">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="FilePdfBox" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="تصدير كشف الحساب (PDF) 📄" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13"/>
                </StackPanel>
            </Button>

            <!-- زر إغلاق -->
            <Button Click="Close_Click" Style="{StaticResource MaterialDesignFlatButton}"
                    Background="#f1f5f9" Foreground="#334155" Height="40" Padding="24,0"
                    materialDesign:ButtonAssist.CornerRadius="8">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Close" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="إغلاق الشاشة" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>
