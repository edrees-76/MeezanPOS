<Window x:Class="MeezanPOS.Presentation.Views.MainView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:MeezanPOS.Application.ViewModels"
        mc:Ignorable="d"
        Title="{Binding Title}" Height="800" Width="1200"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        FlowDirection="RightToLeft"
        Background="#f8f9ff"
        FontFamily="Segoe UI">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" /> <!-- Sidebar -->
            <ColumnDefinition Width="*" /> <!-- Main Content -->
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="#0b1c30" BorderBrush="#1Affffff" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Margin="16,30,16,20" Orientation="Horizontal">
                    <Border Width="65" Height="65" CornerRadius="32.5" Background="White" Margin="-5,0,0,0" ClipToBounds="True">
                        <Image Source="/Assets/Images/mizan_chef_scale-removebg-preview.png" Stretch="Uniform" Margin="4"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="ميزان للمطاعم" FontWeight="Bold" FontSize="18" Foreground="#ffe081"/>
                    </StackPanel>
                </StackPanel>

                <!-- Navigation List -->
                <ListBox Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="0,10,0,0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectedIndex="{Binding SelectedNavIndex}">
                    <ListBox.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#eaf1ff"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True">
                                    <Setter Property="Foreground" Value="#ffe081"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                        <Style TargetType="materialDesign:PackIcon">
                            <Setter Property="Foreground" Value="#eaf1ff"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True">
                                    <Setter Property="Foreground" Value="#ffe081"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="16,12"/>
                            <Setter Property="Margin" Value="0,2"/>
                            <Setter Property="Foreground" Value="#eaf1ff"/>
                            <Setter Property="Opacity" Value="0.7"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="0,20,20,0" Margin="0,0,16,0">
                                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#1Affffff" />
                                                <Setter Property="Opacity" Value="1"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#1Affe081" />
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#ffe081"/>
                                                <Setter TargetName="Bd" Property="BorderThickness" Value="4,0,0,0"/>
                                                <Setter Property="Foreground" Value="#ffe081"/>
                                                <Setter Property="Opacity" Value="1"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.Resources>

                    <!-- Items -->
                    <ListBoxItem materialDesign:ListBoxItemAssist.ShowSelection="False">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ViewDashboard" Width="24" Height="24" Margin="0,0,16,0"/>
                            <TextBlock Text="لوحة التحكم" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CashRegister" Width="24" Height="24" Margin="0,0,16,0"/>
                            <TextBlock Text="المبيعات والإيرادات" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>

                <StackPanel Grid.Row="2" Margin="0,0,0,40">

                    <Button Command="{Binding LogoutCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}" 
                            Foreground="#ffdad6" Margin="16,0" Padding="8" Height="45"
                            HorizontalContentAlignment="Left">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Logout" Width="20" Height="20" Margin="0,0,16,0" VerticalAlignment="Center"/>
                            <TextBlock Text="تسجيل الخروج" FontSize="15" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="80" /> <!-- TopNav -->
                <RowDefinition Height="*" /> <!-- Content -->
            </Grid.RowDefinitions>

            <!-- Top Navbar -->
            <Border Grid.Row="0" Background="White" BorderBrush="#e5eeff" BorderThickness="0,0,0,1">
                <Grid Margin="32,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="24" FontWeight="Bold" Foreground="#0b1c30" VerticalAlignment="Center"/>

                    <!-- Search -->
                    <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" 
                            Background="#eff4ff" CornerRadius="20" Width="300" Height="40" Padding="16,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Grid.Column="0" Kind="Magnify" Foreground="#76777d" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" 
                                     materialDesign:HintAssist.Hint="بحث..." 
                                     BorderThickness="0" Background="Transparent"/>
                        </Grid>
                    </Border>

                    <!-- Actions -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Quick Add Action -->
                        <Button Command="{Binding NavigateCommand}" CommandParameter="AddJournal" 
                                Background="#10b981" BorderThickness="0" Padding="12,4" Margin="0,0,16,0" materialDesign:ButtonAssist.CornerRadius="8">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Title}" Value="ميزان للمالية - عرض تفاصيل الحركة اليومية">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Plus" Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="تسجيل حركة يومية" Foreground="White" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource MaterialDesignIconButton}" Foreground="#76777d" Margin="0,0,8,0">
                            <materialDesign:PackIcon Kind="BellOutline" Width="24" Height="24"/>
                        </Button>
                        <Button Style="{StaticResource MaterialDesignIconButton}" Foreground="#76777d" Margin="0,0,16,0">
                            <materialDesign:PackIcon Kind="CogOutline" Width="24" Height="24"/>
                        </Button>

                        <Border Width="40" Height="40" CornerRadius="20" Background="#e5eeff" BorderBrush="#bec6e0" BorderThickness="2">
                            <materialDesign:PackIcon Kind="Account" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#0b1c30"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Dynamic Content -->
            <ContentControl Grid.Row="1" Margin="32" Content="{Binding CurrentViewModel}" />
        </Grid>
    </Grid>
</Window>
