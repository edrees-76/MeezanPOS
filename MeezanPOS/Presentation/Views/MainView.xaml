<Window x:Class="MeezanPOS.Presentation.Views.MainView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:MeezanPOS.Application.ViewModels"
        mc:Ignorable="d"
        Title="{Binding Title}" AutomationProperties.AutomationId="MainWindow" Height="800" Width="1200"
        MinWidth="1280" MinHeight="720"
        Icon="pack://application:,,,/MeezanPOS;component/Assets/Images/mizan_3d_icon_final_transparent.png"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        FlowDirection="RightToLeft"
        Background="{StaticResource Brush.Canvas}"
        FontFamily="{StaticResource Font.Body}">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <!-- التنقل بين الأقسام: Ctrl+1 .. Ctrl+0 (مفاتيح F محجوزة لإجراءات الشاشات مثل F5 حفظ و F9 ترحيل) -->
    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="D1" Command="{Binding NavigateCommand}" CommandParameter="Dashboard"/>
        <KeyBinding Modifiers="Control" Key="D2" Command="{Binding NavigateCommand}" CommandParameter="AddJournal"/>
        <KeyBinding Modifiers="Control" Key="D3" Command="{Binding NavigateCommand}" CommandParameter="Sales"/>
        <KeyBinding Modifiers="Control" Key="D4" Command="{Binding NavigateCommand}" CommandParameter="Suppliers"/>
        <KeyBinding Modifiers="Control" Key="D5" Command="{Binding NavigateCommand}" CommandParameter="Expenses"/>
        <KeyBinding Modifiers="Control" Key="D6" Command="{Binding NavigateCommand}" CommandParameter="Wages"/>
        <KeyBinding Modifiers="Control" Key="D7" Command="{Binding NavigateCommand}" CommandParameter="Banking"/>
        <KeyBinding Modifiers="Control" Key="D8" Command="{Binding NavigateCommand}" CommandParameter="FreeOrdersReturns"/>
        <KeyBinding Modifiers="Control" Key="D9" Command="{Binding NavigateCommand}" CommandParameter="ClosingAccount"/>
        <KeyBinding Modifiers="Control" Key="D0" Command="{Binding NavigateCommand}" CommandParameter="Settings"/>
    </Window.InputBindings>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <!-- عنصر في القائمة الجانبية: أيقونة + نص (الاختصار يظهر كتلميح) -->
        <Style x:Key="NavItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="14,11"/>
            <Setter Property="Margin" Value="12,2"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.SidebarText}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}"
                                BorderBrush="{StaticResource Brush.Accent}" BorderThickness="0">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.SidebarHover}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.SidebarActive}"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="3,0,0,0"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Font.BodyMedium}"/>
            <Setter Property="FontSize" Value="14.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
        </Style>
        <Style x:Key="NavIcon" TargetType="materialDesign:PackIcon">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== القائمة الجانبية ===== -->
        <Border Grid.Column="0" Width="264" Background="{StaticResource Brush.Sidebar}"
                Visibility="{Binding IsSidebarVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- الشعار واسم المنظومة -->
                <Border Grid.Row="0" Padding="20,22,20,18" BorderBrush="#1FFFFFFF" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="46" Height="46" CornerRadius="10" Background="White" Padding="3">
                            <Image Source="pack://application:,,,/MeezanPOS;component/Assets/Images/mizan_3d_icon_final_transparent.png" Stretch="Uniform"/>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="ميزان للمطاعم" FontFamily="{StaticResource Font.Heading}" FontWeight="Bold" FontSize="19" Foreground="White"/>
                            <TextBlock Text="إدارة المحاسبة والخزينة" FontSize="12" Foreground="{StaticResource Brush.SidebarText}" Margin="0,1,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- عناصر التنقل (الترتيب يطابق NavOrder في MainViewModel) -->
                <ListBox Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="0,14,0,0"
                         ItemContainerStyle="{StaticResource NavItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectedIndex="{Binding SelectedNavIndex}">
                    <ListBoxItem ToolTip="Ctrl+1" Visibility="{Binding NavVisible[0], Converter={StaticResource BooleanToVisibilityConverter}}">
                        <DockPanel>
                            <materialDesign:PackIcon Kind="ViewDashboardOutline" Style="{StaticResource NavIcon}"/>
                            <TextBlock Text="لوحة التحكم" Style="{StaticResource NavText}"/>
                        </DockPanel>
                    </ListBoxItem>
                    <ListBoxItem ToolTip="Ctrl+2" Visibility="{Binding NavVisible[1], Converter={StaticResource BooleanToVisibilityConverter}}">
                        <DockPanel>
                            <materialDesign:PackIcon Kind="CalendarEditOutline" Style="{StaticResource NavIcon}"/>
                            <TextBlock Text="تسجيل حركة يومية" Style="{StaticResource NavText}"/>
                        </DockPanel>
                    </ListBoxItem>
                    <ListBoxItem ToolTip="Ctrl+3" Visibility="{Binding NavVisible[2], Converter={StaticResource BooleanToVisibilityConverter}}">
                        <DockPanel>
                            <materialDesign:PackIcon Kind="CashRegister" Style="{StaticResource NavIcon}"/>
                            <TextBlock Text="المبيعات والإيرادات" Style="{StaticResource NavText}"/>
                        </DockPanel>
                    </ListBoxItem>
                    <ListBoxItem ToolTip="Ctrl+4" Visibility="{Binding NavVisible[3], Converter={StaticResource BooleanToVisibilityConverter}}">
                        <DockPanel>
                            <materialDesign:PackIcon Kind="TruckOutline" Style="{StaticResource NavIcon}"/>
                            <TextBlock Text="إدارة الموردين" Style="{StaticResource NavText}"/>
                        </DockPanel>
                    </ListBoxItem>
                    <ListBoxItem ToolTip="Ctrl+5" Visibility="{Binding NavVisible[4], Converter={StaticResource BooleanToVisibilityConverter}}">
                        <DockPanel>
                            <materialDesign:PackIcon Kind="ReceiptTextOutline" Style="{StaticResource NavIcon}"/>
                            <TextBlock Text="إدارة المصروفات" Style="{StaticResource NavText}"/>
                        </DockPanel>
                    </ListBoxItem>
                    <ListBoxItem ToolTip="Ctrl+6" Visibility="{Binding NavVisible[5], Converter={StaticResource BooleanToVisibilityConverter}}">
                        <DockPanel>
                            <materialDesign:PackIcon Kind="AccountGroupOutline" Style="{StaticResource NavIcon}"/>
                            <TextBlock Text="أجور ومستحقات العمال" Style="{StaticResource NavText}"/>
                        </DockPanel>
                    </ListBoxItem>
                    <ListBoxItem ToolTip="Ctrl+7" Visibility="{Binding NavVisible[6], Converter={StaticResource BooleanToVisibilityConverter}}">
                        <DockPanel>
                            <materialDesign:PackIcon Kind="Bank" Style="{StaticResource NavIcon}"/>
                            <TextBlock Text="الحسابات البنكية والخزينة" Style="{StaticResource NavText}"/>
                        </DockPanel>
                    </ListBoxItem>
                    <ListBoxItem ToolTip="Ctrl+8" Visibility="{Binding NavVisible[7], Converter={StaticResource BooleanToVisibilityConverter}}">
                        <DockPanel>
                            <materialDesign:PackIcon Kind="GiftOutline" Style="{StaticResource NavIcon}"/>
                            <TextBlock Text="الطلبات المجانية والمرتجعات" Style="{StaticResource NavText}"/>
                        </DockPanel>
                    </ListBoxItem>
                    <ListBoxItem ToolTip="Ctrl+9" Visibility="{Binding NavVisible[8], Converter={StaticResource BooleanToVisibilityConverter}}">
                        <DockPanel>
                            <materialDesign:PackIcon Kind="ChartBoxOutline" Style="{StaticResource NavIcon}"/>
                            <TextBlock Text="الحساب الختامي والتقارير" Style="{StaticResource NavText}"/>
                        </DockPanel>
                    </ListBoxItem>
                    <ListBoxItem ToolTip="Ctrl+0" Visibility="{Binding NavVisible[9], Converter={StaticResource BooleanToVisibilityConverter}}">
                        <DockPanel>
                            <materialDesign:PackIcon Kind="CogOutline" Style="{StaticResource NavIcon}"/>
                            <TextBlock Text="الإعدادات" Style="{StaticResource NavText}"/>
                        </DockPanel>
                    </ListBoxItem>
                    <ListBoxItem Visibility="{Binding NavVisible[10], Converter={StaticResource BooleanToVisibilityConverter}}">
                        <DockPanel>
                            <materialDesign:PackIcon Kind="AccountGroupOutline" Style="{StaticResource NavIcon}"/>
                            <TextBlock Text="المستخدمون والنشاط" Style="{StaticResource NavText}"/>
                        </DockPanel>
                    </ListBoxItem>
                </ListBox>

                <!-- بطاقة المستخدم وتسجيل الخروج -->
                <Border Grid.Row="2" Margin="12,8,12,16" Padding="12,10" CornerRadius="10" Background="#26000000">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Command="{Binding LogoutCommand}" ToolTip="تسجيل الخروج"
                                Style="{StaticResource MaterialDesignIconButton}" Width="36" Height="36" Foreground="{StaticResource Brush.ExpenseSoft}">
                            <materialDesign:PackIcon Kind="Logout" Width="20" Height="20"/>
                        </Button>
                        <Button DockPanel.Dock="Right" Command="{Binding ChangePasswordCommand}" ToolTip="تغيير كلمة المرور"
                                Style="{StaticResource MaterialDesignIconButton}" Width="36" Height="36" Foreground="{StaticResource Brush.SidebarText}">
                            <materialDesign:PackIcon Kind="KeyChange" Width="19" Height="19"/>
                        </Button>
                        <Border Width="38" Height="38" CornerRadius="19" Background="{StaticResource Brush.Accent}">
                            <TextBlock Text="{Binding CurrentUserInitial}" FontFamily="{StaticResource Font.Heading}" FontWeight="Bold" FontSize="16"
                                       Foreground="{StaticResource Brush.PrimaryDark}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentUserName}" FontFamily="{StaticResource Font.BodyMedium}" FontSize="14" Foreground="White" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding CurrentUserRole}" FontSize="12" Foreground="{StaticResource Brush.SidebarText}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ===== منطقة المحتوى ===== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- الشريط العلوي -->
            <Border Grid.Row="0" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1">
                <DockPanel Margin="20,0" LastChildFill="True">
                    <Button DockPanel.Dock="Left" Command="{Binding ToggleSidebarCommand}" ToolTip="إظهار / إخفاء القائمة"
                            Style="{StaticResource MaterialDesignIconButton}" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,0,8,0">
                        <materialDesign:PackIcon Kind="MenuOpen" Width="24" Height="24"/>
                    </Button>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource Chip}" Margin="0,0,12,0" Padding="12,5">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CalendarToday" Width="16" Height="16" Foreground="{StaticResource Brush.TextMuted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding TodayText}" FontFamily="{StaticResource Font.Money}" FontSize="13"
                                           Foreground="{StaticResource Brush.TextSecondary}" FlowDirection="LeftToRight" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Button x:Name="btnSettings" AutomationProperties.AutomationId="btnSettings" ToolTip="الإعدادات"
                                Command="{Binding NavigateCommand}" CommandParameter="Settings"
                                Style="{StaticResource MaterialDesignIconButton}" Foreground="{StaticResource Brush.TextMuted}">
                            <materialDesign:PackIcon Kind="CogOutline" Width="22" Height="22"/>
                        </Button>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="ميزان" Style="{StaticResource Text.Caption}" VerticalAlignment="Center"/>
                        <materialDesign:PackIcon Kind="ChevronLeft" Width="16" Height="16" Foreground="{StaticResource Brush.TextMuted}" VerticalAlignment="Center" Margin="4,0"/>
                        <TextBlock Text="{Binding PageTitle}" FontFamily="{StaticResource Font.Title}" FontWeight="Bold" FontSize="17"
                                   Foreground="{StaticResource Brush.TextPrimary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- محتوى الشاشة الحالية -->
            <ContentControl Grid.Row="1" Margin="24" Content="{Binding CurrentViewModel}" />
        </Grid>
    </Grid>
</Window>
