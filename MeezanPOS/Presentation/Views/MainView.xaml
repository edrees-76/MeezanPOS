<Window x:Class="MeezanPOS.Presentation.Views.MainView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:MeezanPOS.Application.ViewModels"
        mc:Ignorable="d"
        Title="{Binding Title}" Height="800" Width="1200"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        FlowDirection="RightToLeft"
        Background="#f8f9ff"
        FontFamily="Segoe UI">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" /> <!-- Sidebar -->
            <ColumnDefinition Width="*" /> <!-- Main Content -->
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Width="260" Visibility="{Binding IsSidebarVisible, Converter={StaticResource BooleanToVisibilityConverter}}" BorderBrush="#1Affffff" BorderThickness="0,0,1,0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Color="#0F172A" Offset="0"/> <!-- Slate 900 -->
                    <GradientStop Color="#172554" Offset="1"/> <!-- Blue 950 -->
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Margin="16,30,16,20" Orientation="Horizontal">
                    <Border Width="65" Height="65" CornerRadius="32.5" Background="White" Margin="-5,0,0,0" ClipToBounds="True">
                        <Image Source="/Assets/Images/mizan_chef_scale-removebg-preview.png" Stretch="Uniform" Margin="4"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="ميزان للمطاعم" FontWeight="Bold" FontSize="18" Foreground="#ffe081"/>
                    </StackPanel>
                </StackPanel>

                <!-- Navigation List -->
                <ListBox Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="0,10,0,0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectedIndex="{Binding SelectedNavIndex}">
                    <ListBox.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#cbd5e1"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True">
                                    <Setter Property="Foreground" Value="#fbbf24"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                        <Style TargetType="materialDesign:PackIcon">
                            <Setter Property="Foreground" Value="#cbd5e1"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True">
                                    <Setter Property="Foreground" Value="#fbbf24"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="16,14"/>
                            <Setter Property="Margin" Value="0,4"/>
                            <Setter Property="Foreground" Value="#cbd5e1"/>
                            <Setter Property="Opacity" Value="0.75"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="0,24,24,0" Margin="0,0,16,0">
                                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#1Affffff" />
                                                <Setter Property="Opacity" Value="1"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#1Afbbf24" />
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#fbbf24"/>
                                                <Setter TargetName="Bd" Property="BorderThickness" Value="4,0,0,0"/>
                                                <Setter Property="Foreground" Value="#fbbf24"/>
                                                <Setter Property="Opacity" Value="1"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.Resources>

                    <!-- Items -->
                    <ListBoxItem materialDesign:ListBoxItemAssist.ShowSelection="False">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ViewDashboard" Width="24" Height="24" Margin="0,0,16,0"/>
                            <TextBlock Text="لوحة التحكم" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CashRegister" Width="24" Height="24" Margin="0,0,16,0"/>
                            <TextBlock Text="المبيعات والإيرادات" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AccountTie" Width="24" Height="24" Margin="0,0,16,0"/>
                            <TextBlock Text="إدارة الموردين" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CashMultiple" Width="24" Height="24" Margin="0,0,16,0"/>
                            <TextBlock Text="إدارة المصروفات" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>

                <StackPanel Grid.Row="2" Margin="0,0,0,40">

                    <Button Command="{Binding LogoutCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}" 
                            Foreground="#ffdad6" Margin="16,0" Padding="8" Height="45"
                            HorizontalContentAlignment="Left">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Logout" Width="20" Height="20" Margin="0,0,16,0" VerticalAlignment="Center"/>
                            <TextBlock Text="تسجيل الخروج" FontSize="15" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="80" /> <!-- TopNav -->
                <RowDefinition Height="*" /> <!-- Content -->
            </Grid.RowDefinitions>

            <!-- Top Navbar -->
            <Border Grid.Row="0" Background="White" BorderBrush="#e5eeff" BorderThickness="0,0,0,1">
                <Grid Margin="32,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Command="{Binding ToggleSidebarCommand}" Style="{StaticResource MaterialDesignIconButton}" Foreground="#0b1c30" Margin="0,0,16,0" ToolTip="إظهار / إخفاء القائمة">
                        <materialDesign:PackIcon Kind="Menu" Width="28" Height="28"/>
                    </Button>

                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="24" FontWeight="Bold" Foreground="#0b1c30" VerticalAlignment="Center"/>

                    <!-- Search Removed -->

                    <!-- Actions -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Quick Add Action -->
                        <Button Command="{Binding NavigateCommand}" CommandParameter="AddJournal" 
                                Background="#10b981" BorderThickness="0" Padding="12,4" Margin="0,0,16,0" materialDesign:ButtonAssist.CornerRadius="8">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Title}" Value="ميزان للمالية - لوحة التحكم">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Plus" Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="تسجيل حركة يومية" Foreground="White" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Bell removed -->
                        <Button Style="{StaticResource MaterialDesignIconButton}" Foreground="#76777d" Margin="0,0,16,0">
                            <materialDesign:PackIcon Kind="CogOutline" Width="24" Height="24"/>
                        </Button>

                        <Border Width="40" Height="40" CornerRadius="20" Background="#e5eeff" BorderBrush="#bec6e0" BorderThickness="2">
                            <materialDesign:PackIcon Kind="Account" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#0b1c30"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Dynamic Content -->
            <ContentControl Grid.Row="1" Margin="32" Content="{Binding CurrentViewModel}" />
        </Grid>
    </Grid>
</Window>
