<Window x:Class="MeezanPOS.Presentation.Views.BankStatementReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:converters="clr-namespace:MeezanPOS.Presentation.Converters"
        Title="كشف حساب المصرف البنكي"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{StaticResource Brush.PrimarySoft}"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource Font.Body}"
        TextElement.FontFamily="{StaticResource Font.Body}">

    <Window.Resources>
        <converters:TransactionTypeToNameConverter x:Key="TransactionTypeToNameConverter" />
    </Window.Resources>

    <Grid Margin="24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- العنوان والأزرار -->
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>  <!-- كروت الملخص -->
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>     <!-- الجدول -->
        </Grid.RowDefinitions>

        <!-- ═══════ الشريط العلوي: العنوان + الأزرار ═══════ -->
        <Border Grid.Row="0" Background="White" CornerRadius="14" Padding="20,14" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Color="{StaticResource Color.TextFaint}" Opacity="0.1"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- العنوان -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FileDocumentOutline" Width="24" Height="24" Foreground="{StaticResource Brush.PrimaryInteractive}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="كشف حساب المصرف البنكي" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Brush.TextPrimary}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="34,4,0,0">
                        <TextBlock Text="{Binding StatementAccount.DisplayName, StringFormat='الحساب: {0}'}" FontSize="13" Foreground="{StaticResource Brush.TextMuted}" FontWeight="SemiBold"/>
                        <TextBlock Text="  |  " Foreground="{StaticResource Brush.BorderStrong}"/>
                        <TextBlock Text="{Binding StatementStartDate, StringFormat='من: {0:yyyy/MM/dd}'}" FontSize="13" Foreground="{StaticResource Brush.TextMuted}"/>
                        <TextBlock Text="  —  " Foreground="{StaticResource Brush.BorderStrong}"/>
                        <TextBlock Text="{Binding StatementEndDate, StringFormat='إلى: {0:yyyy/MM/dd}'}" FontSize="13" Foreground="{StaticResource Brush.TextMuted}"/>
                    </StackPanel>
                </StackPanel>

                <!-- الأزرار -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- زر تصدير PDF -->
                    <Button Command="{Binding PrintStatementCommand}" Style="{StaticResource MaterialDesignFlatButton}" Background="{StaticResource Brush.PrimaryInteractive}" Foreground="White" Height="40" Padding="20,0" Margin="0,0,10,0" materialDesign:ButtonAssist.CornerRadius="10">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FilePdfBox" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="تصدير PDF" VerticalAlignment="Center" FontWeight="Bold" FontSize="13"/>
                        </StackPanel>
                    </Button>

                    <!-- زر إغلاق -->
                    <Button Click="CloseButton_Click" Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="{StaticResource Brush.TextMuted}" BorderBrush="{StaticResource Brush.BorderStrong}" Height="40" Padding="20,0" materialDesign:ButtonAssist.CornerRadius="10">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Close" Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="إغلاق" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════ كروت الملخص المالي ═══════ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- الرصيد الافتتاحي -->
            <Border Grid.Column="0" CornerRadius="14" Padding="20,14" BorderThickness="1" BorderBrush="{StaticResource Brush.Border}">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{StaticResource Color.SurfaceAlt}" Offset="0"/>
                        <GradientStop Color="{StaticResource Color.LockedSoft}" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Color="{StaticResource Color.TextFaint}" Opacity="0.08"/>
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Border Background="{StaticResource Brush.LockedSoft}" CornerRadius="8" Width="30" Height="30" Margin="0,0,8,0">
                            <materialDesign:PackIcon Kind="WalletOutline" Foreground="{StaticResource Brush.TextMuted}" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="الرصيد الافتتاحي" FontSize="12" Foreground="{StaticResource Brush.TextMuted}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{Binding StatementOpeningBalance, StringFormat={}{0:N2} د.ل}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Brush.TextStrong}"/>
                </StackPanel>
            </Border>

            <!-- إجمالي الإيداعات -->
            <Border Grid.Column="2" CornerRadius="14" Padding="20,14" BorderThickness="1" BorderBrush="{StaticResource Brush.IncomeSoft}">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{StaticResource Color.IncomeSoft}" Offset="0"/>
                        <GradientStop Color="{StaticResource Color.IncomeSoft}" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Color="{StaticResource Color.Income}" Opacity="0.08"/>
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Border Background="{StaticResource Brush.IncomeSoft}" CornerRadius="8" Width="30" Height="30" Margin="0,0,8,0">
                            <materialDesign:PackIcon Kind="ArrowUpBold" Foreground="{StaticResource Brush.Income}" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="إجمالي الإيداعات (+)" FontSize="12" Foreground="{StaticResource Brush.IncomeText}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{Binding StatementTotalDeposits, StringFormat=+{0:N2} د.ل}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Brush.Income}"/>
                </StackPanel>
            </Border>

            <!-- إجمالي السحوبات -->
            <Border Grid.Column="4" CornerRadius="14" Padding="20,14" BorderThickness="1" BorderBrush="{StaticResource Brush.ExpenseSoft}">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{StaticResource Color.ExpenseSoft}" Offset="0"/>
                        <GradientStop Color="{StaticResource Color.ExpenseSoft}" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Color="{StaticResource Color.Expense}" Opacity="0.08"/>
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Border Background="{StaticResource Brush.ExpenseSoft}" CornerRadius="8" Width="30" Height="30" Margin="0,0,8,0">
                            <materialDesign:PackIcon Kind="ArrowDownBold" Foreground="{StaticResource Brush.Expense}" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="إجمالي السحوبات (-)" FontSize="12" Foreground="{StaticResource Brush.ExpenseText}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{Binding StatementTotalWithdrawals, StringFormat=-{0:N2} د.ل}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Brush.Expense}"/>
                </StackPanel>
            </Border>

            <!-- الرصيد النهائي -->
            <Border Grid.Column="6" CornerRadius="14" Padding="20,14" BorderThickness="1" BorderBrush="{StaticResource Brush.SidebarText}">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{StaticResource Color.PrimarySoft}" Offset="0"/>
                        <GradientStop Color="{StaticResource Color.PrimarySoft}" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Color="{StaticResource Color.PrimaryInteractive}" Opacity="0.12"/>
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Border Background="{StaticResource Brush.SidebarText}" CornerRadius="8" Width="30" Height="30" Margin="0,0,8,0">
                            <materialDesign:PackIcon Kind="ScaleBalance" Foreground="{StaticResource Brush.PrimaryInteractive}" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="صافي الرصيد النهائي" FontSize="12" Foreground="{StaticResource Brush.Primary}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{Binding StatementEndingBalance, StringFormat={}{0:N2} د.ل}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Brush.PrimaryInteractive}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══════ جدول الحركات الكامل ═══════ -->
        <Border Grid.Row="4" Background="White" CornerRadius="14" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" Padding="0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Color="{StaticResource Color.TextFaint}" Opacity="0.08"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- عنوان الجدول -->
                <Border Grid.Row="0" Background="{StaticResource Brush.SurfaceAlt}" CornerRadius="14,14,0,0" Padding="20,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FormatListBulleted" Width="20" Height="20" Foreground="{StaticResource Brush.PrimaryInteractive}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="سجل الحركات المصرفية التفصيلي" FontSize="15" FontWeight="Bold" Foreground="{StaticResource Brush.TextPrimary}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" FontSize="12" Foreground="{StaticResource Brush.TextFaint}" VerticalAlignment="Center">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="عدد الحركات: {0}">
                                    <Binding Path="StatementTransactions.Count"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- جدول البيانات -->
                <DataGrid CanUserSortColumns="False" Grid.Row="1" 
                          ItemsSource="{Binding StatementTransactions}" 
                          AutoGenerateColumns="False" 
                          CanUserAddRows="False" 
                          IsReadOnly="True" 
                          HeadersVisibility="Column" 
                          GridLinesVisibility="Horizontal" 
                          BorderThickness="0" 
                          Background="Transparent" 
                          RowHeight="44" 
                          FontSize="14"
                          AlternatingRowBackground="#F5F7FA"
                          materialDesign:DataGridAssist.ColumnHeaderPadding="12"
                          materialDesign:DataGridAssist.CellPadding="12,6"
                          VerticalScrollBarVisibility="Auto"
                          MouseDoubleClick="StatementDataGrid_MouseDoubleClick">
                    <!-- تغيير شكل المؤشر لحركات الحساب للإشارة لإمكانية النقر وعرض التفاصيل -->
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Type}" Value="CardSalesDeposit">
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="ToolTip" Value="انقر مرتين لعرض تفاصيل مبيعات الخدمات المصرفية للوردية"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Type}" Value="SupplierPayment">
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="ToolTip" Value="انقر مرتين لعرض تفاصيل حركة سداد المورد"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Type}" Value="ExpensePayment">
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="ToolTip" Value="انقر مرتين لعرض تفاصيل المصروف العام"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <!-- التسلسل -->
                        <DataGridTextColumn Header="م" Binding="{Binding SequenceNumber}" Width="Auto" MinWidth="50">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="{StaticResource Brush.TextFaint}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- التاريخ والوقت -->
                        <DataGridTextColumn Header="التاريخ والوقت" Binding="{Binding TransactionDate, StringFormat=yyyy/MM/dd HH:mm}" Width="Auto" MinWidth="160">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- نوع العملية -->
                        <DataGridTextColumn Header="نوع العملية" Binding="{Binding TransactionTypeDisplayName}" Width="Auto" MinWidth="130">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- الرقم المرجعي -->
                        <DataGridTextColumn Header="المرجع" Binding="{Binding ReferenceNumber}" Width="Auto" MinWidth="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource Brush.TextFaint}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- البيان والتفاصيل -->
                        <DataGridTextColumn Header="البيان والتفاصيل" Binding="{Binding DisplayNotes}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource Brush.TextStrong}"/>
                                    <Setter Property="TextWrapping" Value="NoWrap"/>
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- إيداع (+) -->
                        <DataGridTextColumn Header="إيداع (+)" Binding="{Binding Amount, StringFormat=N2}" Width="Auto" MinWidth="130">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource Brush.Income}"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="TextAlignment" Value="Center"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Type}" Value="Withdrawal">
                                            <Setter Property="Visibility" Value="Hidden"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Type}" Value="SupplierPayment">
                                            <Setter Property="Visibility" Value="Hidden"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Type}" Value="ExpensePayment">
                                            <Setter Property="Visibility" Value="Hidden"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Type}" Value="InternalTransfer">
                                            <Setter Property="Visibility" Value="Hidden"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Type}" Value="OwnerDebtSettlement">
                                            <Setter Property="Visibility" Value="Hidden"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Type}" Value="ExchangeDifference">
                                            <Setter Property="Visibility" Value="Hidden"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- سحب (-) -->
                        <DataGridTextColumn Header="سحب (-)" Binding="{Binding Amount, StringFormat=N2}" Width="Auto" MinWidth="130">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource Brush.Expense}"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="TextAlignment" Value="Center"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Type}" Value="Deposit">
                                            <Setter Property="Visibility" Value="Hidden"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Type}" Value="CardSalesDeposit">
                                            <Setter Property="Visibility" Value="Hidden"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- الرصيد التراكمي -->
                        <DataGridTextColumn Header="الرصيد التراكمي" Binding="{Binding BalanceAfter, StringFormat=N2}" Width="Auto" MinWidth="150">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource Brush.PrimaryInteractive}"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="TextAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</Window>
