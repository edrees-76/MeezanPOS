<UserControl x:Class="MeezanPOS.Presentation.Views.SalesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:MeezanPOS.Presentation.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1000"
             FlowDirection="RightToLeft"
             Background="White">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Summary Cards -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Total Sales -->
            <Border Grid.Column="0" Background="#f8faff" CornerRadius="12" Padding="20" BorderBrush="#e5eeff" BorderThickness="1">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <materialDesign:PackIcon Kind="CashRegister" Width="24" Height="24" Foreground="#3b82f6" Margin="0,0,8,0"/>
                        <TextBlock Text="إجمالي المبيعات" FontSize="16" Foreground="#606060" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{Binding TotalSalesPeriod, StringFormat=\{0:N2\} د.ل}" FontSize="28" FontWeight="Bold" Foreground="#0b1c30"/>
                </StackPanel>
            </Border>

            <!-- Total Cash Sales -->
            <Border Grid.Column="2" Background="#f0fdf4" CornerRadius="12" Padding="20" BorderBrush="#dcfce7" BorderThickness="1">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <materialDesign:PackIcon Kind="CashMultiple" Width="24" Height="24" Foreground="#10b981" Margin="0,0,8,0"/>
                        <TextBlock Text="إجمالي مبيعات نقدية" FontSize="16" Foreground="#606060" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{Binding TotalCashSalesPeriod, StringFormat=\{0:N2\} د.ل}" FontSize="28" FontWeight="Bold" Foreground="#0b1c30"/>
                </StackPanel>
            </Border>

            <!-- Total Banking Sales -->
            <Border Grid.Column="4" Background="#f3e8ff" CornerRadius="12" Padding="20" BorderBrush="#e9d5ff" BorderThickness="1">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <materialDesign:PackIcon Kind="CreditCard" Width="24" Height="24" Foreground="#a855f7" Margin="0,0,8,0"/>
                        <TextBlock Text="إجمالي مبيعات خدمات مصرفية" FontSize="16" Foreground="#606060" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{Binding TotalBankingSalesPeriod, StringFormat=\{0:N2\} د.ل}" FontSize="28" FontWeight="Bold" Foreground="#0b1c30"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Data Grid -->
        <Border Grid.Row="2" Background="White" CornerRadius="12" BorderBrush="#e5eeff" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header & Filters -->
                <Border Grid.Row="0" Background="#f8faff" CornerRadius="12,12,0,0" Padding="20,16" BorderBrush="#e5eeff" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="16"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="سجل الورديات" FontSize="18" FontWeight="SemiBold" Foreground="#0b1c30" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Style="{StaticResource MaterialDesignOutlinedButton}" Content="تحديث البيانات" Command="{Binding LoadDataCommand}" Height="32"/>
                        </Grid>

                        <!-- Filters -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="بحث باسم الكاشير..." Style="{StaticResource MaterialDesignOutlinedTextBox}" Height="50" VerticalContentAlignment="Center"/>
                            
                            <DatePicker Grid.Column="2" SelectedDate="{Binding FilterDate}" materialDesign:HintAssist.Hint="تصفية بالتاريخ..." Style="{StaticResource MaterialDesignOutlinedDatePicker}" Height="50" VerticalContentAlignment="Center"/>
                            
                            <ComboBox Grid.Column="4" ItemsSource="{Binding ShiftTypes}" SelectedItem="{Binding FilterShiftType}" materialDesign:HintAssist.Hint="نوع الوردية" Style="{StaticResource MaterialDesignOutlinedComboBox}" Height="50" VerticalContentAlignment="Center"/>
                            
                            <Button Grid.Column="6" Command="{Binding ApplyFiltersCommand}" Content="تطبيق الفلتر" Style="{StaticResource MaterialDesignRaisedButton}" Background="#10b981" BorderBrush="#10b981" Height="50"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Table -->
                <DataGrid Grid.Row="1" Margin="0" 
                          ItemsSource="{Binding Journals}" 
                          SelectedItem="{Binding SelectedJournal}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeColumns="False"
                          CanUserReorderColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          Background="Transparent"
                          BorderThickness="0"
                          RowHeight="50"
                          GridLinesVisibility="Horizontal"
                          HorizontalScrollBarVisibility="Auto"
                          HorizontalGridLinesBrush="#f0f0f0">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="التسلسل" Binding="{Binding Id}" Width="Auto"/>
                        <DataGridTextColumn Header="التاريخ" Binding="{Binding JournalDate, StringFormat=\{0:dd-MM-yyyy\}}" Width="Auto"/>
                        <DataGridTextColumn Header="الوردية" Binding="{Binding ShiftName}" Width="Auto"/>
                        <DataGridTextColumn Header="اسم الكاشير" Binding="{Binding EmployeeName}" Width="*" MinWidth="120"/>
                        <DataGridTextColumn Header="إجمالي&#x0a;المبيعات" Binding="{Binding TotalSales, StringFormat=\{0:N2\}}" Width="Auto" MinWidth="80"/>
                        <DataGridTextColumn Header="مبيعات&#x0a;نقدية" Binding="{Binding CashSales, StringFormat=\{0:N2\}}" Width="Auto" MinWidth="80"/>
                        <DataGridTextColumn Header="خدمات&#x0a;مصرفية" Binding="{Binding BankingTotal, StringFormat=\{0:N2\}}" Width="Auto" MinWidth="80"/>
                        <DataGridTextColumn Header="المرتجعات" Binding="{Binding ReturnsTotal, StringFormat=\{0:N2\}}" Width="Auto" MinWidth="80"/>
                        <DataGridTextColumn Header="الطلبات&#x0a;المجانية" Binding="{Binding FreeOrdersTotal, StringFormat=\{0:N2\}}" Width="Auto" MinWidth="80"/>
                        <DataGridTextColumn Header="المصاريف" Binding="{Binding TotalExpenses, StringFormat=\{0:N2\}}" Width="Auto" MinWidth="80"/>
                        <DataGridTemplateColumn Header="الفروقات" Width="Auto" MinWidth="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DifferenceText}" Foreground="{Binding DifferenceColor}" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="إجراءات" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Command="{Binding DataContext.ViewDetailsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                CommandParameter="{Binding}"
                                                ToolTip="عرض التفاصيل"
                                                Style="{StaticResource MaterialDesignToolButton}" 
                                                Height="32" Width="36" Padding="0" Cursor="Hand" Margin="0,0,4,0">
                                            <materialDesign:PackIcon Kind="Eye" Width="18" Height="18" Foreground="#3b82f6"/>
                                        </Button>
                                        <Button Command="{Binding DataContext.EditJournalCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                CommandParameter="{Binding}"
                                                ToolTip="تعديل الحركة"
                                                Style="{StaticResource MaterialDesignToolButton}" 
                                                Height="32" Width="36" Padding="0" Cursor="Hand">
                                            <materialDesign:PackIcon Kind="Pencil" Width="18" Height="18" Foreground="#10b981"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                
                <ProgressBar Grid.Row="1" IsIndeterminate="True" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" HorizontalAlignment="Center" VerticalAlignment="Center" Width="40" Height="40" Style="{StaticResource MaterialDesignCircularProgressBar}"/>
                
                <!-- PDF Export Button -->
                <Border Grid.Row="2" Background="#f8faff" CornerRadius="0,0,12,12" Padding="20,12" BorderBrush="#e5eeff" BorderThickness="0,1,0,0">
                    <Button Command="{Binding ExportPdfCommand}" 
                            HorizontalAlignment="Right"
                            Style="{StaticResource MaterialDesignOutlinedButton}" 
                            Background="White"
                            BorderBrush="#ef4444" Foreground="#ef4444" Height="40" Padding="16,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FilePdfBox" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="تصدير السجل كملف PDF" VerticalAlignment="Center" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
