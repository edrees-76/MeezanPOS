                                        Command="{Binding LoadCashMovementsCommand}" 



                                        Background="#10b981" BorderBrush="#10b981"



                                        Height="40" Cursor="Hand"/>



                            </StackPanel>



                        </Grid>



                    </Border>







                    <!-- Cash Movements DataGrid -->



                    <Grid Grid.Row="1">



                        <DataGrid Margin="0" 



                                  ItemsSource="{Binding CashMovements}" 



                                  AutoGenerateColumns="False"



                                  CanUserAddRows="False" 



                                  IsReadOnly="True"



                                  HeadersVisibility="Column"



                                  Background="Transparent"



                                  BorderThickness="0"



                                  RowHeight="50"



                                  GridLinesVisibility="Horizontal"



                                  HorizontalScrollBarVisibility="Auto"



                                  HorizontalGridLinesBrush="#f1f5f9">



                            <DataGrid.Columns>



                                <DataGridTextColumn Header="م" Binding="{Binding Sequence}" Width="Auto" MinWidth="40"/>



                                <DataGridTextColumn Header="التاريخ" Binding="{Binding TransactionDate, StringFormat=\{0:dd-MM-yyyy hh:mm tt\}}" Width="Auto" MinWidth="150"/>



                                <DataGridTextColumn Header="البيان" Binding="{Binding Notes}" Width="*" MinWidth="250"/>



                                <DataGridTemplateColumn Header="المبلغ" Width="Auto" MinWidth="120">



                                    <DataGridTemplateColumn.CellTemplate>



                                        <DataTemplate>



                                            <Button Command="{Binding DataContext.ViewCashMovementDetailsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"



                                                    CommandParameter="{Binding}"



                                                    Style="{StaticResource MaterialDesignFlatButton}"



                                                    Cursor="Hand" Padding="4,0" Height="Auto"



                                                    ToolTip="اضغط لعرض التفاصيل">



                                                <TextBlock Text="{Binding Amount, StringFormat=\{0:N2\} د.ل}" 



                                                           FontWeight="Bold" Foreground="#3b82f6" 



                                                           TextDecorations="Underline"/>



                                            </Button>



                                        </DataTemplate>



                                    </DataGridTemplateColumn.CellTemplate>



                                </DataGridTemplateColumn>



                                <DataGridTextColumn Header="الرصيد بعد الحركة" Binding="{Binding BalanceAfter, StringFormat=\{0:N2\} د.ل}" Width="Auto" MinWidth="130"/>



                            </DataGrid.Columns>



                        </DataGrid>



                    </Grid>



                </Grid>



            </Border>



        </Grid>









    <!-- Settle Owner Cash Dialog Overlay -->

    <Grid Panel.ZIndex="1000" Background="#900f172a" 

          Visibility="{Binding IsSettleOwnerCashDialogOpen, Converter={StaticResource BooleanToVisibilityConverter}}">

        <Border Background="White" CornerRadius="16" Width="480" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="28" BorderBrush="#cbd5e1" BorderThickness="1">

            <Border.Effect>

                <DropShadowEffect BlurRadius="30" ShadowDepth="4" Color="#0f172a" Opacity="0.25"/>

            </Border.Effect>

            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="20"/>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="20"/>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="20"/>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="24"/>

                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>



                <!-- Title -->

                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">

                    <materialDesign:PackIcon Kind="ScaleBalance" Width="26" Height="26" Foreground="#6366f1" Margin="0,0,10,0" VerticalAlignment="Center"/>

                    <TextBlock Text="تسوية كاش المالك وإغلاق الفترة" FontSize="18" FontWeight="Bold" Foreground="#0f172a" VerticalAlignment="Center"/>

                </StackPanel>



                <!-- Current Balance Info Box -->

                <Border Grid.Row="2" Background="#f8fafc" CornerRadius="12" Padding="16" BorderBrush="#e2e8f0" BorderThickness="1">

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="Auto"/>

                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">

                            <TextBlock Text="الرصيد النقدي الحالي بالصندوق" FontSize="12" Foreground="#64748b" Margin="0,0,0,4"/>

                            <TextBlock Text="{Binding CurrentCashBalance, StringFormat=\{0:N2\} د.ل}" FontSize="22" FontWeight="Bold" Foreground="#1e293b"/>

                        </StackPanel>

                        <materialDesign:PackIcon Grid.Column="1" Kind="Safe" Width="38" Height="38" Foreground="#94a3b8" VerticalAlignment="Center"/>

                    </Grid>

                </Border>



                <!-- Inputs & Calculations -->

                <StackPanel Grid.Row="4">

                    <!-- Payout Input -->

                    <TextBlock Text="المبلغ المراد تسليمه للمالك كاش (د.ل)" FontSize="13" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,8"/>

                    <TextBox Text="{Binding SettlePayoutInput, UpdateSourceTrigger=PropertyChanged}" 

                             FontSize="16" FontWeight="Bold" Padding="12,10" Margin="0,0,0,16"

                             Background="#f8fafc" BorderBrush="#cbd5e1" BorderThickness="1.5"

                             materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"

                             materialDesign:TextFieldAssist.TextBoxViewMargin="0"

                             Style="{StaticResource MaterialDesignTextBox}"/>



                    <!-- Keep Amount (ReadOnly Calculation) -->

                    <Border Background="#f0fdf4" BorderBrush="#bbf7d0" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,16">

                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="Auto"/>

                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">

                                <TextBlock Text="السيولة التشغيلية المتبقية بالصندوق" FontSize="11" Foreground="#166534" Margin="0,0,0,2"/>

                                <TextBlock Text="{Binding SettleKeepCalculation, StringFormat=\{0:N2\} د.ل}" FontSize="16" FontWeight="Bold" Foreground="#15803d"/>

                            </StackPanel>

                            <materialDesign:PackIcon Grid.Column="1" Kind="TrendingUp" Width="24" Height="24" Foreground="#15803d" VerticalAlignment="Center"/>

                        </Grid>

                    </Border>



                    <!-- Notes Input -->

                    <TextBlock Text="ملاحظات والتفاصيل" FontSize="13" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,8"/>

                    <TextBox Text="{Binding SettleNotesInput, UpdateSourceTrigger=PropertyChanged}" 

                             FontSize="14" Padding="12,10" Height="70" TextWrapping="Wrap" AcceptsReturn="True"

                             Background="#f8fafc" BorderBrush="#cbd5e1" BorderThickness="1.5"

                             materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"

                             materialDesign:TextFieldAssist.TextBoxViewMargin="0"

                             Style="{StaticResource MaterialDesignTextBox}"/>

                </StackPanel>



                <!-- Warning Alert -->

                <Border Grid.Row="6" Background="#fffbeb" BorderBrush="#fef3c7" BorderThickness="1" CornerRadius="8" Padding="12">

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="Auto"/>

                            <ColumnDefinition Width="*"/>

                        </Grid.ColumnDefinitions>

                        <materialDesign:PackIcon Grid.Column="0" Kind="AlertCircle" Width="20" Height="20" Foreground="#d97706" Margin="0,0,10,0" VerticalAlignment="Top"/>

                        <TextBlock Grid.Column="1" Text="تنبيه: سيتم ترحيل وتأكيد كافة اليوميات والمصاريف اليومية وتجميدها نهائياً لمنع أي تعديل لاحق." 

                                   FontSize="11.5" Foreground="#b45309" TextWrapping="Wrap" LineHeight="16"/>

                    </Grid>

                </Border>



                <!-- Buttons -->

                <Grid Grid.Row="8">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="12"/>

                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="تأكيد وإقفال" Command="{Binding ConfirmSettleOwnerCashCommand}" 

                            Background="#6366f1" BorderBrush="#6366f1" Foreground="White" Height="42" Cursor="Hand" FontWeight="Bold"/>

                    <Button Grid.Column="2" Content="إلغاء" Command="{Binding CloseSettleOwnerCashDialogCommand}" 

                            Style="{StaticResource MaterialDesignOutlinedButton}" BorderBrush="#94a3b8" Foreground="#64748b" Height="42" Cursor="Hand" FontWeight="Bold"/>

                </Grid>

            </Grid>

        </Border>

    </Grid>



    <!-- Settlement Archive Dialog Overlay -->

    <Grid Panel.ZIndex="1000" Background="#900f172a" 

          Visibility="{Binding IsSettlementArchiveDialogOpen, Converter={StaticResource BooleanToVisibilityConverter}}">

        <Border Background="White" CornerRadius="16" Width="900" MaxHeight="650" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24" BorderBrush="#cbd5e1" BorderThickness="1">

            <Border.Effect>

                <DropShadowEffect BlurRadius="30" ShadowDepth="4" Color="#0f172a" Opacity="0.25"/>

            </Border.Effect>

            <Grid>

                <Grid.RowDefinitions>

                    <!-- 0: Header with Close Button -->

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="16"/>

                    <!-- 1: History DataGrid -->

                    <RowDefinition Height="*"/>

                    <RowDefinition Height="16"/>

                    <!-- 2: Footer / Close Button -->

                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>



                <!-- Header -->

                <Grid Grid.Row="0">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="Auto"/>

                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Grid.Column="0">

                        <materialDesign:PackIcon Kind="History" Width="26" Height="26" Foreground="#6366f1" Margin="0,0,10,0" VerticalAlignment="Center"/>

                        <TextBlock Text="أرشيف تسويات كاش المالك السابقة" FontSize="18" FontWeight="Bold" Foreground="#0f172a" VerticalAlignment="Center"/>

                    </StackPanel>

                    <Button Grid.Column="1" Command="{Binding CloseSettlementArchiveCommand}" Style="{StaticResource MaterialDesignToolButton}" Width="36" Height="36" Padding="0" Cursor="Hand" ToolTip="إغلاق">

                        <materialDesign:PackIcon Kind="Close" Width="24" Height="24" Foreground="#64748b"/>

                    </Button>

                </Grid>



                <!-- History DataGrid -->

                <Grid Grid.Row="2">

                    <DataGrid Margin="0" 

                              ItemsSource="{Binding SettlementHistory}" 

                              AutoGenerateColumns="False"

                              CanUserAddRows="False" 

                              IsReadOnly="True"

                              HeadersVisibility="Column"

                              Background="Transparent"

                              BorderThickness="0"

                              RowHeight="50"

                              MaxHeight="450"

                              GridLinesVisibility="Horizontal"

                              HorizontalScrollBarVisibility="Auto"

                              VerticalScrollBarVisibility="Auto"

                              HorizontalGridLinesBrush="#f1f5f9">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="جلسة التسوية" Binding="{Binding ShortSessionGuid}" Width="Auto" MinWidth="80"/>

                            <DataGridTextColumn Header="التاريخ والوقت" Binding="{Binding SettleDate, StringFormat=\{0:dd-MM-yyyy hh:mm tt\}}" Width="Auto" MinWidth="140"/>

                            <DataGridTextColumn Header="بواسطة" Binding="{Binding CreatedBy}" Width="Auto" MinWidth="90"/>

                            <DataGridTextColumn Header="الرصيد الكلي للفترة" Binding="{Binding BalanceBefore, StringFormat=\{0:N2\} د.ل}" Width="Auto" MinWidth="130"/>

                            <DataGridTextColumn Header="المسلم للمالك" Binding="{Binding PayoutAmount, StringFormat=\{0:N2\} د.ل}" Width="Auto" MinWidth="110"/>

                            <DataGridTextColumn Header="السيولة المتبقية" Binding="{Binding KeepAmount, StringFormat=\{0:N2\} د.ل}" Width="Auto" MinWidth="110"/>

                            <DataGridTextColumn Header="البيان والملاحظات" Binding="{Binding Notes}" Width="*" MinWidth="180"/>

                            <DataGridTextColumn Header="حالة الفترة" Binding="{Binding StatusText}" Width="Auto" MinWidth="120"/>
                            <DataGridTemplateColumn Header="إجراءات" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <!-- PDF Receipt -->
                                            <Button Command="{Binding DataContext.RegenerateSettlementPdfCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource MaterialDesignToolButton}"
                                                    Height="36" Width="36" Padding="0" Cursor="Hand"
                                                    ToolTip="تنزيل وعرض إيصال PDF">
                                                <materialDesign:PackIcon Kind="FilePdfBox" Width="22" Height="22" Foreground="#ef4444"/>
                                            </Button>
                                            <!-- Unlock Period -->
                                            <Button Command="{Binding DataContext.UnlockPeriodCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource MaterialDesignToolButton}"
                                                    Height="36" Width="36" Padding="0" Cursor="Hand"
                                                    ToolTip="إلغاء قفل الفترة للمراجعة">
                                                <materialDesign:PackIcon Kind="LockOpenOutline" Width="22" Height="22" Foreground="#f97316"/>
                                            </Button>
                                            <!-- Unpost Period -->
                                            <Button Command="{Binding DataContext.UnpostPeriodCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource MaterialDesignToolButton}"
                                                    Height="36" Width="36" Padding="0" Cursor="Hand"
                                                    ToolTip="فك ترحيل الفترة بالكامل وعكس الحركات النقدية">
                                                <materialDesign:PackIcon Kind="LockOpenVariantOutline" Width="22" Height="22" Foreground="#dc2626"/>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>

                    </DataGrid>

                </Grid>



                <!-- Footer Buttons -->

                <Grid Grid.Row="4">

                    <Button HorizontalAlignment="Right" Content="إغلاق الأرشيف" Command="{Binding CloseSettlementArchiveCommand}" 

                            Style="{StaticResource MaterialDesignOutlinedButton}" BorderBrush="#94a3b8" Foreground="#64748b" Height="40" Padding="20,0" Cursor="Hand" FontWeight="Bold"/>

                </Grid>

            </Grid>

        </Border>

    </Grid>



    </Grid>



</UserControl>



