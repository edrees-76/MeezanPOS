                                                    <!-- 3. Metrics: Profit -->



                                                    <ColumnDefinition Width="180"/>



                                                    <!-- 4. Days Count -->



                                                    <ColumnDefinition Width="130"/>



                                                    <!-- Spacer -->



                                                    <ColumnDefinition Width="*"/>



