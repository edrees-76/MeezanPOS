<UserControl x:Class="MeezanPOS.Presentation.Views.SalesView"



             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"



             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"



             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 



             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 



             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"



             xmlns:local="clr-namespace:MeezanPOS.Presentation.Views"
             xmlns:converters="clr-namespace:MeezanPOS.Presentation.Converters"



             mc:Ignorable="d" 



             d:DesignHeight="800" d:DesignWidth="1100"



             FlowDirection="RightToLeft"



             Background="{StaticResource Brush.SurfaceAlt}"



             SnapsToDevicePixels="True"



             UseLayoutRounding="True">







    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SalesViewResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>







    <Grid Margin="24">



        <Grid.RowDefinitions>



            <!-- 0: Sleek Top Header / Navigation Tabs -->



            <RowDefinition Height="Auto"/>



            <RowDefinition Height="20"/>



            <!-- 1: Summary Stats Cards (Sales, Cash, Banking) -->



            <RowDefinition Height="Auto"/>



            <RowDefinition Height="20"/>



            <!-- 2: Primary Content Area (Switchable based on Tab) -->



            <RowDefinition Height="*"/>



        </Grid.RowDefinitions>







        <!-- ==================== ROW 0: SLEEK TOP HEADER & TABS ==================== -->



        <Grid Grid.Row="0">



            <Grid.ColumnDefinitions>



                <ColumnDefinition Width="*"/>



                <ColumnDefinition Width="Auto"/>



            </Grid.ColumnDefinitions>







            <!-- Screen Title -->



            <StackPanel Grid.Column="0" VerticalAlignment="Center">



                <TextBlock Text="المبيعات والإيرادات اليومية" FontSize="24" FontWeight="Bold" Foreground="{StaticResource Brush.TextPrimary}"/>



                <TextBlock Text="متابعة الحركات المالية، المصاريف اليومية، وإقفال الورديات والشهور" FontSize="13" Foreground="{StaticResource Brush.TextMuted}" Margin="0,4,0,0"/>



            </StackPanel>







            <!-- Gorgeous Segmented Control for Navigation -->



            <Border Grid.Column="1" Background="{StaticResource Brush.Border}" CornerRadius="22" Padding="4" VerticalAlignment="Center">



                <StackPanel Orientation="Horizontal">



                    



                    <!-- Tab 0: Active Work -->



                    <Button Command="{Binding SetTabCommand}" CommandParameter="0">



                        <Button.Style>



                            <Style TargetType="Button" BasedOn="{StaticResource SleekTabButtonStyle}">



                                <Style.Triggers>



                                    <DataTrigger Binding="{Binding SelectedTab}" Value="0">



                                        <Setter Property="Background" Value="White"/>



                                        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>



                                        <Setter Property="Effect">



                                            <Setter.Value>



                                                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Color="{StaticResource Color.BorderStrong}" Opacity="0.5"/>



                                            </Setter.Value>



                                        </Setter>



                                    </DataTrigger>



                                </Style.Triggers>



                            </Style>



                        </Button.Style>



                        <Button.Resources>



                            <Style TargetType="Border">



                                <Setter Property="CornerRadius" Value="18"/>



                            </Style>



                        </Button.Resources>



                        <StackPanel Orientation="Horizontal">



                            <materialDesign:PackIcon Kind="CashRegister" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"/>



                            <TextBlock Text="العمل الحالي (الورديات المفتوحة)" VerticalAlignment="Center"/>



                        </StackPanel>



                    </Button>







                    <!-- Tab 1: Archive -->



                    <Button Command="{Binding SetTabCommand}" CommandParameter="1">



                        <Button.Style>



                            <Style TargetType="Button" BasedOn="{StaticResource SleekTabButtonStyle}">



                                <Style.Triggers>



                                    <DataTrigger Binding="{Binding SelectedTab}" Value="1">



                                        <Setter Property="Background" Value="White"/>



                                        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>



                                        <Setter Property="Effect">



                                            <Setter.Value>



                                                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Color="{StaticResource Color.BorderStrong}" Opacity="0.5"/>



                                            </Setter.Value>



                                        </Setter>



                                    </DataTrigger>



                                </Style.Triggers>



                            </Style>



                        </Button.Style>



                        <Button.Resources>



                            <Style TargetType="Border">



                                <Setter Property="CornerRadius" Value="18"/>



                            </Style>



                        </Button.Resources>



                        <StackPanel Orientation="Horizontal">



                            <materialDesign:PackIcon Kind="ArchiveOutline" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"/>



                            <TextBlock Text="أرشيف الأشهر المرحّلة" VerticalAlignment="Center"/>



                        </StackPanel>



                    </Button>







                    <!-- Tab 2: Current Cash -->



                    <Button Command="{Binding SetTabCommand}" CommandParameter="2">



                        <Button.Style>



                            <Style TargetType="Button" BasedOn="{StaticResource SleekTabButtonStyle}">



                                <Style.Triggers>



                                    <DataTrigger Binding="{Binding SelectedTab}" Value="2">



                                        <Setter Property="Background" Value="White"/>



                                        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>



                                        <Setter Property="Effect">



                                            <Setter.Value>



                                                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Color="{StaticResource Color.BorderStrong}" Opacity="0.5"/>



                                            </Setter.Value>



                                        </Setter>



                                    </DataTrigger>



                                </Style.Triggers>



                            </Style>



                        </Button.Style>



                        <Button.Resources>



                            <Style TargetType="Border">



                                <Setter Property="CornerRadius" Value="18"/>



                            </Style>



                        </Button.Resources>



                        <StackPanel Orientation="Horizontal">



                            <materialDesign:PackIcon Kind="CashMultiple" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"/>



                            <TextBlock Text="الكاش الحالي" VerticalAlignment="Center"/>



                        </StackPanel>



                    </Button>



                </StackPanel>



            </Border>



        </Grid>







        <!-- ==================== ROW 2: SUMMARY CARDS ==================== -->



        <!-- These cards reflect totals for the active tab list -->



        <Grid Grid.Row="2">



            <Grid.Style>



                <Style TargetType="Grid">



                    <Setter Property="Visibility" Value="Collapsed"/>



                    <Style.Triggers>



                        <!-- Only visible when on Active Work (Tab 0) OR on Archive (Tab 1) Day Level -->



                        <DataTrigger Binding="{Binding SelectedTab}" Value="0">



                            <Setter Property="Visibility" Value="Visible"/>



                        </DataTrigger>



                        <MultiDataTrigger>



                            <MultiDataTrigger.Conditions>



                                <Condition Binding="{Binding SelectedTab}" Value="1"/>



                                <Condition Binding="{Binding ArchiveLevel}" Value="1"/>



                            </MultiDataTrigger.Conditions>



                            <Setter Property="Visibility" Value="Visible"/>



                        </MultiDataTrigger>



                    </Style.Triggers>



                </Style>



            </Grid.Style>



            <Grid.ColumnDefinitions>



                <ColumnDefinition Width="*"/>



                <ColumnDefinition Width="16"/>



                <ColumnDefinition Width="*"/>



                <ColumnDefinition Width="16"/>



                <ColumnDefinition Width="*"/>



                <ColumnDefinition Width="16"/>



                <ColumnDefinition Width="*"/>



            </Grid.ColumnDefinitions>







            <!-- Total Sales -->



            <Border Grid.Column="0" Background="{StaticResource Brush.SurfaceAlt}" CornerRadius="16" Padding="20" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1">



                <StackPanel>



                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">



                        <materialDesign:PackIcon Kind="Finance" Width="24" Height="24" Foreground="{StaticResource Brush.PrimaryInteractive}" Margin="0,0,8,0"/>



                        <TextBlock Text="إجمالي المبيعات بالفترة" FontSize="15" Foreground="{StaticResource Brush.TextMuted}" VerticalAlignment="Center" FontWeight="Medium"/>



                    </StackPanel>



                    <TextBlock Text="{Binding TotalSalesPeriod, StringFormat=\{0:N2\} د.ل}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource Brush.TextPrimary}"/>



                </StackPanel>



            </Border>







            <!-- Total Cash Sales -->



            <Border Grid.Column="2" Background="{StaticResource Brush.IncomeSoft}" CornerRadius="16" Padding="20" BorderBrush="{StaticResource Brush.IncomeSoft}" BorderThickness="1">



                <StackPanel>



                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">



                        <materialDesign:PackIcon Kind="CashMultiple" Width="24" Height="24" Foreground="{StaticResource Brush.Income}" Margin="0,0,8,0"/>



                        <TextBlock Text="إجمالي المبيعات النقدية" FontSize="15" Foreground="{StaticResource Brush.IncomeText}" VerticalAlignment="Center" FontWeight="Medium"/>



                    </StackPanel>



                    <TextBlock Text="{Binding TotalCashSalesPeriod, StringFormat=\{0:N2\} د.ل}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource Brush.IncomeText}"/>



                </StackPanel>



            </Border>







            <!-- Total Banking Sales -->



            <Border Grid.Column="4" Background="{StaticResource Brush.PrimarySoft}" CornerRadius="16" Padding="20" BorderBrush="{StaticResource Brush.PrimarySoft}" BorderThickness="1">



                <StackPanel>



                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">



                        <materialDesign:PackIcon Kind="CreditCardCheckOutline" Width="24" Height="24" Foreground="{StaticResource Brush.PrimaryInteractive}" Margin="0,0,8,0"/>



                        <TextBlock Text="إجمالي الخدمات المصرفية" FontSize="15" Foreground="{StaticResource Brush.PrimaryInteractive}" VerticalAlignment="Center" FontWeight="Medium"/>



                    </StackPanel>



                    <TextBlock Text="{Binding TotalBankingSalesPeriod, StringFormat=\{0:N2\} د.ل}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource Brush.PrimaryDark}"/>



                </StackPanel>



            </Border>







            <!-- Total Differences Card -->



            <Border Grid.Column="6" CornerRadius="16" Padding="20" BorderThickness="1">



                <Border.Style>



                    <Style TargetType="Border">



                        <!-- Default (Matched: Green) -->



                        <Setter Property="Background" Value="{StaticResource Brush.IncomeSoft}"/>



                        <Setter Property="BorderBrush" Value="{StaticResource Brush.IncomeSoft}"/>



                        <Style.Triggers>



                            <!-- Deficit: Red -->



                            <DataTrigger Binding="{Binding TotalDifferenceColor}" Value="#DC2626">



                                <Setter Property="Background" Value="{StaticResource Brush.ExpenseSoft}"/>



                                <Setter Property="BorderBrush" Value="{StaticResource Brush.ExpenseSoft}"/>



                            </DataTrigger>



                            <!-- Surplus: Blue -->



                            <DataTrigger Binding="{Binding TotalDifferenceColor}" Value="#3F51B5">



                                <Setter Property="Background" Value="{StaticResource Brush.PrimarySoft}"/>



                                <Setter Property="BorderBrush" Value="{StaticResource Brush.PrimarySoft}"/>



                            </DataTrigger>



                        </Style.Triggers>



                    </Style>



                </Border.Style>



                <StackPanel>



                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">



                        <materialDesign:PackIcon Width="24" Height="24" Margin="0,0,8,0" VerticalAlignment="Center">



                            <materialDesign:PackIcon.Style>



                                <Style TargetType="materialDesign:PackIcon">



                                    <!-- Default: Green -->



                                    <Setter Property="Kind" Value="CheckCircleOutline"/>



                                    <Setter Property="Foreground" Value="{StaticResource Brush.Income}"/>



                                    <Style.Triggers>



                                        <!-- Deficit: Red -->



                                        <DataTrigger Binding="{Binding TotalDifferenceColor}" Value="#DC2626">



                                            <Setter Property="Kind" Value="AlertCircleOutline"/>



                                            <Setter Property="Foreground" Value="{StaticResource Brush.Expense}"/>



                                        </DataTrigger>



                                        <!-- Surplus: Blue -->



                                        <DataTrigger Binding="{Binding TotalDifferenceColor}" Value="#3F51B5">



                                            <Setter Property="Kind" Value="TrendingUp"/>



                                            <Setter Property="Foreground" Value="{StaticResource Brush.PrimaryInteractive}"/>



                                        </DataTrigger>



                                    </Style.Triggers>



                                </Style>



                            </materialDesign:PackIcon.Style>



                        </materialDesign:PackIcon>



                        <TextBlock Text="إجمالي الفروقات بالفترة" FontSize="15" VerticalAlignment="Center" FontWeight="Medium">



                            <TextBlock.Style>



                                <Style TargetType="TextBlock">



                                    <!-- Default: Green -->



                                    <Setter Property="Foreground" Value="{StaticResource Brush.IncomeText}"/>



                                    <Style.Triggers>



                                        <!-- Deficit: Red -->



                                        <DataTrigger Binding="{Binding TotalDifferenceColor}" Value="#DC2626">



                                            <Setter Property="Foreground" Value="{StaticResource Brush.ExpenseText}"/>



                                        </DataTrigger>



                                        <!-- Surplus: Blue -->



                                        <DataTrigger Binding="{Binding TotalDifferenceColor}" Value="#3F51B5">



                                            <Setter Property="Foreground" Value="{StaticResource Brush.PrimaryInteractive}"/>



                                        </DataTrigger>



                                    </Style.Triggers>



                                </Style>



                            </TextBlock.Style>



                        </TextBlock>



                    </StackPanel>



                    <TextBlock Text="{Binding TotalDifferenceText}" FontSize="26" FontWeight="Bold">



                        <TextBlock.Style>



                            <Style TargetType="TextBlock">



                                <!-- Default: Green -->



                                <Setter Property="Foreground" Value="{StaticResource Brush.IncomeText}"/>



                                <Style.Triggers>



                                    <!-- Deficit: Red -->



                                    <DataTrigger Binding="{Binding TotalDifferenceColor}" Value="#DC2626">



                                        <Setter Property="Foreground" Value="{StaticResource Brush.ExpenseText}"/>



                                    </DataTrigger>



                                    <!-- Surplus: Blue -->



                                    <DataTrigger Binding="{Binding TotalDifferenceColor}" Value="#3F51B5">



                                        <Setter Property="Foreground" Value="{StaticResource Brush.Primary}"/>



                                    </DataTrigger>



                                </Style.Triggers>



                            </Style>



                        </TextBlock.Style>



                    </TextBlock>



                </StackPanel>



            </Border>



        </Grid>







        <!-- ==================== ROW 4: PRIMARY CONTENT AREA ==================== -->



        <Grid Grid.Row="4">



            



            <!-- 🟢 VIEW A: ACTIVE WORK (TAB 0) -->



            <local:SalesActiveTab/>







            <!-- 🗄️ VIEW B: ARCHIVE (TAB 1) -->



            <local:SalesArchiveTab/>



        </Grid>



        <!-- ==================== TAB 2: CURRENT CASH ==================== -->



        <local:SalesCashTab Grid.Row="4"/>









    <!-- Settle Owner Cash Dialog Overlay -->

    <Grid Panel.ZIndex="1000" Background="#900f172a" 

          Visibility="{Binding IsSettleOwnerCashDialogOpen, Converter={StaticResource BooleanToVisibilityConverter}}">

        <Border Background="White" CornerRadius="16" Width="480" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="28" BorderBrush="{StaticResource Brush.BorderStrong}" BorderThickness="1">

            <Border.Effect>

                <DropShadowEffect BlurRadius="30" ShadowDepth="4" Color="{StaticResource Color.TextPrimary}" Opacity="0.25"/>

            </Border.Effect>

            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="20"/>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="20"/>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="20"/>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="24"/>

                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>



                <!-- Title -->

                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">

                    <materialDesign:PackIcon Kind="ScaleBalance" Width="26" Height="26" Foreground="{StaticResource Brush.PrimaryInteractive}" Margin="0,0,10,0" VerticalAlignment="Center"/>

                    <TextBlock Text="تسوية كاش المالك وإغلاق الفترة" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Brush.TextPrimary}" VerticalAlignment="Center"/>

                </StackPanel>



                <!-- Current Balance Info Box -->

                <Border Grid.Row="2" Background="{StaticResource Brush.SurfaceAlt}" CornerRadius="12" Padding="16" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1">

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="Auto"/>

                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">

                            <TextBlock Text="الرصيد النقدي الحالي بالصندوق" FontSize="12" Foreground="{StaticResource Brush.TextMuted}" Margin="0,0,0,4"/>

                            <TextBlock Text="{Binding CurrentCashBalance, StringFormat=\{0:N2\} د.ل}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Brush.TextPrimary}"/>

                        </StackPanel>

                        <materialDesign:PackIcon Grid.Column="1" Kind="Safe" Width="38" Height="38" Foreground="{StaticResource Brush.TextFaint}" VerticalAlignment="Center"/>

                    </Grid>

                </Border>



                <!-- Inputs & Calculations -->

                <StackPanel Grid.Row="4">

                    <!-- Payout Input -->

                    <TextBlock Text="المبلغ المراد تسليمه للمالك كاش (د.ل)" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,0,0,8"/>

                    <TextBox Text="{Binding SettlePayoutInput, UpdateSourceTrigger=PropertyChanged}" 

                             FontSize="16" FontWeight="Bold" Padding="12,10" Margin="0,0,0,16"

                             Background="{StaticResource Brush.SurfaceAlt}" BorderBrush="{StaticResource Brush.BorderStrong}" BorderThickness="1.5"

                             materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"

                             materialDesign:TextFieldAssist.TextBoxViewMargin="0"

                             Style="{StaticResource MaterialDesignTextBox}"/>



                    <!-- Keep Amount (ReadOnly Calculation) -->

                    <Border Background="{StaticResource Brush.IncomeSoft}" BorderBrush="{StaticResource Brush.IncomeSoft}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,16">

                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="Auto"/>

                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">

                                <TextBlock Text="السيولة التشغيلية المتبقية بالصندوق" FontSize="11" Foreground="{StaticResource Brush.IncomeText}" Margin="0,0,0,2"/>

                                <TextBlock Text="{Binding SettleKeepCalculation, StringFormat=\{0:N2\} د.ل}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource Brush.IncomeText}"/>

                            </StackPanel>

                            <materialDesign:PackIcon Grid.Column="1" Kind="TrendingUp" Width="24" Height="24" Foreground="{StaticResource Brush.IncomeText}" VerticalAlignment="Center"/>

                        </Grid>

                    </Border>



                    <!-- Notes Input -->

                    <TextBlock Text="ملاحظات والتفاصيل" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,0,0,8"/>

                    <TextBox Text="{Binding SettleNotesInput, UpdateSourceTrigger=PropertyChanged}" 

                             FontSize="14" Padding="12,10" Height="70" TextWrapping="Wrap" AcceptsReturn="True"

                             Background="{StaticResource Brush.SurfaceAlt}" BorderBrush="{StaticResource Brush.BorderStrong}" BorderThickness="1.5"

                             materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"

                             materialDesign:TextFieldAssist.TextBoxViewMargin="0"

                             Style="{StaticResource MaterialDesignTextBox}"/>

                </StackPanel>



                <!-- Warning Alert -->

                <Border Grid.Row="6" Background="{StaticResource Brush.PendingSoft}" BorderBrush="{StaticResource Brush.PendingSoft}" BorderThickness="1" CornerRadius="8" Padding="12">

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="Auto"/>

                            <ColumnDefinition Width="*"/>

                        </Grid.ColumnDefinitions>

                        <materialDesign:PackIcon Grid.Column="0" Kind="AlertCircle" Width="20" Height="20" Foreground="{StaticResource Brush.Pending}" Margin="0,0,10,0" VerticalAlignment="Top"/>

                        <TextBlock Grid.Column="1" Text="تنبيه: سيتم ترحيل وتأكيد كافة اليوميات والمصاريف اليومية وتجميدها نهائياً لمنع أي تعديل لاحق." 

                                   FontSize="11.5" Foreground="{StaticResource Brush.PendingText}" TextWrapping="Wrap" LineHeight="16"/>

                    </Grid>

                </Border>



                <!-- Buttons -->

                <Grid Grid.Row="8">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="12"/>

                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="تأكيد وإقفال" Command="{Binding ConfirmSettleOwnerCashCommand}" 

                            Background="{StaticResource Brush.PrimaryInteractive}" BorderBrush="{StaticResource Brush.PrimaryInteractive}" Foreground="White" Height="42" Cursor="Hand" FontWeight="Bold"/>

                    <Button Grid.Column="2" Content="إلغاء" Command="{Binding CloseSettleOwnerCashDialogCommand}" 

                            Style="{StaticResource MaterialDesignOutlinedButton}" BorderBrush="{StaticResource Brush.TextFaint}" Foreground="{StaticResource Brush.TextMuted}" Height="42" Cursor="Hand" FontWeight="Bold"/>

                </Grid>

            </Grid>

        </Border>

    </Grid>



    <!-- Settlement Archive Dialog Overlay -->

    <Grid Panel.ZIndex="1000" Background="#900f172a" 

          Visibility="{Binding IsSettlementArchiveDialogOpen, Converter={StaticResource BooleanToVisibilityConverter}}">

        <Border Background="White" CornerRadius="16" Width="1150" MaxHeight="650" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24" BorderBrush="{StaticResource Brush.BorderStrong}" BorderThickness="1">

            <Border.Effect>

                <DropShadowEffect BlurRadius="30" ShadowDepth="4" Color="{StaticResource Color.TextPrimary}" Opacity="0.25"/>

            </Border.Effect>

            <Grid>

                <Grid.RowDefinitions>

                    <!-- 0: Header with Close Button -->

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="16"/>

                    <!-- 1: History DataGrid -->

                    <RowDefinition Height="*"/>

                    <RowDefinition Height="16"/>

                    <!-- 2: Footer / Close Button -->

                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>



                <!-- Header -->

                <Grid Grid.Row="0">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="Auto"/>

                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Grid.Column="0">

                        <materialDesign:PackIcon Kind="History" Width="26" Height="26" Foreground="{StaticResource Brush.PrimaryInteractive}" Margin="0,0,10,0" VerticalAlignment="Center"/>

                        <TextBlock Text="أرشيف تسويات كاش المالك السابقة" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Brush.TextPrimary}" VerticalAlignment="Center"/>

                    </StackPanel>

                    <Button Grid.Column="1" Command="{Binding CloseSettlementArchiveCommand}" Style="{StaticResource MaterialDesignToolButton}" Width="36" Height="36" Padding="0" Cursor="Hand" ToolTip="إغلاق">

                        <materialDesign:PackIcon Kind="Close" Width="24" Height="24" Foreground="{StaticResource Brush.TextMuted}"/>

                    </Button>

                </Grid>



                <!-- History DataGrid -->

                <Grid Grid.Row="2">

                    <DataGrid Margin="0" 

                              ItemsSource="{Binding SettlementHistory}" 

                              AutoGenerateColumns="False"

                              CanUserAddRows="False" 

                              IsReadOnly="True"

                              HeadersVisibility="Column"

                              Background="Transparent"

                              BorderThickness="0"

                              RowHeight="50"

                              MaxHeight="450"

                              GridLinesVisibility="Horizontal"

                              HorizontalScrollBarVisibility="Auto"

                              VerticalScrollBarVisibility="Auto"

                              HorizontalGridLinesBrush="#f1f5f9">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="جلسة التسوية" Binding="{Binding ShortSessionGuid}" Width="Auto" MinWidth="80"/>

                            <DataGridTextColumn Header="التاريخ والوقت" Binding="{Binding SettleDate, StringFormat=\{0:dd-MM-yyyy hh:mm tt\}}" Width="Auto" MinWidth="140"/>

                            <DataGridTextColumn Header="بواسطة" Binding="{Binding CreatedBy}" Width="Auto" MinWidth="90"/>

                            <DataGridTextColumn Header="الرصيد الكلي للفترة" Binding="{Binding BalanceBefore, StringFormat=\{0:N2\} د.ل}" Width="Auto" MinWidth="130"/>

                            <DataGridTextColumn Header="المسلم للمالك" Binding="{Binding PayoutAmount, StringFormat=\{0:N2\} د.ل}" Width="Auto" MinWidth="110"/>

                            <DataGridTextColumn Header="السيولة المتبقية" Binding="{Binding KeepAmount, StringFormat=\{0:N2\} د.ل}" Width="Auto" MinWidth="110"/>

                            <DataGridTextColumn Header="البيان والملاحظات" Binding="{Binding Notes}" Width="*" MinWidth="180"/>

                            <DataGridTextColumn Header="حالة الفترة" Binding="{Binding StatusText}" Width="Auto" MinWidth="120"/>
                            <DataGridTemplateColumn Header="إجراءات" Width="Auto" MinWidth="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <!-- PDF Receipt -->
                                            <Button Command="{Binding DataContext.RegenerateSettlementPdfCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource MaterialDesignToolButton}"
                                                    Height="36" Width="36" Padding="0" Cursor="Hand"
                                                    ToolTip="تنزيل وعرض إيصال PDF">
                                                <materialDesign:PackIcon Kind="FilePdfBox" Width="22" Height="22" Foreground="{StaticResource Brush.Expense}"/>
                                            </Button>
                                            <!-- Unlock Period -->
                                            <Button Command="{Binding DataContext.UnlockPeriodCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource MaterialDesignToolButton}"
                                                    Height="36" Width="36" Padding="0" Cursor="Hand"
                                                    ToolTip="إلغاء قفل الفترة للمراجعة">
                                                <materialDesign:PackIcon Kind="LockOpenOutline" Width="22" Height="22" Foreground="{StaticResource Brush.Pending}"/>
                                            </Button>
                                            <!-- Unpost Period -->
                                            <Button Command="{Binding DataContext.UnpostPeriodCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource MaterialDesignToolButton}"
                                                    Height="36" Width="36" Padding="0" Cursor="Hand"
                                                    ToolTip="فك ترحيل الفترة بالكامل وعكس الحركات النقدية">
                                                <materialDesign:PackIcon Kind="LockOpenVariantOutline" Width="22" Height="22" Foreground="{StaticResource Brush.Expense}"/>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>

                    </DataGrid>

                </Grid>



                <!-- Footer Buttons -->

                <Grid Grid.Row="4">

                    <Button HorizontalAlignment="Right" Content="إغلاق الأرشيف" Command="{Binding CloseSettlementArchiveCommand}" 

                            Style="{StaticResource MaterialDesignOutlinedButton}" BorderBrush="{StaticResource Brush.TextFaint}" Foreground="{StaticResource Brush.TextMuted}" Height="40" Padding="20,0" Cursor="Hand" FontWeight="Bold"/>

                </Grid>

            </Grid>

        </Border>

