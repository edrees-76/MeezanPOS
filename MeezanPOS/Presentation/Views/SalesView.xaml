<UserControl x:Class="MeezanPOS.Presentation.Views.SalesView"



             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"



             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"



             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 



             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 



             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"



             xmlns:converters="clr-namespace:MeezanPOS.Presentation.Converters"



             mc:Ignorable="d" 



             d:DesignHeight="800" d:DesignWidth="1100"



             FlowDirection="RightToLeft"



             Background="#f8fafc"



             SnapsToDevicePixels="True"



             UseLayoutRounding="True">







    <UserControl.Resources>



        <ResourceDictionary>



            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>



            <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>



            



            <!-- ستايل صندوق التحديد الاحترافي المغلق والكامل -->



            <Style x:Key="PremiumCheckBoxStyle" TargetType="CheckBox">



                <Setter Property="Background" Value="White"/>



                <Setter Property="BorderBrush" Value="#cbd5e1"/>



                <Setter Property="BorderThickness" Value="1.5"/>



                <Setter Property="Width" Value="20"/>



                <Setter Property="Height" Value="20"/>



                <Setter Property="Cursor" Value="Hand"/>



                <Setter Property="Template">



                    <Setter.Value>



                        <ControlTemplate TargetType="CheckBox">



                            <Grid x:Name="RootGrid" Background="Transparent" SnapsToDevicePixels="True" UseLayoutRounding="True">



                                <Border x:Name="BoxBorder" 



                                        Width="18" Height="18"



                                        Margin="1"



                                        Background="{TemplateBinding Background}" 



                                        BorderBrush="{TemplateBinding BorderBrush}" 



                                        BorderThickness="{TemplateBinding BorderThickness}" 



                                        CornerRadius="4"



                                        SnapsToDevicePixels="True"



                                        UseLayoutRounding="True"



                                        HorizontalAlignment="Center"



                                        VerticalAlignment="Center">



                                    <materialDesign:PackIcon x:Name="CheckIcon" 



                                                             Kind="Check" 



                                                             Width="12" Height="12" 



                                                             Foreground="White" 



                                                             HorizontalAlignment="Center" 



                                                             VerticalAlignment="Center" 



                                                             Visibility="Collapsed"/>



                                </Border>



                            </Grid>



                            <ControlTemplate.Triggers>



                                <Trigger Property="IsChecked" Value="True">



                                    <Setter TargetName="BoxBorder" Property="Background" Value="#3b82f6"/>



                                    <Setter TargetName="BoxBorder" Property="BorderBrush" Value="#3b82f6"/>



                                    <Setter TargetName="CheckIcon" Property="Visibility" Value="Visible"/>



                                </Trigger>



                                <Trigger Property="IsMouseOver" Value="True">



                                    <Setter TargetName="BoxBorder" Property="BorderBrush" Value="#3b82f6"/>



                                </Trigger>



                            </ControlTemplate.Triggers>



                        </ControlTemplate>



                    </Setter.Value>



                </Setter>



            </Style>



            



            <!-- Tab Button Style -->



            <Style x:Key="SleekTabButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">



                <Setter Property="Height" Value="40"/>



                <Setter Property="Padding" Value="24,0"/>



                <Setter Property="FontSize" Value="14"/>



                <Setter Property="FontWeight" Value="SemiBold"/>



                <Setter Property="Foreground" Value="#64748b"/>



                <Setter Property="Background" Value="Transparent"/>



                <Setter Property="BorderThickness" Value="0"/>



                <Setter Property="Cursor" Value="Hand"/>



                <Style.Resources>



                    <!-- Overriding material design borders -->



                    <Style TargetType="Border">



                        <Setter Property="CornerRadius" Value="20"/>



                    </Style>



                </Style.Resources>



            </Style>



        </ResourceDictionary>



    </UserControl.Resources>







    <Grid Margin="24">



        <Grid.RowDefinitions>



            <!-- 0: Sleek Top Header / Navigation Tabs -->



            <RowDefinition Height="Auto"/>



            <RowDefinition Height="20"/>



            <!-- 1: Summary Stats Cards (Sales, Cash, Banking) -->



            <RowDefinition Height="Auto"/>



            <RowDefinition Height="20"/>



            <!-- 2: Primary Content Area (Switchable based on Tab) -->



            <RowDefinition Height="*"/>



        </Grid.RowDefinitions>







        <!-- ==================== ROW 0: SLEEK TOP HEADER & TABS ==================== -->



        <Grid Grid.Row="0">



            <Grid.ColumnDefinitions>



                <ColumnDefinition Width="*"/>



                <ColumnDefinition Width="Auto"/>



            </Grid.ColumnDefinitions>







            <!-- Screen Title -->



            <StackPanel Grid.Column="0" VerticalAlignment="Center">



                <TextBlock Text="المبيعات والإيرادات اليومية" FontSize="24" FontWeight="Bold" Foreground="#0f172a"/>



                <TextBlock Text="متابعة الحركات المالية، المصاريف اليومية، وإقفال الورديات والشهور" FontSize="13" Foreground="#64748b" Margin="0,4,0,0"/>



            </StackPanel>







            <!-- Gorgeous Segmented Control for Navigation -->



            <Border Grid.Column="1" Background="#e2e8f0" CornerRadius="22" Padding="4" VerticalAlignment="Center">



                <StackPanel Orientation="Horizontal">



                    



                    <!-- Tab 0: Active Work -->



                    <Button Command="{Binding SetTabCommand}" CommandParameter="0">



                        <Button.Style>



                            <Style TargetType="Button" BasedOn="{StaticResource SleekTabButtonStyle}">



                                <Style.Triggers>



                                    <DataTrigger Binding="{Binding SelectedTab}" Value="0">



                                        <Setter Property="Background" Value="White"/>



                                        <Setter Property="Foreground" Value="#0f172a"/>



                                        <Setter Property="Effect">



                                            <Setter.Value>



                                                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Color="#cbd5e1" Opacity="0.5"/>



                                            </Setter.Value>



                                        </Setter>



                                    </DataTrigger>



                                </Style.Triggers>



                            </Style>



                        </Button.Style>



                        <Button.Resources>



                            <Style TargetType="Border">



                                <Setter Property="CornerRadius" Value="18"/>



                            </Style>



                        </Button.Resources>



                        <StackPanel Orientation="Horizontal">



                            <materialDesign:PackIcon Kind="CashRegister" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"/>



                            <TextBlock Text="العمل الحالي (الورديات المفتوحة)" VerticalAlignment="Center"/>



                        </StackPanel>



                    </Button>







                    <!-- Tab 1: Archive -->



                    <Button Command="{Binding SetTabCommand}" CommandParameter="1">



                        <Button.Style>



                            <Style TargetType="Button" BasedOn="{StaticResource SleekTabButtonStyle}">



                                <Style.Triggers>



                                    <DataTrigger Binding="{Binding SelectedTab}" Value="1">



                                        <Setter Property="Background" Value="White"/>



                                        <Setter Property="Foreground" Value="#0f172a"/>



                                        <Setter Property="Effect">



                                            <Setter.Value>



                                                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Color="#cbd5e1" Opacity="0.5"/>



                                            </Setter.Value>



                                        </Setter>



                                    </DataTrigger>



                                </Style.Triggers>



                            </Style>



                        </Button.Style>



                        <Button.Resources>



                            <Style TargetType="Border">



                                <Setter Property="CornerRadius" Value="18"/>



                            </Style>



                        </Button.Resources>



                        <StackPanel Orientation="Horizontal">



                            <materialDesign:PackIcon Kind="ArchiveOutline" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"/>



                            <TextBlock Text="أرشيف الأشهر المرحّلة" VerticalAlignment="Center"/>



                        </StackPanel>



                    </Button>







                    <!-- Tab 2: Current Cash -->



                    <Button Command="{Binding SetTabCommand}" CommandParameter="2">



                        <Button.Style>



                            <Style TargetType="Button" BasedOn="{StaticResource SleekTabButtonStyle}">



                                <Style.Triggers>



                                    <DataTrigger Binding="{Binding SelectedTab}" Value="2">



                                        <Setter Property="Background" Value="White"/>



                                        <Setter Property="Foreground" Value="#0f172a"/>



                                        <Setter Property="Effect">



                                            <Setter.Value>



                                                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Color="#cbd5e1" Opacity="0.5"/>



                                            </Setter.Value>



                                        </Setter>



                                    </DataTrigger>



                                </Style.Triggers>



                            </Style>



                        </Button.Style>



                        <Button.Resources>



                            <Style TargetType="Border">



                                <Setter Property="CornerRadius" Value="18"/>



                            </Style>



                        </Button.Resources>



                        <StackPanel Orientation="Horizontal">



                            <materialDesign:PackIcon Kind="CashMultiple" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"/>



                            <TextBlock Text="الكاش الحالي" VerticalAlignment="Center"/>



                        </StackPanel>



                    </Button>



                </StackPanel>



            </Border>



        </Grid>







        <!-- ==================== ROW 2: SUMMARY CARDS ==================== -->



        <!-- These cards reflect totals for the active tab list -->



        <Grid Grid.Row="2">



            <Grid.Style>



                <Style TargetType="Grid">



                    <Setter Property="Visibility" Value="Collapsed"/>



                    <Style.Triggers>



                        <!-- Only visible when on Active Work (Tab 0) OR on Archive (Tab 1) Day Level -->



                        <DataTrigger Binding="{Binding SelectedTab}" Value="0">



                            <Setter Property="Visibility" Value="Visible"/>



                        </DataTrigger>



                        <MultiDataTrigger>



                            <MultiDataTrigger.Conditions>



                                <Condition Binding="{Binding SelectedTab}" Value="1"/>



                                <Condition Binding="{Binding ArchiveLevel}" Value="1"/>



                            </MultiDataTrigger.Conditions>



                            <Setter Property="Visibility" Value="Visible"/>



                        </MultiDataTrigger>



                    </Style.Triggers>



                </Style>



            </Grid.Style>



            <Grid.ColumnDefinitions>



                <ColumnDefinition Width="*"/>



                <ColumnDefinition Width="16"/>



                <ColumnDefinition Width="*"/>



                <ColumnDefinition Width="16"/>



                <ColumnDefinition Width="*"/>



                <ColumnDefinition Width="16"/>



                <ColumnDefinition Width="*"/>



            </Grid.ColumnDefinitions>







            <!-- Total Sales -->



            <Border Grid.Column="0" Background="#f8fafc" CornerRadius="16" Padding="20" BorderBrush="#e2e8f0" BorderThickness="1">



                <StackPanel>



                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">



                        <materialDesign:PackIcon Kind="Finance" Width="24" Height="24" Foreground="#3b82f6" Margin="0,0,8,0"/>



                        <TextBlock Text="إجمالي المبيعات بالفترة" FontSize="15" Foreground="#64748b" VerticalAlignment="Center" FontWeight="Medium"/>



                    </StackPanel>



                    <TextBlock Text="{Binding TotalSalesPeriod, StringFormat=\{0:N2\} د.ل}" FontSize="26" FontWeight="Bold" Foreground="#0f172a"/>



                </StackPanel>



            </Border>







            <!-- Total Cash Sales -->



            <Border Grid.Column="2" Background="#f0fdf4" CornerRadius="16" Padding="20" BorderBrush="#dcfce7" BorderThickness="1">



                <StackPanel>



                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">



                        <materialDesign:PackIcon Kind="CashMultiple" Width="24" Height="24" Foreground="#10b981" Margin="0,0,8,0"/>



                        <TextBlock Text="إجمالي المبيعات النقدية" FontSize="15" Foreground="#15803d" VerticalAlignment="Center" FontWeight="Medium"/>



                    </StackPanel>



                    <TextBlock Text="{Binding TotalCashSalesPeriod, StringFormat=\{0:N2\} د.ل}" FontSize="26" FontWeight="Bold" Foreground="#14532d"/>



                </StackPanel>



            </Border>







            <!-- Total Banking Sales -->



            <Border Grid.Column="4" Background="#faf5ff" CornerRadius="16" Padding="20" BorderBrush="#f3e8ff" BorderThickness="1">



                <StackPanel>



                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">



                        <materialDesign:PackIcon Kind="CreditCardCheckOutline" Width="24" Height="24" Foreground="#a855f7" Margin="0,0,8,0"/>



                        <TextBlock Text="إجمالي الخدمات المصرفية" FontSize="15" Foreground="#7e22ce" VerticalAlignment="Center" FontWeight="Medium"/>



                    </StackPanel>



                    <TextBlock Text="{Binding TotalBankingSalesPeriod, StringFormat=\{0:N2\} د.ل}" FontSize="26" FontWeight="Bold" Foreground="#581c87"/>



                </StackPanel>



            </Border>







            <!-- Total Differences Card -->



            <Border Grid.Column="6" CornerRadius="16" Padding="20" BorderThickness="1">



                <Border.Style>



                    <Style TargetType="Border">



                        <!-- Default (Matched: Green) -->



                        <Setter Property="Background" Value="#f0fdf4"/>



                        <Setter Property="BorderBrush" Value="#dcfce7"/>



                        <Style.Triggers>



                            <!-- Deficit: Red -->



                            <DataTrigger Binding="{Binding TotalDifferenceColor}" Value="#ef4444">



                                <Setter Property="Background" Value="#fef2f2"/>



                                <Setter Property="BorderBrush" Value="#fee2e2"/>



                            </DataTrigger>



                            <!-- Surplus: Blue -->



                            <DataTrigger Binding="{Binding TotalDifferenceColor}" Value="#3b82f6">



                                <Setter Property="Background" Value="#eff6ff"/>



                                <Setter Property="BorderBrush" Value="#dbeafe"/>



                            </DataTrigger>



                        </Style.Triggers>



                    </Style>



                </Border.Style>



                <StackPanel>



                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">



                        <materialDesign:PackIcon Width="24" Height="24" Margin="0,0,8,0" VerticalAlignment="Center">



                            <materialDesign:PackIcon.Style>



                                <Style TargetType="materialDesign:PackIcon">



                                    <!-- Default: Green -->



                                    <Setter Property="Kind" Value="CheckCircleOutline"/>



                                    <Setter Property="Foreground" Value="#10b981"/>



                                    <Style.Triggers>



                                        <!-- Deficit: Red -->



                                        <DataTrigger Binding="{Binding TotalDifferenceColor}" Value="#ef4444">



                                            <Setter Property="Kind" Value="AlertCircleOutline"/>



                                            <Setter Property="Foreground" Value="#ef4444"/>



                                        </DataTrigger>



                                        <!-- Surplus: Blue -->



                                        <DataTrigger Binding="{Binding TotalDifferenceColor}" Value="#3b82f6">



                                            <Setter Property="Kind" Value="TrendingUp"/>



                                            <Setter Property="Foreground" Value="#3b82f6"/>



                                        </DataTrigger>



                                    </Style.Triggers>



                                </Style>



                            </materialDesign:PackIcon.Style>



                        </materialDesign:PackIcon>



                        <TextBlock Text="إجمالي الفروقات بالفترة" FontSize="15" VerticalAlignment="Center" FontWeight="Medium">



                            <TextBlock.Style>



                                <Style TargetType="TextBlock">



                                    <!-- Default: Green -->



                                    <Setter Property="Foreground" Value="#15803d"/>



                                    <Style.Triggers>



                                        <!-- Deficit: Red -->



                                        <DataTrigger Binding="{Binding TotalDifferenceColor}" Value="#ef4444">



                                            <Setter Property="Foreground" Value="#b91c1c"/>



                                        </DataTrigger>



                                        <!-- Surplus: Blue -->



                                        <DataTrigger Binding="{Binding TotalDifferenceColor}" Value="#3b82f6">



                                            <Setter Property="Foreground" Value="#1d4ed8"/>



                                        </DataTrigger>



                                    </Style.Triggers>



                                </Style>



                            </TextBlock.Style>



                        </TextBlock>



                    </StackPanel>



                    <TextBlock Text="{Binding TotalDifferenceText}" FontSize="26" FontWeight="Bold">



                        <TextBlock.Style>



                            <Style TargetType="TextBlock">



                                <!-- Default: Green -->



                                <Setter Property="Foreground" Value="#14532d"/>



                                <Style.Triggers>



                                    <!-- Deficit: Red -->



                                    <DataTrigger Binding="{Binding TotalDifferenceColor}" Value="#ef4444">



                                        <Setter Property="Foreground" Value="#7f1d1d"/>



                                    </DataTrigger>



                                    <!-- Surplus: Blue -->



                                    <DataTrigger Binding="{Binding TotalDifferenceColor}" Value="#3b82f6">



                                        <Setter Property="Foreground" Value="#1e3a8a"/>



                                    </DataTrigger>



                                </Style.Triggers>



                            </Style>



                        </TextBlock.Style>



                    </TextBlock>



                </StackPanel>



            </Border>



        </Grid>







        <!-- ==================== ROW 4: PRIMARY CONTENT AREA ==================== -->



        <Grid Grid.Row="4">



            



            <!-- 🟢 VIEW A: ACTIVE WORK (TAB 0) -->



            <Grid>



                <Grid.Style>



                    <Style TargetType="Grid">



                        <Setter Property="Visibility" Value="Collapsed"/>



                        <Style.Triggers>



                            <DataTrigger Binding="{Binding SelectedTab}" Value="0">



                                <Setter Property="Visibility" Value="Visible"/>



                            </DataTrigger>



                        </Style.Triggers>



                    </Style>



                </Grid.Style>







                <Border Background="White" CornerRadius="16" BorderBrush="#e2e8f0" BorderThickness="1">



                    <Grid>



                        <Grid.RowDefinitions>



                            <RowDefinition Height="Auto"/>



                            <RowDefinition Height="*"/>



                            <RowDefinition Height="Auto"/>



                        </Grid.RowDefinitions>







                        <!-- Header & Filters -->



                        <Border Grid.Row="0" Background="#f8fafc" CornerRadius="16,16,0,0" Padding="20,16" BorderBrush="#e2e8f0" BorderThickness="0,0,0,1">



                            <Grid>



                                <Grid.RowDefinitions>



                                    <RowDefinition Height="Auto"/>



                                    <RowDefinition Height="12"/>



                                    <RowDefinition Height="Auto"/>



                                </Grid.RowDefinitions>



                                



                                <Grid Grid.Row="0">



                                    <Grid.ColumnDefinitions>



                                        <ColumnDefinition Width="*"/>



                                        <ColumnDefinition Width="Auto"/>



                                    </Grid.ColumnDefinitions>



                                    <StackPanel Grid.Column="0" Orientation="Horizontal">



                                        <materialDesign:PackIcon Kind="LockOpenVariantOutline" Width="20" Height="20" Foreground="#3b82f6" VerticalAlignment="Center" Margin="0,0,8,0"/>



                                        <TextBlock Text="الورديات اليومية المفتوحة حالياً" FontSize="16" FontWeight="SemiBold" Foreground="#0f172a" VerticalAlignment="Center"/>



                                    </StackPanel>



                                    <Button Grid.Column="1" Style="{StaticResource MaterialDesignOutlinedButton}" Content="تحديث البيانات" Command="{Binding LoadDataCommand}" Height="32"/>



                                </Grid>







                                <!-- Filters -->



                                <Grid Grid.Row="2">



                                    <Grid.ColumnDefinitions>



                                        <ColumnDefinition Width="*"/>



                                        <ColumnDefinition Width="12"/>



                                        <ColumnDefinition Width="*"/>



                                        <ColumnDefinition Width="6"/>



                                        <ColumnDefinition Width="*"/>



                                        <ColumnDefinition Width="12"/>



                                        <ColumnDefinition Width="*"/>



                                        <ColumnDefinition Width="12"/>



                                        <ColumnDefinition Width="*"/>



                                        <ColumnDefinition Width="12"/>



                                        <ColumnDefinition Width="Auto"/>



                                    </Grid.ColumnDefinitions>







                                    <ComboBox Grid.Column="0" ItemsSource="{Binding CashierNames}" SelectedItem="{Binding SelectedCashier}" materialDesign:HintAssist.Hint="اختر اسم الكاشير..." Style="{StaticResource MaterialDesignOutlinedComboBox}" Height="45" FontSize="13" Padding="10,6" VerticalContentAlignment="Center"/>



                                    



                                        <DatePicker Grid.Column="2" SelectedDate="{Binding FilterStartDate}" materialDesign:HintAssist.Hint="من تاريخ..." Style="{StaticResource MaterialDesignOutlinedDatePicker}" Height="45" Padding="10,6" FontSize="13" VerticalContentAlignment="Center"/>



                                        <DatePicker Grid.Column="4" SelectedDate="{Binding FilterEndDate}" materialDesign:HintAssist.Hint="إلى تاريخ..." Style="{StaticResource MaterialDesignOutlinedDatePicker}" Height="45" Padding="10,6" FontSize="13" VerticalContentAlignment="Center"/>



                                    



                                    <ComboBox Grid.Column="6" ItemsSource="{Binding ShiftTypes}" SelectedItem="{Binding FilterShiftType}" materialDesign:HintAssist.Hint="نوع الوردية" Style="{StaticResource MaterialDesignOutlinedComboBox}" Height="45" FontSize="13" Padding="10,6" VerticalContentAlignment="Center"/>



                                    



                                    <ComboBox Grid.Column="8" ItemsSource="{Binding DifferenceFilters}" SelectedItem="{Binding SelectedDifferenceFilter}" materialDesign:HintAssist.Hint="فلتر الفروقات" Style="{StaticResource MaterialDesignOutlinedComboBox}" Height="45" FontSize="13" Padding="10,6" VerticalContentAlignment="Center"/>



                                    



                                    <StackPanel Grid.Column="10" Orientation="Horizontal">



                                        <Button Command="{Binding ApplyFiltersCommand}" Content="تطبيق الفلتر" Style="{StaticResource MaterialDesignRaisedButton}" Background="#10b981" BorderBrush="#10b981" Height="45" Width="100" Margin="0,0,8,0"/>



                                        <Button Command="{Binding ClearFiltersCommand}" ToolTip="إلغاء التصفية" Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="#ef4444" BorderBrush="#ef4444" Height="45" Width="45" Padding="0" Margin="0,0,8,0">



                                            <materialDesign:PackIcon Kind="FilterRemove" Width="20" Height="20"/>



                                        </Button>



                                        <Button Command="{Binding PostPeriodCommand}" ToolTip="ترحيل وإقفال جميع اليوميات المفتوحة في هذه الفترة المحددة" Style="{StaticResource MaterialDesignRaisedButton}" Background="#6366f1" BorderBrush="#6366f1" Height="45" Cursor="Hand">



                                            <StackPanel Orientation="Horizontal">



                                                <materialDesign:PackIcon Kind="CalendarClock" Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Center"/>



                                                <TextBlock Text="ترحيل وقفل الفترة" VerticalAlignment="Center" FontWeight="Bold"/>



                                            </StackPanel>



                                        </Button>



                                    </StackPanel>



                                </Grid>



                            </Grid>



                        </Border>







                        <!-- Data Grid & Floating Action Bar Container -->



                        <Grid Grid.Row="1">



                            <!-- Data Grid -->



                            <DataGrid Margin="0" 



                                      ItemsSource="{Binding Journals}" 



                                      SelectedItem="{Binding SelectedJournal}"



                                      AutoGenerateColumns="False"



                                      CanUserAddRows="False"



                                      CanUserDeleteRows="False"



                                      CanUserResizeColumns="False"



                                      CanUserReorderColumns="False"



                                      CanUserSortColumns="False"



                                      IsReadOnly="True"



                                      HeadersVisibility="Column"



                                      Background="Transparent"



                                      BorderThickness="0"



                                      RowHeight="50"



                                      GridLinesVisibility="Horizontal"



                                      HorizontalScrollBarVisibility="Auto"



                                      HorizontalGridLinesBrush="#f1f5f9">







                                <DataGrid.Columns>



                                    <!-- Checkbox Selection Column -->



                                    <DataGridTemplateColumn Width="65">



                                        <DataGridTemplateColumn.HeaderTemplate>



                                            <DataTemplate>



                                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">



                                                    <CheckBox Style="{StaticResource PremiumCheckBoxStyle}" 



                                                              IsChecked="{Binding DataContext.IsAllSelected, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}" 



                                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>



                                                </Grid>



                                            </DataTemplate>



                                        </DataGridTemplateColumn.HeaderTemplate>



                                        <DataGridTemplateColumn.CellTemplate>



                                            <DataTemplate>



                                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">



                                                    <CheckBox Style="{StaticResource PremiumCheckBoxStyle}" 



                                                              IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" 



                                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>



                                                </Grid>



                                            </DataTemplate>



                                        </DataGridTemplateColumn.CellTemplate>



                                    </DataGridTemplateColumn>







                                    <DataGridTextColumn Header="التسلسل" Binding="{Binding Sequence}" Width="Auto"/>



                                    <DataGridTextColumn Header="التاريخ" Binding="{Binding Journal.JournalDate, StringFormat=\{0:dd-MM-yyyy\}}" Width="Auto"/>



                                    <DataGridTextColumn Header="الوردية" Binding="{Binding Journal.ShiftName}" Width="Auto"/>



                                    <DataGridTextColumn Header="اسم الكاشير" Binding="{Binding Journal.EmployeeName}" Width="*" MinWidth="120"/>



                                    <DataGridTextColumn Header="إجمالي المبيعات" Binding="{Binding Journal.TotalSales, StringFormat=\{0:N2\}}" Width="Auto" MinWidth="100"/>



                                    <DataGridTextColumn Header="مبيعات نقدية" Binding="{Binding Journal.CashSales, StringFormat=\{0:N2\}}" Width="Auto" MinWidth="90"/>



                                    <DataGridTextColumn Header="خدمات مصرفية" Binding="{Binding Journal.BankingTotal, StringFormat=\{0:N2\}}" Width="Auto" MinWidth="90"/>



                                    <DataGridTextColumn Header="المرتجعات" Binding="{Binding Journal.ReturnsTotal, StringFormat=\{0:N2\}}" Width="Auto" MinWidth="80"/>



                                    <DataGridTextColumn Header="المصاريف" Binding="{Binding Journal.TotalExpenses, StringFormat=\{0:N2\}}" Width="Auto" MinWidth="80"/>



                                    



                                    <DataGridTemplateColumn Header="الفروقات" Width="Auto" MinWidth="90">



                                        <DataGridTemplateColumn.CellTemplate>



                                            <DataTemplate>



                                                <TextBlock Text="{Binding Journal.DifferenceText}" Foreground="{Binding Journal.DifferenceColor}" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>



                                            </DataTemplate>



                                        </DataGridTemplateColumn.CellTemplate>



                                    </DataGridTemplateColumn>







                                    <DataGridTemplateColumn Header="إجراءات" Width="140">



                                        <DataGridTemplateColumn.CellTemplate>



                                            <DataTemplate>



                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">



                                                    <!-- View Details -->



                                                    <Button Command="{Binding DataContext.ViewDetailsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 



                                                            CommandParameter="{Binding}"



                                                            ToolTip="عرض التفاصيل"



                                                            Style="{StaticResource MaterialDesignToolButton}" 



                                                            Height="32" Width="32" Padding="0" Cursor="Hand" Margin="0,0,4,0">



                                                        <materialDesign:PackIcon Kind="Eye" Width="18" Height="18" Foreground="#3b82f6"/>



                                                    </Button>



                                                    <!-- Edit -->



                                                    <Button Command="{Binding DataContext.EditJournalCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 



                                                            CommandParameter="{Binding}"



                                                            ToolTip="تعديل الوردية"



                                                            Style="{StaticResource MaterialDesignToolButton}" 



                                                            Height="32" Width="32" Padding="0" Cursor="Hand" Margin="0,0,4,0">



                                                        <materialDesign:PackIcon Kind="Pencil" Width="18" Height="18" Foreground="#10b981"/>



                                                    </Button>



                                                    <!-- Post / Lock -->



                                                    <Button Command="{Binding DataContext.PostJournalCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 



                                                            CommandParameter="{Binding}"



                                                            ToolTip="ترحيل وإقفال الوردية مالياً"



                                                            Style="{StaticResource MaterialDesignToolButton}" 



                                                            Height="32" Width="32" Padding="0" Cursor="Hand">



                                                        <materialDesign:PackIcon Kind="LockOutline" Width="18" Height="18" Foreground="#ef4444"/>



                                                    </Button>



                                                </StackPanel>



                                            </DataTemplate>



                                        </DataGridTemplateColumn.CellTemplate>



                                    </DataGridTemplateColumn>



                                </DataGrid.Columns>



                            </DataGrid>







                            <!-- Floating Glassmorphic Action Bar -->



                            <Border VerticalAlignment="Bottom" HorizontalAlignment="Center"



                                    Margin="24,0,24,20" Padding="20,12"



                                    Background="#fcfdfd" BorderBrush="#cbd5e1" BorderThickness="1.5"



                                    CornerRadius="24" Height="Auto" Width="Auto" MinWidth="750"



