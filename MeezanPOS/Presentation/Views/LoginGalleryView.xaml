<Window x:Class="MeezanPOS.Presentation.Views.LoginGalleryView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="معرض تصاميم واجهة الدخول - ميزان المطاعم" 
        Height="850" Width="1350"
        WindowStartupLocation="CenterScreen"
        Background="#0f172a"
        FlowDirection="RightToLeft"
        FontFamily="Segoe UI, Tahoma">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>  <!-- شريط التحكم العلوي -->
            <RowDefinition Height="*"/>   <!-- منطقة عرض التصميم المختار -->
        </Grid.RowDefinitions>

        <!-- ════════════════ الشريط العلوي: الملاحة واختيار التصميم ════════════════ -->
        <Border Grid.Row="0" Background="#1e293b" BorderBrush="#334155" BorderThickness="0,0,0,2" Padding="24,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- العنوان -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="معرض تصاميم واجهة الدخول" FontSize="18" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="ميزان المطاعم - استعرض واقرأ وقارن بين 4 تصاميم تفاعلية فاخرة" FontSize="12" Foreground="#94a3b8" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- أزرار اختيار التصميم -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- الزر 1 -->
                    <RadioButton x:Name="BtnDesign1" IsChecked="True" Style="{StaticResource MaterialDesignTabRadioButton}" 
                                 Content="1. الملكي المظلم والزجاج المذهب" Foreground="White" Width="220" Height="48" FontSize="12" Margin="0,0,10,0"/>
                    <!-- الزر 2 -->
                    <RadioButton x:Name="BtnDesign2" Style="{StaticResource MaterialDesignTabRadioButton}" 
                                 Content="2. اللوحة المنقسمة التنفيذية" Foreground="White" Width="220" Height="48" FontSize="12" Margin="0,0,10,0"/>
                    <!-- الزر 3 -->
                    <RadioButton x:Name="BtnDesign3" Style="{StaticResource MaterialDesignTabRadioButton}" 
                                 Content="3. الهندسي المعاصر البسيط" Foreground="White" Width="220" Height="48" FontSize="12" Margin="0,0,10,0"/>
                    <!-- الزر 4 -->
                    <RadioButton x:Name="BtnDesign4" Style="{StaticResource MaterialDesignTabRadioButton}" 
                                 Content="4. الزجاج السينمائي الفاخر" Foreground="White" Width="220" Height="48" FontSize="12"/>
                </StackPanel>

                <!-- زر الإغلاق والعودة -->
                <Button Grid.Column="3" Content="تطبيق هذا التصميم ✓" Click="ApplyDesign_Click" 
                        Background="#10b981" BorderBrush="#10b981" Foreground="White" Height="40" Padding="16,0" FontWeight="Bold">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>

        <!-- ════════════════ محتوى التصاميم ════════════════ -->
        <Grid Grid.Row="1" Background="#020617">

            <!-- 🟩 التصميم 1: الملكي المظلم والزجاج المذهب (Frosted Dark Gold) -->
            <Grid Visibility="{Binding IsChecked, ElementName=BtnDesign1, Converter={StaticResource BooleanToVisibilityConverter}}">
                <!-- الخلفية الفاخرة مع تدرج لوني داكن وشبكة هندسية ذهبية -->
                <Grid>
                    <Grid.Background>
                        <RadialGradientBrush Center="0.5,0.5" RadiusX="0.7" RadiusY="0.7">
                            <GradientStop Color="#0f1c3f" Offset="0"/>
                            <GradientStop Color="#020617" Offset="1"/>
                        </RadialGradientBrush>
                    </Grid.Background>

                    <!-- محاكاة شبكة الخطوط الذهبية -->
                    <Path Data="M0,50 L2000,50 M0,150 L2000,150 M0,250 L2000,250 M0,350 L2000,350 M0,450 L2000,450 M0,550 L2000,550 M0,650 L2000,650 M0,750 L2000,750" Stroke="#11ffd700" StrokeThickness="0.5"/>
                    <Path Data="M100,0 L100,1000 M300,0 L300,1000 M500,0 L500,1000 M700,0 L700,1000 M900,0 L900,1000 M1100,0 L1100,1000 M1300,0 L1300,1000" Stroke="#11ffd700" StrokeThickness="0.5"/>
                </Grid>

                <!-- بطاقة الدخول العائمة -->
                <Border Width="450" Height="580" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Background="#99030712" CornerRadius="24" BorderBrush="#55d97706" BorderThickness="1.5"
                        Padding="32">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="40" ShadowDepth="0" Color="#d97706" Opacity="0.15"/>
                    </Border.Effect>
                    
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- اللوغو والترحيب -->
                            <RowDefinition Height="*"/>    <!-- مدخلات النص -->
                            <RowDefinition Height="Auto"/> <!-- زر الدخول والروابط السفلى -->
                        </Grid.RowDefinitions>

                        <!-- اللوغو (قبعة شيف وميزان ذهبي مدمجين بمهارة) -->
                        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,10,0,24">
                            <!-- أيقونة مجسمة -->
                            <Grid Width="90" Height="90">
                                <Ellipse Fill="#1e293b" Stroke="#d97706" StrokeThickness="2"/>
                                <materialDesign:PackIcon Kind="ScaleBalance" Foreground="#d97706" Width="44" Height="44" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,14,0,0"/>
                                <materialDesign:PackIcon Kind="ChefHat" Foreground="#fef08a" Width="30" Height="30" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0"/>
                            </Grid>
                            <TextBlock Text="لوحة تحكم ميزان المطاعم" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,14,0,0"/>
                            <TextBlock Text="النظام المالي المتكامل" FontSize="11" Foreground="#a1a1aa" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- مدخلات النص -->
                        <StackPanel Grid.Row="1" VerticalAlignment="Center">
                            <!-- اسم المستخدم -->
                            <TextBlock Text="اسم المستخدم" FontSize="12" Foreground="#d97706" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <Border Background="#1e293b" BorderBrush="#3f3f46" BorderThickness="1" CornerRadius="12" Padding="12,6" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Grid.Column="0" Kind="Account" Foreground="#d97706" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Grid.Column="1" Background="Transparent" BorderThickness="0" Foreground="White" FontSize="14" VerticalAlignment="Center" CaretBrush="White"
                                             materialDesign:HintAssist.Hint="أدخل اسم المستخدم" materialDesign:HintAssist.Foreground="#52525b" materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"/>
                                </Grid>
                            </Border>

                            <!-- كلمة المرور -->
                            <TextBlock Text="كلمة المرور" FontSize="12" Foreground="#d97706" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <Border Background="#1e293b" BorderBrush="#3f3f46" BorderThickness="1" CornerRadius="12" Padding="12,6" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Grid.Column="0" Kind="Lock" Foreground="#d97706" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <PasswordBox Grid.Column="1" Background="Transparent" BorderThickness="0" Foreground="White" FontSize="14" VerticalAlignment="Center" CaretBrush="White"/>
                                    <materialDesign:PackIcon Grid.Column="2" Kind="EyeOff" Foreground="#71717a" Width="18" Height="18" VerticalAlignment="Center" Cursor="Hand"/>
                                </Grid>
                            </Border>

                            <!-- رمز الأمان اليومي -->
                            <TextBlock Text="رمز الأمان / الكود" FontSize="12" Foreground="#d97706" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <Border Background="#1e293b" BorderBrush="#3f3f46" BorderThickness="1" CornerRadius="12" Padding="12,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Grid.Column="0" Kind="Key" Foreground="#d97706" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Grid.Column="1" Background="Transparent" BorderThickness="0" Foreground="White" FontSize="14" VerticalAlignment="Center" CaretBrush="White"
                                             materialDesign:HintAssist.Hint="كود الصندوق اليومي" materialDesign:HintAssist.Foreground="#52525b" materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- زر الدخول والروابط -->
                        <StackPanel Grid.Row="2" Margin="0,16,0,0">
                            <!-- زر ذهبي مجسم -->
                            <Button Content="دخول للمنظومة ✓" Height="48" FontSize="15" FontWeight="Bold" Foreground="#1e293b"
                                    BorderThickness="0" Margin="0,0,0,16">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="14"/>
                                    </Style>
                                </Button.Resources>
                                <Button.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#fbbf24" Offset="0"/>
                                        <GradientStop Color="#d97706" Offset="1"/>
                                    </LinearGradientBrush>
                                </Button.Background>
                                <Button.Effect>
                                    <DropShadowEffect BlurRadius="15" ShadowDepth="2" Color="#d97706" Opacity="0.3"/>
                                </Button.Effect>
                            </Button>

                            <Grid>
                                <CheckBox Content="تذكرني" Foreground="#a1a1aa" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Text="نسيت كلمة المرور؟" Foreground="#d97706" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Left" VerticalAlignment="Center" Cursor="Hand"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- 🟦 التصميم 2: اللوحة المنقسمة التنفيذية (Executive Split Panel) -->
            <Grid Visibility="{Binding IsChecked, ElementName=BtnDesign2, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#1e293b" Offset="0"/>
                        <GradientStop Color="#0f172a" Offset="1"/>
                    </LinearGradientBrush>
                </Grid.Background>

                <!-- بطاقة الدخول المنقسمة الكبيرة -->
                <Border Width="850" Height="520" CornerRadius="28" Background="White" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="40" ShadowDepth="4" Color="Black" Opacity="0.25"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>      <!-- النصف الأيسر: البيانات -->
                            <ColumnDefinition Width="1.1*"/>  <!-- النصف الأيمن: الهوية والمظهر المخملي -->
                        </Grid.ColumnDefinitions>

                        <!-- النصف الأيمن: واجهة الهوية الزرقاء المخملية -->
                        <Border Grid.Column="1" CornerRadius="0,28,28,0" Padding="40">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#1e3a8a" Offset="0"/>
                                    <GradientStop Color="#0f172a" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid>
                                <!-- رسم بياني هادئ بالخلفية -->
                                <Path Data="M0,350 Q100,280 200,320 T400,200 L400,450 L0,450 Z" Fill="#0a0000ff" VerticalAlignment="Bottom"/>

                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <!-- لوغو الميزان الذهبي الدائري الفاخر -->
                                    <Border Width="130" Height="130" Background="#1e293b" BorderBrush="#d97706" BorderThickness="4" CornerRadius="65" HorizontalAlignment="Center">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="25" Color="#d97706" Opacity="0.4"/>
                                        </Border.Effect>
                                        <Grid>
                                            <materialDesign:PackIcon Kind="Scale" Foreground="#fbbf24" Width="68" Height="68" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,15,0,0"/>
                                            <materialDesign:PackIcon Kind="ChefHat" Foreground="White" Width="36" Height="36" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,15,0,0"/>
                                        </Grid>
                                    </Border>
                                    
                                    <TextBlock Text="ميزان المطاعم" FontSize="26" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,20,0,0"/>
                                    <TextBlock Text="النظام الإداري والمالي المتكامل لإدارة المطاعم الفاخرة" FontSize="12" Foreground="#93c5fd" TextAlignment="Center" Width="300" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                    
                                    <!-- تفاصيل فخمة للرصانة والدقة -->
                                    <Border Background="#22ffffff" CornerRadius="8" Padding="12,6" Margin="0,24,0,0" HorizontalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="ShieldCheck" Foreground="#4ade80" Width="18" Height="18" Margin="0,0,8,0"/>
                                            <TextBlock Text="نظام محمي ومشفر بالكامل ✓" FontSize="11" Foreground="White" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- النصف الأيسر: مدخلات البيانات والتسجيل -->
                        <Border Grid.Column="0" Padding="40" Background="Transparent">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0">
                                <TextBlock Text="تسجيل الدخول للنظام" FontSize="20" FontWeight="Bold" Foreground="#1e293b"/>
                                <TextBlock Text="مرحباً بك مجدداً! يرجى إدخال بياناتك للدخول" FontSize="12" Foreground="#64748b" Margin="0,4,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                <!-- اسم المستخدم -->
                                <TextBlock Text="اسم المستخدم أو البريد:" FontSize="11" Foreground="#475569" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}" 
                                         materialDesign:HintAssist.Hint="اكتب اسم المستخدم هنا" FontSize="13" Padding="12,10" Margin="0,0,0,16"/>

                                <!-- كلمة المرور -->
                                <TextBlock Text="كلمة المرور:" FontSize="11" Foreground="#475569" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <PasswordBox Style="{StaticResource MaterialDesignOutlinedPasswordBox}" 
                                             materialDesign:HintAssist.Hint="••••••••" FontSize="13" Padding="12,10" Margin="0,0,0,16"/>

                                <!-- كود الدخول اليومي -->
                                <TextBlock Text="كود الصندوق اليومي:" FontSize="11" Foreground="#475569" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}" 
                                         materialDesign:HintAssist.Hint="الكود الرقمي للمطابقة" FontSize="13" Padding="12,10"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2">
                                <Grid Margin="0,0,0,16">
                                    <CheckBox Content="تذكرني" Foreground="#475569" FontSize="12" VerticalAlignment="Center"/>
                                    <TextBlock Text="نسيت كلمة المرور؟" Foreground="#1e3a8a" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Left" VerticalAlignment="Center" Cursor="Hand"/>
                                </Grid>

                                <!-- زر الدخول الفاخر -->
                                <Button Content="دخول لوحة التحكم ✓" Style="{StaticResource MaterialDesignFlatButton}" 
                                        Background="#1e3a8a" Foreground="White" Height="44" FontSize="14" FontWeight="Bold">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="10"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </StackPanel>
                        </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- 🟨 التصميم 3: الهندسي المعاصر البسيط (Contemporary Navy & Gold) -->
            <Grid Visibility="{Binding IsChecked, ElementName=BtnDesign3, Converter={StaticResource BooleanToVisibilityConverter}}">
                <!-- خلفية ديناميكية مقسمة فنياً مائلة -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <Border Grid.Column="0" Background="#0f172a"/>
                    <!-- الجزء الأيمن مائل وتدرج ذهبي -->
                    <Border Grid.Column="1">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#ffd700" Offset="0"/>
                                <GradientStop Color="#b45309" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    
                    <!-- رسم خط مائل ناعم -->
                    <Path Data="M 675,0 L 750,900 L 0,900 Z" Fill="#0f172a" Stretch="Fill"/>
                </Grid>

                <!-- بطاقة الدخول المطفأة الكبيرة عائمة وذات ظلال عميقة -->
                <Border Width="460" Height="620" CornerRadius="28" Background="White" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Padding="36">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="45" ShadowDepth="5" Color="#000" Opacity="0.3"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- الشعار العلوي -->
                            <RowDefinition Height="*"/>    <!-- المدخلات -->
                            <RowDefinition Height="Auto"/> <!-- الأزرار -->
                        </Grid.RowDefinitions>

                        <!-- اللوغو بلون كحلي وذهبي معاصر ومبسط -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,24">
                            <Grid Width="70" Height="70" HorizontalAlignment="Center">
                                <Ellipse Fill="#f1f5f9"/>
                                <materialDesign:PackIcon Kind="Scale" Foreground="#b45309" Width="36" Height="36" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,6,0,0"/>
                                <materialDesign:PackIcon Kind="ChefHat" Foreground="#0f172a" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0"/>
                            </Grid>
                            <TextBlock Text="ميزان المطاعم" FontSize="22" FontWeight="Bold" Foreground="#0f172a" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                            <TextBlock Text="نظام تسجيل الدخول المعاصر" FontSize="11" Foreground="#64748b" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- المدخلات -->
                        <StackPanel Grid.Row="1" VerticalAlignment="Center">
                            <!-- اسم المستخدم -->
                            <TextBlock Text="اسم المستخدم أو البريد:" FontSize="12" Foreground="#475569" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <Border Background="#f8fafc" BorderBrush="#cbd5e1" BorderThickness="1.5" CornerRadius="8" Padding="12,10" Margin="0,0,0,16">
                                <TextBox Background="Transparent" BorderThickness="0" Foreground="#0f172a" FontSize="13" VerticalAlignment="Center"
                                         materialDesign:HintAssist.Hint="اكتب اسم المستخدم" materialDesign:HintAssist.Foreground="#94a3b8" materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"/>
                            </Border>

                            <!-- كلمة المرور -->
                            <TextBlock Text="كلمة المرور:" FontSize="12" Foreground="#475569" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <Border Background="#f8fafc" BorderBrush="#cbd5e1" BorderThickness="1.5" CornerRadius="8" Padding="12,10" Margin="0,0,0,16">
                                <PasswordBox Background="Transparent" BorderThickness="0" Foreground="#0f172a" FontSize="13" VerticalAlignment="Center"/>
                            </Border>
                            
                            <Grid Margin="0,0,0,10">
                                <CheckBox Content="حفظ البيانات" Foreground="#64748b" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Text="هل نسيت كلمة المرور؟" Foreground="#b45309" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Left" VerticalAlignment="Center" Cursor="Hand"/>
                            </Grid>
                        </StackPanel>

                        <!-- أزرار الإجراءات -->
                        <StackPanel Grid.Row="2">
                            <!-- زر مسطح بلون ذهبي غامق مطفي -->
                            <Button Content="تسجيل الدخول ✓" Style="{StaticResource MaterialDesignFlatButton}" 
                                    Background="#b45309" Foreground="White" Height="46" FontSize="14" FontWeight="Bold" Margin="0,0,0,12">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="10"/>
                                    </Style>
                                </Button.Resources>
                            </Button>

                            <TextBlock Text="دعم فني وتواصل متاح 24/7" FontSize="10" Foreground="#94a3b8" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- 🟧 التصميم 4: الزجاج السينمائي الفاخر (Frosted Restaurant Cinematic) -->
            <Grid Visibility="{Binding IsChecked, ElementName=BtnDesign4, Converter={StaticResource BooleanToVisibilityConverter}}">
                <!-- خلفية لمحاكاة صالة مطعم فاخر ذو إضاءات دافئة (باستخدام التدرج المعقد المميز) -->
                <Grid>
                    <Grid.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#0b0f19" Offset="0"/>
                            <GradientStop Color="#1e1b4b" Offset="0.3"/>
                            <GradientStop Color="#311005" Offset="0.7"/>
                            <GradientStop Color="#030712" Offset="1"/>
                        </LinearGradientBrush>
                    </Grid.Background>
                    
                    <!-- إضاءات دافئة ذهبية محاكية للشموع في المطاعم -->
                    <Ellipse Width="400" Height="400" Fill="#22b45309" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-100,-100,0,0" />
                    <Ellipse Width="500" Height="500" Fill="#224338ca" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-150,-150" />
                </Grid>

                <!-- بطاقة الدخول الزجاجية الشفافة بنقاط ولمعان -->
                <Border Width="450" Height="590" CornerRadius="28" Background="#7f0c1020" BorderBrush="#33ffffff" BorderThickness="1.5" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Padding="36">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="40" ShadowDepth="0" Color="#000" Opacity="0.5"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- اللوغو والجمالية -->
                            <RowDefinition Height="*"/>    <!-- البيانات -->
                            <RowDefinition Height="Auto"/> <!-- زر الدخول -->
                        </Grid.RowDefinitions>

                        <!-- اللوغو الزجاجي الفاخر -->
                        <StackPanel Grid.Row="0" Margin="0,10,0,24">
                            <!-- أيقونة مجردة وبسيطة -->
                            <Border Width="80" Height="80" Background="#26ffffff" BorderBrush="#88ffffff" BorderThickness="1" CornerRadius="22" HorizontalAlignment="Center">
                                <Grid>
                                    <materialDesign:PackIcon Kind="Scale" Foreground="White" Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,8,0,0"/>
                                    <materialDesign:PackIcon Kind="ChefHat" Foreground="#fbbf24" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0"/>
                                </Grid>
                            </Border>
                            <TextBlock Text="لوحة تحكم ميزان المطاعم" FontSize="19" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,14,0,0"/>
                            <TextBlock Text="نظام التشغيل المالي المرن" FontSize="11" Foreground="#94a3b8" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- البيانات والمدخلات بتصميم خط نيون ناعم -->
                        <StackPanel Grid.Row="1" VerticalAlignment="Center">
                            <!-- اسم المستخدم -->
                            <TextBlock Text="اسم المستخدم" FontSize="11" Foreground="#94a3b8" Margin="0,0,0,6"/>
                            <TextBox Foreground="White" FontSize="14" BorderBrush="#55ffffff" BorderThickness="0,0,0,1.5" Padding="4,6" Margin="0,0,0,20"
                                     materialDesign:HintAssist.Hint="اكتب اسم المستخدم" materialDesign:HintAssist.Foreground="#4b5563"/>

                            <!-- كلمة المرور -->
                            <TextBlock Text="كلمة المرور" FontSize="11" Foreground="#94a3b8" Margin="0,0,0,6"/>
                            <PasswordBox Foreground="White" FontSize="14" BorderBrush="#55ffffff" BorderThickness="0,0,0,1.5" Padding="4,6" Margin="0,0,0,20"/>

                            <!-- كود الدخول -->
                            <TextBlock Text="كود الصندوق" FontSize="11" Foreground="#94a3b8" Margin="0,0,0,6"/>
                            <TextBox Foreground="White" FontSize="14" BorderBrush="#55ffffff" BorderThickness="0,0,0,1.5" Padding="4,6"
                                     materialDesign:HintAssist.Hint="كود اليومية المعتمد" materialDesign:HintAssist.Foreground="#4b5563"/>
                        </StackPanel>

                        <!-- زر الدخول الذهبي المطفي الفخم -->
                        <StackPanel Grid.Row="2" Margin="0,20,0,0">
                            <Button Content="تسجيل الدخول ✓" Style="{StaticResource MaterialDesignFlatButton}" 
                                    Background="#d97706" Foreground="White" Height="46" FontSize="14" FontWeight="Bold" Margin="0,0,0,16">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="12"/>
                                    </Style>
                                </Button.Resources>
                                <Button.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="1" Color="#d97706" Opacity="0.3"/>
                                </Button.Effect>
                            </Button>

                            <Grid>
                                <CheckBox Content="تذكرني" Foreground="#94a3b8" FontSize="11" VerticalAlignment="Center"/>
                                <TextBlock Text="نسيت كلمة المرور؟" Foreground="White" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Left" VerticalAlignment="Center" Cursor="Hand"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

        </Grid>
    </Grid>
</Window>
