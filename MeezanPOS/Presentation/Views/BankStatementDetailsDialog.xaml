<Window x:Class="MeezanPOS.Presentation.Views.BankStatementDetailsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="تفاصيل مبيعات الخدمات المصرفية"
        Width="880"
        Height="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource Brush.Canvas}"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource Font.Body}"
        TextElement.FontFamily="{StaticResource Font.Body}"
        ShowInTaskbar="False">

    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- الهيدر والبطاقة التعريفية والفلاتر -->
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>     <!-- الجدول أو رسالة "لا يوجد تفاصيل" -->
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>  <!-- أزرار الإجراء -->
        </Grid.RowDefinitions>

        <!-- ═══════ الجزء العلوي: هيدر النافذة وشريط الفلاتر ═══════ -->
        <StackPanel Grid.Row="0">
            <!-- كرت ترويسة الحساب والمعلومات -->
            <Border Background="White" CornerRadius="12" Padding="16,12" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" Margin="0,0,0,10">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Color="{StaticResource Color.TextFaint}" Opacity="0.08"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CashMultiple" Width="24" Height="24" Foreground="{StaticResource Brush.Income}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="تفاصيل مبيعات الخدمات المصرفية" FontSize="17" FontWeight="Bold" Foreground="{StaticResource Brush.TextPrimary}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="32,6,0,0">
                            <TextBlock Text="{Binding SelectedTransactionDate, StringFormat=تاريخ اليوم: \{0:yyyy/MM/dd\}}" FontSize="13.5" Foreground="{StaticResource Brush.TextMuted}" FontWeight="SemiBold"/>
                            <TextBlock Text="  |  " Foreground="{StaticResource Brush.BorderStrong}" FontSize="13.5"/>
                            <TextBlock Text="{Binding StatementAccount.DisplayName, StringFormat=الحساب البنكي: \{0\}}" FontSize="13.5" Foreground="{StaticResource Brush.TextMuted}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- كرت إجمالي اليوم -->
                    <Border Grid.Column="1" Background="{StaticResource Brush.IncomeSoft}" CornerRadius="8" Padding="14,8" BorderBrush="{StaticResource Brush.Income}" BorderThickness="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="إجمالي اليوم: " FontSize="13" Foreground="{StaticResource Brush.IncomeText}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding SelectedTransactionTotalAmount, StringFormat=\{0:N2\} د.ل}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource Brush.IncomeText}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- شريط التصفية والفلاتر -->
            <Border Background="{StaticResource Brush.LockedSoft}" CornerRadius="12" Padding="16,8" BorderBrush="{StaticResource Brush.BorderStrong}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="تصفية حسب الكاشير:" VerticalAlignment="Center" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource Brush.TextStrong}"/>
                    <ComboBox Grid.Column="2" ItemsSource="{Binding CashierFilters}" SelectedItem="{Binding SelectedCashierFilter, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Height="34" FontSize="13.5" VerticalAlignment="Center" Style="{StaticResource MaterialDesignComboBox}" Foreground="Black"/>

                    <TextBlock Grid.Column="4" Text="تصفية حسب الوردية:" VerticalAlignment="Center" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource Brush.TextStrong}"/>
                    <ComboBox Grid.Column="6" ItemsSource="{Binding ShiftFilters}" SelectedItem="{Binding SelectedShiftFilter, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Height="34" FontSize="13.5" VerticalAlignment="Center" Style="{StaticResource MaterialDesignComboBox}" Foreground="Black"/>

                    <!-- زر إعادة تعيين التصفية -->
                    <Button Grid.Column="8" Command="{Binding ResetFiltersCommand}" Style="{StaticResource MaterialDesignFlatButton}" Foreground="{StaticResource Brush.PrimaryInteractive}" Height="34" Padding="8,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FilterRemoveOutline" Width="16" Height="16" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="إعادة تعيين" FontSize="12.5" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </StackPanel>

        <!-- ═══════ الجزء الأوسط: الجدول أو التنبيه ═══════ -->
        <Grid Grid.Row="2">
            <!-- 1. جدول الحركات التفصيلية (يظهر فقط إذا كان هناك تفاصيل) -->
            <Border Background="White" CornerRadius="12" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" Padding="0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasNoDetails}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Color="{StaticResource Color.TextFaint}" Opacity="0.06"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource Brush.SurfaceAlt}" CornerRadius="12,12,0,0" Padding="16,10" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ViewList" Width="20" Height="20" Foreground="{StaticResource Brush.PrimaryInteractive}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="تفاصيل حركات الورديات والمسؤولين" FontSize="14.5" FontWeight="Bold" Foreground="{StaticResource Brush.TextStrong}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <DataGrid CanUserSortColumns="False" Grid.Row="1"
                              ItemsSource="{Binding SelectedTransactionDetails}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              BorderThickness="0"
                              Background="Transparent"
                              RowHeight="44"
                              FontSize="14"
                              AlternatingRowBackground="#F5F7FA"
                              materialDesign:DataGridAssist.ColumnHeaderPadding="10"
                              materialDesign:DataGridAssist.CellPadding="10,4"
                              VerticalScrollBarVisibility="Auto">
                        <!-- تنسيق رؤوس الأعمدة لتكون في المنتصف وبخط غليظ -->
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="FontSize" Value="14"/>
                                <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <!-- عمود المطابقة (مربع اختيار مكبر) -->
                            <DataGridTemplateColumn Header="المطابقة" Width="Auto" MinWidth="85" IsReadOnly="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsReconciled, UpdateSourceTrigger=PropertyChanged}"
                                                  Command="{Binding DataContext.ToggleReconciliationCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                  CommandParameter="{Binding}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center">
                                            <CheckBox.LayoutTransform>
                                                <ScaleTransform ScaleX="1.4" ScaleY="1.4"/>
                                            </CheckBox.LayoutTransform>
                                        </CheckBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- اسم الكاشير (قراءة فقط) -->
                            <DataGridTemplateColumn Header="الموظف/الكاشير" Width="*" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <materialDesign:PackIcon Kind="AccountOutline" Width="17" Height="17" Foreground="{StaticResource Brush.TextMuted}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding CashierName}" FontWeight="SemiBold" Foreground="{StaticResource Brush.TextStrong}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- الوردية (قراءة فقط - محاذاة في المنتصف) -->
                            <DataGridTextColumn Header="الوردية" Binding="{Binding ShiftName}" Width="Auto" MinWidth="130" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}"/>
                                        <Setter Property="TextAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- رقم الفاتورة (قراءة فقط - محاذاة في المنتصف) -->
                            <DataGridTextColumn Header="رقم الفاتورة" Binding="{Binding InvoiceNumber}" Width="Auto" MinWidth="120" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}"/>
                                        <Setter Property="TextAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- رقم التحويل (قراءة فقط - محاذاة في المنتصف) -->
                            <DataGridTextColumn Header="رقم التحويل" Binding="{Binding TransferReference}" Width="Auto" MinWidth="120" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource Brush.TextFaint}"/>
                                        <Setter Property="TextAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- المبلغ (قراءة فقط - محاذاة في المنتصف) -->
                            <DataGridTextColumn Header="المبلغ" Binding="{Binding Amount, StringFormat=N2}" Width="Auto" MinWidth="130" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource Brush.IncomeText}"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="TextAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- إجماليات الورديات التفاعلية (جديد) -->
                    <Border Grid.Row="2" Background="{StaticResource Brush.SurfaceAlt}" CornerRadius="0,0,12,12" Padding="16,12" BorderBrush="{StaticResource Brush.BorderStrong}" BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="ChartPie" Width="20" Height="20" Foreground="{StaticResource Brush.PrimaryInteractive}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="إجماليات مبيعات الورديات:" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource Brush.TextSecondary}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <ItemsControl Grid.Column="1" ItemsSource="{Binding ShiftTotals}" Margin="16,0,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource Brush.PrimarySoft}" BorderBrush="{StaticResource Brush.SidebarText}" BorderThickness="1" CornerRadius="6" Padding="14,4" Margin="0,0,12,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding ShiftName, StringFormat=\{0\}: }" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Brush.Primary}"/>
                                                <TextBlock Text="{Binding TotalAmount, StringFormat=N2}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource Brush.PrimaryInteractive}"/>
                                                <TextBlock Text=" د.ل" FontSize="11.5" Foreground="{StaticResource Brush.PrimaryInteractive}" VerticalAlignment="Bottom"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- 2. كرت التوضيح عند عدم وجود تفاصيل (يظهر فقط إذا كان HasNoDetails صحيحاً) -->
            <Border CornerRadius="12" BorderBrush="{StaticResource Brush.PendingSoft}" BorderThickness="1" Padding="32">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasNoDetails}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{StaticResource Color.PendingSoft}" Offset="0"/>
                        <GradientStop Color="{StaticResource Color.PendingSoft}" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Color="{StaticResource Color.Pending}" Opacity="0.05"/>
                </Border.Effect>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Background="{StaticResource Brush.PendingSoft}" CornerRadius="40" Width="80" Height="80" HorizontalAlignment="Center" Margin="0,0,0,16" BorderBrush="{StaticResource Brush.Pending}" BorderThickness="1">
                        <materialDesign:PackIcon Kind="AlertCircleOutline" Width="36" Height="36" Foreground="{StaticResource Brush.Pending}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="لا توجد تفاصيل مدخلة" FontSize="17" FontWeight="Bold" Foreground="{StaticResource Brush.PendingText}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBlock FontSize="14" Foreground="{StaticResource Brush.PendingText}" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="420" LineHeight="20">
                        لم يتم تسجيل تفاصيل فردية لمبيعات الخدمات المصرفية في شاشة الحركة اليومية (الورديات) لهذا اليوم.
                    </TextBlock>
                    <TextBlock Text="تم إدراج القيمة الإجمالية فقط كقيد مبيعات يومي مجمع." FontSize="12" Foreground="{StaticResource Brush.Pending}" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══════ الجزء السفلي: أزرار الإجراء ═══════ -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <!-- زر طباعة PDF (جديد) -->
            <Button Command="{Binding PrintDetailsPdfCommand}" Style="{StaticResource MaterialDesignFlatButton}" Background="{StaticResource Brush.PrimarySoft}" Foreground="{StaticResource Brush.PrimaryDark}" Height="38" Padding="20,0" Margin="0,0,12,0" materialDesign:ButtonAssist.CornerRadius="8">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Printer" Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="طباعة تقرير PDF" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13"/>
                </StackPanel>
            </Button>
            
            <!-- زر الإغلاق -->
            <Button Click="CloseButton_Click" Style="{StaticResource MaterialDesignFlatButton}" Background="{StaticResource Brush.BorderStrong}" Foreground="{StaticResource Brush.TextStrong}" Height="38" Padding="20,0" materialDesign:ButtonAssist.CornerRadius="8">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Close" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="إغلاق النافذة" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12.5"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>
