<Window x:Class="MeezanPOS.Presentation.Views.PeriodUnlockDialog"
        FontFamily="{StaticResource Font.Body}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="إلغاء قفل الفترة المالية" 
        Height="420" Width="480"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FlowDirection="RightToLeft"
        MouseLeftButtonDown="DragWindow">

    <Border Background="White" CornerRadius="20" BorderBrush="#cbd5e1" BorderThickness="1.5">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="4" Color="#1E293B" Opacity="0.2"/>
        </Border.Effect>

        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="LockOpenOutline" Width="24" Height="24" Foreground="#f97316" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="إلغاء قفل الفترة المالية للمراجعة" FontSize="18" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center"/>
                </StackPanel>

                <Button Grid.Column="1" Style="{StaticResource MaterialDesignToolButton}" Width="32" Height="32" Padding="0" Click="Cancel_Click" Cursor="Hand">
                    <materialDesign:PackIcon Kind="Close" Width="20" Height="20" Foreground="#64748b"/>
                </Button>
            </Grid>

            <!-- Divider -->
            <Separator Grid.Row="1" Margin="0,16" Background="#f1f5f9"/>

            <!-- Form Inputs -->
            <StackPanel Grid.Row="2" VerticalAlignment="Top">
                <!-- Standard Reason -->
                <TextBlock Text="السبب القياسي لإلغاء القفل:" FontSize="13" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,8"/>
                <ComboBox x:Name="CbReason" Height="45" FontSize="13" Padding="10,6" VerticalContentAlignment="Center" 
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          Margin="0,0,0,16" Cursor="Hand">
                    <ComboBoxItem Content="خطأ إدخال البيانات" IsSelected="True"/>
                    <ComboBoxItem Content="اكتشاف مصروف مفقود"/>
                    <ComboBoxItem Content="إعادة مراجعة الجرد"/>
                    <ComboBoxItem Content="تصحيح قيد مالي"/>
                    <ComboBoxItem Content="سبب آخر"/>
                </ComboBox>

                <!-- Detailed Reason -->
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="الشرح التفصيلي (الحد الأدنى 20 حرفاً):" FontSize="13" FontWeight="SemiBold" Foreground="#475569"/>
                    <TextBlock Grid.Column="1" x:Name="TxtCharCount" Text="0 / 20" FontSize="12" Foreground="#64748b" VerticalAlignment="Bottom"/>
                </Grid>

                <TextBox x:Name="TxtDetailReason" Height="100" TextWrapping="Wrap" AcceptsReturn="True"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         materialDesign:HintAssist.Hint="اكتب هنا تفاصيل وسبب فتح الفترة وإجراء التعديلات..."
                         TextChanged="TxtDetailReason_TextChanged"/>
            </StackPanel>

            <!-- Footer Buttons -->
            <Grid Grid.Row="3" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Confirm Button -->
                <Button Grid.Column="0" x:Name="BtnConfirm"
                        Click="Confirm_Click"
                        Style="{StaticResource MaterialDesignRaisedButton}" 
                        Background="#f97316" BorderBrush="#f97316" Foreground="White"
                        Height="45" Cursor="Hand" IsEnabled="False">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="12"/>
                        </Style>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="LockOpenOutline" Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="إلغاء قفل وتعديل" VerticalAlignment="Center" FontWeight="Bold"/>
                    </StackPanel>
                </Button>

                <!-- Cancel Button -->
                <Button Grid.Column="2" 
                        Click="Cancel_Click"
                        Style="{StaticResource MaterialDesignOutlinedButton}" 
                        Foreground="#64748b" BorderBrush="#cbd5e1"
                        Height="45" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="12"/>
                        </Style>
                    </Button.Resources>
                    <TextBlock Text="إلغاء وتراجع" FontWeight="Bold"/>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
