<Window x:Class="MeezanPOS.Presentation.Views.ChangePasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="تغيير كلمة المرور"
        FontFamily="{StaticResource Font.Body}"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        FlowDirection="RightToLeft"
        MouseLeftButtonDown="DragWindow">

    <Border Background="{StaticResource Brush.Surface}" CornerRadius="16" BorderBrush="{StaticResource Brush.BorderStrong}" BorderThickness="1"
            Effect="{StaticResource Shadow.Dialog}" Margin="12">
        <StackPanel Margin="24">
            <DockPanel Margin="0,0,0,6">
                <Button x:Name="BtnClose" DockPanel.Dock="Right" Style="{StaticResource MaterialDesignToolButton}" Width="32" Height="32" Padding="0"
                        Click="Cancel_Click" ToolTip="إغلاق">
                    <materialDesign:PackIcon Kind="Close" Width="20" Height="20" Foreground="{StaticResource Brush.TextMuted}"/>
                </Button>
                <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource Brush.PrimarySoft}" Margin="0,0,12,0">
                    <materialDesign:PackIcon Kind="KeyChange" Width="22" Height="22" Foreground="{StaticResource Brush.Primary}"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="تغيير كلمة المرور" Style="{StaticResource Text.SectionTitle}" VerticalAlignment="Center"/>
            </DockPanel>

            <TextBlock x:Name="TxtIntro" TextWrapping="Wrap" Style="{StaticResource Text.Caption}" Margin="0,4,0,16"
                       Text="أدخل كلمة المرور الحالية ثم كلمة المرور الجديدة."/>

            <TextBlock Text="كلمة المرور الحالية" Style="{StaticResource Text.Label}" Margin="0,0,0,6"/>
            <PasswordBox x:Name="TxtCurrent" Style="{StaticResource MaterialDesignOutlinedPasswordBox}" Height="44" Padding="12,0"
                         VerticalContentAlignment="Center" FlowDirection="LeftToRight" Margin="0,0,0,14"/>

            <TextBlock Text="كلمة المرور الجديدة" Style="{StaticResource Text.Label}" Margin="0,0,0,6"/>
            <PasswordBox x:Name="TxtNew" Style="{StaticResource MaterialDesignOutlinedPasswordBox}" Height="44" Padding="12,0"
                         VerticalContentAlignment="Center" FlowDirection="LeftToRight" Margin="0,0,0,14"/>

            <TextBlock Text="تأكيد كلمة المرور الجديدة" Style="{StaticResource Text.Label}" Margin="0,0,0,6"/>
            <PasswordBox x:Name="TxtConfirm" Style="{StaticResource MaterialDesignOutlinedPasswordBox}" Height="44" Padding="12,0"
                         VerticalContentAlignment="Center" FlowDirection="LeftToRight" Margin="0,0,0,8"/>

            <TextBlock x:Name="TxtRules" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,0,0,12"/>

            <Border x:Name="ErrorBox" Visibility="Collapsed" Background="{StaticResource Brush.ExpenseSoft}" CornerRadius="8" Padding="12,8" Margin="0,0,0,12">
                <TextBlock x:Name="TxtError" Foreground="{StaticResource Brush.ExpenseText}" TextWrapping="Wrap"/>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" FlowDirection="LeftToRight">
                <Button x:Name="BtnCancel" Content="إلغاء" Style="{StaticResource Button.Secondary}" Click="Cancel_Click" Margin="0,0,10,0" MinWidth="100"/>
                <Button x:Name="BtnSave" Content="حفظ كلمة المرور" Style="{StaticResource Button.Primary}" Click="Save_Click" IsDefault="True" MinWidth="150"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
