<Window x:Class="MeezanPOS.Presentation.Views.PartnerStatementWindow"
        FontFamily="{StaticResource Font.Body}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="كشف حساب الشريك"
        Height="750" Width="1050"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FlowDirection="RightToLeft"
        MouseLeftButtonDown="DragWindow">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Border Background="White" CornerRadius="16" BorderBrush="{StaticResource Brush.BorderStrong}" BorderThickness="1.5">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Color="{StaticResource Color.TextPrimary}" Opacity="0.15"/>
        </Border.Effect>

        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- الهيدر -->
                <RowDefinition Height="Auto"/>  <!-- كروت الإحصاء -->
                <RowDefinition Height="Auto"/>  <!-- الفلاتر -->
                <RowDefinition Height="*"/>     <!-- الجدول -->
                <RowDefinition Height="Auto"/>  <!-- الأزرار -->
            </Grid.RowDefinitions>

            <!-- ═══════════════════════════════════════════════════════ -->
            <!-- 1. الهيدر -->
            <!-- ═══════════════════════════════════════════════════════ -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="FileDocumentOutline" Width="26" Height="26" Foreground="{StaticResource Brush.PrimaryInteractive}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock FontSize="18" FontWeight="Bold" Foreground="{StaticResource Brush.TextPrimary}" VerticalAlignment="Center">
                        <Run Text="كشف حساب الشريك: "/>
                        <Run Text="{Binding PartnerName}" Foreground="{StaticResource Brush.PrimaryInteractive}"/>
                    </TextBlock>
                </StackPanel>

                <Button Grid.Column="1" Style="{StaticResource MaterialDesignToolButton}" Width="32" Height="32" Padding="0" Click="Close_Click" Cursor="Hand">
                    <materialDesign:PackIcon Kind="Close" Width="20" Height="20" Foreground="{StaticResource Brush.TextMuted}"/>
                </Button>
            </Grid>

            <!-- ═══════════════════════════════════════════════════════ -->
            <!-- 2. كروت الإحصاء (4 كروت) -->
            <!-- ═══════════════════════════════════════════════════════ -->
            <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,16">
                <!-- إجمالي التمويل -->
                <Border Background="{StaticResource Brush.ExpenseSoft}" CornerRadius="12" Padding="16,12" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="إجمالي تمويل الشريك" FontSize="11.5" Foreground="{StaticResource Brush.ExpenseText}" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding TotalDebts, StringFormat=N2}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Brush.Expense}"/>
                    </StackPanel>
                </Border>
                <!-- إجمالي التسويات -->
                <Border Background="{StaticResource Brush.IncomeSoft}" CornerRadius="12" Padding="16,12" Margin="4,0">
                    <StackPanel>
                        <TextBlock Text="إجمالي التسويات" FontSize="11.5" Foreground="{StaticResource Brush.IncomeText}" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding TotalSettlements, StringFormat=N2}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Brush.Income}"/>
                    </StackPanel>
                </Border>
                <!-- الرصيد الحالي -->
                <Border Background="{StaticResource Brush.PrimarySoft}" CornerRadius="12" Padding="16,12" Margin="4,0">
                    <StackPanel>
                        <TextBlock Text="الرصيد الحالي" FontSize="11.5" Foreground="{StaticResource Brush.Primary}" Margin="0,0,0,4"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding CurrentBalance, StringFormat=N2}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Brush.PrimaryInteractive}"/>
                            <TextBlock Text="{Binding BalanceDirectionText}" FontSize="10.5" Foreground="{StaticResource Brush.TextMuted}" VerticalAlignment="Bottom" Margin="8,0,0,2"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <!-- عدد العمليات -->
                <Border Background="{StaticResource Brush.PrimarySoft}" CornerRadius="12" Padding="16,12" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="عدد العمليات" FontSize="11.5" Foreground="{StaticResource Brush.PrimaryDark}" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding TransactionCount}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Brush.PrimaryInteractive}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- ═══════════════════════════════════════════════════════ -->
            <!-- 3. شريط الفلاتر -->
            <!-- ═══════════════════════════════════════════════════════ -->
            <Border Grid.Row="2" Background="{StaticResource Brush.SurfaceAlt}" CornerRadius="10" Padding="14,10" Margin="0,0,0,12" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="من:" FontSize="12.5" Foreground="{StaticResource Brush.TextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <DatePicker SelectedDate="{Binding FilterDateFrom}" Width="140" FontSize="12.5" materialDesign:HintAssist.Hint="تاريخ البداية" Margin="0,0,16,0"/>

                    <TextBlock Text="إلى:" FontSize="12.5" Foreground="{StaticResource Brush.TextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <DatePicker SelectedDate="{Binding FilterDateTo}" Width="140" FontSize="12.5" materialDesign:HintAssist.Hint="تاريخ النهاية" Margin="0,0,16,0"/>

                    <ComboBox Width="150" FontSize="12.5" SelectedItem="{Binding FilterTransactionType}"
                              materialDesign:HintAssist.Hint="نوع الحركة" Margin="0,0,16,0">
                        <ComboBoxItem Content="الكل"/>
                        <ComboBoxItem Content="دين على المطعم"/>
                        <ComboBoxItem Content="تسوية ذمة"/>
                    </ComboBox>

                    <Button Content="تصنيف" Command="{Binding ApplyFilterCommand}"
                            Style="{StaticResource MaterialDesignFlatMidBgButton}"
                            Height="32" Padding="16,0" FontSize="12"
                            materialDesign:ButtonAssist.CornerRadius="8" Margin="0,0,6,0"/>
                    <Button Content="إعادة" Command="{Binding ResetFilterCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Height="32" Padding="16,0" FontSize="12"
                            materialDesign:ButtonAssist.CornerRadius="8"/>
                </StackPanel>
            </Border>

            <!-- ═══════════════════════════════════════════════════════ -->
            <!-- 4. جدول كشف الحساب (Banking Statement DataGrid) -->
            <!-- ═══════════════════════════════════════════════════════ -->
            <Border Grid.Row="3" CornerRadius="10" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" Padding="0">
                <DataGrid CanUserSortColumns="False" ItemsSource="{Binding StatementEntries}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          BorderThickness="0"
                          Background="Transparent"
                          RowHeight="40"
                          FontSize="13"
                          AlternatingRowBackground="#F5F7FA"
                          materialDesign:DataGridAssist.ColumnHeaderPadding="10"
                          materialDesign:DataGridAssist.CellPadding="10,6"
                          VerticalScrollBarVisibility="Auto"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          MouseDoubleClick="StatementGrid_MouseDoubleClick">

                    <DataGrid.Columns>
                        <!-- التسلسل -->
                        <DataGridTextColumn Header="م" Binding="{Binding SequenceNumber}" Width="Auto" MinWidth="50">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="{StaticResource Brush.TextFaint}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- التاريخ -->
                        <DataGridTextColumn Header="التاريخ" Binding="{Binding TransactionDate, StringFormat=yyyy/MM/dd}" Width="Auto" MinWidth="110">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- نوع الحركة -->
                        <DataGridTextColumn Header="النوع" Binding="{Binding TransactionType}" Width="Auto" MinWidth="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSettlement}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Brush.Income}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSettlement}" Value="False">
                                            <Setter Property="Foreground" Value="{StaticResource Brush.Expense}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- البيان -->
                        <DataGridTextColumn Header="البيان" Binding="{Binding Description}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource Brush.TextStrong}"/>
                                    <Setter Property="TextWrapping" Value="NoWrap"/>
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- طريقة الدفع -->
                        <DataGridTextColumn Header="طريقة الدفع" Binding="{Binding PaymentMethod}" Width="Auto" MinWidth="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- المرجع -->
                        <DataGridTextColumn Header="المرجع" Binding="{Binding TransferReference}" Width="Auto" MinWidth="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- المبلغ -->
                        <DataGridTextColumn Header="المبلغ" Binding="{Binding Amount, StringFormat=N2}" Width="Auto" MinWidth="130">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="FontSize" Value="13.5"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSettlement}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Brush.Income}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSettlement}" Value="False">
                                            <Setter Property="Foreground" Value="{StaticResource Brush.Expense}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- الرصيد التراكمي -->
                        <DataGridTextColumn Header="الرصيد" Binding="{Binding RunningBalance, StringFormat=N2}" Width="Auto" MinWidth="130">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="FontSize" Value="14"/>
                                    <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- اتجاه الرصيد -->
                        <DataGridTextColumn Header="الاتجاه" Binding="{Binding BalanceDirectionText}" Width="Auto" MinWidth="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Center"/>
                                    <Setter Property="FontSize" Value="11"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BalanceDirection}" Value="RestaurantOwesPartner">
                                            <Setter Property="Foreground" Value="{StaticResource Brush.Expense}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding BalanceDirection}" Value="Settled">
                                            <Setter Property="Foreground" Value="{StaticResource Brush.Income}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- ═══════════════════════════════════════════════════════ -->
            <!-- 5. الأزرار السفلية -->
            <!-- ═══════════════════════════════════════════════════════ -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,16,0,0">
                <Button Command="{Binding ExportToPdfCommand}" Style="{StaticResource MaterialDesignFlatMidBgButton}"
                        Background="{StaticResource Brush.PrimarySoft}" Foreground="{StaticResource Brush.PrimaryInteractive}" Height="38" Padding="20,0"
                        materialDesign:ButtonAssist.CornerRadius="8" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FilePdfBox" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="تصدير PDF" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12.5"/>
                    </StackPanel>
                </Button>
                <Button Click="Close_Click" Style="{StaticResource MaterialDesignFlatButton}"
                        Background="{StaticResource Brush.LockedSoft}" Foreground="{StaticResource Brush.TextStrong}" Height="38" Padding="20,0"
                        materialDesign:ButtonAssist.CornerRadius="8">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Close" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="إغلاق" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12.5"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- حالة التحميل -->
            <ProgressBar Grid.Row="3"
                         Style="{StaticResource MaterialDesignCircularProgressBar}"
                         IsIndeterminate="True"
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                         Width="40" Height="40"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
    </Border>
</Window>
