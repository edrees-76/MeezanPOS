<UserControl x:Class="MeezanPOS.Presentation.Views.BankingServicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:MeezanPOS.Application.ViewModels"
             xmlns:enums="clr-namespace:MeezanPOS.Domain.Enums"
             xmlns:converters="clr-namespace:MeezanPOS.Presentation.Converters"
             xmlns:views="clr-namespace:MeezanPOS.Presentation.Views"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200"
             FlowDirection="RightToLeft"
             Background="#F5F7FA">
    
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        
        <!-- Converter for Inverse Boolean -->
        <materialDesign:BooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" FalseValue="Visible" TrueValue="Collapsed" />
        <converters:TransactionTypeToNameConverter x:Key="TransactionTypeToNameConverter" />

        <!-- Modern Segmented TabControl Style -->
        <Style x:Key="ModernSegmentedTabControlStyle" TargetType="TabControl">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Beautiful Floating Header Container (RTL Right-Aligned Segmented Control) -->
                            <Border Grid.Row="0" 
                                    Background="#F1F5F9" 
                                    CornerRadius="14" 
                                    Padding="5" 
                                    HorizontalAlignment="Right" 
                                    Margin="0,0,0,24"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="1">
                                <TabPanel x:Name="HeaderPanel" 
                                          IsItemsHost="True" 
                                          KeyboardNavigation.TabIndex="1" 
                                          Panel.ZIndex="1"/>
                            </Border>

                            <!-- Tab Page Content -->
                            <Border Grid.Row="1" 
                                    Background="Transparent" 
                                    KeyboardNavigation.TabIndex="2" 
                                    KeyboardNavigation.TabNavigation="Local" 
                                    KeyboardNavigation.DirectionalNavigation="Contained">
                                <ContentPresenter x:Name="PART_SelectedContentHost" 
                                                  ContentSource="SelectedContent" 
                                                  Margin="{TemplateBinding Padding}"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Segmented TabItem Style -->
        <Style x:Key="ModernSegmentedTabItemStyle" TargetType="TabItem">
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <ContentPresenter Content="{TemplateBinding Content}"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="10" 
                                Padding="28,10" 
                                Margin="2,0"
                                SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="ContentSite"
                                              ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Hover state for unselected tab -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsSelected" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Border" Property="Background" Value="#E2E8F0"/>
                                <Setter Property="Foreground" Value="#1E293B"/>
                            </MultiTrigger>
                            
                            <!-- Selected State (Floating Card with DropShadow) -->
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#FFFFFF"/>
                                <Setter Property="Foreground" Value="#3F51B5"/>
                                <Setter TargetName="Border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="10" ShadowDepth="1.5" Color="#64748B" Opacity="0.18"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- المحتوى الرئيسي للمدير المالي -->
        <Grid Margin="32,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ═══════════ القسم العلوي: العنوان والتحديث ═══════════ -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0">
                    <TextBlock Text="إدارة الحسابات البنكية والخدمات المصرفية" FontSize="26" FontWeight="Bold" Foreground="#1E293B"/>
                    <TextBlock Text="إدارة الحسابات البنكية (شخصي ومختلط)، مطابقة مبيعات البطاقات، ومتابعة مسحوبات وديون الشركاء بمرونة وأمان." FontSize="14" Foreground="#64748b" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding LoadDataCommand}" Style="{StaticResource MaterialDesignFlatButton}" Foreground="#3F51B5" Background="#e0eaff" Height="40" Padding="16,0" Margin="0,0,10,0" materialDesign:ButtonAssist.CornerRadius="8">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Refresh" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="تحديث البيانات" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- مؤشر التحميل -->
            <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="4" Background="Transparent" Foreground="#3F51B5" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,16"/>

            <!-- ═══════════ محتوى التبويبات الرئيسي ═══════════ -->
            <TabControl Grid.Row="2" Style="{StaticResource ModernSegmentedTabControlStyle}" FontSize="14">
                
                <!-- ────── Tab 1: الحسابات البنكية والخزائن ────── -->
                <TabItem Style="{StaticResource ModernSegmentedTabItemStyle}">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Bank" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="الحسابات البنكية والخزينة" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </StackPanel>
                        </TabItem.Header>
                        <Grid Margin="16,20,16,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="380"/> <!-- القائمة -->
                                <ColumnDefinition Width="24"/>  <!-- فاصل -->
                                <ColumnDefinition Width="*"/>   <!-- التفاصيل -->
                            </Grid.ColumnDefinitions>

                            <!-- قائمة الحسابات -->
                            <Grid Grid.Column="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Button Grid.Row="0" Command="{Binding OpenAddAccountCommand}" Style="{StaticResource MaterialDesignFlatButton}" Background="#3F51B5" Foreground="White" Height="42" Padding="16,0" Margin="0,0,0,16" materialDesign:ButtonAssist.CornerRadius="10">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Plus" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="إضافة حساب بنكي جديد" VerticalAlignment="Center" FontWeight="Bold"/>
                                    </StackPanel>
                                </Button>

                                <ListBox Grid.Row="1" ItemsSource="{Binding BankAccounts}" SelectedItem="{Binding SelectedAccount}" BorderThickness="0" Background="Transparent" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0,0,0,10"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <ContentPresenter/>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="AccountCard" Background="#f8fafc" CornerRadius="12" Padding="16,14" BorderBrush="#f1f5f9" BorderThickness="1" Cursor="Hand">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0" Background="#EEF2FF" CornerRadius="8" Width="40" Height="40" Margin="0,0,12,0">
                                                        <materialDesign:PackIcon Kind="BankOutline" Foreground="#3F51B5" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding FriendlyName}" FontSize="15" FontWeight="Bold" Foreground="#1E293B"/>
                                                        <TextBlock Text="{Binding BankName}" FontSize="12" Foreground="#64748b" Margin="0,2,0,0"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                        <TextBlock Text="{Binding CurrentBalance, StringFormat={}{0:N2} د.ل}" FontSize="14" FontWeight="Bold" Foreground="#16A34A" HorizontalAlignment="Left"/>
                                                        <Border CornerRadius="4" Padding="4,2" Margin="0,4,0,0" HorizontalAlignment="Left">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="#DCFCE7"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding AccountType}" Value="PersonalMixed">
                                                                            <Setter Property="Background" Value="#FEF3C7"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock FontSize="10" FontWeight="Bold">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Text" Value="حساب تجاري للمطعم"/>
                                                                        <Setter Property="Foreground" Value="#15803d"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding AccountType}" Value="PersonalMixed">
                                                                                <Setter Property="Text" Value="حساب شخصي / شريك"/>
                                                                                <Setter Property="Foreground" Value="#b45309"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                    <Setter TargetName="AccountCard" Property="Background" Value="#EEF2FF"/>
                                                    <Setter TargetName="AccountCard" Property="BorderBrush" Value="#3F51B5"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>

                            <!-- تفاصيل الحساب المحدد والإجراءات -->
                            <Grid Grid.Column="2">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedAccount}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/> <!-- معلومات كرت -->
                                    <RowDefinition Height="20"/>   <!-- فاصل -->
                                    <RowDefinition Height="*"/>    <!-- العمليات السريعة لتغذية/سحب الأموال -->
                                </Grid.RowDefinitions>

                                <!-- كرت معلومات الحساب الرئيسي -->
                                <Border Grid.Row="0" Background="#f8fafc" CornerRadius="16" Padding="24" BorderBrush="#e2e8f0" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding SelectedAccount.FriendlyName}" FontSize="22" FontWeight="Bold" Foreground="#1E293B"/>
                                            <TextBlock Text="{Binding SelectedAccount.LegalOwnerName, StringFormat='المالك القانوني: {0}'}" FontSize="14" Foreground="#475569" Margin="0,6,0,0"/>
                                            <TextBlock Text="{Binding SelectedAccount.BankName, StringFormat='المصرف: {0}'}" FontSize="14" Foreground="#475569" Margin="0,4,0,0"/>
                                            <TextBlock Text="{Binding SelectedAccount.AccountNumber, StringFormat='رقم الحساب: {0}'}" FontSize="15" FontWeight="SemiBold" Foreground="#3F51B5" Margin="0,4,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="الرصيد الدفتري الحالي" FontSize="12" Foreground="#64748b" FontWeight="SemiBold" HorizontalAlignment="Left"/>
                                            <TextBlock Text="{Binding SelectedAccount.CurrentBalance, StringFormat={}{0:N2} د.ل}" FontSize="24" FontWeight="Bold" Foreground="#16A34A" Margin="0,2,0,0" HorizontalAlignment="Left"/>
                                            
                                            <!-- أزرار التعديل والحذف -->
                                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0" HorizontalAlignment="Left">
                                                <Button Command="{Binding OpenEditAccountCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="#3F51B5" BorderBrush="#cbd5e1" Height="34" Padding="12,0" Margin="0,0,8,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="Pencil" Width="14" Height="14" Margin="0,0,4,0"/>
                                                        <TextBlock Text="تعديل" FontSize="12"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- العمليات السريعة لتغذية/سحب الأموال -->
                                <Border Grid.Row="2" Background="White" CornerRadius="16" BorderBrush="#e2e8f0" BorderThickness="1" Padding="24">
                                    <StackPanel>
                                        <TextBlock Text="إجراء عمليات مصرفية يدوية" FontSize="16" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,16"/>
                                        
                                        <UniformGrid Columns="3" Rows="1">
                                            <!-- إيداع -->
                                            <Button Command="{Binding OpenDepositFormCommand}" Style="{StaticResource MaterialDesignFlatButton}" Background="#16A34A" Foreground="White" Height="50" Margin="4" materialDesign:ButtonAssist.CornerRadius="10">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="ArrowUpBold" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="إيداع نقدي" VerticalAlignment="Center" FontWeight="Bold"/>
                                                </StackPanel>
                                            </Button>

                                            <!-- سحب -->
                                            <Button Command="{Binding OpenWithdrawalFormCommand}" Style="{StaticResource MaterialDesignFlatButton}" Background="#D97706" Foreground="White" Height="50" Margin="4" materialDesign:ButtonAssist.CornerRadius="10">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="ArrowDownBold" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="سحب نقدي" VerticalAlignment="Center" FontWeight="Bold"/>
                                                </StackPanel>
                                            </Button>

                                            <!-- تحويل داخلي -->
                                            <Button Command="{Binding OpenTransferFormCommand}" Style="{StaticResource MaterialDesignFlatButton}" Background="#3F51B5" Foreground="White" Height="50" Margin="4" materialDesign:ButtonAssist.CornerRadius="10">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="SwapHorizontal" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="تحويل داخلي" VerticalAlignment="Center" FontWeight="Bold"/>
                                                </StackPanel>
                                            </Button>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- حالة عدم وجود حساب محدد -->
                            <Grid Grid.Column="2">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedAccount}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="HelpCircleOutline" Width="64" Height="64" Foreground="#cbd5e1" HorizontalAlignment="Center"/>
                                    <TextBlock Text="يرجى اختيار حساب بنكي من القائمة الجانبية لعرض الإحصائيات وإجراء العمليات المصرفية." FontSize="14" Foreground="#94a3b8" Margin="0,16,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </TabItem>
                    
                    
                    <!-- ────── Tab 2: ديون ومسحوبات الشركاء ────── -->
                    <TabItem Style="{StaticResource ModernSegmentedTabItemStyle}">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AccountTie" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="سجل تمويل الشركاء" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </StackPanel>
                        </TabItem.Header>
                        
                        <!-- New Professional Partner Dashboard Component -->
                        <views:PartnerDebtsDashboardView DataContext="{Binding PartnerDebtsDashboard}" Margin="16,20,16,16" />
                    </TabItem>

                    <!-- ────── Tab 3: كشف حساب المصرف البنكي ────── -->
                    <TabItem Style="{StaticResource ModernSegmentedTabItemStyle}">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FileDocumentOutline" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="كشف حساب المصرف" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </StackPanel>
                        </TabItem.Header>
                        <Grid Margin="16,20,16,16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- شريط التصفية -->
                                <RowDefinition Height="16"/>
                                <RowDefinition Height="Auto"/> <!-- كروت الملخص -->
                                <RowDefinition Height="16"/>
                                <RowDefinition Height="*"/>    <!-- جدول الحركات -->
                            </Grid.RowDefinitions>

                            <!-- ═══════ شريط التصفية والتحكم المتقدم ═══════ -->
                            <Border Grid.Row="0" Background="#f8fafc" CornerRadius="14" Padding="16,12" BorderBrush="#e2e8f0" BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="10"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- الصف الأول: الحساب + التواريخ -->
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="220"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="الحساب البنكي:" FontSize="13" Foreground="#475569" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Column="2" ItemsSource="{Binding BankAccounts}" SelectedItem="{Binding StatementAccount}" DisplayMemberPath="DisplayName" Style="{StaticResource MaterialDesignOutlinedComboBox}" Padding="8,6" FontSize="13"/>

                                        <TextBlock Grid.Column="4" Text="من:" FontSize="13" Foreground="#475569" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <DatePicker Grid.Column="6" SelectedDate="{Binding StatementStartDate}" Style="{StaticResource MaterialDesignOutlinedDatePicker}" Padding="6,4" FontSize="12"/>

                                        <TextBlock Grid.Column="8" Text="إلى:" FontSize="13" Foreground="#475569" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <DatePicker Grid.Column="10" SelectedDate="{Binding StatementEndDate}" Style="{StaticResource MaterialDesignOutlinedDatePicker}" Padding="6,4" FontSize="12"/>
                                    </Grid>

                                    <!-- الصف الثاني: الفلاتر + البحث + الأزرار -->
                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="200"/>
                                            <ColumnDefinition Width="16"/>
                                            <!-- زر عرض الحركات الشخصية -->
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <!-- أزرار الإجراء -->
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="نوع الحركة:" FontSize="13" Foreground="#475569" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Column="2" ItemsSource="{Binding TransactionTypeFilters}" SelectedItem="{Binding SelectedTransactionTypeFilter}" Style="{StaticResource MaterialDesignOutlinedComboBox}" Padding="8,6" FontSize="12"/>

                                        <TextBlock Grid.Column="4" Text="بحث:" FontSize="13" Foreground="#475569" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="6" Text="{Binding StatementSearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Padding="8,6" FontSize="12" materialDesign:HintAssist.Hint="رقم مرجعي أو بيان..."/>

                                        <!-- CheckBox عرض الحركات الشخصية (يظهر فقط للحسابات المختلطة) -->
                                        <CheckBox Grid.Column="8" Content="عرض الحركات الشخصية للمالك" IsChecked="{Binding ShowPersonalTransactions}" FontSize="12" Foreground="#b45309" FontWeight="SemiBold" VerticalAlignment="Center" Visibility="{Binding IsStatementAccountMixed, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                        <!-- زر تحميل الكشف (يفتح النافذة الجديدة) -->
                                        <Button x:Name="LoadStatementButton" Grid.Column="10" Click="LoadStatementButton_Click" Style="{StaticResource MaterialDesignFlatButton}" Background="#3F51B5" Foreground="White" Height="36" Padding="16,0" materialDesign:ButtonAssist.CornerRadius="8">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Magnify" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="تحميل الكشف" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- ═══════ رسالة توضيحية بدلاً من الجدول ═══════ -->
                            <Border Grid.Row="2" Grid.RowSpan="3" Background="White" CornerRadius="16" BorderBrush="#e2e8f0" BorderThickness="1" Padding="40">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Color="#94a3b8" Opacity="0.08"/>
                                </Border.Effect>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border Background="#EEF2FF" CornerRadius="50" Width="100" Height="100" HorizontalAlignment="Center" Margin="0,0,0,20">
                                        <materialDesign:PackIcon Kind="FileDocumentOutline" Width="48" Height="48" Foreground="#3F51B5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="كشف حساب المصرف البنكي" FontSize="20" FontWeight="Bold" Foreground="#1E293B" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                    <TextBlock FontSize="14" Foreground="#64748b" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="500" TextAlignment="Center" LineHeight="22">
                                        اختر الحساب البنكي وحدد الفترة الزمنية المطلوبة من الأعلى، ثم اضغط على زر "تحميل الكشف" لفتح نافذة التقرير التفصيلي.
                                    </TextBlock>
                                    <TextBlock Text="سيتم عرض الكشف في نافذة منفصلة واسعة تحتوي على جميع الحركات والملخص المالي وزر تصدير PDF." FontSize="12" Foreground="#94a3b8" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="450" TextAlignment="Center" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </TabItem>

            </TabControl>
        </Grid>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!-- ═══════════ النوافذ المنبثقة التفاعلية (Modals Layer) ═══════════ -->
        <!-- ══════════════════════════════════════════════════════════ -->

        <!-- 1. نموذج إضافة/تعديل الحساب البنكي -->
        <Border Background="#99000000" Visibility="{Binding IsAccountFormOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <materialDesign:Card Width="460" VerticalAlignment="Center" HorizontalAlignment="Center" UniformCornerRadius="16" Padding="28,24" Background="White">
                <StackPanel>
                    <TextBlock Text="بيانات الحساب البنكي" FontSize="18" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,16"/>

                    <!-- حقل مدمج لاسم المصرف والفرع -->
                    <TextBlock Text="اسم المصرف والفرع:" FontSize="12" Foreground="#64748b" Margin="0,0,0,6"/>
                    <ComboBox ItemsSource="{Binding LibyanBanks}" 
                              Text="{Binding EditingAccount.FriendlyName, UpdateSourceTrigger=PropertyChanged}" 
                              IsEditable="True"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}" 
                              materialDesign:HintAssist.Hint="مثلاً: مصرف التجارة والتنمية الحدائق"
                              Padding="10,8" FontSize="14" Margin="0,0,0,12"/>

                    <!-- المالك القانوني -->
                    <TextBlock Text="المالك القانوني للحساب:" FontSize="12" Foreground="#64748b" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding EditingAccount.LegalOwnerName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Padding="10,8" FontSize="14" Margin="0,0,0,12"/>

                    <!-- رقم الحساب -->
                    <TextBlock Text="رقم الحساب أو الآيبان:" FontSize="12" Foreground="#64748b" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding EditingAccount.AccountNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Padding="10,8" FontSize="14" Margin="0,0,0,12"/>

                    <!-- طبيعة الاستخدام -->
                    <TextBlock Text="طبيعة الاستخدام (للتقارير المالية):" FontSize="12" Foreground="#64748b" Margin="0,0,0,6"/>
                    <ComboBox SelectedValue="{Binding EditingAccount.AccountType}" SelectedValuePath="Tag" Style="{StaticResource MaterialDesignOutlinedComboBox}" Padding="10,8" FontSize="14" Margin="0,0,0,16">
                        <ComboBoxItem Content="حساب تجاري للمطعم" Tag="{x:Static enums:BankAccountType.Commercial}"/>
                        <ComboBoxItem Content="حساب شخصي للمالك (مختلط)" Tag="{x:Static enums:BankAccountType.PersonalMixed}"/>
                    </ComboBox>

                    <!-- الرصيد الافتتاحي (يظهر فقط في حالة الإضافة) -->
                    <StackPanel Visibility="{Binding IsEditMode, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                        <TextBlock Text="الرصيد الافتتاحي الحالي (د.ل):" FontSize="12" Foreground="#64748b" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding EditingAccount.OpeningBalance, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Padding="10,8" FontSize="14" Margin="0,0,0,16"/>
                    </StackPanel>

                    <!-- الأزرار -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Command="{Binding CloseAccountFormCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="#64748b" BorderBrush="#cbd5e1" Height="40" Padding="16,0" Margin="0,0,10,0">تراجع</Button>
                        <Button Command="{Binding SaveAccountCommand}" Style="{StaticResource MaterialDesignFlatButton}" Background="#3F51B5" Foreground="White" Height="40" Padding="20,0">حفظ الحساب ✓</Button>
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>
        </Border>

        <!-- 2. نموذج إيداع يدوي -->
        <Border Background="#99000000" Visibility="{Binding IsDepositFormOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <materialDesign:Card Width="400" VerticalAlignment="Center" HorizontalAlignment="Center" UniformCornerRadius="16" Padding="28,24" Background="White">
                <StackPanel>
                    <TextBlock Text="تسجيل إيداع نقدي للمصرف" FontSize="18" FontWeight="Bold" Foreground="#16A34A" Margin="0,0,0,16"/>

                    <TextBlock Text="الحساب المستهدف:" FontSize="12" Foreground="#64748b" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding SelectedAccount.FriendlyName}" FontSize="15" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,12"/>

                    <TextBlock Text="مبلغ الإيداع (د.ل):" FontSize="12" Foreground="#64748b" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding ManualTxAmount, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Padding="10,8" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>

                    <TextBlock Text="رقم التحويل أو الوصل (مرجع):" FontSize="12" Foreground="#64748b" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding ManualTxReference, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Padding="10,8" FontSize="14" Margin="0,0,0,12"/>

                    <TextBlock Text="البيان وملاحظات الإيداع:" FontSize="12" Foreground="#64748b" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding ManualTxNotes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Padding="10,8" FontSize="14" Margin="0,0,0,12"/>

                    <TextBlock Text="تاريخ العملية:" FontSize="12" Foreground="#64748b" Margin="0,0,0,6"/>
                    <DatePicker SelectedDate="{Binding ManualTxDate}" Style="{StaticResource MaterialDesignOutlinedDatePicker}" Padding="10,8" FontSize="14" Margin="0,0,0,20"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Command="{Binding CloseDepositFormCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="#64748b" BorderBrush="#cbd5e1" Height="40" Padding="16,0" Margin="0,0,10,0">إلغاء</Button>
                        <Button Command="{Binding SaveDepositCommand}" Style="{StaticResource MaterialDesignFlatButton}" Background="#16A34A" Foreground="White" Height="40" Padding="20,0">إيداع نقدي ✓</Button>
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>
        </Border>

        <!-- 3. نموذج سحب يدوي -->
        <Border Background="#99000000" Visibility="{Binding IsWithdrawalFormOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <materialDesign:Card Width="400" VerticalAlignment="Center" HorizontalAlignment="Center" UniformCornerRadius="16" Padding="28,24" Background="White">
                <StackPanel>
                    <TextBlock Text="تسجيل عملية سحب نقدي" FontSize="18" FontWeight="Bold" Foreground="#D97706" Margin="0,0,0,16"/>

                    <TextBlock Text="الحساب المصدر:" FontSize="12" Foreground="#64748b" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding SelectedAccount.FriendlyName}" FontSize="15" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,12"/>

                    <TextBlock Text="مبلغ السحب (د.ل):" FontSize="12" Foreground="#64748b" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding ManualTxAmount, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Padding="10,8" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>

                    <TextBlock Text="رقم إيصال السحب (مرجع):" FontSize="12" Foreground="#64748b" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding ManualTxReference, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Padding="10,8" FontSize="14" Margin="0,0,0,12"/>

                    <TextBlock Text="ملاحظات السحب واستخدامه:" FontSize="12" Foreground="#64748b" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding ManualTxNotes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Padding="10,8" FontSize="14" Margin="0,0,0,12"/>

                    <TextBlock Text="تاريخ العملية:" FontSize="12" Foreground="#64748b" Margin="0,0,0,6"/>
                    <DatePicker SelectedDate="{Binding ManualTxDate}" Style="{StaticResource MaterialDesignOutlinedDatePicker}" Padding="10,8" FontSize="14" Margin="0,0,0,20"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Command="{Binding CloseWithdrawalFormCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="#64748b" BorderBrush="#cbd5e1" Height="40" Padding="16,0" Margin="0,0,10,0">إلغاء</Button>
                        <Button Command="{Binding SaveWithdrawalCommand}" Style="{StaticResource MaterialDesignFlatButton}" Background="#D97706" Foreground="White" Height="40" Padding="20,0">سحب نقدي ✓</Button>
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>
        </Border>

        <!-- 4. نموذج تحويل داخلي بين الحسابات -->
        <Border Background="#99000000" Visibility="{Binding IsTransferFormOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <materialDesign:Card Width="420" VerticalAlignment="Center" HorizontalAlignment="Center" UniformCornerRadius="16" Padding="28,24" Background="White">
                <StackPanel>
                    <TextBlock Text="إجراء تحويل داخلي بين الحسابات" FontSize="18" FontWeight="Bold" Foreground="#3F51B5" Margin="0,0,0,16"/>

                    <TextBlock Text="الحساب المصدر (الخصم):" FontSize="12" Foreground="#64748b" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding SelectedAccount.FriendlyName}" FontSize="15" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,12"/>

                    <!-- الحساب المستلم -->
                    <TextBlock Text="الحساب المستلم (الإيداع):" FontSize="12" Foreground="#64748b" Margin="0,0,0,6"/>
                    <ComboBox ItemsSource="{Binding TransferDestinationAccounts}" SelectedItem="{Binding TransferDestinationAccount}" DisplayMemberPath="FriendlyName" Style="{StaticResource MaterialDesignOutlinedComboBox}" Padding="10,8" FontSize="14" Margin="0,0,0,12"/>

                    <TextBlock Text="قيمة المبلغ المحول (د.ل):" FontSize="12" Foreground="#64748b" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding ManualTxAmount, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Padding="10,8" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>

                    <TextBlock Text="البيان والتفاصيل:" FontSize="12" Foreground="#64748b" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding ManualTxNotes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Padding="10,8" FontSize="14" Margin="0,0,0,12"/>

                    <TextBlock Text="تاريخ العملية:" FontSize="12" Foreground="#64748b" Margin="0,0,0,6"/>
                    <DatePicker SelectedDate="{Binding ManualTxDate}" Style="{StaticResource MaterialDesignOutlinedDatePicker}" Padding="10,8" FontSize="14" Margin="0,0,0,20"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Command="{Binding CloseTransferFormCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="#64748b" BorderBrush="#cbd5e1" Height="40" Padding="16,0" Margin="0,0,10,0">إلغاء</Button>
                        <Button Command="{Binding SaveTransferCommand}" Style="{StaticResource MaterialDesignFlatButton}" Background="#3F51B5" Foreground="White" Height="40" Padding="20,0">إتمام التحويل ✓</Button>
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>
        </Border>

        <!-- 5. نموذج تأكيد مطابقة الكروت وتحصيلها في حساب بنكي -->
        <Border Background="#99000000" Visibility="{Binding IsClearCardFormOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <materialDesign:Card Width="400" VerticalAlignment="Center" HorizontalAlignment="Center" UniformCornerRadius="16" Padding="28,24" Background="White">
                <StackPanel>
                    <TextBlock Text="تأكيد تحصيل بطاقة إلكترونية ومطابقتها" FontSize="18" FontWeight="Bold" Foreground="#16A34A" Margin="0,0,0,16"/>

                    <TextBlock Text="بيانات العملية المعلقة:" FontSize="12" Foreground="#64748b" Margin="0,0,0,6"/>
                    <Border Background="#f8fafc" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="تاريخ المبيعات:" Foreground="#64748b" FontSize="13"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedPendingCardPayment.JournalDate, StringFormat=yyyy/MM/dd}" FontWeight="SemiBold" Foreground="#1E293B"/>
                            
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="المصرف / الوجهة المعلقة:" Foreground="#64748b" FontSize="13" Margin="0,4,0,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedPendingCardPayment.CardBrand}" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,4,0,0"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="المبلغ المستحق تحصيله:" Foreground="#64748b" FontSize="13" Margin="0,4,0,0"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedPendingCardPayment.Amount, StringFormat={}{0:N2} د.ل}" FontWeight="Bold" Foreground="#3F51B5" Margin="0,4,0,0"/>
                        </Grid>
                    </Border>

                    <!-- الحساب البنكي لتأكيد التحصيل -->
                    <TextBlock Text="أودع في الحساب البنكي التالي:" FontSize="12" Foreground="#64748b" Margin="0,0,0,6"/>
                    <ComboBox ItemsSource="{Binding BankAccounts}" SelectedItem="{Binding ClearingBankAccount}" DisplayMemberPath="DisplayName" Style="{StaticResource MaterialDesignOutlinedComboBox}" Padding="10,8" FontSize="14" Margin="0,0,0,12"/>

                    <!-- تاريخ التحصيل الفعلي في البنك -->
                    <TextBlock Text="تاريخ التحول المالي الفعلي للرصيد:" FontSize="12" Foreground="#64748b" Margin="0,0,0,6"/>
                    <DatePicker SelectedDate="{Binding ClearCardDate}" Style="{StaticResource MaterialDesignOutlinedDatePicker}" Padding="10,8" FontSize="14" Margin="0,0,0,20"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Command="{Binding CloseClearCardFormCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="#64748b" BorderBrush="#cbd5e1" Height="40" Padding="16,0" Margin="0,0,10,0">إلغاء</Button>
                        <Button Command="{Binding ClearCardPaymentCommand}" Style="{StaticResource MaterialDesignFlatButton}" Background="#16A34A" Foreground="White" Height="40" Padding="20,0">تأكيد تحصيل الرصيد ✓</Button>
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>
        </Border>

        <!-- 6. نموذج تسوية / سحب للشركاء والمالك -->
        <Border Background="#99000000" Visibility="{Binding IsSettlementFormOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <materialDesign:Card Width="450" VerticalAlignment="Center" HorizontalAlignment="Center" UniformCornerRadius="16" Padding="28,24" Background="White">
                <StackPanel>
                    <TextBlock Text="تسجيل تسوية ذمة أو مسحوبات جديدة للشركاء" FontSize="17" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,16"/>

                    <!-- اسم الشريك -->
                    <TextBlock Text="اسم الشريك المعني:" FontSize="12" Foreground="#64748b" Margin="0,0,0,6"/>
                    <ComboBox ItemsSource="{Binding PartnerNames}" Text="{Binding SettlementPartnerName, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" Style="{StaticResource MaterialDesignOutlinedComboBox}" Padding="10,8" FontSize="14" Margin="0,0,0,12"/>

                    <!-- المبلغ -->
                    <TextBlock Text="المبلغ النقدي المسدد (د.ل):" FontSize="12" Foreground="#64748b" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding SettlementAmount, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Padding="10,8" FontSize="18" FontWeight="Bold" Foreground="#3F51B5" Margin="0,0,0,12"/>

                    <!-- مصدر التمويل -->
                    <TextBlock Text="مصدر الدفع والتمويل من المطعم:" FontSize="12" Foreground="#64748b" Margin="0,0,0,6"/>
                    <ComboBox SelectedValue="{Binding SelectedSettlementSource}" SelectedValuePath="Tag" Style="{StaticResource MaterialDesignOutlinedComboBox}" Padding="10,8" FontSize="14" Margin="0,0,0,12">
                        <ComboBoxItem Content="النقدية المباشرة (صندوق الكاشير)" Tag="CashRegister"/>
                        <ComboBoxItem Content="حساب بنكي للمطعم" Tag="Bank"/>
                        <ComboBoxItem Content="عهدة نقدية / نثرية" Tag="PettyCash"/>
                    </ComboBox>

                    <!-- الحساب البنكي المستهدف (يظهر فقط إذا كان المصدر هو الحساب البنكي) -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedSettlementSource}" Value="Bank">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="الحساب البنكي المصدر:" FontSize="12" Foreground="#64748b" Margin="0,0,0,6"/>
                        <ComboBox ItemsSource="{Binding BankAccounts}" SelectedItem="{Binding SettlementBankAccount}" DisplayMemberPath="DisplayName" Style="{StaticResource MaterialDesignOutlinedComboBox}" Padding="10,8" FontSize="14" Margin="0,0,0,12"/>
                    </StackPanel>

                    <!-- البيان والملاحظات -->
                    <TextBlock Text="ملاحظات وتفاصيل الحركة:" FontSize="12" Foreground="#64748b" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding SettlementNotes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Padding="10,8" FontSize="14" Margin="0,0,0,12"/>

                    <!-- تاريخ التسوية -->
                    <TextBlock Text="التاريخ الفعلي للتسوية:" FontSize="12" Foreground="#64748b" Margin="0,0,0,6"/>
                    <DatePicker SelectedDate="{Binding SettlementDate}" Style="{StaticResource MaterialDesignOutlinedDatePicker}" Padding="10,8" FontSize="14" Margin="0,0,0,20"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Command="{Binding CloseSettlementFormCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="#64748b" BorderBrush="#cbd5e1" Height="40" Padding="16,0" Margin="0,0,10,0">إلغاء</Button>
                        <Button Command="{Binding SaveSettlementCommand}" Style="{StaticResource MaterialDesignFlatButton}" Background="#3F51B5" Foreground="White" Height="40" Padding="20,0">حفظ وإتمام التسوية ✓</Button>
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>
        </Border>
        <!-- 7. نموذج تسجيل تمويل أو دين جديد (Partner Financing) -->
        <Border Background="#99000000" Visibility="{Binding IsDebtFormOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <materialDesign:Card Width="450" MaxHeight="600" VerticalAlignment="Center" HorizontalAlignment="Center" UniformCornerRadius="16" Background="White">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Border Padding="28,24">
                        <StackPanel>
                            <TextBlock Text="تسجيل تمويل تشغيلي جديد من شريك" FontSize="17" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,16"/>

                            <!-- اسم الشريك -->
                            <TextBlock Text="اسم الشريك الممول:" FontSize="12" Foreground="#64748b" Margin="0,0,0,6"/>
                            <ComboBox ItemsSource="{Binding PartnerNames}" Text="{Binding DebtPartnerName, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" Style="{StaticResource MaterialDesignOutlinedComboBox}" Padding="10,8" FontSize="14" Margin="0,0,0,12"/>

                            <!-- المبلغ -->
                            <TextBlock Text="مبلغ التمويل المقبوض (د.ل):" FontSize="12" Foreground="#64748b" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding DebtAmount, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Padding="10,8" FontSize="18" FontWeight="Bold" Foreground="#e11d48" Margin="0,0,0,12"/>

                            <!-- وجهة الإيداع -->
                            <TextBlock Text="أين تم إيداع هذا المبلغ؟" FontSize="12" Foreground="#64748b" Margin="0,0,0,6"/>
                            <ComboBox SelectedIndex="{Binding SelectedDebtDestinationIndex, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedComboBox}" Padding="10,8" FontSize="14" Margin="0,0,0,12">
                                <ComboBoxItem Content="النقدية المباشرة (صندوق الكاشير)"/>
                                <ComboBoxItem Content="إيداع في حساب بنكي للمطعم"/>
                                <ComboBoxItem Content="عهدة نقدية / نثرية"/>
                            </ComboBox>

                            <!-- الحساب البنكي (يظهر فقط إذا كان المصدر هو الحساب البنكي) -->
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedDebtDestinationIndex}" Value="1">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="الحساب البنكي المستلم:" FontSize="12" Foreground="#64748b" Margin="0,0,0,6"/>
                                <ComboBox ItemsSource="{Binding BankAccounts}" SelectedItem="{Binding DebtBankAccount}" DisplayMemberPath="DisplayName" Style="{StaticResource MaterialDesignOutlinedComboBox}" Padding="10,8" FontSize="14" Margin="0,0,0,12"/>

                                <!-- نوع الدفع: نقدي أو تحويل مصرفي -->
                                <TextBlock Text="طريقة الإيداع:" FontSize="12" Foreground="#64748b" Margin="0,0,0,6"/>
                                <ComboBox SelectedIndex="{Binding SelectedDebtPaymentMethodIndex, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedComboBox}" Padding="10,8" FontSize="14" Margin="0,0,0,12">
                                    <ComboBoxItem Content="نقدي (إيداع مباشر في المصرف)"/>
                                    <ComboBoxItem Content="تحويل مصرفي"/>
                                </ComboBox>

                                <!-- أخر 4 أرقام - يظهر فقط عند اختيار تحويل مصرفي -->
                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedDebtPaymentMethodIndex}" Value="1">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="أخر 4 أرقام من عملية التحويل:" FontSize="12" Foreground="#64748b" Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding DebtTransferReference, UpdateSourceTrigger=PropertyChanged}" 
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}" 
                                             materialDesign:HintAssist.Hint="مثلاً: 4522"
                                             Padding="10,8" FontSize="14" Margin="0,0,0,12"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- البيان والملاحظات -->
                            <TextBlock Text="ملاحظات وتفاصيل التمويل:" FontSize="12" Foreground="#64748b" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding DebtNotes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Padding="10,8" FontSize="14" Margin="0,0,0,12"/>

                            <!-- تاريخ العملية -->
                            <TextBlock Text="تاريخ استلام التمويل:" FontSize="12" Foreground="#64748b" Margin="0,0,0,6"/>
                            <DatePicker SelectedDate="{Binding DebtDate}" Style="{StaticResource MaterialDesignOutlinedDatePicker}" Padding="10,8" FontSize="14" Margin="0,0,0,20"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Command="{Binding CloseDebtFormCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="#64748b" BorderBrush="#cbd5e1" Height="40" Padding="16,0" Margin="0,0,10,0">إلغاء</Button>
                                <Button Command="{Binding SaveDebtCommand}" Style="{StaticResource MaterialDesignFlatButton}" Background="#dc2626" Foreground="White" Height="40" Padding="20,0">حفظ وتسجيل التمويل ✓</Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </materialDesign:Card>
        </Border>
    </Grid>
</UserControl>
