<Window x:Class="MeezanPOS.Presentation.Views.WorkerEditDialog"
        FontFamily="{StaticResource Font.Body}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="بيانات الموظف" 
        Height="470" Width="460"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FlowDirection="RightToLeft"
        MouseLeftButtonDown="DragWindow">

    <Border Background="White" CornerRadius="20" BorderBrush="{StaticResource Brush.BorderStrong}" BorderThickness="1.5">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="4" Color="{StaticResource Color.TextPrimary}" Opacity="0.2"/>
        </Border.Effect>

        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource Brush.PrimarySoft}" CornerRadius="6" Padding="6" Margin="0,0,10,0">
                        <materialDesign:PackIcon Kind="AccountEdit" Foreground="{StaticResource Brush.PrimaryInteractive}" Width="20" Height="20"/>
                    </Border>
                    <TextBlock x:Name="TxtTitle" Text="بيانات الموظف" FontSize="16" FontWeight="Bold" Foreground="{StaticResource Brush.TextPrimary}" VerticalAlignment="Center"/>
                </StackPanel>

                <Button Grid.Column="1" Style="{StaticResource MaterialDesignToolButton}" Width="32" Height="32" Padding="0" Click="Cancel_Click" Cursor="Hand">
                    <materialDesign:PackIcon Kind="Close" Width="20" Height="20" Foreground="{StaticResource Brush.TextMuted}"/>
                </Button>
            </Grid>

            <!-- Divider -->
            <Separator Grid.Row="1" Margin="0,14" Background="{StaticResource Brush.LockedSoft}"/>

            <!-- Form Inputs -->
            <StackPanel Grid.Row="2" VerticalAlignment="Top">
                <!-- اسم العامل -->
                <TextBlock Text="اسم العامل بالكامل:" FontSize="12.5" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,0,0,6" FontWeight="SemiBold"/>
                <TextBox x:Name="TxtName" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         materialDesign:HintAssist.Hint="مثال: أحمد علي"
                         Margin="0,0,0,14" Padding="12,10" FontSize="13"/>

                <!-- اليومية الثابتة -->
                <TextBlock Text="الأجر اليومي الثابت (د.ل):" FontSize="12.5" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,0,0,6" FontWeight="SemiBold"/>
                <TextBox x:Name="TxtDailyWage" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         materialDesign:HintAssist.Hint="0.00"
                         Margin="0,0,0,14" Padding="12,10" FontSize="13" FontWeight="Bold"/>

                <!-- حالة النشاط -->
                <StackPanel Margin="0,4,0,14" Orientation="Horizontal">
                    <CheckBox x:Name="ChkActive" Style="{StaticResource MaterialDesignActionCheckBox}" Margin="0,0,8,0"/>
                    <TextBlock Text="الموظف نشط (يظهر في كشف الحضور واليومية)" FontSize="13" Foreground="{StaticResource Brush.TextStrong}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                </StackPanel>

                <!-- ملاحظات -->
                <TextBlock Text="ملاحظات عامة:" FontSize="12.5" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,0,0,6" FontWeight="SemiBold"/>
                <TextBox x:Name="TxtNotes" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         materialDesign:HintAssist.Hint="ملاحظات أو المهام الموكلة للموظف..."
                         AcceptsReturn="True" Height="70" TextWrapping="Wrap"
                         Padding="12,10" FontSize="13"/>
            </StackPanel>

            <!-- Footer Buttons -->
            <Grid Grid.Row="3" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Save Button -->
                <Button Grid.Column="0" Click="Save_Click"
                        Style="{StaticResource MaterialDesignRaisedButton}" 
                        Background="{StaticResource Brush.PrimaryInteractive}" BorderBrush="{StaticResource Brush.PrimaryInteractive}" Foreground="White"
                        Height="40" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="10"/>
                        </Style>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ContentSave" Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="حفظ البيانات" VerticalAlignment="Center" FontWeight="Bold"/>
                    </StackPanel>
                </Button>

                <!-- Cancel Button -->
                <Button Grid.Column="2" Click="Cancel_Click"
                        Style="{StaticResource MaterialDesignOutlinedButton}" 
                        Foreground="{StaticResource Brush.TextMuted}" BorderBrush="{StaticResource Brush.BorderStrong}"
                        Height="40" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="10"/>
                        </Style>
                    </Button.Resources>
                    <TextBlock Text="إلغاء وتراجع" FontWeight="Bold"/>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
