<UserControl x:Class="MeezanPOS.Presentation.Views.PartnerDebtsDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             FlowDirection="RightToLeft">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- العنوان والبحث -->
            <RowDefinition Height="Auto"/>  <!-- كروت الإحصاء الرئيسية -->
            <RowDefinition Height="*"/>     <!-- كروت الشركاء -->
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- 1. شريط العنوان والبحث -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <materialDesign:PackIcon Kind="AccountGroupOutline" Width="28" Height="28" Foreground="{StaticResource Brush.PrimaryInteractive}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock Text="لوحة متابعة ذمم الشركاء" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Brush.TextPrimary}" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- أزرار الإضافة السريعة الدائرية -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button Command="{Binding RecordSettlementCommand}" 
                        Style="{StaticResource MaterialDesignPaperButton}"
                        Background="{StaticResource Brush.Expense}" Foreground="White"
                        Width="40" Height="40" Padding="0" 
                        materialDesign:ButtonAssist.CornerRadius="20"
                        ToolTip="(خروج سيولة): 📤 سحب / دفعة للشريك"
                        Margin="0,0,12,0">
                    <materialDesign:PackIcon Kind="Minus" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>

                <Button Command="{Binding RecordDebtCommand}" 
                        Style="{StaticResource MaterialDesignPaperButton}"
                        Background="{StaticResource Brush.Income}" Foreground="White"
                        Width="40" Height="40" Padding="0" 
                        materialDesign:ButtonAssist.CornerRadius="20"
                        ToolTip="(دخول سيولة): 📥 إيداع / تمويل جديد">
                    <materialDesign:PackIcon Kind="Plus" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <ComboBox SelectedValue="{Binding SelectedStatusFilter, UpdateSourceTrigger=PropertyChanged}" 
                          SelectedValuePath="Content"
                          Width="190" Height="42" FontSize="12.5" Margin="0,0,10,0"
                          materialDesign:HintAssist.Hint="الحالة المالية"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          Background="{StaticResource Brush.LockedSoft}" BorderThickness="0"
                          Padding="10,0,10,0"
                          VerticalAlignment="Center">
                    <ComboBoxItem Content="الكل"/>
                    <ComboBoxItem Content="المطعم مدين للشريك"/>
                    <ComboBoxItem Content="الشريك مدين للمطعم"/>
                    <ComboBoxItem Content="تمت التسوية"/>
                </ComboBox>

                <Border Background="{StaticResource Brush.LockedSoft}" CornerRadius="10" Padding="12,0" Height="42" Width="220">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Kind="Magnify" Width="20" Height="20" Foreground="{StaticResource Brush.TextFaint}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Grid.Column="1" 
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                 materialDesign:HintAssist.Hint="ابحث باسم الشريك..."
                                 BorderThickness="0" Background="Transparent" FontSize="13.5"
                                 VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- 2. كروت الإحصاء الرئيسية (3 كروت) -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,20">
            <!-- كرت إجمالي الديون -->
            <Border Background="White" CornerRadius="14" Padding="20,16" Margin="0,0,10,0" BorderBrush="{StaticResource Brush.ExpenseSoft}" BorderThickness="1.5">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Color="#000" Opacity="0.06"/>
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Background="{StaticResource Brush.ExpenseSoft}" CornerRadius="8" Padding="6" Margin="0,0,8,0">
                            <materialDesign:PackIcon Kind="TrendingUp" Width="20" Height="20" Foreground="{StaticResource Brush.Expense}"/>
                        </Border>
                        <TextBlock Text="إجمالي تمويل الشركاء" FontSize="12.5" Foreground="{StaticResource Brush.TextMuted}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{Binding TotalDebtsAllPartners, StringFormat=N2}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Brush.Expense}"/>
                </StackPanel>
            </Border>

            <!-- كرت إجمالي التسويات -->
            <Border Background="White" CornerRadius="14" Padding="20,16" Margin="5,0" BorderBrush="{StaticResource Brush.IncomeSoft}" BorderThickness="1.5">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Color="#000" Opacity="0.06"/>
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Background="{StaticResource Brush.IncomeSoft}" CornerRadius="8" Padding="6" Margin="0,0,8,0">
                            <materialDesign:PackIcon Kind="TrendingDown" Width="20" Height="20" Foreground="{StaticResource Brush.Income}"/>
                        </Border>
                        <TextBlock Text="إجمالي التسويات" FontSize="12.5" Foreground="{StaticResource Brush.TextMuted}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{Binding TotalSettlementsAllPartners, StringFormat=N2}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Brush.Income}"/>
                </StackPanel>
            </Border>

            <!-- كرت الصافي -->
            <Border Background="White" CornerRadius="14" Padding="20,16" Margin="10,0,0,0" BorderBrush="{StaticResource Brush.SidebarText}" BorderThickness="1.5">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Color="#000" Opacity="0.06"/>
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Background="{StaticResource Brush.PrimarySoft}" CornerRadius="8" Padding="6" Margin="0,0,8,0">
                            <materialDesign:PackIcon Kind="ScaleBalance" Width="20" Height="20" Foreground="{StaticResource Brush.PrimaryInteractive}"/>
                        </Border>
                        <TextBlock Text="صافي الذمم المستحقة" FontSize="12.5" Foreground="{StaticResource Brush.TextMuted}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{Binding NetBalanceAllPartners, StringFormat=N2}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Brush.PrimaryInteractive}"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- 3. كروت الشركاء (Cards Grid) -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- 3. جدول الشركاء التفصيلي (DataGrid) -->
        <Border Grid.Row="2" CornerRadius="12" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1.5" Padding="0" Background="White">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Color="#000" Opacity="0.05"/>
            </Border.Effect>
            <DataGrid ItemsSource="{Binding FilteredPartners}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      BorderThickness="0"
                      Background="Transparent"
                      RowHeight="44"
                      FontSize="13.5"
                      AlternatingRowBackground="#F5F7FA"
                      materialDesign:DataGridAssist.ColumnHeaderPadding="12,14"
                      materialDesign:DataGridAssist.CellPadding="12,8"
                      VerticalScrollBarVisibility="Auto"
                      MouseDoubleClick="PartnerGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <!-- التسلسل -->
                    <DataGridTextColumn Header="م" Binding="{Binding SequenceNumber}" Width="Auto" MinWidth="50">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Foreground" Value="{StaticResource Brush.TextFaint}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- اسم الشريك -->
                    <DataGridTemplateColumn Header="اسم الشريك" Width="*" SortMemberPath="PartnerName">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border CornerRadius="18" Width="30" Height="30" Margin="0,0,8,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource Brush.LockedSoft}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding BalanceDirection}" Value="RestaurantOwesPartner">
                                                        <Setter Property="Background" Value="{StaticResource Brush.ExpenseSoft}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding BalanceDirection}" Value="Settled">
                                                        <Setter Property="Background" Value="{StaticResource Brush.IncomeSoft}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <materialDesign:PackIcon Kind="AccountOutline" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <materialDesign:PackIcon.Style>
                                                <Style TargetType="materialDesign:PackIcon">
                                                    <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding BalanceDirection}" Value="RestaurantOwesPartner">
                                                            <Setter Property="Foreground" Value="{StaticResource Brush.Expense}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding BalanceDirection}" Value="Settled">
                                                            <Setter Property="Foreground" Value="{StaticResource Brush.Income}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </materialDesign:PackIcon.Style>
                                        </materialDesign:PackIcon>
                                    </Border>
                                    <TextBlock Text="{Binding PartnerName}" FontWeight="Bold" Foreground="{StaticResource Brush.TextPrimary}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- إجمالي التمويلات -->
                    <DataGridTextColumn Header="إجمالي التمويل" Binding="{Binding DebtsTotal, StringFormat=N2}" Width="Auto" MinWidth="150">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- إجمالي التسويات -->
                    <DataGridTextColumn Header="إجمالي التسويات" Binding="{Binding SettlementsTotal, StringFormat=N2}" Width="Auto" MinWidth="150">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- الرصيد الصافي -->
                    <DataGridTextColumn Header="الرصيد الصافي" Binding="{Binding NetBalance, StringFormat=N2}" Width="Auto" MinWidth="180">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BalanceDirection}" Value="RestaurantOwesPartner">
                                        <Setter Property="Foreground" Value="{StaticResource Brush.Expense}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding BalanceDirection}" Value="Settled">
                                        <Setter Property="Foreground" Value="{StaticResource Brush.Income}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding BalanceDirection}" Value="PartnerOwesRestaurant">
                                        <Setter Property="Foreground" Value="{StaticResource Brush.Pending}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- الحالة / الاتجاه -->
                    <DataGridTemplateColumn Header="الحالة المالية" Width="Auto" MinWidth="150" SortMemberPath="BalanceDirectionText">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="6" Padding="8,4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource Brush.LockedSoft}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding BalanceDirection}" Value="RestaurantOwesPartner">
                                                    <Setter Property="Background" Value="{StaticResource Brush.ExpenseSoft}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding BalanceDirection}" Value="Settled">
                                                    <Setter Property="Background" Value="{StaticResource Brush.IncomeSoft}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding BalanceDirectionText}" FontSize="11" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding BalanceDirection}" Value="RestaurantOwesPartner">
                                                        <Setter Property="Foreground" Value="{StaticResource Brush.Expense}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding BalanceDirection}" Value="Settled">
                                                        <Setter Property="Foreground" Value="{StaticResource Brush.Income}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- حالة التحميل -->
        <ProgressBar Grid.Row="2"
                     Style="{StaticResource MaterialDesignCircularProgressBar}"
                     IsIndeterminate="True"
                     Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                     Width="40" Height="40"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
</UserControl>
