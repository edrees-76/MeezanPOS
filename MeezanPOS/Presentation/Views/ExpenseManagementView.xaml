<UserControl x:Class="MeezanPOS.Presentation.Views.ExpenseManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:views="clr-namespace:MeezanPOS.Presentation.Views"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        
        <Style x:Key="InverseBooleanToVisibilityConverter" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsViewingDetails}" Value="False">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BooleanToVisibilityStyle" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsViewingDetails}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Tab Button Style for Segmented Control -->
        <Style x:Key="SleekTabButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="24,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="20"/>
                </Style>
            </Style.Resources>
        </Style>

        <!-- Modern Segmented TabControl Style -->
        <Style x:Key="ModernSegmentedTabControlStyle" TargetType="TabControl">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Beautiful Floating Header Container (RTL Right-Aligned Segmented Control) -->
                            <Border Grid.Row="0" 
                                    Background="{StaticResource Brush.LockedSoft}" 
                                    CornerRadius="14" 
                                    Padding="5" 
                                    HorizontalAlignment="Right" 
                                    Margin="0,0,0,24"
                                    BorderBrush="{StaticResource Brush.Border}"
                                    BorderThickness="1">
                                <TabPanel x:Name="HeaderPanel" 
                                          IsItemsHost="True" 
                                          KeyboardNavigation.TabIndex="1" 
                                          Panel.ZIndex="1"/>
                            </Border>

                            <!-- Tab Page Content -->
                            <Border Grid.Row="1" 
                                    Background="Transparent" 
                                    KeyboardNavigation.TabIndex="2" 
                                    KeyboardNavigation.TabNavigation="Local" 
                                    KeyboardNavigation.DirectionalNavigation="Contained">
                                <ContentPresenter x:Name="PART_SelectedContentHost" 
                                                  ContentSource="SelectedContent" 
                                                  Margin="{TemplateBinding Padding}"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Segmented TabItem Style -->
        <Style x:Key="ModernSegmentedTabItemStyle" TargetType="TabItem">
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <ContentPresenter Content="{TemplateBinding Content}"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="10" 
                                Padding="28,10" 
                                Margin="2,0"
                                SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="ContentSite"
                                              ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Hover state for unselected tab -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsSelected" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource Brush.Border}"/>
                                <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
                            </MultiTrigger>
                            
                            <!-- Selected State (Floating Card with DropShadow) -->
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource Brush.Surface}"/>
                                <Setter Property="Foreground" Value="{StaticResource Brush.PrimaryInteractive}"/>
                                <Setter TargetName="Border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="10" ShadowDepth="1.5" Color="{StaticResource Color.TextMuted}" Opacity="0.18"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <TabControl Style="{StaticResource ModernSegmentedTabControlStyle}" FontSize="14" SelectedIndex="{Binding SelectedTabIndex}">

    <!-- ═══════════ تبويب المصاريف اليومية ═══════════ -->
    <TabItem Style="{StaticResource ModernSegmentedTabItemStyle}">
        <TabItem.Header>
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="CalendarClock" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center"
                                         Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
                <TextBlock Text="المصاريف اليومية" FontSize="14" FontWeight="Bold"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
            </StackPanel>
        </TabItem.Header>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- العنوان -->
            <RowDefinition Height="Auto"/>  <!-- الفلاتر (في الوضع الرئيسي فقط) -->
            <RowDefinition Height="*"/>      <!-- المحتوى -->
        </Grid.RowDefinitions>

        <!-- ═══════════ العنوان ═══════════ -->
        <Border Grid.Row="0" Margin="0,0,0,24" CornerRadius="12" Padding="20,16">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="{StaticResource Color.PrimarySoft}" Offset="0"/>
                    <GradientStop Color="{StaticResource Color.Surface}" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Orientation="Horizontal" Grid.Column="0">
                    <Border Background="{StaticResource Brush.PrimaryInteractive}" CornerRadius="12" Padding="10" Margin="0,0,16,0">
                        <materialDesign:PackIcon Kind="CashMultiple" Width="28" Height="28" Foreground="White" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="إدارة المصروفات اليومية" FontSize="28" FontWeight="ExtraBold" Foreground="{StaticResource Brush.PrimaryDark}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Gorgeous Segmented Control for switching modes -->
                <Border Grid.Column="1" Background="{StaticResource Brush.Border}" CornerRadius="22" Padding="4" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsViewingDetails}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <!-- المصاريف المفتوحة -->
                        <Button Command="{Binding SetShowPostedArchiveCommand}" CommandParameter="False">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SleekTabButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowPostedArchive}" Value="False">
                                            <Setter Property="Background" Value="White"/>
                                            <Setter Property="Foreground" Value="{StaticResource Brush.PrimaryDark}"/>
                                            <Setter Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Color="{StaticResource Color.BorderStrong}" Opacity="0.5"/>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="18"/>
                                </Style>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FolderOpenOutline" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="المصاريف المفتوحة" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- الأرشيف المرحّل -->
                        <Button Command="{Binding SetShowPostedArchiveCommand}" CommandParameter="True">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SleekTabButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowPostedArchive}" Value="True">
                                            <Setter Property="Background" Value="White"/>
                                            <Setter Property="Foreground" Value="{StaticResource Brush.PrimaryDark}"/>
                                            <Setter Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Color="{StaticResource Color.BorderStrong}" Opacity="0.5"/>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="18"/>
                                </Style>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ArchiveOutline" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="الأرشيف المرحّل" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- زر الرجوع (يظهر فقط في شاشة التفاصيل) -->
                <Button Grid.Column="2" Command="{Binding GoBackCommand}" Style="{StaticResource MaterialDesignOutlinedButton}"
                        Foreground="{StaticResource Brush.PrimaryDark}" BorderBrush="{StaticResource Brush.PrimaryDark}" Padding="16,8" Height="40"
                        materialDesign:ButtonAssist.CornerRadius="10"
                        Visibility="{Binding IsViewingDetails, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ArrowRight" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="عودة للقائمة" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ═══════════ شاشة 1: الفلاتر والجدول الرئيسي ═══════════ -->
        <Grid Grid.Row="2" Style="{StaticResource InverseBooleanToVisibilityConverter}">

            <!-- 🔓 1. OPEN EXPENSES PANEL (Visible when ShowPostedArchive is False) -->
            <Grid x:Name="OpenExpensesPanel">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowPostedArchive}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- الفلاتر -->
                <materialDesign:Card Grid.Row="0" UniformCornerRadius="16" Padding="24,20" Margin="0,0,0,24"
                                     Background="White" materialDesign:ElevationAssist.Elevation="Dp2">
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" ItemHeight="50">
                        <StackPanel Orientation="Horizontal" Margin="0,0,24,0" VerticalAlignment="Center">
                            <TextBlock Text="من تاريخ:" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource Brush.TextMuted}"/>
                            <DatePicker SelectedDate="{Binding DateFrom}" Width="130" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,24,0" VerticalAlignment="Center">
                            <TextBlock Text="إلى تاريخ:" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource Brush.TextMuted}"/>
                            <DatePicker SelectedDate="{Binding DateTo}" Width="130" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,24,0" VerticalAlignment="Center">
                            <TextBlock Text="الوردية:" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource Brush.TextMuted}"/>
                            <ComboBox ItemsSource="{Binding Shifts}" SelectedValuePath="Value" DisplayMemberPath="Name" 
                                      SelectedValue="{Binding SelectedShiftType}" Width="130" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,24,0" VerticalAlignment="Center">
                            <TextBlock Text="الكاشير:" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource Brush.TextMuted}"/>
                            <ComboBox ItemsSource="{Binding Cashiers}" SelectedItem="{Binding SelectedCashierName}" 
                                      Width="140" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Command="{Binding LoadExpensesCommand}" 
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    Background="{StaticResource Brush.PrimaryInteractive}" BorderBrush="{StaticResource Brush.PrimaryInteractive}" Foreground="White" Padding="20,8"
                                    materialDesign:ButtonAssist.CornerRadius="10" Margin="0,0,12,0" Height="40">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Filter" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="تصفية" VerticalAlignment="Center" FontSize="14" FontWeight="Bold"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ResetFiltersCommand}" 
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Foreground="{StaticResource Brush.TextMuted}" BorderBrush="{StaticResource Brush.BorderStrong}" Padding="16,8" Height="40"
                                    materialDesign:ButtonAssist.CornerRadius="10" Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Refresh" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="إعادة ضبط" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding PrintDailySummariesCommand}" 
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Foreground="{StaticResource Brush.Expense}" BorderBrush="{StaticResource Brush.ExpenseSoft}" Padding="16,8" Height="40"
                                    materialDesign:ButtonAssist.CornerRadius="10" ToolTip="طباعة التقرير (PDF)">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Printer" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="طباعة PDF" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </WrapPanel>
                </materialDesign:Card>

                <!-- الجدول الرئيسي -->
                <Border Grid.Row="1" CornerRadius="16" Background="White" Padding="0" Margin="0,0,0,0"
                        BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" ClipToBounds="True">
                    <DataGrid ItemsSource="{Binding DailySummaries}" AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                              CanUserSortColumns="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#F1F5F9"
                              Background="White" RowBackground="White" AlternatingRowBackground="#F8FAFC"
                              FontSize="15" BorderThickness="0"
                              materialDesign:DataGridAssist.CellPadding="16,16"
                              materialDesign:DataGridAssist.ColumnHeaderPadding="16,14">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}"/>
                                <Setter Property="FontSize" Value="15"/>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="التسلسل" Binding="{Binding Sequence}" Width="Auto" MinWidth="100"/>
                            <DataGridTextColumn Header="اليوم (التاريخ)" Binding="{Binding DateDisplay}" Width="Auto" MinWidth="250">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="{StaticResource Brush.PrimaryDark}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="إجمالي المصاريف" Binding="{Binding TotalAmount, StringFormat='{}{0:N2} د.ل'}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="ExtraBold"/>
                                        <Setter Property="Foreground" Value="{StaticResource Brush.Pending}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="إجراءات" Width="Auto" MinWidth="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.ViewDayDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                CommandParameter="{Binding Date}"
                                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                                Foreground="{StaticResource Brush.PrimaryInteractive}" BorderBrush="{StaticResource Brush.PrimaryInteractive}"
                                                materialDesign:ButtonAssist.CornerRadius="8" Padding="12,4" Height="32">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Eye" Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="مشاهدة" VerticalAlignment="Center" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- الإجمالي العام للشاشة الرئيسية -->
                <Border Grid.Row="2" CornerRadius="16" Padding="24,18" Margin="0,24,0,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="{StaticResource Color.PrimaryDark}" Offset="0"/> 
                            <GradientStop Color="{StaticResource Color.PrimaryDark}" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="إجمالي المصروفات المعروضة:" FontSize="20" FontWeight="SemiBold" 
                                   Foreground="{StaticResource Brush.PrimarySoft}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding TotalFilteredExpensesAmount, StringFormat='{}{0:N2} د.ل'}" 
                                   FontSize="32" FontWeight="ExtraBold" Foreground="{StaticResource Brush.Accent}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- 🗂️ 2. ARCHIVED MONTHS PANEL (Visible when ShowPostedArchive is True and ArchiveLevel == 0) -->
            <Grid x:Name="ArchivedMonthsPanel">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding ShowPostedArchive}" Value="True"/>
                                    <Condition Binding="{Binding ArchiveLevel}" Value="0"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Title Bar -->
                        <Border Background="White" CornerRadius="16" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" Padding="20,16" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FolderZipOutline" Width="24" Height="24" Foreground="{StaticResource Brush.PrimaryInteractive}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="أرشيف الترحيل الشهري للمصروفات" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Brush.TextPrimary}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource MaterialDesignOutlinedButton}" Content="تحديث الأرشيف" Command="{Binding LoadArchivedMonthsCommand}" Height="32"/>
                            </Grid>
                        </Border>

                        <!-- Months List -->
                        <ItemsControl ItemsSource="{Binding ArchivedMonths}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding CardBackground}" BorderBrush="{Binding CardBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="20,12" Margin="0,0,0,12">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Color="{StaticResource Color.BorderStrong}" Opacity="0.4"/>
                                        </Border.Effect>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <!-- Month Name + Badge -->
                                                <ColumnDefinition Width="240"/>
                                                <!-- Sales -->
                                                <ColumnDefinition Width="160"/>
                                                <!-- Expenses -->
                                                <ColumnDefinition Width="160"/>
                                                <!-- Profit -->
                                                <ColumnDefinition Width="180"/>
                                                <!-- Days Count -->
                                                <ColumnDefinition Width="130"/>
                                                <!-- Spacer -->
                                                <ColumnDefinition Width="*"/>
                                                <!-- Actions -->
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Month Name + Badge -->
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Background="{StaticResource Brush.LockedSoft}" CornerRadius="13" Width="26" Height="26" Margin="0,0,8,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Sequence}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Brush.TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <materialDesign:PackIcon Kind="CalendarMonthOutline" Width="22" Height="22" Foreground="{StaticResource Brush.PrimaryInteractive}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding MonthName}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource Brush.TextPrimary}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <Border Background="{Binding StatusColor}" CornerRadius="10" Padding="8,3" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                                </Border>
                                            </StackPanel>

                                            <!-- Sales -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="المبيعات: " FontSize="12" Foreground="{StaticResource Brush.TextMuted}" FontWeight="Medium" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding TotalSales, StringFormat=\{0:N2\} د.ل}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Brush.Income}" VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <!-- Expenses -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="المصاريف: " FontSize="12" Foreground="{StaticResource Brush.TextMuted}" FontWeight="Medium" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding TotalExpenses, StringFormat=\{0:N2\} د.ل}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Brush.Expense}" VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <!-- Profit -->
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="صافي الأرباح: " FontSize="12" Foreground="{StaticResource Brush.TextMuted}" FontWeight="Medium" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding NetProfit, StringFormat=\{0:N2\} د.ل}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource Brush.TextPrimary}" VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <!-- Days Count -->
                                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="الأيام: " FontSize="12" Foreground="{StaticResource Brush.TextMuted}" FontWeight="Medium" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding DaysCount, StringFormat=\{0\} أيام عمل}" FontSize="12" Foreground="{StaticResource Brush.TextMuted}" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <!-- Action Button -->
                                            <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="عرض كشف التفاصيل" 
                                                        Command="{Binding DataContext.SelectMonthCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource MaterialDesignRaisedButton}" 
                                                        Background="{StaticResource Brush.PrimaryInteractive}" BorderBrush="{StaticResource Brush.PrimaryInteractive}" Height="36" Cursor="Hand" Margin="0,0,10,0">
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="8"/>
                                                        </Style>
                                                    </Button.Resources>
                                                </Button>

                                                <!-- Padlock/Lock icon as status -->
                                                <Border Width="36" Height="36" Background="{StaticResource Brush.PrimarySoft}" CornerRadius="18" Padding="6" ToolTip="حالة ترحيل الشهر">
                                                    <materialDesign:PackIcon Kind="Lock" Width="20" Height="20" Foreground="{StaticResource Brush.Income}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- 🗂️ 3. ARCHIVED MONTH DAYS PANEL (Visible when ShowPostedArchive is True and ArchiveLevel == 1) -->
            <Grid x:Name="ArchivedMonthDaysPanel">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding ShowPostedArchive}" Value="True"/>
                                    <Condition Binding="{Binding ArchiveLevel}" Value="1"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header with back button & month name -->
                <Border Grid.Row="0" Background="{StaticResource Brush.SurfaceAlt}" CornerRadius="16" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" Padding="20,12" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Go Back Button -->
                        <Button Grid.Column="0" Command="{Binding GoBackToMonthsCommand}" Style="{StaticResource MaterialDesignFlatButton}" Foreground="{StaticResource Brush.PrimaryInteractive}" Height="36" Padding="8,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ArrowRight" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="العودة لقائمة الأشهر" VerticalAlignment="Center" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>

                        <TextBlock Grid.Column="2" Text="{Binding SelectedArchivedMonth.MonthName, StringFormat=أرشيف مصروفات شهر: \{0\}}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource Brush.TextPrimary}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Days DataGrid -->
                <Border Grid.Row="1" CornerRadius="16" Background="White" Padding="0" Margin="0"
                        BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" ClipToBounds="True">
                    <DataGrid ItemsSource="{Binding DailySummaries}" AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                              CanUserSortColumns="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#F1F5F9"
                              Background="White" RowBackground="White" AlternatingRowBackground="#F8FAFC"
                              FontSize="15" BorderThickness="0"
                              materialDesign:DataGridAssist.CellPadding="16,16"
                              materialDesign:DataGridAssist.ColumnHeaderPadding="16,14">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}"/>
                                <Setter Property="FontSize" Value="15"/>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="التسلسل" Binding="{Binding Sequence}" Width="Auto" MinWidth="100"/>
                            <DataGridTextColumn Header="اليوم (التاريخ)" Binding="{Binding DateDisplay}" Width="Auto" MinWidth="250">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="{StaticResource Brush.PrimaryDark}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="إجمالي المصاريف" Binding="{Binding TotalAmount, StringFormat='{}{0:N2} د.ل'}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="ExtraBold"/>
                                        <Setter Property="Foreground" Value="{StaticResource Brush.Pending}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="إجراءات" Width="Auto" MinWidth="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.ViewDayDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                CommandParameter="{Binding Date}"
                                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                                Foreground="{StaticResource Brush.PrimaryInteractive}" BorderBrush="{StaticResource Brush.PrimaryInteractive}"
                                                materialDesign:ButtonAssist.CornerRadius="8" Padding="12,4" Height="32">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Eye" Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="مشاهدة" VerticalAlignment="Center" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- Total Border -->
                <Border Grid.Row="2" CornerRadius="16" Padding="24,18" Margin="0,16,0,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="{StaticResource Color.PrimaryDark}" Offset="0"/> 
                            <GradientStop Color="{StaticResource Color.PrimaryDark}" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="إجمالي مصروفات الشهر المرحّلة:" FontSize="20" FontWeight="SemiBold" 
                                   Foreground="{StaticResource Brush.PrimarySoft}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding TotalFilteredExpensesAmount, StringFormat='{}{0:N2} د.ل'}" 
                                   FontSize="32" FontWeight="ExtraBold" Foreground="{StaticResource Brush.Accent}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ═══════════ شاشة 2: تفاصيل يوم محدد ═══════════ -->
        <Grid Grid.Row="2" Style="{StaticResource BooleanToVisibilityStyle}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- عنوان التقرير وأزرار التقرير -->
            <materialDesign:Card Grid.Row="0" UniformCornerRadius="12" Padding="20,16" Margin="0,0,0,16" Background="{StaticResource Brush.SurfaceAlt}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Brush.TextStrong}" VerticalAlignment="Center">
                        <Run Text="{Binding SelectedDateDetailsTitle, Mode=OneWay}"/>
                        <Run Text="{Binding SelectedDateDetailsDisplay, Mode=OneWay}" Foreground="{StaticResource Brush.PrimaryInteractive}"/>
                    </TextBlock>
                    <Button Grid.Column="1" Command="{Binding PrintDayExpensesCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="{StaticResource Brush.IncomeText}" BorderBrush="{StaticResource Brush.IncomeText}" Foreground="White" Padding="16,6"
                            materialDesign:ButtonAssist.CornerRadius="8">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Printer" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="طباعة التقرير" VerticalAlignment="Center" FontSize="14" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </materialDesign:Card>

            <!-- قائمة الورديات -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding DayShifts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <materialDesign:Card UniformCornerRadius="16" Margin="0,0,0,24" Padding="0"
                                                 materialDesign:ElevationAssist.Elevation="Dp3">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- هيدر الوردية -->
                                    <Border Grid.Row="0" Background="{StaticResource Brush.PrimarySoft}" Padding="20,16" CornerRadius="16,16,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- اسم الوردية والكاشير -->
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <materialDesign:PackIcon Kind="ClockOutline" Width="24" Height="24" Foreground="{StaticResource Brush.PrimaryInteractive}" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding ShiftName}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Brush.PrimaryDark}" Margin="0,0,16,0"/>
                                                <materialDesign:PackIcon Kind="Account" Width="24" Height="24" Foreground="{StaticResource Brush.TextMuted}" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding CashierName}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Brush.TextSecondary}"/>
                                            </StackPanel>

                                            <!-- إجمالي الوردية -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                                                <TextBlock Text="إجمالي الوردية:" FontSize="16" Foreground="{StaticResource Brush.TextMuted}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding ShiftTotal, StringFormat='{}{0:N2} د.ل'}" FontSize="20" FontWeight="ExtraBold" Foreground="{StaticResource Brush.Pending}" VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <!-- زر التعديل / العرض -->
                                            <Button Grid.Column="3" Command="{Binding DataContext.EditShiftExpenseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding JournalId}"
                                                    materialDesign:ButtonAssist.CornerRadius="8" Padding="12,4" Height="36">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                                                        <!-- الافتراضي: تعديل الوردية (الوضع المفتوح) -->
                                                        <Setter Property="Background" Value="{StaticResource Brush.Pending}"/>
                                                        <Setter Property="BorderBrush" Value="{StaticResource Brush.Pending}"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                        <Setter Property="Content">
                                                            <Setter.Value>
                                                                <StackPanel Orientation="Horizontal">
                                                                    <materialDesign:PackIcon Kind="Pencil" Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                                    <TextBlock Text="تعديل الوردية" VerticalAlignment="Center" FontWeight="Bold"/>
                                                                </StackPanel>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DataContext.ShowPostedArchive, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                                <!-- عند تشغيل وضع الأرشيف المرحل: عرض الوردية -->
                                                                <Setter Property="Background" Value="{StaticResource Brush.PrimaryInteractive}"/>
                                                                <Setter Property="BorderBrush" Value="{StaticResource Brush.PrimaryInteractive}"/>
                                                                <Setter Property="Content">
                                                                    <Setter.Value>
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <materialDesign:PackIcon Kind="Eye" Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                                            <TextBlock Text="عرض الوردية" VerticalAlignment="Center" FontWeight="Bold"/>
                                                                        </StackPanel>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <!-- جدول مصاريف الوردية -->
                                    <DataGrid Grid.Row="1" ItemsSource="{Binding Expenses}" AutoGenerateColumns="False"
                                              CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                                              CanUserSortColumns="False"
                                              HeadersVisibility="Column" GridLinesVisibility="None"
                                              Background="White" RowBackground="White" AlternatingRowBackground="#F8FAFC"
                                              FontSize="14" BorderThickness="0" Margin="0,8,0,8"
                                              materialDesign:DataGridAssist.CellPadding="20,10"
                                              materialDesign:DataGridAssist.ColumnHeaderPadding="20,12">
                                        <DataGrid.Resources>
                                            <Style TargetType="DataGridColumnHeader">
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="Foreground" Value="{StaticResource Brush.TextFaint}"/>
                                            </Style>
                                        </DataGrid.Resources>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="التسلسل" Binding="{Binding Sequence}" Width="Auto" MinWidth="80"/>
                                            <DataGridTextColumn Header="نوع المصروف" Binding="{Binding ExpenseType}" Width="Auto" MinWidth="150">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource Brush.TextStrong}"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="المبلغ" Binding="{Binding Amount, StringFormat='{}{0:N2}'}" Width="Auto" MinWidth="120">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="المورد / الجهة" Binding="{Binding SupplierName}" Width="Auto" MinWidth="180"/>
                                            <DataGridTextColumn Header="البيان" Binding="{Binding Description}" Width="Auto" MinWidth="200"/>
                                            <DataGridTextColumn Header="ملاحظات" Binding="{Binding Notes}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </materialDesign:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- الإجمالي العام لليوم -->
            <Border Grid.Row="2" CornerRadius="16" Padding="24,18" Margin="0,16,0,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{StaticResource Color.IncomeText}" Offset="0"/> 
                        <GradientStop Color="{StaticResource Color.IncomeText}" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Column="0" Text="الإجمالي العام لمصاريف اليوم:" FontSize="20" FontWeight="SemiBold" 
                               Foreground="{StaticResource Brush.IncomeSoft}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding DayGrandTotal, StringFormat='{}{0:N2} د.ل'}" 
                               FontSize="32" FontWeight="ExtraBold" Foreground="White" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>

    </Grid>

    </TabItem>

    <!-- ═══════════ تبويب المصاريف العامة ═══════════ -->
    <TabItem Style="{StaticResource ModernSegmentedTabItemStyle}">
        <TabItem.Header>
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="CashMultiple" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center"
                                         Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
                <TextBlock Text="المصاريف العامة" FontSize="14" FontWeight="Bold"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
            </StackPanel>
        </TabItem.Header>
        <views:GeneralExpensesView/>
    </TabItem>

    </TabControl>

</UserControl>
