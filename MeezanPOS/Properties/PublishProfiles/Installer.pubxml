<?xml version="1.0" encoding="utf-8"?>
<!--
  نشر نسخة الإنتاج التي يحزمها المثبّت (Installer/MeezanPOS_Setup.iss):
  Release، ويندوز 64 بت، تتضمن بيئة .NET (لا تحتاج تثبيت .NET على جهاز المطعم)، في ملف تنفيذي واحد.
  الاستخدام: dotnet publish MeezanPOS/MeezanPOS.csproj -p:PublishProfile=Installer
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishDir>$(MSBuildProjectDirectory)\..\Publish\</PublishDir>
    <DeleteExistingFiles>true</DeleteExistingFiles>
  </PropertyGroup>
</Project>
