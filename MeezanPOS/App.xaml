<Application x:Class="MeezanPOS.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MeezanPOS"
             xmlns:vm="clr-namespace:MeezanPOS.Application.ViewModels"
             xmlns:views="clr-namespace:MeezanPOS.Presentation.Views"
             xmlns:converters="clr-namespace:MeezanPOS.Presentation.Converters"
             StartupUri="Presentation/Views/LoginView.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Light" PrimaryColor="BlueGrey" SecondaryColor="Amber" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>
            
            <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                <views:DashboardView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DailyJournalViewModel}">
                <views:DailyJournalView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SalesViewModel}">
                <views:SalesView />
            </DataTemplate>
            
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
            <converters:NumberToBooleanConverter x:Key="NumberToBooleanConverter"/>
            
        </ResourceDictionary>
    </Application.Resources>
</Application>
