<Application x:Class="MeezanPOS.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MeezanPOS"
             xmlns:vm="clr-namespace:MeezanPOS.Application.ViewModels"
             xmlns:views="clr-namespace:MeezanPOS.Presentation.Views"
             xmlns:converters="clr-namespace:MeezanPOS.Presentation.Converters"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Light" PrimaryColor="Indigo" SecondaryColor="Amber" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
                <ResourceDictionary Source="Presentation/Themes/MeezanTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- ===== أنماط هوية ميزان المبنية على MaterialDesign ===== -->
            <!-- ===== الأزرار ===== -->
            <Style x:Key="Button.Primary" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                <Setter Property="Background" Value="{StaticResource Brush.Primary}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Brush.Primary}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontFamily" Value="{StaticResource Font.Body}"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Height" Value="40"/>
                <Setter Property="Padding" Value="18,0"/>
                <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="6"/>
                <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp0"/>
            </Style>
            <Style x:Key="Button.Secondary" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
                <Setter Property="Background" Value="White"/>
                <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderStrong}"/>
                <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
                <Setter Property="FontFamily" Value="{StaticResource Font.Body}"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Height" Value="40"/>
                <Setter Property="Padding" Value="16,0"/>
                <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="6"/>
            </Style>
            <Style x:Key="Button.Danger" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
                <Setter Property="Background" Value="{StaticResource Brush.ExpenseSoft}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Brush.ExpenseSoft}"/>
                <Setter Property="Foreground" Value="{StaticResource Brush.ExpenseText}"/>
            </Style>

            <!-- شارة اختصار لوحة المفاتيح داخل الأزرار (مثل F9) -->
            <Style x:Key="KeyHint" TargetType="Border">
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="Padding" Value="5,1"/>
                <Setter Property="Background" Value="#33FFFFFF"/>
                <Setter Property="Margin" Value="8,0,0,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="KeyHintText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource Font.Money}"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FlowDirection" Value="LeftToRight"/>
            </Style>

            <!-- ===== حقل المبالغ: عريض بما يكفي لـ 999,999.000 ولا يقص الأرقام ===== -->
            <Style x:Key="MoneyTextBox" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
                <Setter Property="FontFamily" Value="{StaticResource Font.Money}"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="MinWidth" Value="150"/>
                <Setter Property="FlowDirection" Value="LeftToRight"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Padding" Value="10,8"/>
                <Setter Property="materialDesign:TextFieldAssist.SuffixText" Value="د.ل"/>
                <Setter Property="materialDesign:TextFieldAssist.TextFieldCornerRadius" Value="6"/>
            </Style>


            
            <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                <views:DashboardView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DailyJournalViewModel}">
                <views:DailyJournalView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SalesViewModel}">
                <views:SalesView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SupplierListViewModel}">
                <views:SupplierListView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SupplierDetailsViewModel}">
                <views:SupplierDetailsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ExpenseManagementViewModel}">
                <views:ExpenseManagementView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:WagesManagementViewModel}">
                <views:WagesManagementView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:BankingServicesViewModel}">
                <views:BankingServicesView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:FreeOrdersReturnsViewModel}">
                <views:FreeOrdersReturnsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ClosingAccountViewModel}">
                <views:ClosingAccountView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsView />
            </DataTemplate>
            
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
            <converters:NumberToBooleanConverter x:Key="NumberToBooleanConverter"/>
            
            <!-- ===== الجداول: كثيفة، مخططة بالتناوب، رأس ثابت (هوية ميزان) ===== -->
            <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                <!-- الترتيب بالنقر على العنوان مفعّل؛ يُعطَّل فقط في جداول الإدخال وكشوف الرصيد التراكمي -->
                <Setter Property="CanUserSortColumns" Value="True"/>
                <!-- الأعمدة تتسع لعنوانها ومحتواها كاملين دون الحاجة لتوسيعها يدوياً -->
                <Setter Property="ColumnWidth" Value="Auto"/>
                <!-- تحرير الخلية بنقرة واحدة بدل نقرتين -->
                <Setter Property="materialDesign:DataGridAssist.EnableEditBoxAssist" Value="True"/>
                <Setter Property="Background" Value="{StaticResource Brush.Surface}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontFamily" Value="{StaticResource Font.Body}"/>
                <Setter Property="FontSize" Value="13.5"/>
                <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
                <Setter Property="GridLinesVisibility" Value="Horizontal"/>
                <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Brush.Border}"/>
                <Setter Property="AlternationCount" Value="2"/>
                <Setter Property="AlternatingRowBackground" Value="{StaticResource Brush.SurfaceAlt}"/>
                <Setter Property="RowBackground" Value="{StaticResource Brush.Surface}"/>
                <Setter Property="HeadersVisibility" Value="Column"/>
                <Setter Property="materialDesign:DataGridAssist.CellPadding" Value="12,9"/>
                <Setter Property="materialDesign:DataGridAssist.ColumnHeaderPadding" Value="12,10"/>
            </Style>
            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                <Setter Property="Background" Value="{StaticResource Brush.SurfaceAlt}"/>
                <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}"/>
                <Setter Property="FontFamily" Value="{StaticResource Font.Title}"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderStrong}"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
            </Style>
            <!-- الخلية المختارة: خلفية نيلية فاتحة ونص واضح بدل الرمادي -->
            <Style TargetType="DataGridCell" BasedOn="{StaticResource MaterialDesignDataGridCell}">
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{StaticResource Brush.PrimarySoft}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource Brush.PrimarySoft}"/>
                        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style TargetType="DataGridRow" BasedOn="{StaticResource MaterialDesignDataGridRow}">
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{StaticResource Brush.PrimarySoft}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- ===== البطاقات من MaterialDesign بنفس شكل بطاقات ميزان ===== -->
            <Style TargetType="materialDesign:Card" BasedOn="{StaticResource {x:Type materialDesign:Card}}">
                <Setter Property="UniformCornerRadius" Value="12"/>
                <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp1"/>
            </Style>

            <!-- Global Modern Segmented TabControl Style -->
            <Style TargetType="TabControl">
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabControl">
                            <Grid KeyboardNavigation.TabNavigation="Local">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Beautiful Floating Header Container (RTL Right-Aligned Segmented Control) -->
                                <Border Grid.Row="0" 
                                        Background="#F1F5F9" 
                                        CornerRadius="14" 
                                        Padding="5" 
                                        HorizontalAlignment="Right" 
                                        Margin="0,0,0,24"
                                        BorderBrush="#E2E8F0"
                                        BorderThickness="1">
                                    <TabPanel x:Name="HeaderPanel" 
                                              IsItemsHost="True" 
                                              KeyboardNavigation.TabIndex="1" 
                                              Panel.ZIndex="1"/>
                                </Border>

                                <!-- Tab Page Content -->
                                <Border Grid.Row="1" 
                                        Background="Transparent" 
                                        KeyboardNavigation.TabIndex="2" 
                                        KeyboardNavigation.TabNavigation="Local" 
                                        KeyboardNavigation.DirectionalNavigation="Contained">
                                    <ContentPresenter x:Name="PART_SelectedContentHost" 
                                                      ContentSource="SelectedContent" 
                                                      Margin="{TemplateBinding Padding}"/>
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Global Modern Segmented TabItem Style -->
            <Style TargetType="TabItem">
                <Setter Property="HeaderTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <ContentPresenter Content="{TemplateBinding Content}"/>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}"/>
                <Setter Property="FontFamily" Value="{StaticResource Font.Title}"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border x:Name="Border" 
                                    Background="{TemplateBinding Background}" 
                                    CornerRadius="10" 
                                    Padding="28,10" 
                                    Margin="2,0"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter x:Name="ContentSite"
                                                  ContentSource="Header"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <!-- Hover state for unselected tab -->
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="True"/>
                                        <Condition Property="IsSelected" Value="False"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="Border" Property="Background" Value="#E2E8F0"/>
                                    <Setter Property="Foreground" Value="#0F172A"/>
                                </MultiTrigger>
                                
                                <!-- Selected State (Floating Card with DropShadow) -->
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Border" Property="Background" Value="#FFFFFF"/>
                                    <Setter Property="Foreground" Value="{StaticResource Brush.Primary}"/>
                                    <Setter TargetName="Border" Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect BlurRadius="10" ShadowDepth="1.5" Color="#64748B" Opacity="0.18"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
